# Tracking de holasara.ai. Copiá a .env y completá con los IDs de la cuenta que uses.
# Los tags cargan solo en build de prod.
#
# En Vercel: cargá estas mismas vars en Project → Settings → Environment Variables (Production).
#
# NO las marques como "Sensitive": el valor de una var sensible no se puede volver a leer,
# y como el build corre en el runner de GitHub (deploy.yml usa --prebuilt), `vercel pull`
# baja el literal "[SENSITIVE]" y eso es lo que termina en el HTML. Son IDs de tag público,
# no hay nada que proteger. Mientras tanto deploy.yml repone las cuatro de tracking.

# GA4 (ya seteado el de holasara por default; overrideable acá)
PUBLIC_GA4_ID=G-NRN8H0WR62

# Meta Pixel — dataset "Sara holasara.ai" (business RAY Software). NO es el pixel de
# RAY food. Es el mismo id que usa el backend (META_CAPI_PIXEL_ID) para los eventos
# server-side de Click-to-WhatsApp, así que web y CAPI reportan al mismo dataset.
PUBLIC_META_PIXEL_ID=4546263272359000

# Google Ads — ID de la cuenta, formato AW-XXXXXXXXXX. Es el mismo para todas las
# acciones de conversión de esa cuenta.
PUBLIC_GOOGLE_ADS_ID=

# Labels de conversión (la parte después de la barra en send_to: AW-123.../AbC-D_efGh).
#
# IMPORTANTE: dos labels distintos, no uno compartido.
#   DEMO → acción PRINCIPAL, la que optimiza Smart Bidding (form enviado).
#   WA   → acción SECUNDARIA, solo observación (clic en el botón de WhatsApp).
# Si comparten label, el algoritmo optimiza hacia el clic —que es barato y no es un
# lead— y el pipeline queda vacío con un CPA que parece excelente.
PUBLIC_GOOGLE_ADS_DEMO_LABEL=
PUBLIC_GOOGLE_ADS_WA_LABEL=

# Label viejo (setup de un solo label). Se usa como fallback de DEMO si no cargaste
# el nuevo. Podés dejarlo vacío.
PUBLIC_GOOGLE_ADS_LEAD_LABEL=

# Endpoint del lead (Zapier/Make catch hook, o tu CRM). Si queda vacío, el form del
# /demo hace handoff a WhatsApp con el resumen prellenado. Cargarlo es lo que evita
# que el usuario tenga que escribir dos veces.
PUBLIC_DEMO_ENDPOINT=

# Google Places (browser key, restringida por referrer). Sin esto el campo "clínica"
# queda como input de texto normal.
PUBLIC_GOOGLE_MAPS_API_KEY=
