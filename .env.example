# Tracking de holasara.ai (Fase 1). Copiá a .env y completá con los IDs NUEVOS de holasara
# (NO reusar los de RAY: contaminan su Pixel/Ads/GA). Los tags cargan solo en build de prod.
#
# En Vercel: cargá estas mismas vars en Project → Settings → Environment Variables (Production).

# GA4 (ya seteado el de holasara por default; overrideable acá)
PUBLIC_GA4_ID=G-NRN8H0WR62

# Meta Pixel — crear uno nuevo para holasara.ai en Meta Events Manager
PUBLIC_META_PIXEL_ID=

# Google Ads — tag del NUEVO account/campaña de holasara (formato AW-XXXXXXXXXX)
PUBLIC_GOOGLE_ADS_ID=

# Label de la conversión "Lead" de Google Ads (la parte después de la barra en send_to)
PUBLIC_GOOGLE_ADS_LEAD_LABEL=
