---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CtaBand from '../components/CtaBand.astro';
import CtaInline from '../components/CtaInline.astro';
import ClientsStrip from '../components/ClientsStrip.astro';
import FeatureFaq from '../components/FeatureFaq.astro';
import { whatsappLink } from '../lib/whatsapp';

const faqs = [
  { q: '¿Se nota que es una inteligencia artificial?', a: 'Sara se presenta con naturalidad y responde con el tono de tu clínica. El paciente siente que lo atiende alguien que sabe, no un bot con botones.' },
  { q: '¿Usa mi número de WhatsApp actual?', a: 'Sara atiende sobre una línea de WhatsApp Business conectada a tu clínica. Coordinamos el número en la implementación; no tienes que cambiar de teléfono personal.' },
  { q: '¿Reemplaza a mi recepción?', a: 'La libera de lo repetitivo: responder lo mismo, confirmar citas, perseguir pagos. Tu equipo se dedica al paciente que está en la clínica.' },
  { q: '¿Toca mi historia clínica?', a: 'No. No se almacena historia clínica ni información médica de tus pacientes. Eso queda donde está hoy.' },
  { q: '¿Qué necesito para empezar?', a: 'Conectar tu Google Calendar y una línea de WhatsApp. La implementación la hacemos contigo; no migras datos ni cambias de sistema.' },
];

const saraDoes = [
  'Responde en el momento, en WhatsApp e Instagram.',
  'Informa tratamientos, precios y disponibilidad real.',
  'Agenda la cita y cobra la consulta o el anticipo.',
  'Recuerda, confirma y reprograma sin que nadie intervenga.',
  'Reactiva pacientes que no vuelven hace meses.',
];

const context = [
  {
    n: '01',
    title: 'Escriben, no llaman',
    body: 'El primer contacto entra por WhatsApp o Instagram, y casi siempre fuera del horario de recepción.',
  },
  {
    n: '02',
    title: 'Esperan minutos, no horas',
    body: 'Si la respuesta llega al día siguiente, el interés ya se enfrió y la decisión ya se tomó.',
  },
  {
    n: '03',
    title: 'Agendan con el primero',
    body: 'Comparan pocas opciones y reservan en la clínica que responde antes.',
  },
];

const payments = [
  { title: 'Anticipo en línea al reservar', body: 'Compromete la cita y adelanta el flujo de caja. Baja la ausencia desde el primer mes.' },
  { title: 'Consulta cobrada por adelantado', body: 'El paciente paga cuando agenda, no cuando llega. Tu hora deja de ser gratis.' },
  { title: 'Gift cards', body: 'Tu paciente le regala un tratamiento a alguien que no te conoce. Cobras hoy y ganas un paciente nuevo que no te costó publicidad.' },
];

const marketing = [
  { title: 'Publicaciones listas para salir', body: 'Sara escribe el texto, elige la imagen y arma el calendario con la marca de tu clínica. Tú solo apruebas.' },
  { title: 'El post termina en una cita', body: 'Quien comenta o escribe por una publicación, Sara lo atiende y lo agenda. Sin que el interés se enfríe.' },
  { title: 'Sabes qué funcionó', body: 'Cada mes, en español claro: qué publicación trajo más consultas y cuánto facturaste. Sin planillas.' },
];

const posts = [
  { src: '/img/post-1.jpg', step: '1 · Sara publica', body: 'Una publicación de tu clínica sale en Instagram.' },
  { src: '/img/post-2.jpg', step: '2 · Alguien responde', body: 'Comenta o escribe, y Sara lo atiende al instante.' },
  { src: '/img/post-3.jpg', step: '3 · Reserva y paga', body: 'Agenda la cita y deja la seña. Confirmada.' },
];

// Overlay del hero: el circuito de Sara, sin recepción. Con logos reales de plataformas.
const chipBase = 'inline-block h-4 w-4 shrink-0 align-middle';
const chipWA = `<img src="/img/logos/whatsapp.svg" class="${chipBase}" alt="WhatsApp" loading="lazy" decoding="async" />`;
const chipIG = `<img src="/img/logos/instagram.svg" class="${chipBase}" alt="Instagram" loading="lazy" decoding="async" />`;
const chipG = `<img src="/img/logos/google.svg" class="${chipBase}" alt="Google" loading="lazy" decoding="async" />`;
const stars = `<span style="color:#f5b50a;letter-spacing:1px;font-size:11px;line-height:1">★★★★★</span>`;
const circuito = [
  { t: 'Te encuentran', icons: `${chipG}${chipIG}`, d: 'donde ya te buscan' },
  { t: 'Chatean con Sara', icons: `${chipWA}${chipIG}`, d: 'a cualquier hora' },
  { t: 'Sara agenda', d: 'Jueves 16:00 · confirmada' },
  { t: 'Cobra el anticipo', d: 'US$45 antes de llegar' },
  { t: 'Pide la reseña', icons: `${chipG}${stars}`, d: 'reseña nueva' },
];
---

<Layout>
  <Header />

  <main>
    <!-- ══════════ HERO ══════════ -->
    <section class="relative overflow-hidden">
      <div
        class="pointer-events-none absolute -right-32 -top-40 h-[520px] w-[520px] rounded-full opacity-60 blur-3xl"
        style="background: radial-gradient(circle, color-mix(in srgb, var(--color-mint) 40%, transparent), transparent 70%);"
        aria-hidden="true"
      >
      </div>

      <div class="mx-auto grid max-w-6xl items-center gap-14 px-5 py-20 md:grid-cols-[1.05fr_0.95fr] md:py-24">
        <div>
          <p class="mb-6 flex items-center gap-2.5 text-sm font-semibold uppercase tracking-[0.14em] text-pine-dark">
            <span class="dot h-2 w-2"></span>
            La secretaria con IA de tu clínica
          </p>
          <h1 class="font-serif font-black leading-[1.05] tracking-tight text-[clamp(1.5rem,8vw,3.75rem)]">
            <span class="block whitespace-nowrap">Más pacientes.</span>
            <span class="block whitespace-nowrap">Más facturación.</span>
            <span class="block whitespace-nowrap text-pine-dark">Todo automático,</span>
            <span class="block whitespace-nowrap text-pine-dark">las 24 horas.</span>
          </h1>
          <p class="mt-7 max-w-xl text-lg text-salvia">
            Sara atiende WhatsApp e Instagram, agenda, cobra el anticipo y baja las ausencias.
            Sin cambiar tu agenda ni tocar tu historia&nbsp;clínica.
          </p>

          <div class="mt-9 flex flex-wrap items-center gap-3">
            <a
              href="/demo"
              class="inline-flex items-center gap-2 rounded-full bg-pine px-6 py-3 text-base font-semibold text-cream transition-colors hover:bg-pine-dark"
            >
              Pedir demo
            </a>
            <a
              href={whatsappLink()}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-2 rounded-full border border-line px-6 py-3 text-base font-semibold text-ink transition-colors hover:border-ink/30"
            >
              Habla con Sara
            </a>
          </div>
        </div>

        <div class="flex justify-center md:justify-end">
          <div class="relative w-full max-w-lg">
            <img
              src="/img/hero/home-hero.jpg"
              width="1024"
              height="1024"
              alt="Dueña de una clínica de estética, tranquila y con todo bajo control, en un espacio luminoso con plantas de salvia."
              class="hidden w-full rounded-2xl border border-line shadow-[0_10px_30px_-20px_rgba(20,38,31,0.26)] md:block"
              fetchpriority="high"
            />
            <div class="mt-3 w-full rounded-2xl border border-line bg-cream/95 p-4 shadow-[0_16px_40px_-20px_rgba(20,38,31,0.45)] backdrop-blur-sm md:absolute md:bottom-4 md:right-4 md:mt-0 md:w-[14.5rem]">
              <p class="text-[11px] font-semibold uppercase tracking-[0.12em] text-pine-dark">El circuito, sin recepción</p>
              <ul class="mt-3 flex flex-col gap-2.5">
                {
                  circuito.map((c, i) => (
                    <li class="flex items-start gap-2.5">
                      <span class="grid h-5 w-5 shrink-0 place-items-center rounded-full bg-pine text-[11px] font-bold text-cream tabular-nums">{i + 1}</span>
                      <span class="min-w-0">
                        <span class="block text-[13px] font-semibold leading-tight text-ink">{c.t}</span>
                        {
                          c.icons ? (
                            <span class="mt-0.5 flex items-center gap-1">
                              <span class="flex items-center gap-1" set:html={c.icons} />
                              <span class="text-[11px] leading-tight text-salvia">{c.d}</span>
                            </span>
                          ) : (
                            <span class="block text-[11px] leading-tight text-salvia">{c.d}</span>
                          )
                        }
                      </span>
                    </li>
                  ))
                }
              </ul>
              <p class="mt-3 rounded-full border border-pine/15 bg-mint/[0.14] px-2.5 py-1 text-center text-[11px] font-medium text-pine-dark">
                <span aria-hidden="true">↺</span> Cada reseña trae al próximo paciente
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <ClientsStrip tone="paper" />

    <!-- ══════════ VIDEO ══════════ -->
    <section id="video" class="border-t border-line bg-paper">
      <div class="reveal mx-auto max-w-5xl px-5 py-24 text-center">
        <p class="mb-3 text-sm font-semibold uppercase tracking-[0.14em] text-pine-dark">En acción</p>
        <h2 class="mx-auto max-w-2xl font-serif text-4xl font-black leading-tight text-balance md:text-5xl">
          Mira a Sara en 60&nbsp;segundos.
        </h2>

        <!-- Video demo: portada liviana (thumbnail YouTube); el iframe se carga recién al clic -->
        <div
          id="video-embed"
          data-yt="-HAjxKXeltI"
          class="group relative mt-10 aspect-video cursor-pointer overflow-hidden rounded-2xl border border-line bg-ink shadow-[0_16px_40px_-26px_rgba(20,38,31,0.38)]"
        >
          <img
            src="https://img.youtube.com/vi/-HAjxKXeltI/maxresdefault.jpg"
            alt="Video: Sara en acción, en 60 segundos"
            class="absolute inset-0 h-full w-full object-cover opacity-95 transition group-hover:opacity-100"
            loading="lazy"
            decoding="async"
          />
          <button
            type="button"
            class="absolute inset-0 flex items-center justify-center bg-ink/25 transition group-hover:bg-ink/15"
            aria-label="Reproducir el video de Sara"
          >
            <span class="grid h-20 w-20 place-items-center rounded-full bg-mint shadow-lg transition-transform duration-300 group-hover:scale-110">
              <svg width="26" height="30" viewBox="0 0 26 30" fill="none" aria-hidden="true">
                <path d="M25 13.27a2 2 0 0 1 0 3.46L3 29.32A2 2 0 0 1 0 27.6V2.4A2 2 0 0 1 3 .68l22 12.6Z" fill="#14261F" />
              </svg>
            </span>
          </button>
        </div>
      </div>
    </section>

    <script is:inline>
      (function () {
        var el = document.getElementById('video-embed');
        if (!el) return;
        el.addEventListener('click', function () {
          var id = el.getAttribute('data-yt');
          el.innerHTML =
            '<iframe class="absolute inset-0 h-full w-full" src="https://www.youtube-nocookie.com/embed/' +
            id +
            '?autoplay=1&rel=0" title="Sara en acción" frameborder="0" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>';
        });
      })();
    </script>

    <!-- ══════════ EL CONTEXTO (banda oscura) ══════════ -->
    <section class="bg-ink text-cream">
      <div class="reveal mx-auto max-w-6xl px-5 py-24 md:py-28">
        <div class="max-w-3xl">
          <p class="mb-4 flex items-center gap-2.5 text-sm font-semibold uppercase tracking-[0.14em] text-mint">
            <span class="h-2 w-2 rounded-full bg-mint"></span>El contexto
          </p>
          <h2 class="font-serif text-4xl font-black leading-tight text-balance md:text-5xl">
            Tu paciente ya decidió <em class="text-mint">cómo</em> quiere&nbsp;agendar.
          </h2>
          <p class="mt-5 text-lg text-cream/70">
            Espera lo mismo que en cualquier otro servicio: respuesta inmediata. La clínica que
            responde primero se queda con el&nbsp;paciente.
          </p>
        </div>

        <div class="mt-16 grid gap-x-10 gap-y-12 md:grid-cols-3">
          {
            context.map((c) => (
              <div>
                <div class="flex items-center gap-4">
                  <span class="font-serif text-4xl font-black text-mint tabular-nums">{c.n}</span>
                  <span class="h-px flex-1 bg-cream/15" />
                </div>
                <h3 class="mt-5 text-xl font-semibold text-cream">{c.title}</h3>
                <p class="mt-2 text-cream/65">{c.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ══════════ CONOCE A SARA ══════════ -->
    <section id="sara" class="border-t border-line bg-paper">
      <div class="reveal mx-auto grid max-w-6xl gap-14 px-5 py-24 md:grid-cols-[0.85fr_1.15fr] md:items-center">
        <div>
          <p class="mb-3 text-sm font-semibold uppercase tracking-[0.14em] text-pine-dark">Conoce a Sara</p>
          <h2 class="font-serif text-4xl font-black leading-tight text-balance md:text-5xl">
            23:41 entra una&nbsp;consulta.<br /><em class="text-pine-dark">23:43 está pagada y&nbsp;agendada.</em>
          </h2>
          <p class="mt-5 text-lg text-salvia">
            Trabaja de noche, los fines de semana y en los picos. Sin sumar una persona más a recepción.
          </p>
          <ul class="mt-8 flex flex-col gap-3.5">
            {
              saraDoes.map((item) => (
                <li class="flex items-start gap-3">
                  <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-mint" />
                  <span class="text-ink">{item}</span>
                </li>
              ))
            }
          </ul>
          <a
            href="/sara"
            class="mt-8 inline-flex items-center gap-1.5 text-base font-semibold text-pine-dark transition-colors hover:text-ink"
          >
            Conoce más sobre Sara <span aria-hidden="true">→</span>
          </a>
        </div>

        <div class="flex justify-center md:justify-end">
          <img
            src="/img/chat-whatsapp.jpg"
            width="945"
            height="2045"
            alt="Conversación de WhatsApp: una paciente consulta de madrugada y Sara responde, agenda y cobra el anticipo."
            loading="lazy"
            decoding="async"
            class="w-full max-w-sm rounded-2xl border border-line shadow-[0_10px_30px_-20px_rgba(20,38,31,0.26)]"
          />
        </div>
      </div>
    </section>

    <!-- ══════════ MARKETING ══════════ -->
    <section class="border-t border-line bg-paper">
      <div class="reveal mx-auto max-w-6xl px-5 py-24">
        <p class="mb-3 text-sm font-semibold uppercase tracking-[0.14em] text-pine-dark">Marketing</p>
        <h2 class="max-w-2xl font-serif text-4xl font-black leading-tight text-balance md:text-5xl">
          Sara también lleva tu&nbsp;Instagram.
        </h2>
        <p class="mt-5 max-w-2xl text-lg text-salvia">
          Crea las publicaciones de tu clínica y atiende a quien responde, hasta agendar.
          Tu marketing y tu agenda, por fin&nbsp;conectados.
        </p>
        <a
          href="/instagram"
          class="mt-5 inline-flex items-center gap-1.5 text-base font-semibold text-pine-dark transition-colors hover:text-ink"
        >
          Ver cómo Sara lleva tu Instagram <span aria-hidden="true">→</span>
        </a>

        <div class="mt-14 grid gap-14 md:grid-cols-[0.85fr_1.15fr] md:items-stretch">
          <div class="flex h-full flex-col gap-6">
            {
              marketing.map((m) => (
                <div class="flex flex-1 flex-col justify-center rounded-xl border border-line bg-cream p-7">
                  <h3 class="text-xl font-semibold">{m.title}</h3>
                  <p class="mt-2 text-salvia">{m.body}</p>
                </div>
              ))
            }
          </div>
          <div class="flex justify-center md:justify-end">
            <img
              src="/img/instagram.jpg"
              width="1200"
              height="1242"
              alt="Feed de Instagram de una clínica generado con IA: publicaciones con la marca, listas para salir."
              loading="lazy"
              decoding="async"
              class="w-full rounded-xl border border-line shadow-[0_10px_30px_-20px_rgba(20,38,31,0.28)]"
            />
          </div>
        </div>

        <div class="mt-14">
          <p class="text-sm font-semibold uppercase tracking-wide text-pine-dark">Del post a la cita, paso a paso</p>
          <div class="mt-6 grid gap-6 sm:grid-cols-3">
            {
              posts.map((p) => (
                <div>
                  <div class="overflow-hidden rounded-xl border border-line bg-white shadow-[0_10px_30px_-20px_rgba(20,38,31,0.28)]">
                    <img src={p.src} alt={p.step} loading="lazy" decoding="async" class="w-full" />
                  </div>
                  <p class="mt-3 font-serif text-lg font-bold">{p.step}</p>
                  <p class="text-salvia">{p.body}</p>
                </div>
              ))
            }
          </div>
          <p class="mt-8 text-lg text-salvia">Instagram, el chat y el cobro, en un mismo lugar. Nadie más cierra ese&nbsp;círculo.</p>
        </div>
      </div>
    </section>

    <!-- ══════════ SPOTLIGHT · OPERADORA ══════════ -->
    <section class="border-t border-line">
      <div class="reveal mx-auto grid max-w-6xl gap-14 px-5 py-24 md:grid-cols-[1.15fr_0.85fr] md:items-center">
        <div class="order-2 md:order-1 flex justify-center md:justify-start">
          <img
            src="/img/operador.jpg"
            width="1200"
            height="1087"
            alt="Sara gestiona la agenda de la semana y reprograma todas las citas del martes, avisando a cada paciente."
            loading="lazy"
            decoding="async"
            class="w-full rounded-xl border border-line shadow-[0_10px_30px_-20px_rgba(20,38,31,0.26)]"
          />
        </div>
        <div class="order-1 md:order-2">
          <p class="mb-3 text-sm font-semibold uppercase tracking-[0.14em] text-pine-dark">Spotlight · Sara</p>
          <h2 class="font-serif text-4xl font-black leading-tight text-balance md:text-5xl">
            Además de atender y vender, <em class="text-pine-dark">Sara es tu&nbsp;secretaria.</em>
          </h2>
          <div class="mt-8 flex flex-col gap-3">
            {
              ['“Bloquea mi agenda el viernes.”', '“Pasa a Juan al jueves 10.”', '“Reagenda a todos los del martes.”'].map((q) => (
                <div class="rounded-xl border border-line bg-paper px-4 py-3 font-accent text-lg italic text-pine-dark">
                  {q}
                </div>
              ))
            }
          </div>
          <p class="mt-6 text-salvia">
            Gestiona la agenda entera y notifica a cada paciente. Las 24 horas.
          </p>
        </div>
      </div>
    </section>

    <!-- CTA intercalado -->
    <CtaInline title="Cada consulta que no respondes a tiempo, agenda en&nbsp;otra clínica." />

    <!-- ══════════ COBROS ══════════ -->
    <section id="cobros" class="border-t border-line">
      <div class="reveal mx-auto grid max-w-6xl gap-14 px-5 py-24 md:grid-cols-[0.85fr_1.15fr] md:items-center">
        <div>
          <p class="mb-3 text-sm font-semibold uppercase tracking-[0.14em] text-pine-dark">Cobros</p>
          <h2 class="font-serif text-4xl font-black leading-tight text-balance md:text-5xl">
            Cobra antes de&nbsp;atender.
          </h2>
          <p class="mt-5 text-lg text-salvia">Tres formas de que entre dinero sin que nadie lo persiga.</p>
          <div class="mt-8 flex flex-col gap-5">
            {
              payments.map((p, i) => (
                <div class="flex gap-4">
                  <span class="font-accent text-xl italic text-pine-dark">{`0${i + 1}`}</span>
                  <div>
                    <h3 class="text-lg font-semibold">{p.title}</h3>
                    <p class="mt-1 text-salvia">{p.body}</p>
                  </div>
                </div>
              ))
            }
          </div>
          <a
            href="/cobros"
            class="mt-8 inline-flex items-center gap-1.5 text-base font-semibold text-pine-dark transition-colors hover:text-ink"
          >
            Ver todas las formas de cobrar <span aria-hidden="true">→</span>
          </a>
        </div>
        <div class="flex justify-center md:justify-end">
          <img
            src="/img/cobros.jpg"
            width="1200"
            height="1186"
            alt="Panel de cobros: anticipos, consultas y gift cards cobrados por Sara, todos sin recepción."
            loading="lazy"
            decoding="async"
            class="w-full rounded-xl border border-line shadow-[0_10px_30px_-20px_rgba(20,38,31,0.28)]"
          />
        </div>
      </div>
    </section>

    <!-- CTA intercalado -->
    <CtaInline title="Ve a Sara atendiendo tu clínica, en vivo." cta="Pedir mi demo" />

    <!-- ══════════ IMPLEMENTACIÓN ══════════ -->
    <section class="border-t border-line">
      <div class="reveal mx-auto grid max-w-6xl gap-14 px-5 py-24 md:grid-cols-[0.85fr_1.15fr] md:items-center">
        <div>
          <p class="mb-3 text-sm font-semibold uppercase tracking-[0.14em] text-pine-dark">Implementación</p>
          <h2 class="font-serif text-3xl font-black leading-tight text-balance md:text-4xl">
            Conectas tu Google Calendar y ya está funcionando.
          </h2>
          <div class="mt-8 flex flex-col gap-6">
            <div>
              <h3 class="text-lg font-semibold">Un clic y listo</h3>
              <p class="mt-1 text-salvia">Autorizas tu cuenta de Google y Sara empieza a leer y escribir en el calendario que ya usas. No migras nada.</p>
            </div>
            <div>
              <h3 class="text-lg font-semibold">Ve tu disponibilidad real</h3>
              <p class="mt-1 text-salvia">Agenda solo en los espacios libres, bloquea al instante y todo aparece en el calendario de tu equipo. Sin dobles reservas.</p>
            </div>
            <div>
              <h3 class="text-lg font-semibold">Tus datos clínicos no pasan por aquí</h3>
              <p class="mt-1 text-salvia">No se almacena historia clínica ni información médica de tus pacientes. Eso queda donde está hoy.</p>
            </div>
          </div>
          <a
            href="/implementacion"
            class="mt-8 inline-flex items-center gap-1.5 text-base font-semibold text-pine-dark transition-colors hover:text-ink"
          >
            Ver cómo se conecta <span aria-hidden="true">→</span>
          </a>
        </div>
        <div class="flex justify-center md:justify-end">
          <img
            src="/img/implementacion.jpg"
            width="1200"
            height="1186"
            alt="Sara sincronizada con Google Calendar, agendando solo en los espacios libres del consultorio."
            loading="lazy"
            decoding="async"
            class="w-full rounded-xl border border-line shadow-[0_10px_30px_-20px_rgba(20,38,31,0.28)]"
          />
        </div>
      </div>
    </section>

    <!-- ══════════ CASO REAL ══════════ -->
    <section id="caso" class="border-t border-line bg-paper">
