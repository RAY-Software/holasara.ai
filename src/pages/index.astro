---
// Raíz del sitio. En producción, el Edge Middleware (middleware.ts) detecta el
// idioma del navegador por Accept-Language + cookie y redirige a /es o /en ANTES
// de llegar acá. Esta página es el fallback (preview local, crawlers sin
// Accept-Language, JS deshabilitado): manda al idioma por defecto.
import { defaultLocale } from '../i18n/config';
const target = `/${defaultLocale}`;
Astro.response.headers.set('cache-control', 'no-store');
---

<!doctype html>
<html lang={defaultLocale}>
  <head>
    <meta charset="utf-8" />
    <!-- Verificación de dominio de Meta. Duplicado del Layout a propósito: Meta pide el
         tag en la home y este es el fallback que se sirve cuando el middleware no corre
         (preview local, crawler sin Accept-Language). Mantener ambos en sync. -->
    <meta name="facebook-domain-verification" content="njpqfx6xxvyxxakl8z8pch5r1k5e9f" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <link rel="canonical" href={target} />
    <meta name="robots" content="noindex" />
    <title>Sara</title>
    <script is:inline set:html={`location.replace(${JSON.stringify(target)})`}></script>
  </head>
  <body>
    <a href={target}>Continuar →</a>
  </body>
</html>
