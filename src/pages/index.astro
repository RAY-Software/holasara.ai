---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { whatsappLink } from '../lib/whatsapp';

const saraDoes = [
  'Responde en el momento, en WhatsApp e Instagram.',
  'Informa tratamientos, precios y disponibilidad real.',
  'Agenda la cita y cobra la consulta o el anticipo.',
  'Recuerda, confirma y reprograma sin que nadie intervenga.',
  'Reactiva pacientes que no vuelven hace meses.',
];

const context = [
  {
    n: '01',
    title: 'Escriben, no llaman',
    body: 'El primer contacto entra por WhatsApp o Instagram, y casi siempre fuera del horario de recepción.',
  },
  {
    n: '02',
    title: 'Esperan minutos, no horas',
    body: 'Si la respuesta llega al día siguiente, el interés ya se enfrió y la decisión ya se tomó.',
  },
  {
    n: '03',
    title: 'Agendan con el primero',
    body: 'Comparan pocas opciones y reservan en la clínica que responde antes.',
  },
];

const agenda = [
  { title: 'Anticipo o consulta cobrada al reservar', body: 'El que paga, viene. Es el filtro de ausencias más efectivo que existe.' },
  { title: 'Recordatorios y confirmación automáticos', body: 'Sin que nadie de recepción levante el teléfono.' },
  { title: 'Lista de espera activa', body: 'Se cancela una cita y Sara la vuelve a ofrecer al instante.' },
  { title: 'Reactivación de pacientes inactivos', body: 'Los que no vuelven hace meses, contactados uno por uno.' },
  { title: 'Seguimiento post-tratamiento', body: 'Controles y retoques agendados en el momento justo, sin que los persigas.' },
];

const payments = [
  { title: 'Anticipo en línea al reservar', body: 'Compromete la cita y adelanta el flujo de caja. Baja la ausencia desde el primer mes.' },
  { title: 'Consulta cobrada por adelantado', body: 'El paciente paga cuando agenda, no cuando llega. Tu hora deja de ser gratis.' },
  { title: 'Gift cards', body: 'Tu paciente le regala un tratamiento a alguien que no te conoce. Cobras hoy y ganas un paciente nuevo que no te costó publicidad.' },
];

const marketing = [
  { title: 'Contenido de Instagram con IA', body: 'Ideas, textos, imágenes y calendario con la marca de tu clínica. Publicaciones listas para salir.' },
  { title: 'Resultados explicados', body: 'Qué funcionó y por qué, en español claro. Sin hojas de cálculo ni métricas para interpretar a mano.' },
  { title: 'Campañas medidas de verdad', body: 'Cuánto invertiste, cuántas citas entraron y cuánto facturaste. Por campaña.' },
];

const posts = [
  { src: '/img/post-1.jpg', step: '1 · El post', body: 'Tu agenda no sabe de marketing.' },
  { src: '/img/post-2.jpg', step: '2 · El chat con Sara', body: 'Tu agencia no ve tu facturación.' },
  { src: '/img/post-3.jpg', step: '3 · El checkout', body: 'Instagram no sabe qué es una cita.' },
];
---

<Layout>
  <Header />

  <main>
    <!-- ══════════ HERO ══════════ -->
    <section class="relative overflow-hidden">
      <div
        class="pointer-events-none absolute -right-32 -top-40 h-[520px] w-[520px] rounded-full opacity-60 blur-3xl"
        style="background: radial-gradient(circle, color-mix(in srgb, var(--color-mint) 40%, transparent), transparent 70%);"
        aria-hidden="true"
      >
      </div>

      <div class="mx-auto grid max-w-6xl items-center gap-14 px-5 py-20 md:grid-cols-[1.05fr_0.95fr] md:py-24">
        <div>
          <p class="mb-6 flex items-center gap-2.5 text-sm font-semibold uppercase tracking-[0.14em] text-pine-dark">
            <span class="dot h-2 w-2"></span>
            La secretaria con IA de tu clínica
          </p>
          <h1 class="font-serif font-black leading-[1.05] tracking-tight text-[clamp(1.85rem,6.6vw,3.75rem)]">
            <span class="block whitespace-nowrap">Más pacientes.</span>
            <span class="block whitespace-nowrap">Más facturación.</span>
            <span class="block whitespace-nowrap text-pine-dark">Todo automático,</span>
            <span class="block whitespace-nowrap text-pine-dark">las 24 horas.</span>
          </h1>
          <p class="mt-7 max-w-xl text-lg text-salvia">
            Sara atiende WhatsApp e Instagram, agenda, cobra el anticipo y baja las ausencias.
            Sin cambiar tu agenda ni tocar tu historia clínica.
          </p>

          <div class="mt-9 flex flex-wrap items-center gap-3">
            <a
              href={whatsappLink()}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-2 rounded-full bg-pine px-6 py-3 text-base font-semibold text-cream transition-colors hover:bg-pine-dark"
            >
              Habla con Sara
            </a>
            <a
              href="#sara"
              class="inline-flex items-center gap-2 rounded-full border border-line px-6 py-3 text-base font-semibold text-ink transition-colors hover:border-ink/30"
            >
              Ver cómo funciona
            </a>
          </div>

          <div class="mt-9 inline-flex flex-wrap items-center gap-3 rounded-full border border-line bg-paper px-5 py-3 text-sm shadow-sm">
            <b class="font-bold tabular-nums">23:41</b>
            <span class="text-salvia">entra una consulta</span>
            <span class="text-pine-dark">→</span>
            <b class="font-bold tabular-nums">23:43</b>
            <span class="text-salvia">pagada y agendada</span>
          </div>
        </div>

        <div class="flex justify-center md:justify-end">
          <img
            src="/img/hero.jpg"
            width="1200"
            height="1424"
            alt="Profesional en una clínica de estética, con el circuito de Sara: te encuentran, chatean, agenda, cobra y pide la reseña."
            class="w-full max-w-lg rounded-3xl border border-line shadow-[0_20px_50px_-24px_rgba(20,38,31,0.45)]"
            fetchpriority="high"
          />
        </div>
      </div>
    </section>

    <!-- ══════════ VIDEO ══════════ -->
    <section id="video" class="border-t border-line bg-paper">
      <div class="reveal mx-auto max-w-5xl px-5 py-24">
        <p class="mb-3 text-sm font-semibold uppercase tracking-[0.14em] text-pine-dark">En acción</p>
        <h2 class="max-w-2xl font-serif text-4xl font-black leading-tight text-balance md:text-5xl">
          Mira a Sara en 60 segundos.
        </h2>

        <div class="group relative mt-10 aspect-video overflow-hidden rounded-3xl border border-line bg-ink shadow-[0_30px_60px_-30px_rgba(20,38,31,0.6)]">
          <div
            class="absolute inset-0"
            style="background: radial-gradient(120% 90% at 50% 0%, color-mix(in srgb, var(--color-pine) 45%, transparent), transparent 60%);"
            aria-hidden="true"
          >
          </div>
          <div class="absolute inset-0 flex flex-col items-center justify-center gap-5">
            <span class="grid h-20 w-20 place-items-center rounded-full bg-mint shadow-lg transition-transform duration-300 group-hover:scale-110">
              <svg width="26" height="30" viewBox="0 0 26 30" fill="none" aria-hidden="true">
                <path d="M25 13.27a2 2 0 0 1 0 3.46L3 29.32A2 2 0 0 1 0 27.6V2.4A2 2 0 0 1 3 .68l22 12.6Z" fill="#14261F" />
              </svg>
            </span>
            <p class="font-serif text-xl font-bold text-cream">Video demo</p>
          </div>
          <span class="absolute left-4 top-4 rounded-full border border-cream/25 bg-ink/60 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-cream/70 backdrop-blur">
            Placeholder · 16:9
          </span>
        </div>
        <p class="mt-4 text-sm text-salvia">
          Aquí va el video demo (YouTube/Vimeo). Carga liviana: se muestra la portada y el video se
          carga recién al hacer clic.
        </p>
      </div>
    </section>

    <!-- ══════════ EL CONTEXTO ══════════ -->
    <section class="border-t border-line">
      <div class="reveal mx-auto max-w-6xl px-5 py-24">
        <p class="mb-3 text-sm font-semibold uppercase tracking-[0.14em] text-pine-dark">El contexto</p>
        <h2 class="max-w-2xl font-serif text-4xl font-black leading-tight text-balance md:text-5xl">
          Tu paciente ya decidió <em class="text-pine-dark">cómo</em> quiere agendar.
        </h2>
        <p class="mt-5 max-w-2xl text-lg text-salvia">
          Espera lo mismo que en cualquier otro servicio: respuesta inmediata. La clínica que
          responde primero se queda con el paciente.
        </p>

        <div class="mt-14 grid gap-6 md:grid-cols-3">
          {
            context.map((c) => (
              <div class="rounded-2xl border border-line bg-paper p-8">
                <span class="font-accent text-2xl italic text-pine-dark">{c.n}</span>
                <h3 class="mt-3 text-xl font-semibold">{c.title}</h3>
                <p class="mt-2 text-salvia">{c.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ══════════ CONOCE A SARA ══════════ -->
    <section id="sara" class="border-t border-line bg-paper">
      <div class="reveal mx-auto grid max-w-6xl gap-14 px-5 py-24 md:grid-cols-[0.85fr_1.15fr] md:items-center">
        <div>
          <p class="mb-3 text-sm font-semibold uppercase tracking-[0.14em] text-pine-dark">Conoce a Sara</p>
          <h2 class="font-serif text-4xl font-black leading-tight text-balance md:text-5xl">
            23:41 entra una consulta.<br /><em class="text-pine-dark">23:43 está pagada y agendada.</em>
          </h2>
          <p class="mt-5 text-lg text-salvia">
            Trabaja de noche, los fines de semana y en los picos. Sin sumar una persona más a recepción.
          </p>
          <ul class="mt-8 flex flex-col gap-3.5">
            {
              saraDoes.map((item) => (
                <li class="flex items-start gap-3">
                  <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-mint" />
                  <span class="text-ink">{item}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="flex justify-center md:justify-end">
          <img
            src="/img/chat-whatsapp.jpg"
            width="945"
            height="2045"
            alt="Conversación de WhatsApp: una paciente consulta de madrugada y Sara responde, agenda y cobra el anticipo."
            loading="lazy"
            decoding="async"
            class="w-full max-w-sm rounded-3xl border border-line shadow-[0_20px_50px_-24px_rgba(20,38,31,0.45)]"
          />
        </div>
      </div>
    </section>

    <!-- ══════════ SPOTLIGHT · OPERADORA ══════════ -->
    <section class="border-t border-line">
      <div class="reveal mx-auto grid max-w-6xl gap-14 px-5 py-24 md:grid-cols-[1.15fr_0.85fr] md:items-center">
        <div class="order-2 md:order-1 flex justify-center md:justify-start">
          <img
            src="/img/operador.jpg"
            width="1200"
            height="1087"
            alt="Sara gestiona la agenda de la semana y reprograma todas las citas del martes, avisando a cada paciente."
            loading="lazy"
            decoding="async"
            class="w-full rounded-2xl border border-line shadow-[0_20px_50px_-24px_rgba(20,38,31,0.45)]"
          />
        </div>
        <div class="order-1 md:order-2">
          <p class="mb-3 text-sm font-semibold uppercase tracking-[0.14em] text-pine-dark">Spotlight · Sara</p>
          <h2 class="font-serif text-4xl font-black leading-tight text-balance md:text-5xl">
            Además de atender y vender, <em class="text-pine-dark">Sara es tu secretaria.</em>
          </h2>
          <div class="mt-8 flex flex-col gap-3">
            {
              ['“Bloquea mi agenda el viernes.”', '“Pasa a Juan al jueves 10.”', '“Reagenda a todos los del martes.”'].map((q) => (
                <div class="rounded-xl border border-line bg-paper px-4 py-3 font-accent text-lg italic text-pine-dark">
                  {q}
                </div>
              ))
            }
          </div>
          <p class="mt-6 text-salvia">
            Gestiona la agenda entera y notifica a cada paciente. Las 24 horas.
          </p>
        </div>
      </div>
    </section>

    <!-- ══════════ AGENDA ══════════ -->
    <section id="agenda" class="border-t border-line bg-paper">
      <div class="reveal mx-auto max-w-6xl px-5 py-24">
        <p class="mb-3 text-sm font-semibold uppercase tracking-[0.14em] text-pine-dark">Agenda</p>
        <h2 class="max-w-2xl font-serif text-4xl font-black leading-tight text-balance md:text-5xl">
          La agenda que se llena sola.
        </h2>

        <div class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {
            agenda.map((a) => (
              <div class="flex flex-col rounded-2xl border border-line bg-cream p-7">
                <h3 class="text-lg font-semibold text-ink">{a.title}</h3>
                <p class="mt-2 text-salvia">{a.body}</p>
              </div>
            ))
          }
          <div class="flex flex-col justify-center rounded-2xl border border-pine/25 bg-mint/[0.08] p-7">
            <p class="font-accent text-xl italic text-pine-dark">El que paga, viene.</p>
          </div>
        </div>

        <div class="mt-8 overflow-hidden rounded-2xl border border-line bg-white shadow-[0_20px_50px_-30px_rgba(20,38,31,0.5)]">
          <img
            src="/img/agenda.jpg"
            width="1200"
            height="1186"
            alt="Vista de la agenda semanal: citas con anticipo pagado, confirmadas, recordatorios enviados y huecos revendidos desde la lista de espera."
            loading="lazy"
            decoding="async"
            class="w-full"
          />
        </div>
      </div>
    </section>

    <!-- ══════════ COBROS ══════════ -->
    <section id="cobros" class="border-t border-line">
      <div class="reveal mx-auto grid max-w-6xl gap-14 px-5 py-24 md:grid-cols-[0.85fr_1.15fr] md:items-center">
        <div>
          <p class="mb-3 text-sm font-semibold uppercase tracking-[0.14em] text-pine-dark">Cobros</p>
          <h2 class="font-serif text-4xl font-black leading-tight text-balance md:text-5xl">
            Cobra antes de atender.
          </h2>
          <p class="mt-5 text-lg text-salvia">Tres formas de que entre dinero sin que nadie lo persiga.</p>
          <div class="mt-8 flex flex-col gap-5">
            {
              payments.map((p, i) => (
                <div class="flex gap-4">
                  <span class="font-accent text-xl italic text-pine-dark">{`0${i + 1}`}</span>
                  <div>
                    <h3 class="text-lg font-semibold">{p.title}</h3>
                    <p class="mt-1 text-salvia">{p.body}</p>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
        <div class="flex justify-center md:justify-end">
          <img
            src="/img/cobros.jpg"
            width="1200"
            height="1186"
            alt="Panel de cobros: anticipos, consultas y gift cards cobrados por Sara, todos sin recepción."
            loading="lazy"
            decoding="async"
            class="w-full rounded-2xl border border-line shadow-[0_20px_50px_-30px_rgba(20,38,31,0.5)]"
          />
        </div>
      </div>
    </section>

    <!-- ══════════ MARKETING ══════════ -->
    <section class="border-t border-line bg-paper">
      <div class="reveal mx-auto max-w-6xl px-5 py-24">
        <p class="mb-3 text-sm font-semibold uppercase tracking-[0.14em] text-pine-dark">Marketing</p>
        <h2 class="max-w-2xl font-serif text-4xl font-black leading-tight text-balance md:text-5xl">
          Marketing que no depende de que tengas tiempo.
        </h2>

        <div class="mt-14 grid gap-14 md:grid-cols-[0.85fr_1.15fr] md:items-center">
          <div class="flex flex-col gap-6">
            {
              marketing.map((m) => (
                <div class="rounded-2xl border border-line bg-cream p-7">
                  <h3 class="text-xl font-semibold">{m.title}</h3>
                  <p class="mt-2 text-salvia">{m.body}</p>
                </div>
              ))
            }
          </div>
          <div class="flex justify-center md:justify-end">
            <img
              src="/img/instagram.jpg"
              width="1200"
              height="1242"
              alt="Feed de Instagram de una clínica generado con IA: publicaciones con la marca, listas para salir."
              loading="lazy"
              decoding="async"
              class="w-full rounded-2xl border border-line shadow-[0_20px_50px_-30px_rgba(20,38,31,0.5)]"
            />
          </div>
        </div>

        <div class="mt-14">
          <p class="text-sm font-semibold uppercase tracking-wide text-pine-dark">Del post al ingreso facturado</p>
          <div class="mt-6 grid gap-6 sm:grid-cols-3">
            {
              posts.map((p) => (
                <div>
                  <div class="overflow-hidden rounded-2xl border border-line bg-white shadow-[0_20px_50px_-30px_rgba(20,38,31,0.5)]">
                    <img src={p.src} alt={p.step} loading="lazy" decoding="async" class="w-full" />
                  </div>
                  <p class="mt-3 font-serif text-lg font-bold">{p.step}</p>
                  <p class="text-salvia">{p.body}</p>
                </div>
              ))
            }
          </div>
          <p class="mt-8 text-lg text-salvia">Los tres momentos ocurren en un mismo lugar. Nadie más cierra este círculo.</p>
        </div>
      </div>
    </section>

    <!-- ══════════ IMPLEMENTACIÓN ══════════ -->
    <section class="border-t border-line">
      <div class="reveal mx-auto grid max-w-6xl gap-14 px-5 py-24 md:grid-cols-[0.85fr_1.15fr] md:items-center">
        <div>
          <p class="mb-3 text-sm font-semibold uppercase tracking-[0.14em] text-pine-dark">Implementación</p>
          <h2 class="font-serif text-4xl font-black leading-tight text-balance md:text-5xl">
            Conectas tu Google Calendar y ya está funcionando.
          </h2>
          <div class="mt-8 flex flex-col gap-6">
            <div>
              <h3 class="text-lg font-semibold">Un clic y listo</h3>
              <p class="mt-1 text-salvia">Autorizas tu cuenta de Google y Sara empieza a leer y escribir en el calendario que ya usas. No migras nada.</p>
            </div>
            <div>
              <h3 class="text-lg font-semibold">Ve tu disponibilidad real</h3>
              <p class="mt-1 text-salvia">Agenda solo en los espacios libres, bloquea al instante y todo aparece en el calendario de tu equipo. Sin dobles reservas.</p>
            </div>
            <div>
              <h3 class="text-lg font-semibold">Tus datos clínicos no pasan por aquí</h3>
              <p class="mt-1 text-salvia">No se almacena historia clínica ni información médica de tus pacientes. Eso queda donde está hoy.</p>
            </div>
          </div>
        </div>
        <div class="flex justify-center md:justify-end">
          <img
            src="/img/implementacion.jpg"
            width="1200"
            height="1186"
            alt="Sara sincronizada con Google Calendar, agendando solo en los espacios libres del consultorio."
            loading="lazy"
            decoding="async"
            class="w-full rounded-2xl border border-line shadow-[0_20px_50px_-30px_rgba(20,38,31,0.5)]"
          />
        </div>
      </div>
    </section>

    <!-- ══════════ CASO REAL ══════════ -->
    <section id="caso" class="border-t border-line bg-paper">
      <div class="reveal mx-auto grid max-w-6xl gap-14 px-5 py-24 md:grid-cols-[0.85fr_1.15fr] md:items-center">
        <div>
          <p class="mb-4 text-sm font-semibold uppercase tracking-[0.14em] text-pine-dark">Caso de éxito</p>
          <img src="/img/vialaser-logo.png" width="398" height="126" alt="ViaLaser" class="mb-6 h-9 w-auto" loading="lazy" />
          <h2 class="font-serif text-4xl font-black leading-tight text-balance md:text-5xl">
            Ya está funcionando en clínicas reales.
          </h2>
          <div class="mt-10 flex flex-col gap-8">
            <div>
              <p class="font-serif text-5xl font-black text-pine-dark tabular-nums">114</p>
              <p class="mt-1 text-salvia">conversaciones atendidas por Sara, sin que recepción tocara nada.</p>
            </div>
            <div>
              <p class="font-serif text-5xl font-black text-pine-dark tabular-nums">7 de 10</p>
              <p class="mt-1 text-salvia">citas agendadas por Sara en WhatsApp, Instagram y la web.</p>
            </div>
            <div>
              <p class="font-serif text-5xl font-black text-pine-dark tabular-nums">US$1.071</p>
              <p class="mt-1 text-salvia">en citas generadas, cada una atribuida al canal que la trajo.</p>
            </div>
          </div>
        </div>
        <div class="flex justify-center md:justify-end">
          <img
            src="/img/vialaser-chart.jpg"
            width="1130"
            height="944"
            alt="Turnos de ViaLaser por canal y conversaciones por semana atendidas por Sara."
            loading="lazy"
            decoding="async"
            class="w-full rounded-2xl border border-line shadow-[0_20px_50px_-30px_rgba(20,38,31,0.5)]"
          />
        </div>
      </div>
    </section>

    <!-- ══════════ CTA FINAL ══════════ -->
    <section class="border-t border-line bg-ink text-cream">
      <div class="reveal mx-auto max-w-4xl px-5 py-28 text-center">
        <p class="mb-5 inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.14em] text-mint">
          <span class="dot h-2 w-2"></span> La recepción que nunca cierra
        </p>
        <h2 class="mx-auto max-w-3xl font-serif text-4xl font-black leading-tight text-balance md:text-6xl">
          Que la próxima consulta de las 23:41 no se te escape.
        </h2>
        <p class="mx-auto mt-6 max-w-xl text-lg text-cream/70">
          Pon a Sara a atender, agendar y cobrar hoy mismo. Sin cambiar tu agenda ni tu forma de trabajar.
        </p>
        <a
          href={whatsappLink()}
          target="_blank"
          rel="noopener"
          class="mt-10 inline-flex items-center gap-2 rounded-full bg-mint px-8 py-4 text-lg font-semibold text-ink transition-opacity hover:opacity-90"
        >
          Habla con Sara
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
