---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppChat from '../components/WhatsAppChat.astro';
import { whatsappLink } from '../lib/whatsapp';

const saraDoes = [
  'Responde en el momento, en WhatsApp e Instagram.',
  'Informa tratamientos, precios y disponibilidad real.',
  'Agenda la cita y cobra la consulta o el anticipo.',
  'Recuerda, confirma y reprograma sin que nadie intervenga.',
  'Reactiva pacientes que no vuelven hace meses.',
];

const context = [
  {
    n: '01',
    title: 'Escriben, no llaman',
    body: 'El primer contacto entra por WhatsApp o Instagram, y casi siempre fuera del horario de recepción.',
  },
  {
    n: '02',
    title: 'Esperan minutos, no horas',
    body: 'Si la respuesta llega al día siguiente, el interés ya se enfrió y la decisión ya se tomó.',
  },
  {
    n: '03',
    title: 'Agendan con el primero',
    body: 'Comparan pocas opciones y reservan en la clínica que contesta antes.',
  },
];

const agenda = [
  {
    title: 'Anticipo o consulta cobrada al reservar',
    body: 'El que paga, viene. Es el filtro de ausencias más efectivo que existe.',
  },
  {
    title: 'Recordatorios y confirmación automáticos',
    body: 'Sin que nadie de recepción levante el teléfono.',
  },
  {
    title: 'Lista de espera activa',
    body: 'Se cancela una cita y Sara la reofrece al instante.',
  },
  {
    title: 'Reactivación de pacientes inactivos',
    body: 'Los que no vuelven hace meses, contactados uno por uno.',
  },
  {
    title: 'Seguimiento post-tratamiento',
    body: 'Controles y retoques agendados en el momento justo, sin que los persigas.',
  },
];

const payments = [
  {
    title: 'Anticipo online al reservar',
    body: 'Compromete la cita y adelanta el flujo de caja. Baja la ausencia desde el primer mes.',
  },
  {
    title: 'Consulta cobrada por adelantado',
    body: 'El paciente paga cuando agenda, no cuando llega. Tu hora deja de ser gratis.',
  },
  {
    title: 'Gift cards',
    body: 'Tu paciente le regala un tratamiento a alguien que no te conoce. Cobrás hoy y ganás un paciente nuevo que no te costó publicidad.',
  },
];

const marketing = [
  {
    title: 'Contenido de Instagram con IA',
    body: 'Ideas, copy, imágenes y calendario con la marca de tu clínica. Publicaciones listas para salir.',
  },
  {
    title: 'Engagement explicado',
    body: 'Qué funcionó y por qué, en español claro. Sin hojas de cálculo ni métricas para interpretar a mano.',
  },
  {
    title: 'Campañas medidas de verdad',
    body: 'Cuánto gastaste, cuántas citas entraron y cuánto facturaste. Por campaña.',
  },
];
---

<Layout>
  <Header />

  <main>
    <!-- ══════════ HERO ══════════ -->
    <section class="relative overflow-hidden">
      <div
        class="pointer-events-none absolute -right-32 -top-40 h-[520px] w-[520px] rounded-full opacity-60 blur-3xl"
        style="background: radial-gradient(circle, color-mix(in srgb, var(--color-mint) 40%, transparent), transparent 70%);"
        aria-hidden="true"
      >
      </div>

      <div class="mx-auto grid max-w-6xl items-center gap-14 px-5 py-20 md:grid-cols-[1.1fr_0.9fr] md:py-28">
        <div>
          <p class="mb-6 flex items-center gap-2.5 text-xs font-semibold uppercase tracking-[0.16em] text-pine-dark">
            <span class="dot h-2 w-2"></span>
            La secretaria con IA de tu clínica
          </p>
          <h1 class="font-serif text-5xl font-medium leading-[1.02] tracking-tight text-balance md:text-7xl">
            Más pacientes.<br />Más facturación.<br />
            <em class="text-pine-dark">Todo automático, las 24 horas.</em>
          </h1>
          <p class="mt-7 max-w-xl text-lg text-salvia">
            Sara atiende WhatsApp e Instagram, agenda, cobra el anticipo y baja las ausencias —
            sin cambiar tu agenda ni tocar tu historia clínica.
          </p>

          <div class="mt-9 flex flex-wrap items-center gap-3">
            <a
              href={whatsappLink()}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-2 rounded-full bg-pine px-6 py-3 text-base font-semibold text-cream transition-colors hover:bg-pine-dark"
            >
              Hablá con Sara
            </a>
            <a
              href="#sara"
              class="inline-flex items-center gap-2 rounded-full border border-line px-6 py-3 text-base font-semibold text-ink transition-colors hover:border-ink/30"
            >
              Ver cómo funciona
            </a>
          </div>

          <div class="mt-9 inline-flex flex-wrap items-center gap-3 rounded-full border border-line bg-paper px-5 py-3 text-sm shadow-sm">
            <b class="font-bold tabular-nums">23:41</b>
            <span class="text-salvia">entra una consulta</span>
            <span class="text-pine-dark">→</span>
            <b class="font-bold tabular-nums">23:43</b>
            <span class="text-salvia">pagada y agendada</span>
          </div>
        </div>

        <div class="flex justify-center md:justify-end">
          <WhatsAppChat />
        </div>
      </div>
    </section>

    <!-- ══════════ EL COSTO ══════════ -->
    <section id="costo" class="border-t border-line bg-ink text-cream">
      <div class="reveal mx-auto max-w-6xl px-5 py-24">
        <p class="mb-3 text-xs font-semibold uppercase tracking-[0.16em] text-mint">El costo</p>
        <h2 class="max-w-2xl font-serif text-4xl font-medium leading-tight text-balance md:text-5xl">
          La cuenta que ninguna clínica hace.
        </h2>
        <p class="mt-5 max-w-2xl text-lg text-cream/60">
          Es dinero que ya pagaste para atraer. Un ejemplo con una clínica de medicina estética
          de tamaño medio — los números se reemplazan por los tuyos.
        </p>

        <div class="mt-14 grid gap-6 md:grid-cols-2">
          <div class="rounded-2xl border border-cream/10 bg-cream/[0.03] p-8">
            <p class="text-sm font-semibold uppercase tracking-wide text-cream/50">
              Consultas fuera de horario
            </p>
            <p class="mt-4 text-cream/80">
              <b class="tabular-nums">120</b> consultas/mes fuera de horario ×
              <b class="tabular-nums">35%</b> que habría agendado ×
              <b class="tabular-nums">US$180</b> ticket promedio
            </p>
            <p class="mt-6 font-serif text-4xl font-medium text-mint tabular-nums">US$7.560<span class="text-lg text-cream/50">/mes</span></p>
          </div>

          <div class="rounded-2xl border border-cream/10 bg-cream/[0.03] p-8">
            <p class="text-sm font-semibold uppercase tracking-wide text-cream/50">
              Citas que terminan en ausencia
            </p>
            <p class="mt-4 text-cream/80">
              <b class="tabular-nums">200</b> citas/mes ×
              <b class="tabular-nums">25%</b> que termina en ausencia ×
              <b class="tabular-nums">US$180</b> ticket promedio
            </p>
            <p class="mt-6 font-serif text-4xl font-medium text-mint tabular-nums">US$9.000<span class="text-lg text-cream/50">/mes</span></p>
          </div>
        </div>

        <div class="mt-6 rounded-2xl border border-mint/30 bg-mint/[0.08] p-8">
          <p class="text-sm font-semibold uppercase tracking-wide text-mint">Total que hoy no entra</p>
          <p class="mt-2 font-serif text-5xl font-medium tabular-nums md:text-6xl">US$16.560<span class="text-2xl text-cream/50"> por mes</span></p>
        </div>
      </div>
    </section>

    <!-- ══════════ EL CONTEXTO ══════════ -->
    <section class="border-t border-line">
      <div class="reveal mx-auto max-w-6xl px-5 py-24">
        <p class="mb-3 text-xs font-semibold uppercase tracking-[0.16em] text-pine-dark">El contexto</p>
        <h2 class="max-w-2xl font-serif text-4xl font-medium leading-tight text-balance md:text-5xl">
          Tu paciente ya decidió <em class="text-pine-dark">cómo</em> quiere agendar.
        </h2>
        <p class="mt-5 max-w-2xl text-lg text-salvia">
          Espera lo mismo que en cualquier otro servicio: respuesta inmediata. La clínica que
          responde primero se queda con el paciente.
        </p>

        <div class="mt-14 grid gap-6 md:grid-cols-3">
          {
            context.map((c) => (
              <div class="rounded-2xl border border-line bg-paper p-8">
                <span class="font-serif text-2xl text-pine-dark">{c.n}</span>
                <h3 class="mt-3 text-xl font-semibold">{c.title}</h3>
                <p class="mt-2 text-salvia">{c.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ══════════ CONOCÉ A SARA ══════════ -->
    <section id="sara" class="border-t border-line bg-paper">
      <div class="reveal mx-auto grid max-w-6xl gap-14 px-5 py-24 md:grid-cols-2 md:items-center">
        <div>
          <p class="mb-3 text-xs font-semibold uppercase tracking-[0.16em] text-pine-dark">Conocé a Sara</p>
          <h2 class="font-serif text-4xl font-medium leading-tight text-balance md:text-5xl">
            Atiende, agenda y cobra.<br /><em class="text-pine-dark">Sin sumar a nadie a recepción.</em>
          </h2>
          <p class="mt-5 text-lg text-salvia">
            Trabaja de noche, los fines de semana y en los picos. Con tus pacientes y con tu equipo.
          </p>
          <ul class="mt-8 flex flex-col gap-3.5">
            {
              saraDoes.map((item) => (
                <li class="flex items-start gap-3">
                  <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-mint" />
                  <span class="text-ink">{item}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="rounded-3xl border border-line bg-cream p-10">
          <p class="text-sm font-semibold uppercase tracking-wide text-salvia">Spotlight</p>
          <p class="mt-4 font-serif text-2xl leading-snug text-ink">
            Además de atender y vender, Sara es tu secretaria.
          </p>
          <div class="mt-6 flex flex-col gap-3">
            {
              [
                '“Bloqueá mi agenda el viernes.”',
                '“Pasá a Juan al jueves 10.”',
                '“Reagendá a todos los del martes.”',
              ].map((q) => (
                <div class="rounded-xl border border-line bg-paper px-4 py-3 font-serif text-lg italic text-pine-dark">
                  {q}
                </div>
              ))
            }
          </div>
          <p class="mt-6 text-salvia">
            Gestiona la agenda entera y notifica a cada paciente. Las 24 horas.
          </p>
        </div>
      </div>
    </section>

    <!-- ══════════ AGENDA ══════════ -->
    <section id="agenda" class="border-t border-line">
      <div class="reveal mx-auto max-w-6xl px-5 py-24">
        <p class="mb-3 text-xs font-semibold uppercase tracking-[0.16em] text-pine-dark">Agenda</p>
        <h2 class="max-w-2xl font-serif text-4xl font-medium leading-tight text-balance md:text-5xl">
          La agenda que se llena sola.
        </h2>

        <div class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {
            agenda.map((a) => (
              <div class="flex flex-col rounded-2xl border border-line bg-paper p-7">
                <h3 class="text-lg font-semibold text-ink">{a.title}</h3>
                <p class="mt-2 text-salvia">{a.body}</p>
              </div>
            ))
          }
          <div class="flex flex-col justify-center rounded-2xl border border-pine/25 bg-mint/[0.08] p-7">
            <p class="font-serif text-xl italic text-pine-dark">El que paga, viene.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════ COBROS ══════════ -->
    <section id="cobros" class="border-t border-line bg-paper">
      <div class="reveal mx-auto max-w-6xl px-5 py-24">
        <p class="mb-3 text-xs font-semibold uppercase tracking-[0.16em] text-pine-dark">Cobros</p>
        <h2 class="max-w-2xl font-serif text-4xl font-medium leading-tight text-balance md:text-5xl">
          Cobrá antes de atender.
        </h2>
        <p class="mt-5 max-w-2xl text-lg text-salvia">
          Tres formas de que entre dinero sin que nadie lo persiga.
        </p>

        <div class="mt-14 grid gap-6 md:grid-cols-3">
          {
            payments.map((p, i) => (
              <div class="rounded-2xl border border-line bg-cream p-8">
                <span class="font-serif text-2xl text-pine-dark">{`0${i + 1}`}</span>
                <h3 class="mt-3 text-xl font-semibold">{p.title}</h3>
                <p class="mt-2 text-salvia">{p.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ══════════ MARKETING ══════════ -->
    <section class="border-t border-line">
      <div class="reveal mx-auto max-w-6xl px-5 py-24">
        <p class="mb-3 text-xs font-semibold uppercase tracking-[0.16em] text-pine-dark">Marketing</p>
        <h2 class="max-w-2xl font-serif text-4xl font-medium leading-tight text-balance md:text-5xl">
          Marketing que no depende de que tengas tiempo.
        </h2>

        <div class="mt-14 grid gap-6 md:grid-cols-3">
          {
            marketing.map((m) => (
              <div class="rounded-2xl border border-line bg-paper p-8">
                <h3 class="text-xl font-semibold">{m.title}</h3>
                <p class="mt-2 text-salvia">{m.body}</p>
              </div>
            ))
          }
        </div>

        <div class="mt-8 rounded-2xl border border-line bg-ink p-10 text-cream">
          <p class="text-sm font-semibold uppercase tracking-wide text-mint">Del post al ingreso facturado</p>
          <div class="mt-6 grid gap-6 md:grid-cols-3">
            <div><p class="font-serif text-xl">1 · El post</p><p class="mt-1 text-cream/60">Tu agenda no sabe de marketing.</p></div>
            <div><p class="font-serif text-xl">2 · El chat con Sara</p><p class="mt-1 text-cream/60">Tu agencia no ve tu facturación.</p></div>
            <div><p class="font-serif text-xl">3 · El checkout</p><p class="mt-1 text-cream/60">Instagram no sabe qué es una cita.</p></div>
          </div>
          <p class="mt-8 text-lg text-cream/80">Los tres momentos ocurren en un mismo lugar. Nadie más cierra este círculo.</p>
        </div>
      </div>
    </section>

    <!-- ══════════ CASO REAL ══════════ -->
    <section id="caso" class="border-t border-line bg-paper">
      <div class="reveal mx-auto max-w-6xl px-5 py-24">
        <p class="mb-3 text-xs font-semibold uppercase tracking-[0.16em] text-pine-dark">Caso de éxito · ViaLaser</p>
        <h2 class="max-w-2xl font-serif text-4xl font-medium leading-tight text-balance md:text-5xl">
          Ya está funcionando en clínicas reales.
        </h2>

        <div class="mt-14 grid gap-6 md:grid-cols-3">
          <div class="rounded-2xl border border-line bg-cream p-8">
            <p class="font-serif text-5xl font-medium text-pine-dark tabular-nums">114</p>
            <p class="mt-3 text-salvia">conversaciones atendidas por Sara, sin que recepción tocara nada.</p>
          </div>
          <div class="rounded-2xl border border-line bg-cream p-8">
            <p class="font-serif text-5xl font-medium text-pine-dark tabular-nums">7&nbsp;de&nbsp;10</p>
            <p class="mt-3 text-salvia">citas agendadas por Sara en WhatsApp, Instagram y la web.</p>
          </div>
          <div class="rounded-2xl border border-line bg-cream p-8">
            <p class="font-serif text-5xl font-medium text-pine-dark tabular-nums">US$1.071</p>
            <p class="mt-3 text-salvia">en citas generadas, cada una atribuida al canal que la trajo.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════ IMPLEMENTACIÓN ══════════ -->
    <section class="border-t border-line">
      <div class="reveal mx-auto max-w-6xl px-5 py-24">
        <p class="mb-3 text-xs font-semibold uppercase tracking-[0.16em] text-pine-dark">Implementación</p>
        <h2 class="max-w-2xl font-serif text-4xl font-medium leading-tight text-balance md:text-5xl">
          Conectás tu Google Calendar y ya está funcionando.
        </h2>

        <div class="mt-14 grid gap-6 md:grid-cols-3">
          <div class="rounded-2xl border border-line bg-paper p-8">
            <h3 class="text-xl font-semibold">Un clic y listo</h3>
            <p class="mt-2 text-salvia">Autorizás tu cuenta de Google y Sara empieza a leer y escribir en el calendario que ya usás. No migrás nada.</p>
          </div>
          <div class="rounded-2xl border border-line bg-paper p-8">
            <h3 class="text-xl font-semibold">Ve tu disponibilidad real</h3>
            <p class="mt-2 text-salvia">Agenda solo en los huecos libres, bloquea al instante y todo aparece en el calendario de tu equipo. Sin dobles reservas.</p>
          </div>
          <div class="rounded-2xl border border-line bg-paper p-8">
            <h3 class="text-xl font-semibold">Tus datos clínicos no pasan por aquí</h3>
            <p class="mt-2 text-salvia">No se almacena historia clínica ni información médica de tus pacientes. Eso queda donde está hoy.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════ CTA FINAL ══════════ -->
    <section class="border-t border-line bg-ink text-cream">
      <div class="reveal mx-auto max-w-4xl px-5 py-28 text-center">
        <p class="mb-5 inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.16em] text-mint">
          <span class="dot h-2 w-2"></span> La recepción que nunca cierra
        </p>
        <h2 class="mx-auto max-w-3xl font-serif text-4xl font-medium leading-tight text-balance md:text-6xl">
          Que la próxima consulta de las 23:41 no se te escape.
        </h2>
        <p class="mx-auto mt-6 max-w-xl text-lg text-cream/70">
          Poné a Sara a atender, agendar y cobrar hoy mismo. Sin cambiar tu agenda ni tu forma de trabajar.
        </p>
        <a
          href={whatsappLink()}
          target="_blank"
          rel="noopener"
          class="mt-10 inline-flex items-center gap-2 rounded-full bg-mint px-8 py-4 text-lg font-semibold text-ink transition-opacity hover:opacity-90"
        >
          Hablá con Sara
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
