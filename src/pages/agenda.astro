---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import FeatureSteps from '../components/FeatureSteps.astro';
import FeatureFaq from '../components/FeatureFaq.astro';
import CtaInline from '../components/CtaInline.astro';
import CtaBand from '../components/CtaBand.astro';

const steps = [
  { title: 'Se agenda la cita', body: 'Sara la reserva desde el chat, o tu equipo la carga: todo cae en tu Google Calendar.' },
  { title: 'Sara la cuida', body: 'Cobra el anticipo, recuerda, confirma y libera el hueco si alguien cancela.' },
  { title: 'La agenda se llena sola', body: 'Reofrece los huecos a la lista de espera y reactiva a los que no vuelven.' },
];

const faqs = [
  { q: '¿Se integra con el calendario que ya uso?', a: 'Sí. Sara lee y escribe en tu Google Calendar. No migras nada ni cambias de sistema.' },
  { q: '¿Puede reservar dos pacientes en el mismo horario?', a: 'No. Agenda solo sobre la disponibilidad real y bloquea al instante, así no hay dobles reservas.' },
  { q: '¿Mi equipo puede seguir cargando turnos a mano?', a: 'Claro. Sara convive con tu equipo: lo que cargue recepción también queda reflejado y cuidado.' },
  { q: '¿Sirve si tengo varios profesionales o sucursales?', a: 'Sí. Se configura por agenda y por sucursal, para que cada turno caiga donde corresponde.' },
];

const items = [
  { t: 'Anticipo o consulta cobrada al reservar', b: 'El que paga, viene. Es el filtro de ausencias más efectivo que existe.' },
  { t: 'Recordatorios y confirmación automáticos', b: 'Sin que nadie de recepción levante el teléfono.' },
  { t: 'Lista de espera activa', b: 'Se cancela una cita y Sara la vuelve a ofrecer al instante.' },
  { t: 'Reactivación de pacientes inactivos', b: 'Los que no vuelven hace meses, contactados uno por uno.' },
  { t: 'Seguimiento post-tratamiento', b: 'Controles y retoques agendados en el momento justo, sin que los persigas.' },
];
---

<Layout
  title="Agenda · La agenda que se llena sola"
  description="Anticipo al reservar, recordatorios y confirmación automáticos, lista de espera activa y reactivación de pacientes. La agenda de tu clínica se llena y se cuida sola."
>
  <Header />
  <main>
    <PageHero
      eyebrow="Agenda"
      title="La agenda que se llena <em class='text-pine-dark'>sola.</em>"
      lead="Sara no solo agenda: cobra por adelantado, recuerda, confirma, reofrece los huecos que se liberan y trae de vuelta a los que dejaron de venir."
      image="/img/agenda.jpg"
      imageAlt="Vista de la agenda semanal: citas con anticipo pagado, confirmadas, recordatorios enviados y huecos revendidos desde la lista de espera."
      imageW={1200}
      imageH={1186}
    />

    <section class="border-b border-line bg-paper">
      <div class="mx-auto max-w-6xl px-5 py-24">
        <h2 class="max-w-2xl font-serif text-3xl font-black leading-tight text-balance md:text-4xl">
          Cinco formas de que no te quede un hueco&nbsp;vacío.
        </h2>
        <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {
            items.map((d) => (
              <div class="flex flex-col rounded-xl border border-line bg-cream p-7">
                <h3 class="text-lg font-semibold">{d.t}</h3>
                <p class="mt-2 text-salvia">{d.b}</p>
              </div>
            ))
          }
          <div class="flex items-center rounded-xl border border-pine/25 bg-mint/[0.08] p-7">
            <p class="font-accent text-xl italic text-pine-dark">El que paga, viene.</p>
          </div>
        </div>
      </div>
    </section>

    <FeatureSteps title="Cómo se llena tu agenda, paso a&nbsp;paso." steps={steps} />

    <CtaInline title="Que tu agenda deje de depender de que alguien la&nbsp;empuje." />

    <FeatureFaq items={faqs} />

    <CtaBand />
  </main>
  <Footer />
</Layout>
