---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import FeatureRow from '../components/FeatureRow.astro';
import ConversationDemo from '../components/ConversationDemo.astro';
import FeatureFaq from '../components/FeatureFaq.astro';
import CtaInline from '../components/CtaInline.astro';
import CtaBand from '../components/CtaBand.astro';

const steps = [
  { n: '01', title: 'Se agenda la cita', body: 'Por Sara o cargada por tu equipo: entra al calendario que ya usas.' },
  { n: '02', title: 'Sara recuerda y pide confirmar', body: 'Un mensaje claro el día antes, con la opción de confirmar o reprogramar en un toque.' },
  { n: '03', title: 'La agenda queda limpia', body: 'Confirmados marcados, cancelaciones liberadas y los huecos vueltos a ofrecer a la lista de espera.' },
];

const faqs = [
  { q: '¿Cuándo manda el recordatorio?', a: 'En la ventana que mejor funciona para tu clínica (por ejemplo, el día anterior). Lo ajustamos en la implementación.' },
  { q: '¿Cómo confirma el paciente?', a: 'Directo en el chat: responde SÍ para confirmar. Sin apps, sin links raros, sin llamadas. En el panel ves quién confirmó de un vistazo.' },
  { q: '¿Qué pasa si el paciente no confirma?', a: 'Sara puede reintentar con criterio y, si la cita igual se libera, ofrecerla a alguien de la lista de espera para no perder la hora.' },
  { q: '¿Sirve para cualquier tratamiento?', a: 'Sí. Funciona igual para una consulta de valoración que para un control post-tratamiento.' },
  { q: '¿Reemplaza a mi recepción?', a: 'La libera de la tarea más repetitiva. Tu equipo deja de perseguir confirmaciones y se dedica al paciente que está en la clínica.' },
];
---

<Layout
  title="Recordatorios y confirmación · Sara"
  description="Sara recuerda cada cita y pide confirmación por WhatsApp, sin que nadie de recepción llame. Menos ausencias, agenda siempre al día, y el hueco que se libera vuelve a la lista de espera."
>
  <Header />
  <main>
    <PageHero
      eyebrow="Agenda · Recordatorios y confirmación"
      title="Menos ausencias, <em class='text-pine-dark'>sin levantar el teléfono.</em>"
      lead="La ausencia es dinero que se va. Sara recuerda cada cita y pide confirmación por WhatsApp, en automático, para que tu agenda llegue llena al día."
      image="/img/hero/recordatorios-hero.jpg"
      imageAlt="Una paciente relajada recibe un recordatorio suave en su teléfono, con una taza de té."
      imageW={1200}
      imageH={900}
    />

    <!-- ══════════ TIRA DE MECÁNICA ══════════ -->
    <section class="border-b border-line bg-paper">
      <div class="mx-auto grid max-w-6xl gap-8 px-5 py-10 sm:grid-cols-3">
        <div class="py-2">
          <p class="font-serif text-lg font-black text-ink">Recuerda el día antes</p>
          <p class="mt-1 text-salvia">En automático, en el momento justo. Nadie tiene que acordarse.</p>
        </div>
        <div class="py-2 sm:border-l sm:border-line sm:pl-8">
          <p class="font-serif text-lg font-black text-ink">Confirma en un toque</p>
          <p class="mt-1 text-salvia">El paciente responde SÍ. Ves la agenda al día, sin llamar.</p>
        </div>
        <div class="py-2 sm:border-l sm:border-line sm:pl-8">
          <p class="font-serif text-lg font-black text-ink">Rescata el hueco</p>
          <p class="mt-1 text-salvia">Si se cae, la hora vuelve a la lista de espera.</p>
        </div>
      </div>
    </section>

    <!-- ══════════ CÓMO LO HACE SARA ══════════ -->
    <section class="border-t border-line">
      <div class="reveal mx-auto grid max-w-6xl items-center gap-14 px-5 py-24 md:grid-cols-[1.05fr_0.95fr]">
        <div>
          <p class="mb-3 text-sm font-semibold uppercase tracking-[0.14em] text-pine-dark">Cómo lo hace Sara</p>
          <h2 class="font-serif text-3xl font-black leading-tight text-balance md:text-4xl">
            Un “SÍ” el día antes, y la ausencia&nbsp;desaparece.
          </h2>
          <p class="mt-5 text-lg text-salvia">
            El recordatorio no es un mensaje suelto: pide una respuesta. El paciente confirma en un toque y tu
            agenda deja de tener sorpresas a la&nbsp;mañana.
          </p>
        </div>
        <div class="flex justify-center md:justify-end">
          <ConversationDemo
            channel="whatsapp"
            bubbles={[
              { who: 'out', text: 'Hola, Paula! Te recuerdo tu cita de mañana jueves a las 14:00. ¿Nos confirmas que vienes? Responde SÍ para confirmar 🙌', t: '18:00' },
              { who: 'in', text: 'Sí! ahí voy', t: '19:12' },
              { who: 'out', text: '¡Genial! Queda confirmada tu asistencia para mañana a las 14:00. ¡Te esperamos!', t: '19:12' },
            ]}
          />
        </div>
      </div>
    </section>

    <!-- ══════════ CÓMO FUNCIONA · 3 tiempos ══════════ -->
    <section class="border-t border-line bg-ink text-cream">
      <div class="reveal mx-auto max-w-6xl px-5 py-24">
        <h2 class="max-w-2xl font-serif text-3xl font-black leading-tight text-balance md:text-4xl">
          Confirmar deja de ser una tarea de&nbsp;recepción.
        </h2>
        <div class="mt-14 grid gap-x-10 gap-y-12 md:grid-cols-3">
          {
            steps.map((s) => (
              <div>
                <div class="flex items-center gap-4">
                  <span class="font-serif text-4xl font-black text-mint tabular-nums">{s.n}</span>
                  <span class="h-px flex-1 bg-cream/15" />
                </div>
                <h3 class="mt-5 text-xl font-semibold text-cream">{s.title}</h3>
                <p class="mt-2 text-cream/65">{s.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ══════════ CAPACIDADES ══════════ -->
    <section class="border-t border-line">
      <div class="reveal mx-auto flex max-w-6xl flex-col gap-24 px-5 py-24">
        <FeatureRow
          eyebrow="Cuando avisan que no pueden"
          title="Un “no puedo” a tiempo <em class='text-pine-dark'>es una hora rescatada.</em>"
          body="Si el paciente avisa que no llega, Sara no lo toma como una pérdida: libera la hora, ofrece reprogramar y le pasa ese hueco a quien está en la lista de espera. La ausencia se transforma en otra reserva."
          points={[
            'Libera la hora apenas avisan',
            'Ofrece reprogramar en el momento',
            'Y se la ofrece a la lista de espera',
          ]}
        >
          <ConversationDemo
            channel="whatsapp"
            bubbles={[
              { who: 'out', text: 'Hola, Martín! Te recuerdo tu cita de mañana a las 11:00. ¿Confirmas que vienes?', t: '18:00' },
              { who: 'in', text: 'Uy, mañana no voy a poder 😞', t: '18:20' },
              { who: 'out', text: '¡Sin problema! ¿Te reprogramo? Tengo viernes 10:00 o lunes 16:00. Y así libero tu hora de mañana para alguien que la está esperando.', t: '18:20' },
            ]}
          />
        </FeatureRow>

        <FeatureRow
          flip
          eyebrow="Después de la cita"
          title="Y cierra el círculo <em class='text-pine-dark'>con la reseña.</em>"
          body="El mismo canal que confirma la cita pide la reseña cuando el paciente sale contento. Menos ausencias hoy, mejor reputación mañana."
        >
          <ConversationDemo
            channel="whatsapp"
            bubbles={[
              { who: 'out', text: 'Hola, Juan! ¿Cómo estuvo tu sesión? Si quedaste conforme, nos ayudarías un montón con una reseña en Google 🙏', t: '17:30' },
              { who: 'in', text: 'Listo, ya la dejé ⭐️⭐️⭐️⭐️⭐️', t: '20:04' },
              { who: 'out', text: '¡Mil gracias, Juan! Nos ayuda muchísimo 🙌', t: '20:04' },
            ]}
          />
        </FeatureRow>
      </div>
    </section>

    <CtaInline title="Que las ausencias dejen de comerte la&nbsp;agenda." />

    <FeatureFaq items={faqs} />

    <CtaBand />
  </main>
  <Footer />
</Layout>
