---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import FeatureRow from '../components/FeatureRow.astro';
import ConversationDemo from '../components/ConversationDemo.astro';
import FeatureFaq from '../components/FeatureFaq.astro';
import CtaInline from '../components/CtaInline.astro';
import CtaBand from '../components/CtaBand.astro';

const steps = [
  { n: '01', title: 'Le escribes la orden', body: 'Desde tu WhatsApp, en tus palabras: bloquear, mover, reagendar o consultar la agenda.' },
  { n: '02', title: 'Sara la ejecuta', body: 'Actualiza tu Google Calendar y resuelve el cambio en el momento, sin dobles reservas.' },
  { n: '03', title: 'Notifica a los pacientes', body: 'Le avisa a cada afectado su nueva hora, sin que levantes el teléfono.' },
];

const orders = [
  '“Bloquea mi agenda el viernes a la tarde.”',
  '“Pasa a Juan Pérez al jueves 10.”',
  '“Reagenda a todos los del martes y avísales.”',
  '“¿Cuántos turnos tengo mañana?”',
];

const faqs = [
  { q: '¿Cualquiera puede darle órdenes a Sara?', a: 'No. El modo operador se habilita solo para los números de teléfono que autorices (el tuyo, el de recepción). Los pacientes nunca acceden a estas acciones.' },
  { q: '¿Necesito instalar una app?', a: 'No. Todo pasa por WhatsApp, el mismo que ya usas todo el día.' },
  { q: '¿Y si reagendo veinte turnos de golpe?', a: 'Sara los mueve y le escribe a cada paciente por separado con su nueva hora. Es justo el caso donde más tiempo te ahorra.' },
  { q: '¿Puedo ver qué hizo?', a: 'Cada cambio queda reflejado en tu Google Calendar y en el panel, así siempre tienes el registro.' },
];
---

<Layout
  title="Modo operador · Sara"
  description="Tu equipo le pide cosas a Sara por WhatsApp: bloquear la agenda, mover un turno o reagendar el día entero. Sara ejecuta en tu calendario y le avisa a cada paciente."
>
  <Header />
  <main>
    <PageHero
      eyebrow="Atiende · Modo operador"
      title="Además de atender, <em class='text-pine-dark'>Sara es tu secretaria.</em>"
      lead="Le hablas por WhatsApp como a cualquier persona de tu equipo. Gestiona la agenda entera y le avisa a cada paciente. Las 24 horas."
      image="/img/hero/operador-hero.jpg"
      imageAlt="La dueña de una clínica, relajada con un café, gestiona su agenda desde el teléfono."
      imageW={1200}
      imageH={900}
    />

    <!-- ══════════ TIRA DE MECÁNICA ══════════ -->
    <section class="border-b border-line bg-paper">
      <div class="mx-auto grid max-w-6xl gap-8 px-5 py-10 sm:grid-cols-3">
        <div class="py-2">
          <p class="font-serif text-lg font-black text-ink">Le hablas por WhatsApp</p>
          <p class="mt-1 text-salvia">Sin app nueva ni pantallas. En tus palabras.</p>
        </div>
        <div class="py-2 sm:border-l sm:border-line sm:pl-8">
          <p class="font-serif text-lg font-black text-ink">Ejecuta en tu calendario</p>
          <p class="mt-1 text-salvia">Los cambios caen en el Google Calendar de tu equipo.</p>
        </div>
        <div class="py-2 sm:border-l sm:border-line sm:pl-8">
          <p class="font-serif text-lg font-black text-ink">Avisa a cada paciente</p>
          <p class="mt-1 text-salvia">Con su nueva hora, sin que persigas a nadie.</p>
        </div>
      </div>
    </section>

    <!-- ══════════ CÓMO LO HACE SARA ══════════ -->
    <section class="border-t border-line">
      <div class="reveal mx-auto grid max-w-6xl items-center gap-14 px-5 py-24 md:grid-cols-[1.05fr_0.95fr]">
        <div>
          <p class="mb-3 text-sm font-semibold uppercase tracking-[0.14em] text-pine-dark">Cómo lo hace Sara</p>
          <h2 class="font-serif text-3xl font-black leading-tight text-balance md:text-4xl">
            Reprogramar un día entero, en un solo&nbsp;mensaje.
          </h2>
          <p class="mt-5 text-lg text-salvia">
            Se te complicó el martes y hay que mover todo. En vez de llamar a cada paciente, le escribes a Sara
            una frase. Ella reagenda y avisa a cada uno, uno por&nbsp;uno.
          </p>
        </div>
        <div class="flex justify-center md:justify-end">
          <ConversationDemo
            channel="whatsapp"
            name="Sara"
            bubbles={[
              { who: 'in', text: 'Reagenda a todos los del martes al jueves, mismo horario, y avísales', t: '08:15' },
              { who: 'out', text: '¡Hecho! ✅ Moví los 8 turnos del martes al jueves a la misma hora. Ya le escribí a cada paciente con su nueva hora para que confirme.', t: '08:15' },
              { who: 'in', text: 'Perfecto, gracias', t: '08:16' },
              { who: 'out', text: 'De nada 🙌 Te aviso a medida que vayan confirmando. El martes queda libre en tu calendario.', t: '08:16' },
            ]}
          />
        </div>
      </div>
    </section>

    <!-- ══════════ CÓMO FUNCIONA · 3 tiempos ══════════ -->
    <section class="border-t border-line bg-ink text-cream">
      <div class="reveal mx-auto max-w-6xl px-5 py-24">
        <h2 class="max-w-2xl font-serif text-3xl font-black leading-tight text-balance md:text-4xl">
          Cómo funciona el modo&nbsp;operador.
        </h2>
        <div class="mt-14 grid gap-x-10 gap-y-12 md:grid-cols-3">
          {
            steps.map((s) => (
              <div>
                <div class="flex items-center gap-4">
                  <span class="font-serif text-4xl font-black text-mint tabular-nums">{s.n}</span>
                  <span class="h-px flex-1 bg-cream/15" />
                </div>
                <h3 class="mt-5 text-xl font-semibold text-cream">{s.title}</h3>
                <p class="mt-2 text-cream/65">{s.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ══════════ CAPACIDADES ══════════ -->
    <section class="border-t border-line">
      <div class="reveal mx-auto flex max-w-6xl flex-col gap-24 px-5 py-24">
        <FeatureRow
          eyebrow="Le dices, y pasa"
          title="Órdenes que resuelve <em class='text-pine-dark'>sola.</em>"
          body="Bloquear una tarde, mover un paciente, reagendar el día o consultar cuántos turnos tienes mañana. Le escribes como a tu recepción, y lo hace."
        >
          <div class="w-full">
            <div class="flex flex-col gap-3">
              {
                orders.map((o) => (
                  <div class="rounded-xl border border-line bg-paper px-5 py-4 font-accent text-lg italic text-pine-dark">{o}</div>
                ))
              }
            </div>
          </div>
        </FeatureRow>

        <FeatureRow
          flip
          eyebrow="Avisa por ti"
          title="Reprograma, <em class='text-pine-dark'>y notifica a cada paciente.</em>"
          body="Lo más pesado de reprogramar no es mover las citas: es avisarle a cada persona. Sara le escribe a todos con su nueva hora y te resume la gestión, sin que muevas un dedo."
          points={[
            'Le avisa a cada paciente por separado',
            'Te resume qué movió y quién confirmó',
            'Todo queda en tu Google Calendar',
          ]}
        >
          <img
            src="/img/operador.jpg"
            width="1200"
            height="1087"
            alt="Sara reprograma todas las citas del martes y avisa a cada paciente por WhatsApp, con el resumen de la gestión."
            loading="lazy"
            decoding="async"
            class="w-full rounded-xl border border-line shadow-[0_10px_30px_-20px_rgba(20,38,31,0.28)]"
          />
        </FeatureRow>

        <FeatureRow
          eyebrow="Con control"
          title="Solo tu equipo <em class='text-pine-dark'>puede pedírselo.</em>"
          body="El modo operador se activa por número autorizado. Un paciente puede agendar y consultar, pero nunca bloquear tu agenda ni mover turnos de otros. Ese poder es solo tuyo y de tu equipo."
          points={[
            'Se habilita por número de teléfono',
            'Un paciente no accede a estas acciones',
            'Cada cambio queda registrado en el panel',
          ]}
        >
          <div class="w-full rounded-2xl border border-pine/20 bg-mint/[0.07] p-8">
            <p class="font-accent text-2xl italic text-pine-dark">“Reprogramar un día entero deja de ser una tarde de teléfono. Es un mensaje.”</p>
          </div>
        </FeatureRow>
      </div>
    </section>

    <CtaInline title="Que reprogramar un día entero sea un solo&nbsp;mensaje." />

    <FeatureFaq items={faqs} />

    <CtaBand />
  </main>
  <Footer />
</Layout>
