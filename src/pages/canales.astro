---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import FeatureSteps from '../components/FeatureSteps.astro';
import FeatureFaq from '../components/FeatureFaq.astro';
import CtaInline from '../components/CtaInline.astro';
import CtaBand from '../components/CtaBand.astro';

const caps = [
  { t: 'Un número, todos los canales', b: 'WhatsApp e Instagram entran al mismo lugar. Sara no pierde el hilo aunque el paciente cambie de canal.' },
  { t: 'Los comentarios también cuentan', b: 'Cuando alguien comenta una publicación, Sara le escribe por privado y lo lleva a agendar.' },
  { t: 'Habla como tu recepción', b: 'Con el tono de tu clínica y el registro de tu país. Sin respuestas robóticas ni plantillas frías.' },
  { t: 'Te pasa la posta cuando hace falta', b: 'Si una consulta necesita a una persona, Sara avisa a tu equipo con todo el contexto de la charla.' },
];

const steps = [
  { title: 'Llega el mensaje', body: 'Por WhatsApp o Instagram, casi siempre fuera del horario de recepción.' },
  { title: 'Sara responde al instante', body: 'Informa tratamientos, precios y la disponibilidad real de tu agenda.' },
  { title: 'Agenda y cobra ahí mismo', body: 'Reserva la cita y toma el anticipo sin salir de la conversación.' },
];

const faqs = [
  { q: '¿Usa mi número de WhatsApp actual?', a: 'Sara atiende sobre una línea de WhatsApp Business conectada a tu clínica. Coordinamos el número en la implementación; no tienes que cambiar de teléfono personal.' },
  { q: '¿Se nota que es una IA?', a: 'Sara se presenta con naturalidad y responde con el tono de tu clínica. El paciente siente que lo atiende alguien que sabe, no un bot con botones.' },
  { q: '¿Responde los comentarios públicos de Instagram?', a: 'Cuando alguien comenta, Sara le escribe por mensaje directo para seguir la conversación en privado y agendar. El comentario público no se usa para datos sensibles.' },
  { q: '¿Qué pasa si le preguntan algo que no sabe?', a: 'Si algo excede lo que puede resolver, Sara lo deriva a tu equipo con el contexto completo, así nadie arranca de cero.' },
];
---

<Layout
  title="WhatsApp e Instagram 24/7 · Sara"
  description="Sara atiende WhatsApp e Instagram las 24 horas: informa, agenda y cobra en la misma conversación, con el tono de tu clínica. Hasta los comentarios terminan en una cita."
>
  <Header />
  <main>
    <PageHero
      eyebrow="Atiende · Canales"
      title="Responde donde te escriben. <em class='text-pine-dark'>A cualquier hora.</em>"
      lead="El primer contacto entra por WhatsApp o Instagram, y casi nunca en horario de oficina. Sara contesta en el momento, informa de verdad y deja la cita agendada."
      image="/img/chat-whatsapp.jpg"
      imageAlt="Conversación de WhatsApp: una paciente consulta de madrugada y Sara responde, agenda y cobra el anticipo."
      imageW={945}
      imageH={2045}
    />

    <FeatureSteps
      title="Del mensaje a la cita, sin que nadie de recepción&nbsp;intervenga."
      steps={steps}
    />

    <section class="border-t border-line">
      <div class="reveal mx-auto max-w-6xl px-5 py-24">
        <h2 class="max-w-2xl font-serif text-3xl font-black leading-tight text-balance md:text-4xl">
          Todo lo que hace en tus&nbsp;canales.
        </h2>
        <div class="mt-12 grid gap-6 md:grid-cols-2">
          {
            caps.map((c) => (
              <div class="rounded-xl border border-line bg-cream p-7">
                <h3 class="text-lg font-semibold text-ink">{c.t}</h3>
                <p class="mt-2 text-salvia">{c.b}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <CtaInline title="La próxima consulta de las 23:41 no tiene por qué&nbsp;esperar." />

    <FeatureFaq items={faqs} />

    <CtaBand />
  </main>
  <Footer />
</Layout>
