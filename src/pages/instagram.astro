---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import FeatureRow from '../components/FeatureRow.astro';
import ConversationDemo from '../components/ConversationDemo.astro';
import FeatureFaq from '../components/FeatureFaq.astro';
import CtaInline from '../components/CtaInline.astro';
import CtaBand from '../components/CtaBand.astro';

const flow = [
  { src: '/img/post-1.jpg', step: '1 · Sara publica', body: 'Una publicación de tu clínica sale en Instagram, con tu marca.' },
  { src: '/img/post-2.jpg', step: '2 · Alguien responde', body: 'Comenta o escribe, y Sara lo atiende al instante.' },
  { src: '/img/post-3.jpg', step: '3 · Reserva y paga', body: 'Agenda la cita y deja la seña. Confirmada.' },
];

const faqs = [
  { q: '¿Sara publica sola o apruebo yo?', a: 'Sara prepara el texto, la imagen y el calendario. Apruebas antes de que salga; nada se publica sin tu ok.' },
  { q: '¿Usa la marca de mi clínica?', a: 'Sí. Las publicaciones salen con tu identidad: tu logo, tus colores y el tono de tu clínica.' },
  { q: '¿Qué pasa con los comentarios y mensajes?', a: 'Sara los atiende. A quien comenta o escribe por una publicación, lo lleva de la conversación hasta la cita agendada.' },
  { q: '¿Puedo saber qué publicación funcionó?', a: 'Cada mes tienes, en español claro, qué post trajo más consultas y cuánto se facturó. Sin planillas.' },
];
---

<Layout
  title="Instagram con IA · Sara también lleva tu Instagram"
  description="Sara crea las publicaciones de tu clínica con tu marca, atiende a quien responde hasta agendar y te dice cada mes qué post trajo consultas. Del post a la cita cobrada."
>
  <Header />
  <main>
    <PageHero
      eyebrow="Marketing · Instagram con IA"
      title="Que cada publicación termine en una cita, <em class='text-pine-dark'>no en un like.</em>"
      lead="Sara crea las publicaciones de tu clínica, atiende a quien responde hasta agendar y te dice qué funcionó. Tu marketing y tu agenda, por fin conectados."
      image="/img/hero/instagram-hero.jpg"
      imageAlt="Flat lay con un teléfono mostrando un feed de Instagram de clínica, una cámara y flores de salvia."
      imageW={1200}
      imageH={900}
    />

    <!-- ══════════ TIRA DE MECÁNICA ══════════ -->
    <section class="border-b border-line bg-paper">
      <div class="mx-auto grid max-w-6xl gap-8 px-5 py-10 sm:grid-cols-3">
        <div class="py-2">
          <p class="font-serif text-lg font-black text-ink">Crea las publicaciones</p>
          <p class="mt-1 text-salvia">Texto, imagen y calendario, con la marca de tu clínica.</p>
        </div>
        <div class="py-2 sm:border-l sm:border-line sm:pl-8">
          <p class="font-serif text-lg font-black text-ink">Atiende a quien responde</p>
          <p class="mt-1 text-salvia">Comentarios y mensajes, hasta dejar la cita agendada.</p>
        </div>
        <div class="py-2 sm:border-l sm:border-line sm:pl-8">
          <p class="font-serif text-lg font-black text-ink">Te dice qué funcionó</p>
          <p class="mt-1 text-salvia">Qué post trajo consultas y cuánto facturaste.</p>
        </div>
      </div>
    </section>

    <!-- ══════════ CÓMO LO HACE SARA · del post a la cita ══════════ -->
    <section class="border-t border-line">
      <div class="reveal mx-auto max-w-6xl px-5 py-24">
        <p class="mb-3 text-sm font-semibold uppercase tracking-[0.14em] text-pine-dark">Cómo lo hace Sara</p>
        <h2 class="max-w-2xl font-serif text-3xl font-black leading-tight text-balance md:text-4xl">
          Del post a la cita, sin que el interés se&nbsp;enfríe.
        </h2>
        <p class="mt-5 max-w-2xl text-lg text-salvia">
          La mayoría de las clínicas publica y ahí muere: el que comenta queda sin respuesta. Sara conecta la
          publicación con la conversación, y la conversación con la&nbsp;agenda.
        </p>
        <div class="mt-12 grid gap-6 sm:grid-cols-3">
          {
            flow.map((p) => (
              <div>
                <div class="overflow-hidden rounded-xl border border-line bg-white shadow-[0_10px_30px_-20px_rgba(20,38,31,0.28)]">
                  <img src={p.src} alt={p.step} loading="lazy" decoding="async" class="w-full" />
                </div>
                <p class="mt-3 font-serif text-lg font-bold">{p.step}</p>
                <p class="text-salvia">{p.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ══════════ CAPACIDADES ══════════ -->
    <section class="border-t border-line">
      <div class="reveal mx-auto flex max-w-6xl flex-col gap-24 px-5 py-24">
        <FeatureRow
          eyebrow="Contenido"
          title="Publicaciones listas para salir, <em class='text-pine-dark'>con tu marca.</em>"
          body="Sara escribe el texto, elige la imagen y arma el calendario del mes con la identidad de tu clínica. Tú solo apruebas. Se acabó el “esta semana no publiqué nada”."
          points={[
            'Texto, imagen y calendario, hechos',
            'Con tu logo, tus colores y tu tono',
            'Nada sale sin tu aprobación',
          ]}
        >
          <img
            src="/img/instagram.jpg"
            width="1200"
            height="1242"
            alt="Feed de Instagram de una clínica generado con IA: publicaciones con la marca, listas para salir."
            loading="lazy"
            decoding="async"
            class="w-full rounded-xl border border-line shadow-[0_10px_30px_-20px_rgba(20,38,31,0.28)]"
          />
        </FeatureRow>

        <FeatureRow
          flip
          eyebrow="Del comentario a la cita"
          title="Al que responde, <em class='text-pine-dark'>lo agenda.</em>"
          body="Cuando alguien comenta o escribe por una publicación, Sara le responde por mensaje directo, sigue la conversación en privado y la lleva hasta la reserva. El interés que generó tu contenido no se pierde."
          points={[
            'Responde comentarios por mensaje directo',
            'Atiende, informa y propone un turno',
            'Del post a la reserva, sin cortar el hilo',
          ]}
        >
          <ConversationDemo
            channel="instagram"
            bubbles={[
              { who: 'out', text: '¡Hola! Vi tu comentario en la publicación 🙌 Te escribo por aquí. ¿Qué zona te interesa?', t: '19:40' },
              { who: 'in', text: 'La verdad me interesa el tratamiento del video', t: '19:52' },
              { who: 'out', text: '¡Genial! Es ideal para eso. Tenemos una primera sesión de prueba sin costo para que lo conozcas. ¿Te agendo?', t: '19:52' },
            ]}
          />
        </FeatureRow>

        <FeatureRow
          eyebrow="Con números claros"
          title="Y sabes qué post <em class='text-pine-dark'>trajo pacientes.</em>"
          body="Cada mes, en español claro: qué publicación generó más consultas y cuánto se facturó a partir de ahí. Dejas de publicar a ciegas y de medir por likes."
          points={[
            'Qué post trajo más consultas',
            'Cuánto facturaste a partir de cada uno',
            'En el panel, sin planillas',
          ]}
        >
          <img
            src="/img/vialaser-chart.jpg"
            width="1130"
            height="944"
            alt="Panel con las consultas y el valor generado por canal, incluida la actividad de Instagram."
            loading="lazy"
            decoding="async"
            class="w-full rounded-xl border border-line shadow-[0_10px_30px_-20px_rgba(20,38,31,0.28)]"
          />
        </FeatureRow>
      </div>
    </section>

    <CtaInline title="Que cada publicación termine en una cita, no en un&nbsp;like." />

    <FeatureFaq items={faqs} />

    <CtaBand />
  </main>
  <Footer />
</Layout>
