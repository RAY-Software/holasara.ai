---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import FeatureSteps from '../components/FeatureSteps.astro';
import FeatureFaq from '../components/FeatureFaq.astro';
import CtaInline from '../components/CtaInline.astro';
import CtaBand from '../components/CtaBand.astro';

const steps = [
  { title: 'El paciente agenda', body: 'Por WhatsApp, Instagram o tu web, en la conversación con Sara.' },
  { title: 'Paga en el momento', body: 'Anticipo o consulta, con un link de pago seguro dentro del mismo chat.' },
  { title: 'La cita queda firme', body: 'El que paga, viene: menos ausencias y caja adelantada desde el primer mes.' },
];

const faqs = [
  { q: '¿Cómo cobra Sara?', a: 'Con un link de pago seguro dentro de la conversación. El paciente paga desde su teléfono, sin fricción.' },
  { q: '¿Puedo elegir qué cobrar?', a: 'Sí. Defines si pides anticipo, consulta completa o ambos, y para qué tratamientos aplica.' },
  { q: '¿El anticipo baja las ausencias de verdad?', a: 'Es el filtro más efectivo que existe: quien deja plata comprometida, aparece. Se nota desde el primer mes.' },
  { q: '¿Y si el paciente prefiere pagar en la clínica?', a: 'Puedes seguir aceptando el pago presencial. El cobro online es para asegurar la cita y adelantar la caja, no para reemplazar tu forma de trabajar.' },
];

const methods = [
  { t: 'Anticipo en línea al reservar', b: 'Compromete la cita y adelanta el flujo de caja. Baja la ausencia desde el primer mes.' },
  { t: 'Consulta cobrada por adelantado', b: 'El paciente paga cuando agenda, no cuando llega. Tu hora deja de ser gratis.' },
  { t: 'Gift cards', b: 'Tu paciente le regala un tratamiento a alguien que no te conoce. Cobras hoy y ganas un paciente nuevo que no te costó publicidad.' },
];
---

<Layout
  title="Cobros · Cobra antes de atender"
  description="Tres formas de que entre dinero sin que nadie lo persiga: anticipo en línea al reservar, consulta cobrada por adelantado y gift cards."
>
  <Header />
  <main>
    <PageHero
      eyebrow="Cobros"
      title="Cobra <em class='text-pine-dark'>antes</em> de atender."
      lead="Tres formas de que entre dinero sin que nadie lo persiga. El anticipo baja las ausencias y adelanta la caja desde el primer mes."
      image="/img/cobros.jpg"
      imageAlt="Panel de cobros: anticipos, consultas y gift cards cobrados por Sara, todos sin recepción."
      imageW={1200}
      imageH={1186}
    />

    <section class="border-b border-line bg-paper">
      <div class="mx-auto max-w-6xl px-5 py-24">
        <div class="grid gap-6 md:grid-cols-3">
          {
            methods.map((m, i) => (
              <div class="rounded-xl border border-line bg-cream p-8">
                <span class="font-accent text-2xl italic text-pine-dark">{`0${i + 1}`}</span>
                <h3 class="mt-3 text-xl font-semibold">{m.t}</h3>
                <p class="mt-2 text-salvia">{m.b}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <FeatureSteps title="Del sí del paciente al pago, sin&nbsp;fricción." steps={steps} />

    <CtaInline title="Que tu hora deje de ser&nbsp;gratis." />

    <FeatureFaq items={faqs} />

    <CtaBand />
  </main>
  <Footer />
</Layout>
