---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import FeatureRow from '../components/FeatureRow.astro';
import ConversationDemo from '../components/ConversationDemo.astro';
import FeatureFaq from '../components/FeatureFaq.astro';
import CtaInline from '../components/CtaInline.astro';
import CtaBand from '../components/CtaBand.astro';

const steps = [
  { n: '01', title: 'El paciente agenda', body: 'Por WhatsApp, Instagram o tu web, en la conversación con Sara.' },
  { n: '02', title: 'Paga en el momento', body: 'Anticipo o consulta, con un link de pago seguro (Stripe) dentro del mismo chat.' },
  { n: '03', title: 'La cita queda firme', body: 'El que paga, viene: menos ausencias y caja adelantada desde el primer mes.' },
];

const methods = [
  { t: 'Anticipo al reservar', b: 'Compromete la cita y adelanta el flujo de caja. Baja la ausencia desde el primer mes.' },
  { t: 'Consulta por adelantado', b: 'El paciente paga cuando agenda, no cuando llega. Tu hora deja de ser gratis.' },
  { t: 'Gift cards', b: 'Tu paciente le regala un tratamiento a alguien que no te conoce. Cobras hoy y ganas un paciente nuevo.' },
];

const faqs = [
  { q: '¿Cómo cobra Sara?', a: 'Con un link de pago seguro (procesado por Stripe) dentro de la conversación. El paciente paga desde su teléfono, sin fricción y sin que recepción maneje dinero.' },
  { q: '¿Puedo elegir qué cobrar?', a: 'Sí. Defines si pides anticipo, consulta completa o ambos, y para qué tratamientos aplica.' },
  { q: '¿El anticipo baja las ausencias de verdad?', a: 'Es el filtro más efectivo que existe: quien deja dinero comprometido, aparece. Se nota desde el primer mes.' },
  { q: '¿Y si el paciente prefiere pagar en la clínica?', a: 'Puedes seguir aceptando el pago presencial. El cobro online es para asegurar la cita y adelantar la caja, no para reemplazar tu forma de trabajar.' },
  { q: '¿Queda registrado cuánto entró?', a: 'Sí. En el panel ves lo cobrado por Stripe (anticipos, consultas y gift cards) y a qué turno corresponde cada pago.' },
];
---

<Layout
  title="Cobros · Cobra antes de atender"
  description="Tres formas de que entre dinero sin que nadie lo persiga: anticipo al reservar, consulta por adelantado y gift cards. Cobrado por Stripe, dentro del mismo chat."
>
  <Header />
  <main>
    <PageHero
      eyebrow="Cobros · Anticipo y consulta"
      title="Cobra <em class='text-pine-dark'>antes</em> de atender."
      lead="Tres formas de que entre dinero sin que nadie lo persiga. El anticipo baja las ausencias y adelanta la caja desde el primer mes, todo dentro de la misma conversación."
      image="/img/hero/cobros-hero.jpg"
      imageAlt="Un teléfono muestra un pago confirmado junto a una tarjeta, en un ambiente de spa."
      imageW={1200}
      imageH={900}
    />

    <!-- ══════════ TIRA DE MECÁNICA ══════════ -->
    <section class="border-b border-line bg-paper">
      <div class="mx-auto grid max-w-6xl gap-8 px-5 py-10 sm:grid-cols-3">
        <div class="py-2">
          <p class="font-serif text-lg font-black text-ink">Anticipo al reservar</p>
          <p class="mt-1 text-salvia">La seña que compromete la cita y baja la ausencia.</p>
        </div>
        <div class="py-2 sm:border-l sm:border-line sm:pl-8">
          <p class="font-serif text-lg font-black text-ink">Link de pago en el chat</p>
          <p class="mt-1 text-salvia">Seguro, por Stripe. El paciente paga desde su teléfono.</p>
        </div>
        <div class="py-2 sm:border-l sm:border-line sm:pl-8">
          <p class="font-serif text-lg font-black text-ink">Sin recepción</p>
          <p class="mt-1 text-salvia">Nadie maneja dinero ni persigue un pago.</p>
        </div>
      </div>
    </section>

    <!-- ══════════ CÓMO LO HACE SARA ══════════ -->
    <section class="border-t border-line">
      <div class="reveal mx-auto grid max-w-6xl items-center gap-14 px-5 py-24 md:grid-cols-[1.05fr_0.95fr]">
        <div>
          <p class="mb-3 text-sm font-semibold uppercase tracking-[0.14em] text-pine-dark">Cómo lo hace Sara</p>
          <h2 class="font-serif text-3xl font-black leading-tight text-balance md:text-4xl">
            La reserva y el pago, en el mismo&nbsp;chat.
          </h2>
          <p class="mt-5 text-lg text-salvia">
            No hay un “después te paso los datos para la seña”. Sara agenda y cobra en la misma conversación, así
            la cita queda firme antes de&nbsp;cortar.
          </p>
        </div>
        <div class="flex justify-center md:justify-end">
          <ConversationDemo
            channel="whatsapp"
            bubbles={[
              { who: 'out', text: '¡Genial! Te dejo el jueves 17:30. Para confirmar la reserva va un anticipo, te paso el link 👇', t: '18:22' },
              { who: 'out', text: 'pagos.tu-clinica.com/seña', t: '18:22' },
              { who: 'in', text: 'Listo, ya pagué', t: '18:25' },
              { who: 'out', text: '¡Reservado! ✅ Recibimos tu anticipo. Te llega el recordatorio un día antes. ¡Nos vemos!', t: '18:25' },
            ]}
          />
        </div>
      </div>
    </section>

    <!-- ══════════ CÓMO FUNCIONA · 3 tiempos ══════════ -->
    <section class="border-t border-line bg-ink text-cream">
      <div class="reveal mx-auto max-w-6xl px-5 py-24">
        <h2 class="max-w-2xl font-serif text-3xl font-black leading-tight text-balance md:text-4xl">
          Del sí del paciente al pago, sin&nbsp;fricción.
        </h2>
        <div class="mt-14 grid gap-x-10 gap-y-12 md:grid-cols-3">
          {
            steps.map((s) => (
              <div>
                <div class="flex items-center gap-4">
                  <span class="font-serif text-4xl font-black text-mint tabular-nums">{s.n}</span>
                  <span class="h-px flex-1 bg-cream/15" />
                </div>
                <h3 class="mt-5 text-xl font-semibold text-cream">{s.title}</h3>
                <p class="mt-2 text-cream/65">{s.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ══════════ CAPACIDADES ══════════ -->
    <section class="border-t border-line">
      <div class="reveal mx-auto flex max-w-6xl flex-col gap-24 px-5 py-24">
        <FeatureRow
          eyebrow="El mejor filtro de ausencias"
          title="El que paga, <em class='text-pine-dark'>viene.</em>"
          body="Un paciente que dejó una seña casi no falta. El anticipo no es solo caja adelantada: es la forma más efectiva de que la agenda del día llegue completa."
          points={[
            'Anticipo o consulta, tú decides cuál',
            'Menos ausencias desde el primer mes',
            'Caja que entra hoy, no cuando atiendes',
          ]}
        >
          <img
            src="/img/cobros.jpg"
            width="1200"
            height="1186"
            alt="Panel de cobros: anticipos, consultas y gift cards cobrados por Sara, todos sin recepción."
            loading="lazy"
            decoding="async"
            class="w-full rounded-xl border border-line shadow-[0_10px_30px_-20px_rgba(20,38,31,0.28)]"
          />
        </FeatureRow>

        <FeatureRow
          flip
          eyebrow="Gift cards"
          title="Y vende tratamientos <em class='text-pine-dark'>por adelantado.</em>"
          body="Tus pacientes regalan tratamientos a gente que todavía no te conoce. Cobras hoy y ganas un paciente nuevo que llega por recomendación, sin gastar en publicidad."
          points={[
            'Se venden desde tu propia web, con tu marca',
            'Cobras hoy, atiendes cuando la usan',
            'Un paciente nuevo que no te costó publicidad',
          ]}
        >
          <div class="w-full">
            <div class="grid gap-4 sm:grid-cols-3">
              {
                methods.map((m, i) => (
                  <div class="rounded-xl border border-line bg-cream p-5">
                    <span class="font-accent text-xl italic text-pine-dark">{`0${i + 1}`}</span>
                    <h3 class="mt-2 text-base font-semibold">{m.t}</h3>
                  </div>
                ))
              }
            </div>
            <a
              href="/gift-cards"
              class="mt-5 inline-flex items-center gap-1.5 text-base font-semibold text-pine-dark transition-colors hover:text-ink"
            >
              Ver las gift cards <span aria-hidden="true">→</span>
            </a>
          </div>
        </FeatureRow>
      </div>
    </section>

    <CtaInline title="Que tu hora deje de ser&nbsp;gratis." />

    <FeatureFaq items={faqs} />

    <CtaBand />
  </main>
  <Footer />
</Layout>
