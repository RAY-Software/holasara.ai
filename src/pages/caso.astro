---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CtaBand from '../components/CtaBand.astro';
import CtaInline from '../components/CtaInline.astro';
import ClientsStrip from '../components/ClientsStrip.astro';
import { whatsappLink } from '../lib/whatsapp';
---

<Layout
  title="Caso de éxito · ViaLaser ya trabaja con Sara"
  description="114 conversaciones atendidas por Sara sin que recepción tocara nada, 7 de cada 10 citas agendadas por Sara y US$1.071 en citas generadas, atribuidas al canal que las trajo."
>
  <Header />
  <main>
    <section class="border-b border-line">
      <div class="mx-auto grid max-w-6xl gap-14 px-5 pb-20 pt-14 md:grid-cols-[0.95fr_1.05fr] md:items-center">
        <div>
          <a href="/" class="mb-8 inline-flex items-center gap-1.5 text-sm font-medium text-salvia transition-colors hover:text-ink">
            <span aria-hidden="true">←</span> Volver al inicio
          </a>
          <p class="mb-4 text-sm font-semibold uppercase tracking-[0.14em] text-pine-dark">Caso de éxito</p>
          <img src="/img/vialaser-logo.png" width="398" height="126" alt="ViaLaser" class="mb-6 h-9 w-auto" />
          <h1 class="font-serif text-4xl font-black leading-[1.05] tracking-tight text-balance md:text-6xl">
            Ya está funcionando en clínicas&nbsp;reales.
          </h1>
          <p class="mt-6 max-w-xl text-lg text-salvia">
            ViaLaser puso a Sara a atender su WhatsApp, Instagram y web. Esto pasó, sin sumar a nadie a recepción.
          </p>
          <a
            href={whatsappLink()}
            target="_blank"
            rel="noopener"
            class="mt-8 inline-flex items-center gap-2 rounded-full bg-pine px-6 py-3 text-base font-semibold text-cream transition-colors hover:bg-pine-dark"
          >
            Habla con Sara
          </a>
        </div>
        <div class="flex justify-center md:justify-end">
          <img
            src="/img/vialaser-chart.jpg"
            width="1130"
            height="944"
            alt="Turnos de ViaLaser por canal y conversaciones por semana atendidas por Sara."
            class="w-full rounded-xl border border-line shadow-[0_10px_30px_-20px_rgba(20,38,31,0.28)]"
          />
        </div>
      </div>
    </section>

    <ClientsStrip />

    <CtaInline title="¿Quieres números así en tu&nbsp;clínica?" cta="Pedir mi demo" />

    <section class="border-b border-line bg-paper">
      <div class="mx-auto grid max-w-6xl gap-6 px-5 py-24 md:grid-cols-3">
        <div class="rounded-xl border border-line bg-cream p-8">
          <p class="font-serif text-5xl font-black text-pine-dark tabular-nums">114</p>
          <p class="mt-3 text-salvia">conversaciones atendidas por Sara, sin que recepción tocara nada.</p>
        </div>
        <div class="rounded-xl border border-line bg-cream p-8">
          <p class="font-serif text-5xl font-black text-pine-dark tabular-nums">7 de 10</p>
          <p class="mt-3 text-salvia">citas agendadas por Sara en WhatsApp, Instagram y la web.</p>
        </div>
        <div class="rounded-xl border border-line bg-cream p-8">
          <p class="font-serif text-5xl font-black text-pine-dark tabular-nums">US$1.071</p>
          <p class="mt-3 text-salvia">en citas generadas, cada una atribuida al canal que la trajo.</p>
        </div>
      </div>
    </section>

    <CtaBand />
  </main>
  <Footer />
</Layout>
