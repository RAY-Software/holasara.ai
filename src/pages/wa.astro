---
import { GA4_ID, GOOGLE_ADS_ID, ADS_WA_LABEL, META_PIXEL_ID } from '../lib/tracking';
import { WHATSAPP_AR, WHATSAPP_MX, WHATSAPP_TEXT, SRC_TAG } from '../lib/whatsapp';
import MetaAttribution from '../components/MetaAttribution.astro';

// Puente para Google Ads. La final URL de un anuncio no puede ser wa.me: Google exige
// que el dominio del destino coincida con el visible. Esta página vive en holasara.ai,
// rutea AR/MX y arrastra el gclid dentro del texto del mensaje — que es lo que después
// nos deja subir la conversación como conversión offline.
//
//   Uso en anuncios:  https://holasara.ai/wa
//   Mensaje a medida: https://holasara.ai/wa?m=Hola%20Sara%2C%20vi%20su%20anuncio
//
// Página deliberadamente mínima: sin Tailwind, sin fuentes, sin JSON-LD. Solo los tags
// y el redirect. Muestra una tarjeta con botón manual para que no sea una pantalla en
// blanco si el redirect tarda o el navegador lo bloquea.
//
// Esta página NO usa Layout.astro, así que los tags hay que repetirlos acá: es la única
// del sitio que se los pierde si uno se olvida. Estuvo sin el píxel de Meta hasta el
// 2026-09-02, y como es un destino válido de anuncio (la final URL no puede ser wa.me),
// un anuncio apuntado acá no generaba ni PageView.
const gtagSrc = `https://www.googletagmanager.com/gtag/js?id=${GA4_ID}`;
const gtagJs =
  `window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}` +
  `gtag('js',new Date());gtag('config','${GA4_ID}');` +
  (GOOGLE_ADS_ID ? `gtag('config','${GOOGLE_ADS_ID}');` : '');
const pixelJs = META_PIXEL_ID
  ? `!function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');fbq('init','${META_PIXEL_ID}');fbq('track','PageView');`
  : '';
const pixelNoscript = META_PIXEL_ID
  ? `<img height="1" width="1" style="display:none" alt="" src="https://www.facebook.com/tr?id=${META_PIXEL_ID}&ev=PageView&noscript=1"/>`
  : '';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Abriendo WhatsApp · Sara</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {
      import.meta.env.PROD && (
        <Fragment>
          <script async is:inline src={gtagSrc} />
          <script is:inline set:html={gtagJs} />
          <script is:inline set:html={pixelJs} />
          <noscript set:html={pixelNoscript}></noscript>
        </Fragment>
      )
    }
    <MetaAttribution />
    <style>
      body {
        margin: 0;
        min-height: 100svh;
        display: grid;
        place-items: center;
        background: #f7f5f0;
        color: #14261f;
        font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
        padding: 24px;
      }
      .card {
        max-width: 340px;
        text-align: center;
      }
      .dot {
        width: 44px;
        height: 44px;
        margin: 0 auto 20px;
        border-radius: 999px;
        border: 3px solid rgba(20, 38, 31, 0.12);
        border-top-color: #25d366;
        animation: spin 0.9s linear infinite;
      }
      @keyframes spin {
        to {
          transform: rotate(360deg);
        }
      }
      @media (prefers-reduced-motion: reduce) {
        .dot {
          animation: none;
        }
      }
      h1 {
        font-size: 1.15rem;
        margin: 0 0 8px;
      }
      p {
        margin: 0 0 20px;
        color: #5c6b64;
        font-size: 0.95rem;
      }
      a.btn {
        display: inline-block;
        background: #14261f;
        color: #f7f5f0;
        text-decoration: none;
        padding: 12px 24px;
        border-radius: 999px;
        font-weight: 600;
      }
    </style>
  </head>
  <body>
    <div class="card">
      <div class="dot" aria-hidden="true"></div>
      <h1>Abriendo WhatsApp…</h1>
      <p>Si no se abre solo, toca el botón.</p>
      <a class="btn" id="wa-manual" href={`https://wa.me/${WHATSAPP_MX}`}>Hablar con Sara</a>
    </div>

    <script
      is:inline
      define:vars={{ WHATSAPP_AR, WHATSAPP_MX, WHATSAPP_TEXT, SRC_TAG, ADS_WA_LABEL, GOOGLE_ADS_ID }}
    >
      (function () {
        var p = new URLSearchParams(location.search);

        // 1) Click-ids: de la URL, o de la cookie que dejó una visita anterior al sitio.
        function getCookie(n) {
          var m = document.cookie.match('(^|;)\\s*' + n + '\\s*=\\s*([^;]+)');
          return m ? m.pop() : '';
        }
        var toks = [];
        ['gclid', 'wbraid', 'gbraid', 'fbclid'].forEach(function (k) {
          var v = p.get(k);
          if (v) toks.push('[' + k + ':' + v + ']');
        });
        var token = toks.join('');
        if (token) {
          document.cookie =
            'sara_click=' + encodeURIComponent(token) + ';path=/;max-age=' + 60 * 60 * 24 * 90 + ';SameSite=Lax';
        } else {
          token = decodeURIComponent(getCookie('sara_click') || '');
        }

        // 2) Ruteo AR/MX, mismo criterio que el resto del sitio.
        var IS_AR = false;
        try {
          var tz = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
          IS_AR = /America\/Argentina/.test(tz) || /^es-AR/i.test(navigator.language || '');
        } catch (e) {}
        var WA = IS_AR ? WHATSAPP_AR : WHATSAPP_MX;

        // 3) Marca + token viajan DENTRO del mensaje: el token es lo que matchea el
        //    backend para subir la conversación como conversión offline, y el marcador
        //    de marca es lo que lo distingue de una conversación de RAY (línea y backend
        //    son compartidos). Esta es la ruta de Google, que no trae `referral`.
        //    Del token guardado van solo los click-ids de Google. El de Meta viaja como
        //    `[fbc:fb.1.<ts>.<fbclid>]` (+ `[fbp:…]`), que es el formato que lee
        //    `extractFbc()` en el backend; el `[fbclid:<crudo>]` no lo lee nadie.
        var googleToken = token.replace(/\[fbclid:[^\]]*\]/g, '');
        var metaRefs = '';
        try {
          if (window.__saraMeta) metaRefs = window.__saraMeta.refs();
        } catch (e) {}
        var msg = (p.get('m') || WHATSAPP_TEXT) + ' ' + SRC_TAG + googleToken + metaRefs;
        var target = 'https://wa.me/' + WA + '?text=' + encodeURIComponent(msg);

        var manual = document.getElementById('wa-manual');
        if (manual) manual.href = target;

        // 4) Conversión secundaria + GA4, con event_callback para no perderla en el
        //    redirect. Si el tag no está, no esperamos nada.
        var went = false;
        function go() {
          if (went) return;
          went = true;
          window.location.replace(target);
        }

        var hasAds = !!(window.gtag && GOOGLE_ADS_ID && ADS_WA_LABEL);
        var hasPixel = !!window.fbq;
        try {
          // Meta: `Contact`, igual que el clic de WhatsApp del resto del sitio. NO
          // `Lead` — ver el comentario del handler en Layout.astro.
          if (hasPixel)
            fbq('track', 'Contact', {
              content_name: 'whatsapp-click',
              content_category: '/wa',
            });
        } catch (e) {}
        try {
          if (window.gtag) {
            gtag('event', 'generate_lead', {
              event_category: 'engagement',
              event_label: 'wa-bridge',
              transport_type: 'beacon',
            });
          }
          if (hasAds) {
            gtag('event', 'conversion', {
              send_to: GOOGLE_ADS_ID + '/' + ADS_WA_LABEL,
              event_callback: go,
            });
          }
        } catch (e) {}

        // Sin ningún tag: redirect inmediato. Con alguno: 700 ms de gracia y salimos
        // igual. El píxel manda su beacon sin callback, así que la espera es lo único
        // que evita que el redirect lo mate.
        if (hasAds || hasPixel) setTimeout(go, 700);
        else setTimeout(go, 0);
      })();
    </script>
  </body>
</html>
