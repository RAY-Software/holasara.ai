    estados: [
      { tag: '📞 Call', desc: 'Sara answered a call. Logged with the time, the duration and a text summary.' },
      { tag: 'Booked', desc: 'The appointment was scheduled in your Google Calendar from the conversation.' },
      { tag: '⏰ Reminder', desc: "Sara reminded them the day before so the appointment doesn't fall through." },
      { tag: '✅ Confirmed', desc: "The patient confirmed they're coming and the deposit was collected." },
    ],
    related: {
      lead: 'Keep exploring:',
      links: [
        { href: L('/llamadas'), label: 'See the medical answering service' },
        { href: L('/negocios/odontologia'), label: 'Sara for dental practices' },
      ],
    },
    faqs: [
      { q: 'Does Sara replace my front desk?', a: "No, she frees it up. Sara handles the repetitive part (answering the phone, replying to the same questions by text, booking, confirming, chasing the deposit) so your front desk can focus on the patient standing in front of them. And she covers nights, weekends and peak times, when there's no one there." },
      { q: 'Which channels does she answer?', a: 'Phone (by voice), text messages, WhatsApp, Instagram (DMs and comments) and your website chat. Same Sara on all of them, with one history per patient.' },
      { q: 'Does she answer in English and Spanish?', a: "Yes. Sara answers in English and in Spanish, in your practice's tone and terms. How each language is handled at your office is something we define during onboarding." },
      { q: 'Is Sara HIPAA compliant?', a: "Sara doesn't store or read medical records or clinical information: she works on the conversation and the calendar, not on your clinical system. Your practice's specific requirements, such as a BAA, are something we review with you in the demo." },
      { q: 'Does it work with my dental software (Dentrix, Open Dental) or my PMS?', a: "Sara books into Google Calendar and works on the conversation; she doesn't connect to your practice management system or your clinical records. If your office keeps its schedule in Dentrix, Open Dental or another PMS, we look at it together in the demo." },
      { q: "What happens when she doesn't know something?", a: "She doesn't make things up. She answers with the information you loaded about your practice (treatments, prices, hours, instructions) and, when something falls outside of that, she hands it to your team with the full context of the conversation, so no one starts from scratch." },
      { q: 'How much does it cost?', a: "It's a fixed monthly subscription, with no per-call charge and no commission per appointment. The price is put together for each practice based on size, number of calendars and country, and we go over it in the demo." },
    ],
  },
}[lang];

const { steps, compare, estados, related, faqs } = dict;
---

<Layout ogImage={`/og/receptionist-${lang}.jpg`} lang={lang} title={dict.metaTitle} description={dict.metaDescription}>
  <Header lang={lang} />
  <main>
    <PageHero
      lang={lang}
      eyebrow={dict.heroEyebrow}
      title={dict.heroTitle}
      lead={dict.heroLead}
      image="/img/hero/recepcionista-virtual-hero.jpg"
      imageAlt={dict.heroImageAlt}
      imageW={1024}
      imageH={768}
    />

    <!-- ══════════ TIRA DE MECÁNICA (no son stats inventadas: es lo que hace) ══════════ -->
    <section class="border-b border-line bg-paper">
      <div class="mx-auto grid max-w-6xl gap-8 px-5 py-10 sm:grid-cols-3">
        <div class="py-2">
          <p class="font-serif text-lg font-black text-ink">{dict.strip[0].t}</p>
          <p class="mt-1 text-salvia">{dict.strip[0].b}</p>
        </div>
        <div class="py-2 sm:border-l sm:border-line sm:pl-8">
          <p class="font-serif text-lg font-black text-ink">{dict.strip[1].t}</p>
          <p class="mt-1 text-salvia">{dict.strip[1].b}</p>
        </div>
        <div class="py-2 sm:border-l sm:border-line sm:pl-8">
          <p class="font-serif text-lg font-black text-ink">{dict.strip[2].t}</p>
          <p class="mt-1 text-salvia">{dict.strip[2].b}</p>
        </div>
      </div>
    </section>

    <!-- ══════════ CÓMO LO HACE SARA · llamada real ══════════ -->
    <section class="border-t border-line">
      <div class="reveal mx-auto grid max-w-6xl items-center gap-14 px-5 py-24 md:grid-cols-[1.05fr_0.95fr]">
        <div>
          <p class="mb-3 text-sm font-semibold uppercase tracking-[0.14em] text-pine-dark">{dict.howKicker}</p>
          <h2 class="font-serif text-3xl font-black leading-tight text-balance md:text-4xl" set:html={dict.howH2} />
          <p class="mt-5 text-lg text-salvia">
            {dict.howP1}
          </p>
          <p class="mt-4 text-salvia" set:html={dict.howP2} />
        </div>
        <div class="flex justify-center md:justify-end">
          <CallDemo lang={lang} turns={dict.howTurns} timer="01:04" />
        </div>
      </div>
    </section>

    <!-- ══════════ CÓMO FUNCIONA · 3 tiempos (banda oscura) ══════════ -->
    <section class="border-t border-line bg-ink text-cream">
      <div class="reveal mx-auto max-w-6xl px-5 py-24">
        <h2 class="max-w-2xl font-serif text-3xl font-black leading-tight text-balance md:text-4xl" set:html={dict.stepsH2} />
        <div class="mt-14 grid gap-x-10 gap-y-12 md:grid-cols-3">
          {
            steps.map((s) => (
              <div>
                <div class="flex items-center gap-4">
                  <span class="font-serif text-4xl font-black text-mint tabular-nums">{s.n}</span>
                  <span class="h-px flex-1 bg-cream/15" />
                </div>
                <h3 class="mt-5 text-xl font-semibold text-cream">{s.title}</h3>
                <p class="mt-2 text-cream/65">{s.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ══════════ CAPACIDADES · filas alternadas (copy + visual) ══════════ -->
    <!-- Cada fila va envuelta en un div con id de ancla (#dental, #med-spa) porque FeatureRow no acepta id. -->
    <section class="border-t border-line">
      <div class="reveal mx-auto flex max-w-6xl flex-col gap-24 px-5 py-24">
        <div id="dental" class="scroll-mt-24">
          <FeatureRow
            eyebrow={dict.row1Eyebrow}
            title={dict.row1Title}
            body={dict.row1Body}
            points={dict.row1Points}
          >
            <ConversationDemo lang={lang} channel="whatsapp" bubbles={dict.row1Bubbles} />
          </FeatureRow>
        </div>

        <div id="med-spa" class="scroll-mt-24">
          <FeatureRow
            flip
            eyebrow={dict.row2Eyebrow}
            title={dict.row2Title}
            body={dict.row2Body}
            points={dict.row2Points}
          >
            <ConversationDemo lang={lang} channel="instagram" bubbles={dict.row2Bubbles} />
          </FeatureRow>
        </div>

        <div id="ai-vs-human" class="scroll-mt-24">
          <FeatureRow
            eyebrow={dict.row3Eyebrow}
            title={dict.row3Title}
            body={dict.row3Body}
          >
            <!-- Tabla comparativa inline (IA vs recepcionista virtual humana). Sin cifras: solo el modelo de cobro. -->
            <div class="w-full max-w-xl overflow-x-auto rounded-2xl border border-line bg-paper shadow-[0_16px_40px_-24px_rgba(20,38,31,0.32)]">
              <table class="w-full min-w-[460px] border-collapse text-sm">
                <thead>
                  <tr class="border-b border-line bg-mint/[0.07] text-left">
                    <th scope="col" class="px-4 py-3"></th>
                    <th scope="col" class="whitespace-nowrap px-4 py-3 font-semibold text-pine-dark">
                      {compare.colSara}
                      <span class="mt-0.5 block text-xs font-normal text-salvia">{compare.colSaraSub}</span>
                    </th>
                    <th scope="col" class="whitespace-nowrap px-4 py-3 font-semibold text-ink">
                      {compare.colHuman}
                      <span class="mt-0.5 block text-xs font-normal text-salvia">{compare.colHumanSub}</span>
                    </th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-line">
                  {
                    compare.rows.map((row, r) => (
                      <tr class={r % 2 ? 'bg-mint/[0.03]' : ''}>
                        <th scope="row" class="px-4 py-3 text-left align-top font-medium text-ink">{row.label}</th>
                        <td class="px-4 py-3 align-top text-ink">{row.sara}</td>
                        <td class="px-4 py-3 align-top text-salvia">{row.human}</td>
                      </tr>
                    ))
                  }
                </tbody>
              </table>
            </div>
          </FeatureRow>
        </div>

        <div id="one-thread" class="scroll-mt-24">
          <FeatureRow
            flip
            eyebrow={dict.row4Eyebrow}
            title={dict.row4Title}
            body={dict.row4Body}
            points={dict.row4Points}
          >
            <ConversationDemo lang={lang} channel="whatsapp" bubbles={dict.row4Bubbles} />
          </FeatureRow>
        </div>

        <div id="calendar" class="scroll-mt-24">
          <FeatureRow
            eyebrow={dict.row5Eyebrow}
            title={dict.row5Title}
            body={dict.row5Body}
            points={dict.row5Points}
          >
            <CalendarSyncPanel lang={lang} class="w-full" />
          </FeatureRow>
        </div>
      </div>
    </section>

    <CtaInline title={dict.ctaInline} lang={lang} />

    <!-- ══════════ ASÍ SE VE EN TU PANEL · estados ══════════ -->
    <section class="border-t border-line bg-paper">
      <div class="reveal mx-auto max-w-6xl px-5 py-24">
        <p class="mb-3 text-sm font-semibold uppercase tracking-[0.14em] text-pine-dark">{dict.panelKicker}</p>
        <h2 class="max-w-2xl font-serif text-3xl font-black leading-tight text-balance md:text-4xl" set:html={dict.panelH2} />
        <p class="mt-5 max-w-2xl text-lg text-salvia" set:html={dict.panelLead} />
        <div class="mt-12 grid gap-6 md:grid-cols-2">
          {
            estados.map((e) => (
              <div class="flex items-start gap-4 rounded-xl border border-line bg-cream p-6">
                <span class="shrink-0 rounded-full border border-pine/20 bg-mint/[0.12] px-3 py-1.5 text-sm font-medium text-pine-dark">
                  {e.tag}
                </span>
                <p class="text-salvia">{e.desc}</p>
              </div>
            ))
          }
        </div>
        <!-- Links de texto a las páginas hermanas (teléfono por voz y odontología). -->
        <p class="mt-12 flex flex-wrap items-center gap-x-5 gap-y-2 text-salvia">
          <span>{related.lead}</span>
          {
            related.links.map((l) => (
              <a href={l.href} class={linkCls}>
                {l.label}
              </a>
            ))
          }
        </p>
      </div>
    </section>

    <FeatureFaq items={faqs} lang={lang} />

    <CtaBand lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>
