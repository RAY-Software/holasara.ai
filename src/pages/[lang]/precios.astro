---
import { getStaticPaths, toLocale } from '../../i18n/config';
export { getStaticPaths };
import { localePath } from '../../i18n/config';
const lang = toLocale(Astro.params.lang);
const L = (p: string) => localePath(p, lang);
// Unidad de facturación. El número (PRICE_MX) es el mismo que da el backend, pero
// la etiqueta se localiza (PRICE_UNIT viene en español desde lib/pricing.ts).
const priceUnit = lang === 'en' ? 'per location / month' : PRICE_UNIT;
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FeatureFaq from '../../components/FeatureFaq.astro';
import CtaBand from '../../components/CtaBand.astro';
import ClientsStrip from '../../components/ClientsStrip.astro';
import { whatsappLink, whatsappText } from '../../lib/whatsapp';
import { PRICE_MX, PRICE_UNIT } from '../../lib/pricing';

// ── Copy por idioma. EN es traducción, no calco. ──
const dict = {
  es: {
    metaTitle: 'Precios · Sara',
    metaDescription:
      'Un plan que incluye todo lo que hace Sara, con precio por país y sin comisión por cita. Pide tu precio en una demo.',
    includes: [
      'Sara atendiendo WhatsApp e Instagram 24/7',
      'Agenda automática con tu Google Calendar',
      'Recordatorios, confirmación y lista de espera',
      'Cobro de anticipo y consulta',
      'Gift cards en tu web',
      'Instagram con IA y pedido de reseñas',
      'Modo operador para tu equipo',
      'Panel con resultados por canal',
    ],
    faqs: [
      { q: '¿Cobran comisión por cita?', a: 'No. Es una suscripción mensual fija. Las citas que agende Sara no te suman una comisión por transacción.' },
      { q: '¿El precio es el mismo en todos los países?', a: `Se ajusta al país. En México el plan arranca en ${PRICE_MX.display} ${priceUnit}, y es un piso: el número final depende de cuántas sucursales tengas. En la demo te pasamos el exacto para tu caso.` },
      { q: '¿Qué pasa si tengo varias sucursales?', a: 'El plan se arma por sucursal. Si manejas varias sedes, dínoslo en la demo y te pasamos el número cerrado para todas.' },
      { q: '¿Hay contrato de permanencia?', a: 'Trabajamos con un modelo simple y sin letra chica. Los detalles los vemos en la demo, con todo claro antes de empezar.' },
      { q: '¿Qué necesito para arrancar?', a: 'Conectar tu Google Calendar y una línea de WhatsApp. La implementación la hacemos contigo; no migras datos ni tocas tu historia clínica.' },
    ],
    kicker: 'Precios',
    h1: 'Un plan. Todo lo que hace&nbsp;Sara.',
    heroSub: `Sin planes confusos ni comisión por cita. Una suscripción mensual que incluye a Sara completa, desde <strong class="font-semibold text-ink">${PRICE_MX.display} ${PRICE_UNIT}</strong>.`,
    includesH2: 'Todo incluido, sin&nbsp;sorpresas.',
    planFrom: 'Plan desde',
    planBody:
      'Todo lo que hace Sara incluido, sin comisión por cita. El plan final depende de tu país y de cuántas sucursales tengas.',
    priceCta: 'Pedir mi precio',
    waCta: 'Preguntar por WhatsApp',
  },
  en: {
    metaTitle: 'Pricing · Sara',
    metaDescription:
      'One plan that includes everything Sara does, with country-based pricing and no per-appointment commission. Ask for your price in a demo.',
    includes: [
      'Sara answering WhatsApp and Instagram 24/7',
      'Automatic scheduling with your Google Calendar',
      'Reminders, confirmation and waitlist',
      'Deposit and consult payments',
      'Gift cards on your website',
      'AI-powered Instagram and review requests',
      'Operator mode for your team',
      'Dashboard with results by channel',
    ],
    faqs: [
      { q: 'Do you charge a commission per appointment?', a: 'No. It’s a fixed monthly subscription. The appointments Sara books don’t add a per-transaction fee.' },
      { q: 'Is the price the same in every country?', a: `It adjusts to your country. In Mexico the plan starts at ${PRICE_MX.display} ${priceUnit}, and that’s a floor: the final number depends on how many locations you have. In the demo we’ll give you the exact one for your case.` },
      { q: 'What if I have several locations?', a: 'The plan is built per location. If you run several sites, let us know in the demo and we’ll give you the final number for all of them.' },
      { q: 'Is there a lock-in contract?', a: 'We work with a simple model and no fine print. We go over the details in the demo, with everything clear before you start.' },
      { q: 'What do I need to get started?', a: 'Connect your Google Calendar and a WhatsApp line. We handle onboarding with you; you don’t migrate data or touch your medical records.' },
    ],
    kicker: 'Pricing',
    h1: 'One plan. Everything Sara&nbsp;does.',
    heroSub: `No confusing tiers or per-appointment commission. A monthly subscription that includes the full Sara, from <strong class="font-semibold text-ink">${PRICE_MX.display} ${priceUnit}</strong>.`,
    includesH2: 'Everything included, no&nbsp;surprises.',
    planFrom: 'Plan from',
    planBody:
      'Everything Sara does, included, with no per-appointment commission. Your final plan depends on your country and how many locations you have.',
    priceCta: 'Get my price',
    waCta: 'Ask on WhatsApp',
  },
}[lang];

const { includes, faqs } = dict;
---

<Layout lang={lang}
  title={dict.metaTitle}
  description={dict.metaDescription}
>
  <Header lang={lang} />
  <main>
    <section class="border-b border-line">
      <div class="mx-auto max-w-3xl px-5 pb-16 pt-14 text-center">
        <p class="mb-4 flex items-center justify-center gap-2.5 text-sm font-semibold uppercase tracking-[0.14em] text-pine-dark">
          <span class="dot h-2 w-2"></span> {dict.kicker}
        </p>
        <h1 class="font-serif text-4xl font-black leading-[1.05] tracking-tight text-balance md:text-6xl" set:html={dict.h1} />
        <p class="mx-auto mt-6 max-w-xl text-lg text-salvia" set:html={dict.heroSub} />
      </div>
    </section>

    <ClientsStrip lang={lang} />

    <section class="border-b border-line bg-paper">
      <div class="mx-auto grid max-w-5xl gap-8 px-5 py-20 md:grid-cols-[1.1fr_0.9fr] md:items-center">
        <div>
          <h2 class="font-serif text-3xl font-black leading-tight text-balance md:text-4xl" set:html={dict.includesH2} />
          <ul class="mt-8 grid gap-3.5 sm:grid-cols-2">
            {
              includes.map((x) => (
                <li class="flex items-start gap-3">
                  <span class="mt-1 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-mint">
                    <svg width="12" height="12" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                      <path d="M4 10.5 8 14.5 16 6" stroke="#14261F" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </span>
                  <span class="text-ink">{x}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="rounded-2xl border border-pine/20 bg-white p-8 text-center shadow-[0_16px_40px_-24px_rgba(20,38,31,0.35)]">
          <p class="text-sm font-semibold uppercase tracking-[0.12em] text-pine-dark">{dict.planFrom}</p>
          <p class="mt-4 flex items-baseline justify-center gap-1.5">
            <span class="font-serif text-5xl font-black leading-none tracking-tight text-ink">
              {PRICE_MX.display}
            </span>
          </p>
          <p class="mt-2 text-sm font-semibold text-salvia">{priceUnit}</p>
          <p class="mt-4 text-salvia">
            {dict.planBody}
          </p>
          <a
            href={L('/demo')}
            class="mt-7 inline-flex w-full items-center justify-center rounded-full bg-pine px-6 py-3.5 text-base font-semibold text-cream transition-colors hover:bg-pine-dark"
          >
            {dict.priceCta}
          </a>
          <a
            href={whatsappLink(whatsappText(lang))}
            target="_blank"
            rel="noopener"
            class="mt-3 inline-flex w-full items-center justify-center gap-2 rounded-full border border-line px-6 py-3 text-base font-semibold text-ink transition-colors hover:border-ink/30"
          >
            <span class="dot h-2 w-2"></span> {dict.waCta}
          </a>
        </div>
      </div>
    </section>

    <FeatureFaq items={faqs} lang={lang} />

    <CtaBand lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>
