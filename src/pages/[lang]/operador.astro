---
import { getStaticPaths, toLocale } from '../../i18n/config';
export { getStaticPaths };
const lang = toLocale(Astro.params.lang);
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import OperatorPanel from '../../components/mocks/OperatorPanel.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import FeatureRow from '../../components/FeatureRow.astro';
import ConversationDemo from '../../components/ConversationDemo.astro';
import FeatureFaq from '../../components/FeatureFaq.astro';
import CtaInline from '../../components/CtaInline.astro';
import CtaBand from '../../components/CtaBand.astro';

// ── Copy por idioma. EN es traducción, no calco. ──
const dict = {
  es: {
    metaTitle: 'Modo operador · Sara',
    metaDescription:
      'Tu equipo le pide cosas a Sara por WhatsApp: bloquear la agenda, mover una cita o reagendar el día entero. Sara ejecuta en tu calendario y le avisa a cada paciente.',
    heroEyebrow: 'Atiende · Modo operador',
    heroTitle: "Además de atender, <em class='text-pine-dark'>Sara es tu secretaria.</em>",
    heroLead:
      'Le hablas por WhatsApp como a cualquier persona de tu equipo. Gestiona la agenda entera y le avisa a cada paciente. Las 24 horas.',
    heroImageAlt: 'La dueña de una clínica, relajada con un café, gestiona su agenda desde el teléfono.',
    strip: [
      { t: 'Le hablas por WhatsApp', b: 'Sin app nueva ni pantallas. En tus palabras.' },
      { t: 'Ejecuta en tu calendario', b: 'Los cambios caen en el Google Calendar de tu equipo.' },
      { t: 'Avisa a cada paciente', b: 'Con su nueva hora, sin que persigas a nadie.' },
    ],
    howKicker: 'Cómo lo hace Sara',
    howH2: 'Reprogramar un día entero, en un solo&nbsp;mensaje.',
    howP:
      'Se te complicó el martes y hay que mover todo. En vez de llamar a cada paciente, le escribes a Sara una frase. Ella reagenda y avisa a cada uno, uno por&nbsp;uno.',
    howBubbles: [
      { who: 'in', text: 'Reagenda a todos los del martes al jueves, mismo horario, y avísales', t: '08:15' },
      { who: 'out', text: '¡Hecho! ✅ Moví las 8 citas del martes al jueves a la misma hora. Ya le escribí a cada paciente con su nueva hora para que confirme.', t: '08:15' },
      { who: 'in', text: 'Perfecto, gracias', t: '08:16' },
      { who: 'out', text: 'De nada 🙌 Te aviso a medida que vayan confirmando. El martes queda libre en tu calendario.', t: '08:16' },
    ],
    stepsH2: 'Cómo funciona el modo&nbsp;operador.',
    steps: [
      { n: '01', title: 'Le escribes la orden', body: 'Desde tu WhatsApp, en tus palabras: bloquear, mover, reagendar o consultar la agenda.' },
      { n: '02', title: 'Sara la ejecuta', body: 'Actualiza tu Google Calendar y resuelve el cambio en el momento, sin dobles reservas.' },
      { n: '03', title: 'Notifica a los pacientes', body: 'Le avisa a cada afectado su nueva hora, sin que levantes el teléfono.' },
    ],
    row1Eyebrow: 'Le dices, y pasa',
    row1Title: "Órdenes que resuelve <em class='text-pine-dark'>sola.</em>",
    row1Body:
      'Bloquear una tarde, mover un paciente, reagendar el día o consultar cuántas citas tienes mañana. Le escribes como a tu recepción, y lo hace.',
    orders: [
      '“Bloquea mi agenda el viernes a la tarde.”',
      '“Pasa a Juan Pérez al jueves 10.”',
      '“Reagenda a todos los del martes y avísales.”',
      '“¿Cuántas citas tengo mañana?”',
    ],
    row2Eyebrow: 'Avisa por ti',
    row2Title: "Reprograma, <em class='text-pine-dark'>y notifica a cada paciente.</em>",
    row2Body:
      'Lo más pesado de reprogramar no es mover las citas: es avisarle a cada persona. Sara le escribe a todos con su nueva hora y te resume la gestión, sin que muevas un dedo.',
    row2Points: [
      'Le avisa a cada paciente por separado',
      'Te resume qué movió y quién confirmó',
      'Todo queda en tu Google Calendar',
    ],
    row2ImgAlt: 'Sara reprograma todas las citas del martes y avisa a cada paciente por WhatsApp, con el resumen de la gestión.',
    row3Eyebrow: 'Con control',
    row3Title: "Solo tu equipo <em class='text-pine-dark'>puede pedírselo.</em>",
    row3Body:
      'El modo operador se activa por número autorizado. Un paciente puede agendar y consultar, pero nunca bloquear tu agenda ni mover citas de otros. Ese poder es solo tuyo y de tu equipo.',
    row3Points: [
      'Se habilita por número de teléfono',
      'Un paciente no accede a estas acciones',
      'Cada cambio queda registrado en el panel',
    ],
    row3Quote: '“Reprogramar un día entero deja de ser una tarde de teléfono. Es un mensaje.”',
    ctaInline: 'Que reprogramar un día entero sea un solo&nbsp;mensaje.',
    faqs: [
      { q: '¿Cualquiera puede darle órdenes a Sara?', a: 'No. El modo operador se habilita solo para los números de teléfono que autorices (el tuyo, el de recepción). Los pacientes nunca acceden a estas acciones.' },
      { q: '¿Necesito instalar una app?', a: 'No. Todo pasa por WhatsApp, el mismo que ya usas todo el día.' },
      { q: '¿Y si reagendo veinte citas de golpe?', a: 'Sara las mueve y le escribe a cada paciente por separado con su nueva hora. Es justo el caso donde más tiempo te ahorra.' },
      { q: '¿Puedo ver qué hizo?', a: 'Cada cambio queda reflejado en tu Google Calendar y en el panel, así siempre tienes el registro.' },
    ],
  },
  en: {
    metaTitle: 'Operator mode · Sara',
    metaDescription:
      'Your team asks Sara for things over WhatsApp: block the calendar, move an appointment or reschedule the whole day. Sara acts in your calendar and notifies every patient.',
    heroEyebrow: 'Answers · Operator mode',
    heroTitle: "Beyond answering,<br /><em class='text-pine-dark'>Sara is your secretary.</em>",
    heroLead:
      'You talk to her over WhatsApp like anyone on your team. She manages the entire calendar and notifies every patient. Around the clock.',
    heroImageAlt: 'A clinic owner, relaxed with a coffee, manages her calendar from her phone.',
    strip: [
      { t: 'You talk to her on WhatsApp', b: 'No new app or screens. In your own words.' },
      { t: 'Acts in your calendar', b: "The changes land in your team's Google Calendar." },
      { t: 'Notifies every patient', b: 'With their new time, without you chasing anyone.' },
    ],
    howKicker: 'How Sara does it',
    howH2: 'Reschedule a whole day, in a single&nbsp;message.',
    howP:
      'Tuesday got complicated and everything has to move. Instead of calling each patient, you send Sara one sentence. She reschedules and notifies each one, one by&nbsp;one.',
    howBubbles: [
      { who: 'in', text: 'Reschedule everyone from Tuesday to Thursday, same time, and let them know', t: '8:15 am' },
      { who: 'out', text: 'Done! ✅ I moved all 8 Tuesday appointments to Thursday at the same time. I already messaged each patient with their new time to confirm.', t: '8:15 am' },
      { who: 'in', text: 'Perfect, thanks', t: '8:16 am' },
      { who: 'out', text: "You're welcome 🙌 I'll let you know as they confirm. Tuesday is now open in your calendar.", t: '8:16 am' },
    ],
    stepsH2: 'How operator mode&nbsp;works.',
    steps: [
      { n: '01', title: 'You send the order', body: 'From your WhatsApp, in your own words: block, move, reschedule or check the calendar.' },
      { n: '02', title: 'Sara carries it out', body: 'She updates your Google Calendar and resolves the change on the spot, with no double bookings.' },
      { n: '03', title: 'Notifies the patients', body: 'She tells each affected patient their new time, without you picking up the phone.' },
    ],
    row1Eyebrow: 'You tell her, and it happens',
    row1Title: "Orders she handles <em class='text-pine-dark'>on her own.</em>",
    row1Body:
      'Block an afternoon, move a patient, reschedule the day or check how many appointments you have tomorrow. You message her like your front desk, and she does it.',
    orders: [
      '“Block my calendar on Friday afternoon.”',
      '“Move Juan Pérez to Thursday at 10.”',
      '“Reschedule everyone from Tuesday and let them know.”',
      '“How many appointments do I have tomorrow?”',
    ],
    row2Eyebrow: 'She notifies for you',
    row2Title: "Reschedules, <em class='text-pine-dark'>and notifies every patient.</em>",
    row2Body:
      "The hardest part of rescheduling isn't moving the appointments: it's telling each person. Sara messages everyone with their new time and gives you a summary, without you lifting a finger.",
    row2Points: [
      'Notifies each patient individually',
      'Summarizes what she moved and who confirmed',
      'Everything stays in your Google Calendar',
    ],
    row2ImgAlt: 'Sara reschedules every Tuesday appointment and notifies each patient over WhatsApp, with a summary of what she did.',
    row3Eyebrow: 'With control',
    row3Title: "Only your team <em class='text-pine-dark'>can ask her.</em>",
    row3Body:
      "Operator mode is enabled per authorized number. A patient can book and ask questions, but never block your calendar or move other people's appointments. That power is yours and your team's alone.",
    row3Points: [
      'Enabled per phone number',
      "A patient can't access these actions",
      'Every change is logged in the dashboard',
    ],
    row3Quote: "“Rescheduling a whole day stops being an afternoon on the phone. It's one message.”",
    ctaInline: 'Make rescheduling a whole day a single&nbsp;message.',
    faqs: [
      { q: 'Can anyone give Sara orders?', a: "No. Operator mode is enabled only for the phone numbers you authorize (yours, the front desk's). Patients never access these actions." },
      { q: 'Do I need to install an app?', a: 'No. Everything happens over WhatsApp, the same one you already use all day.' },
      { q: 'What if I reschedule twenty appointments at once?', a: "Sara moves them and messages each patient individually with their new time. That's exactly the case where she saves you the most time." },
      { q: 'Can I see what she did?', a: 'Every change is reflected in your Google Calendar and in the dashboard, so you always have the record.' },
    ],
  },
}[lang];

const { steps, orders, faqs } = dict;
---

<Layout ogImage={`/og/operador-${lang}.jpg`} lang={lang}
  title={dict.metaTitle}
  description={dict.metaDescription}
>
  <Header lang={lang} />
  <main>
    <PageHero
      lang={lang}
      eyebrow={dict.heroEyebrow}
      title={dict.heroTitle}
      lead={dict.heroLead}
      image="/img/hero/operador-hero.jpg"
      imageAlt={dict.heroImageAlt}
      imageW={1200}
      imageH={900}
    />

    <!-- ══════════ TIRA DE MECÁNICA ══════════ -->
    <section class="border-b border-line bg-paper">
      <div class="mx-auto grid max-w-6xl gap-8 px-5 py-10 sm:grid-cols-3">
        <div class="py-2">
          <p class="font-serif text-lg font-black text-ink">{dict.strip[0].t}</p>
          <p class="mt-1 text-salvia">{dict.strip[0].b}</p>
        </div>
        <div class="py-2 sm:border-l sm:border-line sm:pl-8">
          <p class="font-serif text-lg font-black text-ink">{dict.strip[1].t}</p>
          <p class="mt-1 text-salvia">{dict.strip[1].b}</p>
        </div>
        <div class="py-2 sm:border-l sm:border-line sm:pl-8">
          <p class="font-serif text-lg font-black text-ink">{dict.strip[2].t}</p>
          <p class="mt-1 text-salvia">{dict.strip[2].b}</p>
        </div>
      </div>
    </section>

    <!-- ══════════ CÓMO LO HACE SARA ══════════ -->
    <section class="border-t border-line">
      <div class="reveal mx-auto grid max-w-6xl items-center gap-14 px-5 py-24 md:grid-cols-[1.05fr_0.95fr]">
        <div>
          <p class="mb-3 text-sm font-semibold uppercase tracking-[0.14em] text-pine-dark">{dict.howKicker}</p>
          <h2 class="font-serif text-3xl font-black leading-tight text-balance md:text-4xl" set:html={dict.howH2} />
          <p class="mt-5 text-lg text-salvia" set:html={dict.howP} />
        </div>
        <div class="flex justify-center md:justify-end">
          <ConversationDemo
            lang={lang}
            channel="whatsapp"
            name="Sara"
            bubbles={dict.howBubbles}
          />
        </div>
      </div>
    </section>

    <!-- ══════════ CÓMO FUNCIONA · 3 tiempos ══════════ -->
    <section class="border-t border-line bg-ink text-cream">
      <div class="reveal mx-auto max-w-6xl px-5 py-24">
        <h2 class="max-w-2xl font-serif text-3xl font-black leading-tight text-balance md:text-4xl" set:html={dict.stepsH2} />
        <div class="mt-14 grid gap-x-10 gap-y-12 md:grid-cols-3">
          {
            steps.map((s) => (
              <div>
                <div class="flex items-center gap-4">
                  <span class="font-serif text-4xl font-black text-mint tabular-nums">{s.n}</span>
                  <span class="h-px flex-1 bg-cream/15" />
                </div>
                <h3 class="mt-5 text-xl font-semibold text-cream">{s.title}</h3>
                <p class="mt-2 text-cream/65">{s.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ══════════ CAPACIDADES ══════════ -->
    <section class="border-t border-line">
      <div class="reveal mx-auto flex max-w-6xl flex-col gap-24 px-5 py-24">
        <FeatureRow
          eyebrow={dict.row1Eyebrow}
          title={dict.row1Title}
          body={dict.row1Body}
        >
          <div class="w-full">
            <div class="flex flex-col gap-3">
              {
                orders.map((o) => (
                  <div class="rounded-xl border border-line bg-paper px-5 py-4 font-accent text-lg italic text-pine-dark">{o}</div>
                ))
              }
            </div>
          </div>
        </FeatureRow>

        <FeatureRow
          flip
          eyebrow={dict.row2Eyebrow}
          title={dict.row2Title}
          body={dict.row2Body}
          points={dict.row2Points}
        >
          <OperatorPanel lang={lang} class="w-full" />
        </FeatureRow>

        <FeatureRow
          eyebrow={dict.row3Eyebrow}
          title={dict.row3Title}
          body={dict.row3Body}
          points={dict.row3Points}
        >
          <div class="w-full rounded-2xl border border-pine/20 bg-mint/[0.07] p-8">
            <p class="font-accent text-2xl italic text-pine-dark">{dict.row3Quote}</p>
          </div>
        </FeatureRow>
      </div>
    </section>

    <CtaInline title={dict.ctaInline} lang={lang} />

    <FeatureFaq items={faqs} lang={lang} />

    <CtaBand lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>
