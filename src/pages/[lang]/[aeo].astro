    ],
    row3Bubbles: [
      { who: 'out', text: 'Hi Juan. How was your session today? If you were happy with it, a Google review would help us a lot.', t: '5:30 pm' },
      { who: 'out', text: 'It is a single click, here is the direct link.', t: '5:30 pm', link: 'g.page/your-clinic' },
      { who: 'in', text: 'Done, just left it', t: '8:04 pm' },
      { who: 'out', text: 'Thank you so much, Juan. It helps us a lot. See you at your next session.', t: '8:04 pm' },
    ],
    row4Eyebrow: 'Agency vs Mia',
    row4Title: "An AEO agency <em class='text-pine-dark'>vs&nbsp;Mia.</em>",
    row4Body:
      'Answer engine optimization agencies sell audits and reports. Mia does the work: every week, on your profile, your site and your reviews, and she messages you what changed. No meetings, no waiting for the monthly report, and Sara answering whoever shows up.',
    cmpHead: ['AEO agency', 'Mia'],
    cmpRows: [
      { label: 'What you get', agency: 'An initial audit and a monthly report', mia: 'Changes made every week to your profile and your site' },
      { label: 'Who does the work', agency: 'You or your team, from a to-do list', mia: 'Mia, and she tells you on WhatsApp' },
      { label: 'How you find out', agency: 'A monthly meeting or a PDF', mia: 'One message a week with what changed and what she proposes' },
      { label: 'Reviews', agency: 'They tell you to ask for more', mia: 'Sara asks after every appointment' },
      { label: 'The patient who arrives', agency: 'Lands on your contact form', mia: `Answered and booked by ${a(L('/recepcionista-virtual'), 'Sara')}, around the clock` },
    ],
    ctaInline: 'Get found when patients ask, not just when they&nbsp;search.',
    panelKicker: 'How it looks in your dashboard',
    panelH2: 'Every change leaves a&nbsp;trail.',
    panelLead:
      'Mia does not work in silence. Everything she touches is logged in the dashboard, and once a week she sums it up for you on&nbsp;WhatsApp.',
    estados: [
      { tag: 'Profile updated', desc: 'Mia changed something on your Google Business Profile: hours, treatments, photos or description.' },
      { tag: 'Article published', desc: 'A new article went live on your site, with its direct answer and its FAQs.' },
      { tag: 'New review', desc: 'A patient left a Google review after Sara asked for it.' },
      { tag: 'Enquiry from Google', desc: 'Someone came in from your profile or your site and messaged Sara. It is attributed to that channel.' },
    ],
    faqs: [
      { q: 'What is the difference between SEO, AEO and GEO?', a: "SEO is showing up in Google's list of results. AEO (answer engine optimization) is showing up inside the answer an assistant like ChatGPT or Google's AI overview gives. GEO (generative engine optimization) is another name for the same work, with the focus on generative engines. In practice they go together: almost everything that helps AEO also helps your SEO." },
      { q: 'Does AEO replace SEO?', a: 'No, it builds on it. Assistants read the same sources Google already reads: your profile, your website, your reviews. What changes is the format that wins: direct answers, FAQs and consistent facts matter more than ever. If your SEO is in good shape, AEO is the next step; if it is not, they get done together.' },
      { q: 'Can you guarantee my clinic shows up in ChatGPT?', a: 'No, and be wary of anyone who promises it. Nobody controls what an assistant answers. What you do control is what assistants read about your clinic: a complete profile, a website that answers clearly, recent reviews and facts that match everywhere. That is what Mia works on every week.' },
      { q: 'How do I know if it is working?', a: 'With what can actually be measured today: how many times your profile showed up in searches, how many calls and visits came from Google, and how many enquiries Sara handled. Mia sums it up for you every week. What cannot be measured reliably yet is how many times an assistant mentioned you, and we will not show you a made-up number.' },
      { q: 'What does Mia actually do each week?', a: 'She checks your Google Business Profile and completes or fixes it, publishes articles on your site with direct answers and FAQs, asks for reviews through Sara, keeps the facts identical across your site, your profile and your Instagram, runs your Instagram, and messages you what changed and what she proposes next. Nothing goes live without your approval.' },
      { q: 'Does this work for dental offices and med spas?', a: 'Yes, that is where it shows the most, because these are local searches with intent to book. We have dedicated pages on dental SEO and med spa SEO with the details for each; they are linked higher up on this page.' },
      { q: 'How much does it cost?', a: 'Pricing is built for each clinic, based on country and size, and shared in the demo. Mia works on the same account as Sara; in the demo we go over what each plan includes.' },
    ],
  },
}[lang];

const { steps, estados, faqs, aiCard, gb, blog } = dict;
---

<Layout ogImage={`/og/aeo-${lang}.jpg`} lang={lang} title={dict.metaTitle} description={dict.metaDescription}>
  <Header lang={lang} />
  <main>
    <PageHero
      lang={lang}
      eyebrow={dict.heroEyebrow}
      title={dict.heroTitle}
      lead={dict.heroLead}
    >
      <!-- El hero muestra la conversación con el asistente (pedido de Franco): el paciente pregunta y la clínica aparece en la respuesta. -->
      <AiChatPhone
        slot="visual"
        title={aiCard.title}
        q={aiCard.q}
        a={aiCard.a}
        sourcesLabel={aiCard.sourcesLabel}
        sources={aiCard.sources}
        compose={aiCard.compose}
        disclaimer={aiCard.disclaimer}
      />
    </PageHero>

    <!-- ══════════ TIRA DE MECÁNICA (qué leen los asistentes; no son stats) ══════════ -->
    <section class="border-b border-line bg-paper">
      <div class="mx-auto grid max-w-6xl gap-8 px-5 py-10 sm:grid-cols-3">
        <div class="py-2">
          <p class="font-serif text-lg font-black text-ink">{dict.strip[0].t}</p>
          <p class="mt-1 text-salvia">{dict.strip[0].b}</p>
        </div>
        <div class="py-2 sm:border-l sm:border-line sm:pl-8">
          <p class="font-serif text-lg font-black text-ink">{dict.strip[1].t}</p>
          <p class="mt-1 text-salvia">{dict.strip[1].b}</p>
        </div>
        <div class="py-2 sm:border-l sm:border-line sm:pl-8">
          <p class="font-serif text-lg font-black text-ink">{dict.strip[2].t}</p>
          <p class="mt-1 text-salvia">{dict.strip[2].b}</p>
        </div>
      </div>
    </section>

    <!-- ══════════ QUÉ ES AEO · guía + mock de respuesta de asistente ══════════ -->
    <section class="border-t border-line">
      <div class="reveal mx-auto max-w-6xl px-5 py-24">
        <div class="grid items-center gap-14 md:grid-cols-[1.05fr_0.95fr]">
          <div>
            <p class="mb-3 text-sm font-semibold uppercase tracking-[0.14em] text-pine-dark">{dict.whatKicker}</p>
            <h2 class="font-serif text-3xl font-black leading-tight text-balance md:text-4xl" set:html={dict.whatH2} />
            <p class="mt-5 text-lg text-salvia">{dict.whatP1}</p>
            <p class="mt-4 text-salvia">{dict.whatP2}</p>
            <p class="mt-4 text-salvia" set:html={dict.whatSeeAlso} />
          </div>

          <!-- Tabla SEO vs AEO/GEO (la conversación con el asistente vive en el hero). -->
          <div class="min-w-0">
          <h3 class="font-serif text-2xl font-black leading-tight text-balance" set:html={dict.tableH3} />
          <div class="mt-6 overflow-x-auto rounded-2xl border border-line">
            <table class="w-full min-w-[560px] border-collapse text-sm">
              <thead>
                <tr class="border-b border-line bg-mint/[0.07] text-left">
                  <th scope="col" class="px-4 py-3"><span class="sr-only">{lang === 'en' ? 'Aspect' : 'Aspecto'}</span></th>
                  <th scope="col" class="whitespace-nowrap px-4 py-3 font-semibold text-ink">{dict.tableHead[0]}</th>
                  <th scope="col" class="whitespace-nowrap px-4 py-3 font-semibold text-pine-dark">{dict.tableHead[1]}</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-line">
                {
                  dict.tableRows.map((r, i) => (
                    <tr class={i % 2 ? 'bg-mint/[0.03]' : ''}>
                      <th scope="row" class="whitespace-nowrap px-4 py-3 text-left align-top font-medium text-ink">{r.label}</th>
                      <td class="px-4 py-3 align-top text-salvia">{r.seo}</td>
                      <td class="px-4 py-3 align-top text-ink">{r.aeo}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════ CÓMO LO HACE MIA · resumen semanal por WhatsApp ══════════ -->
    <section class="border-t border-line bg-paper">
      <div class="reveal mx-auto grid max-w-6xl items-center gap-14 px-5 py-24 md:grid-cols-[1.05fr_0.95fr]">
        <div>
          <p class="mb-3 text-sm font-semibold uppercase tracking-[0.14em] text-pine-dark">{dict.howKicker}</p>
          <h2 class="font-serif text-3xl font-black leading-tight text-balance md:text-4xl" set:html={dict.howH2} />
          <p class="mt-5 text-lg text-salvia">{dict.howP1}</p>
          <p class="mt-4 text-salvia" set:html={dict.howP2} />
        </div>
        <div class="flex justify-center md:justify-end">
          <ConversationDemo
            lang={lang}
            channel="whatsapp"
            name="Mia"
            avatar="/equipo/mia-avatar.jpg"
            bubbles={dict.howBubbles}
            animate
          />
        </div>
      </div>
    </section>

    <!-- ══════════ CÓMO FUNCIONA · 3 tiempos (banda oscura) ══════════ -->
    <section class="border-t border-line bg-ink text-cream">
      <div class="reveal mx-auto max-w-6xl px-5 py-24">
        <h2 class="max-w-2xl font-serif text-3xl font-black leading-tight text-balance md:text-4xl" set:html={dict.stepsH2} />
        <div class="mt-14 grid gap-x-10 gap-y-12 md:grid-cols-3">
          {
            steps.map((s) => (
              <div>
                <div class="flex items-center gap-4">
                  <span class="font-serif text-4xl font-black text-mint tabular-nums">{s.n}</span>
                  <span class="h-px flex-1 bg-cream/15" />
                </div>
                <h3 class="mt-5 text-xl font-semibold text-cream">{s.title}</h3>
                <p class="mt-2 text-cream/65">{s.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ══════════ CAPACIDADES · filas alternadas (copy + visual) ══════════ -->
    <section class="border-t border-line">
      <div class="reveal mx-auto flex max-w-6xl flex-col gap-24 px-5 py-24">
        <FeatureRow
          eyebrow={dict.row1Eyebrow}
          title={dict.row1Title}
          body={dict.row1Body}
          points={dict.row1Points}
        >
          <!-- Tarjeta de ficha de Google Business, mantenida por Mia. -->
          <figure class="w-full max-w-sm overflow-hidden rounded-2xl border border-line bg-white shadow-[0_12px_34px_-20px_rgba(20,38,31,0.32)]">
            <div class="flex items-center gap-2 border-b border-line px-4 py-3">
              <img src="/img/logos/google.svg" alt="" width="20" height="20" class="h-5 w-5 shrink-0" loading="lazy" decoding="async" />
              <span class="truncate text-xs font-semibold uppercase tracking-[0.08em] text-salvia">{gb.kicker}</span>
              <span class="ml-auto inline-flex shrink-0 items-center gap-1.5 whitespace-nowrap rounded-full border border-pine/20 bg-mint/[0.12] px-2.5 py-1 text-[11px] font-semibold text-pine-dark">
                <span class="dot h-1.5 w-1.5"></span>{gb.updated}
              </span>
            </div>
            <div class="px-4 py-4">
              <p class="font-serif text-xl font-black text-ink">{gb.name}</p>
              <p class="mt-0.5 text-sm text-salvia">{gb.category}</p>
              <p class="mt-1.5 flex items-center gap-1.5 text-sm">
                <span class="tracking-tight text-[#fbbc05]" aria-hidden="true">★★★★★</span>
                <span class="font-semibold text-ink">{gb.rating}</span>
                <span class="text-salvia">({gb.reviews})</span>
              </p>
              <dl class="mt-4 flex flex-col gap-2 text-sm">
                {
                  gb.rows.map((r) => (
                    <div class="flex gap-3">
                      <dt class="w-20 shrink-0 text-salvia">{r.k}</dt>
                      <dd class="min-w-0 text-ink">{r.v}</dd>
                    </div>
                  ))
                }
              </dl>
              <p class="mt-4 text-[11px] font-semibold uppercase tracking-[0.08em] text-salvia">{gb.servicesLabel}</p>
              <div class="mt-2 flex flex-wrap gap-1.5">
                {gb.services.map((s) => <span class="rounded-full border border-line bg-paper px-2.5 py-1 text-xs text-ink">{s}</span>)}
              </div>
            </div>
            <div class="flex items-center gap-2 border-t border-line bg-paper px-4 py-2.5 text-xs text-salvia">
              <svg viewBox="0 0 24 24" fill="none" class="h-4 w-4 shrink-0" aria-hidden="true">
                <rect x="4" y="5" width="16" height="14" rx="2" stroke="currentColor" stroke-width="1.6" />
                <path d="M4 15l4-4 3 3 4-4 5 5" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
              </svg>
              {gb.footer}
            </div>
          </figure>
        </FeatureRow>

        <FeatureRow
          flip
          eyebrow={dict.row2Eyebrow}
          title={dict.row2Title}
          body={dict.row2Body}
          points={dict.row2Points}
        >
          <!-- Tarjeta de artículo del blog con respuesta directa y preguntas frecuentes. -->
          <figure class="w-full max-w-sm overflow-hidden rounded-2xl border border-line bg-white shadow-[0_12px_34px_-20px_rgba(20,38,31,0.32)]">
            <img src="/img/mia/blog.jpg" alt="" width="900" height="900" class="aspect-[16/9] w-full object-cover" loading="lazy" decoding="async" />
            <div class="px-5 py-4">
              <p class="text-[11px] font-semibold uppercase tracking-[0.08em] text-salvia">{blog.kind}</p>
              <p class="mt-1.5 font-serif text-lg font-black leading-snug text-ink">{blog.title}</p>
              <div class="mt-3 rounded-xl border border-pine/20 bg-mint/[0.08] p-3">
                <p class="text-[11px] font-semibold uppercase tracking-[0.08em] text-pine-dark">{blog.answerLabel}</p>
                <p class="mt-1 text-sm leading-relaxed text-ink">{blog.answer}</p>
              </div>
              <p class="mt-3 text-[11px] font-semibold uppercase tracking-[0.08em] text-salvia">{blog.faqLabel}</p>
              <ul class="mt-1.5 flex flex-col gap-1 text-sm text-ink">
                {
                  blog.faqs.map((q) => (
                    <li class="flex items-start gap-2">
                      <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-mint" />
                      <span>{q}</span>
                    </li>
                  ))
                }
              </ul>
            </div>
            <div class="flex items-center gap-2 border-t border-line bg-paper px-5 py-2.5 text-xs text-salvia">
              <span class="dot h-1.5 w-1.5"></span>{blog.status}
            </div>
          </figure>
        </FeatureRow>

        <FeatureRow
          eyebrow={dict.row3Eyebrow}
          title={dict.row3Title}
          body={dict.row3Body}
          points={dict.row3Points}
        >
          <ConversationDemo
            lang={lang}
            channel="whatsapp"
            bubbles={dict.row3Bubbles}
          />
        </FeatureRow>

        <FeatureRow
          flip
          eyebrow={dict.row4Eyebrow}
          title={dict.row4Title}
          body={dict.row4Body}
        >
          <!-- Tabla agencia de AEO vs Mia (sin números). -->
          <div class="w-full overflow-x-auto rounded-2xl border border-line bg-white shadow-[0_12px_34px_-20px_rgba(20,38,31,0.32)]">
            <table class="w-full min-w-[440px] border-collapse text-sm">
              <thead>
                <tr class="border-b border-line bg-mint/[0.07] text-left">
                  <th scope="col" class="px-4 py-3"><span class="sr-only">{lang === 'en' ? 'Aspect' : 'Aspecto'}</span></th>
                  <th scope="col" class="whitespace-nowrap px-4 py-3 font-semibold text-ink">{dict.cmpHead[0]}</th>
                  <th scope="col" class="whitespace-nowrap px-4 py-3 font-semibold text-pine-dark">{dict.cmpHead[1]}</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-line">
                {
                  dict.cmpRows.map((r, i) => (
                    <tr class={i % 2 ? 'bg-mint/[0.03]' : ''}>
                      <th scope="row" class="px-4 py-3 text-left align-top font-medium text-ink">{r.label}</th>
                      <td class="px-4 py-3 align-top text-salvia">{r.agency}</td>
                      <td class="px-4 py-3 align-top text-ink" set:html={r.mia} />
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </FeatureRow>
      </div>
    </section>

    <CtaInline title={dict.ctaInline} lang={lang} />

    <!-- ══════════ ASÍ SE VE EN TU PANEL · estados ══════════ -->
    <section class="border-t border-line bg-paper">
      <div class="reveal mx-auto max-w-6xl px-5 py-24">
        <p class="mb-3 text-sm font-semibold uppercase tracking-[0.14em] text-pine-dark">{dict.panelKicker}</p>
        <h2 class="max-w-2xl font-serif text-3xl font-black leading-tight text-balance md:text-4xl" set:html={dict.panelH2} />
        <p class="mt-5 max-w-2xl text-lg text-salvia" set:html={dict.panelLead} />
        <div class="mt-12 grid gap-6 md:grid-cols-2">
          {
            estados.map((e) => (
              <div class="flex items-start gap-4 rounded-xl border border-line bg-cream p-6">
                <span class="shrink-0 rounded-full border border-pine/20 bg-mint/[0.12] px-3 py-1.5 text-sm font-medium text-pine-dark">
                  {e.tag}
                </span>
                <p class="text-salvia">{e.desc}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <FeatureFaq items={faqs} lang={lang} />

    <CtaBand lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>
