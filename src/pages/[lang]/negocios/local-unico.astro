---

<Layout lang={lang}
  title={dict.metaTitle}
  description={dict.metaDesc}
>
  <Header lang={lang} />
  <main>
    <PageHero
      lang={lang}
      eyebrow={dict.heroEyebrow}
      title={dict.heroTitle}
      lead={dict.heroLead}
      image="/img/hero/local-unico-hero.jpg"
      imageAlt={dict.heroImageAlt}
      imageW={1200}
      imageH={896}
    />

    <!-- ══════════ TIRA DE MECÁNICA ══════════ -->
    <section class="border-b border-line bg-paper">
      <div class="mx-auto grid max-w-6xl gap-8 px-5 py-10 sm:grid-cols-3">
        <div class="py-2">
          <p class="font-serif text-lg font-black text-ink">{mecanica[0].title}</p>
          <p class="mt-1 text-salvia">{mecanica[0].desc}</p>
        </div>
        <div class="py-2 sm:border-l sm:border-line sm:pl-8">
          <p class="font-serif text-lg font-black text-ink">{mecanica[1].title}</p>
          <p class="mt-1 text-salvia">{mecanica[1].desc}</p>
        </div>
        <div class="py-2 sm:border-l sm:border-line sm:pl-8">
          <p class="font-serif text-lg font-black text-ink">{mecanica[2].title}</p>
          <p class="mt-1 text-salvia">{mecanica[2].desc}</p>
        </div>
      </div>
    </section>

    <!-- ══════════ CÓMO LO HACE SARA · conversación real ══════════ -->
    <section class="border-t border-line">
      <div class="reveal mx-auto grid max-w-6xl items-center gap-14 px-5 py-24 md:grid-cols-[1.05fr_0.95fr]">
        <div>
          <p class="mb-3 text-sm font-semibold uppercase tracking-[0.14em] text-pine-dark">{dict.comoKicker}</p>
          <h2 class="font-serif text-3xl font-black leading-tight text-balance md:text-4xl" set:html={dict.comoH2} />
          <p class="mt-5 text-lg text-salvia">{dict.comoP1}</p>
          <p class="mt-4 text-salvia" set:html={dict.comoP2} />
        </div>
        <div class="flex justify-center md:justify-end">
          <ConversationDemo
            channel="whatsapp"
            lang={lang}
            bubbles={dict.demoHero}
          />
        </div>
