      image="/img/hero/estetica-spa-hero.jpg"
      imageAlt={dict.heroImgAlt}
      imageW={1200}
      imageH={896}
    />

    <!-- ══════════ TIRA DE MECÁNICA ══════════ -->
    <section class="border-b border-line bg-paper">
      <div class="mx-auto grid max-w-6xl gap-8 px-5 py-10 sm:grid-cols-3">
        <div class="py-2">
          <p class="font-serif text-lg font-black text-ink">{dict.mech1t}</p>
          <p class="mt-1 text-salvia">{dict.mech1d}</p>
        </div>
        <div class="py-2 sm:border-l sm:border-line sm:pl-8">
          <p class="font-serif text-lg font-black text-ink">{dict.mech2t}</p>
          <p class="mt-1 text-salvia">{dict.mech2d}</p>
        </div>
        <div class="py-2 sm:border-l sm:border-line sm:pl-8">
          <p class="font-serif text-lg font-black text-ink">{dict.mech3t}</p>
          <p class="mt-1 text-salvia">{dict.mech3d}</p>
        </div>
      </div>
    </section>

    <!-- ══════════ CÓMO LO HACE SARA · conversación real ══════════ -->
    <section class="border-t border-line">
      <div class="reveal mx-auto grid max-w-6xl items-center gap-14 px-5 py-24 md:grid-cols-[1.05fr_0.95fr]">
        <div>
          <p class="mb-3 text-sm font-semibold uppercase tracking-[0.14em] text-pine-dark">{dict.demoKicker}</p>
          <h2 class="font-serif text-3xl font-black leading-tight text-balance md:text-4xl" set:html={dict.demoH2} />
          <p class="mt-5 text-lg text-salvia">{dict.demoP1}</p>
          <p class="mt-4 text-salvia" set:html={dict.demoP2} />
        </div>
        <div class="flex justify-center md:justify-end">
          <ConversationDemo channel="instagram" lang={lang} bubbles={demoBubbles} />
        </div>
      </div>
    </section>

    <!-- ══════════ POR QUÉ ES DISTINTO · 3 tiempos (banda oscura) ══════════ -->
    <section class="border-t border-line bg-ink text-cream">
      <div class="reveal mx-auto max-w-6xl px-5 py-24">
        <p class="mb-3 text-sm font-semibold uppercase tracking-[0.14em] text-mint">{dict.whyKicker}</p>
        <h2 class="max-w-2xl font-serif text-3xl font-black leading-tight text-balance md:text-4xl" set:html={dict.whyH2} />
        <div class="mt-14 grid gap-x-10 gap-y-12 md:grid-cols-3">
          {
            steps.map((s) => (
              <div>
                <div class="flex items-center gap-4">
                  <span class="font-serif text-4xl font-black text-mint tabular-nums">{s.n}</span>
                  <span class="h-px flex-1 bg-cream/15" />
                </div>
                <h3 class="mt-5 text-xl font-semibold text-cream">{s.title}</h3>
                <p class="mt-2 text-cream/65">{s.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ══════════ CAPACIDADES ══════════ -->
    <section class="border-t border-line">
      <div class="reveal mx-auto flex max-w-6xl flex-col gap-24 px-5 py-24">
        <FeatureRow
          eyebrow={dict.fr1Eyebrow}
          title={dict.fr1Title}
          body={dict.fr1Body}
          points={fr1Points}
        >
          <ConversationDemo channel="whatsapp" lang={lang} bubbles={fr1Bubbles} />
        </FeatureRow>

        <FeatureRow
          flip
          eyebrow={dict.fr2Eyebrow}
          title={dict.fr2Title}
          body={dict.fr2Body}
          points={fr2Points}
        >
          <ConversationDemo channel="whatsapp" lang={lang} bubbles={fr2Bubbles} />
        </FeatureRow>

        <FeatureRow
          eyebrow={dict.fr3Eyebrow}
          title={dict.fr3Title}
          body={dict.fr3Body}
          points={fr3Points}
        >
          <ConversationDemo channel="instagram" lang={lang} bubbles={fr3Bubbles} />
        </FeatureRow>

        <FeatureRow
          flip
          eyebrow={dict.fr4Eyebrow}
          title={dict.fr4Title}
          body={dict.fr4Body}
          points={fr4Points}
        >
          <ConversationDemo channel="whatsapp" lang={lang} bubbles={fr4Bubbles} />
        </FeatureRow>

        <FeatureRow
          eyebrow={dict.fr5Eyebrow}
          title={dict.fr5Title}
          body={dict.fr5Body}
          points={fr5Points}
        >
          <ConversationDemo channel="whatsapp" lang={lang} bubbles={fr5Bubbles} />
        </FeatureRow>
      </div>
    </section>

    <CtaInline title={dict.ctaInline1} lang={lang} />

    <!-- ══════════ CASO REAL · placeholder, reemplazar por testimonial propio ══════════ -->
    <section class="border-t border-line bg-paper">
      <div class="reveal mx-auto grid max-w-6xl items-center gap-14 px-5 py-24 md:grid-cols-[0.95fr_1.05fr]">
        <div>
          <p class="mb-3 text-sm font-semibold uppercase tracking-[0.14em] text-pine-dark">{dict.caseKicker}</p>
          <blockquote class="font-serif text-2xl font-black leading-snug text-ink text-balance md:text-3xl" set:html={dict.caseQuote} />
          <p class="mt-6 text-salvia">{dict.caseAttr}</p>
          <a href={L('/caso')} class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-pine-dark transition-colors hover:text-ink">
            {dict.caseLink} <span aria-hidden="true">→</span>
          </a>
        </div>
        <div>
          <img
            src="/img/vialaser-chart.jpg"
            width="1200"
            height="900"
            alt={dict.caseImgAlt}
            loading="lazy"
            decoding="async"
            class="w-full rounded-xl border border-line shadow-[0_10px_30px_-20px_rgba(20,38,31,0.28)]"
          />
        </div>
      </div>
    </section>

    <!-- ══════════ ASÍ SE VE EN TU PANEL · estados ══════════ -->
    <section class="border-t border-line">
      <div class="reveal mx-auto max-w-6xl px-5 py-24">
        <p class="mb-3 text-sm font-semibold uppercase tracking-[0.14em] text-pine-dark">{dict.panelKicker}</p>
        <h2 class="max-w-2xl font-serif text-3xl font-black leading-tight text-balance md:text-4xl" set:html={dict.panelH2} />
        <p class="mt-5 max-w-2xl text-lg text-salvia" set:html={dict.panelP} />
        <div class="mt-12 grid gap-6 md:grid-cols-2">
          {
            estados.map((e) => (
              <div class="flex items-start gap-4 rounded-xl border border-line bg-cream p-6">
                <span class="shrink-0 rounded-full border border-pine/20 bg-mint/[0.12] px-3 py-1.5 text-sm font-medium text-pine-dark">
                  {e.tag}
                </span>
                <p class="text-salvia">{e.desc}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <FeatureFaq items={faqs} lang={lang} />

    <CtaBand title={dict.ctaBandTitle} sub={dict.ctaBandSub} lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>
