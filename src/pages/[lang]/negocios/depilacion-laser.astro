    <section class="border-b border-line bg-paper">
      <div class="mx-auto grid max-w-6xl gap-8 px-5 py-10 sm:grid-cols-3">
        <div class="py-2">
          <p class="font-serif text-lg font-black text-ink">{mechanics[0].title}</p>
          <p class="mt-1 text-salvia">{mechanics[0].body}</p>
        </div>
        <div class="py-2 sm:border-l sm:border-line sm:pl-8">
          <p class="font-serif text-lg font-black text-ink">{mechanics[1].title}</p>
          <p class="mt-1 text-salvia">{mechanics[1].body}</p>
        </div>
        <div class="py-2 sm:border-l sm:border-line sm:pl-8">
          <p class="font-serif text-lg font-black text-ink">{mechanics[2].title}</p>
          <p class="mt-1 text-salvia">{mechanics[2].body}</p>
        </div>
      </div>
    </section>

    <!-- ══════════ CÓMO LO HACE SARA · conversación real ══════════ -->
    <section class="border-t border-line">
      <div class="reveal mx-auto grid max-w-6xl items-center gap-14 px-5 py-24 md:grid-cols-[1.05fr_0.95fr]">
        <div>
          <p class="mb-3 text-sm font-semibold uppercase tracking-[0.14em] text-pine-dark">{demo.eyebrow}</p>
          <h2 class="font-serif text-3xl font-black leading-tight text-balance md:text-4xl" set:html={demo.title} />
          <p class="mt-5 text-lg text-salvia" set:html={demo.p1} />
          <p class="mt-4 text-salvia" set:html={demo.p2} />
        </div>
        <div class="flex justify-center md:justify-end">
          <ConversationDemo
            lang={lang}
            channel="instagram"
            bubbles={demo.bubbles}
          />
        </div>
      </div>
    </section>

    <!-- ══════════ POR QUÉ EL LÁSER ES DISTINTO · 3 tiempos (banda oscura) ══════════ -->
    <section class="border-t border-line bg-ink text-cream">
      <div class="reveal mx-auto max-w-6xl px-5 py-24">
        <p class="mb-3 text-sm font-semibold uppercase tracking-[0.14em] text-mint">{why.eyebrow}</p>
        <h2 class="max-w-2xl font-serif text-3xl font-black leading-tight text-balance md:text-4xl" set:html={why.title} />
        <div class="mt-14 grid gap-x-10 gap-y-12 md:grid-cols-3">
          {
            steps.map((s) => (
              <div>
                <div class="flex items-center gap-4">
                  <span class="font-serif text-4xl font-black text-mint tabular-nums">{s.n}</span>
                  <span class="h-px flex-1 bg-cream/15" />
                </div>
                <h3 class="mt-5 text-xl font-semibold text-cream">{s.title}</h3>
                <p class="mt-2 text-cream/65">{s.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ══════════ CAPACIDADES · filas alternadas ══════════ -->
    <section class="border-t border-line">
      <div class="reveal mx-auto flex max-w-6xl flex-col gap-24 px-5 py-24">
        <FeatureRow
          eyebrow={features[0].eyebrow}
          title={features[0].title}
          body={features[0].body}
          points={features[0].points}
        >
          <ConversationDemo
            lang={lang}
            channel="whatsapp"
            bubbles={features[0].bubbles}
          />
        </FeatureRow>

        <FeatureRow
          flip
          eyebrow={features[1].eyebrow}
          title={features[1].title}
          body={features[1].body}
          points={features[1].points}
        >
          <ConversationDemo
            lang={lang}
            channel="whatsapp"
            bubbles={features[1].bubbles}
          />
        </FeatureRow>

        <FeatureRow
          eyebrow={features[2].eyebrow}
          title={features[2].title}
          body={features[2].body}
          points={features[2].points}
        >
          <ConversationDemo
            lang={lang}
            channel="whatsapp"
            bubbles={features[2].bubbles}
          />
        </FeatureRow>

        <FeatureRow
          flip
          eyebrow={features[3].eyebrow}
          title={features[3].title}
          body={features[3].body}
          points={features[3].points}
        >
          <ConversationDemo
            lang={lang}
            channel="whatsapp"
            bubbles={features[3].bubbles}
          />
        </FeatureRow>

        <FeatureRow
          eyebrow={features[4].eyebrow}
          title={features[4].title}
          body={features[4].body}
          points={features[4].points}
        >
          <ConversationDemo
            lang={lang}
            channel="whatsapp"
            bubbles={features[4].bubbles}
          />
        </FeatureRow>
      </div>
    </section>

    <CtaInline lang={lang} title={dict.ctaInline} />

    <!-- ══════════ CASO REAL · ViaLaser ══════════ -->
    <section class="border-t border-line bg-paper">
      <div class="reveal mx-auto grid max-w-6xl items-center gap-14 px-5 py-24 md:grid-cols-[0.95fr_1.05fr]">
        <div>
          <p class="mb-3 text-sm font-semibold uppercase tracking-[0.14em] text-pine-dark">{caso.eyebrow}</p>
          <blockquote class="font-serif text-2xl font-black leading-snug text-ink text-balance md:text-3xl" set:html={caso.quote} />
          <p class="mt-6 text-salvia">{caso.attribution}</p>
          <a href={L('/caso')} class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-pine-dark transition-colors hover:text-ink">
            {caso.link} <span aria-hidden="true">→</span>
          </a>
        </div>
        <div>
          <ResultsChart lang={lang} class="w-full max-w-full" />
        </div>
      </div>
    </section>

    <!-- ══════════ ASÍ SE VE EN TU PANEL · estados ══════════ -->
    <section class="border-t border-line">
      <div class="reveal mx-auto max-w-6xl px-5 py-24">
        <p class="mb-3 text-sm font-semibold uppercase tracking-[0.14em] text-pine-dark">{panel.eyebrow}</p>
        <h2 class="max-w-2xl font-serif text-3xl font-black leading-tight text-balance md:text-4xl" set:html={panel.title} />
        <p class="mt-5 max-w-2xl text-lg text-salvia" set:html={panel.lead} />
        <div class="mt-12 grid gap-6 md:grid-cols-2">
          {
            estados.map((e) => (
              <div class="flex items-start gap-4 rounded-xl border border-line bg-cream p-6">
                <span class="shrink-0 rounded-full border border-pine/20 bg-mint/[0.12] px-3 py-1.5 text-sm font-medium text-pine-dark">
                  {e.tag}
                </span>
                <p class="text-salvia">{e.desc}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <FeatureFaq items={faqs} lang={lang} />

    <CtaBand
      lang={lang}
      title={dict.ctaBand.title}
      sub={dict.ctaBand.sub}
    />
  </main>
  <Footer lang={lang} />
</Layout>
