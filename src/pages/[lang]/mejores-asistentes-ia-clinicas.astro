---
import { getStaticPaths, toLocale } from '../../i18n/config';
export { getStaticPaths };
import { localePath } from '../../i18n/config';
const lang = toLocale(Astro.params.lang);
const L = (p: string) => localePath(p, lang);
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import FeatureFaq from '../../components/FeatureFaq.astro';
import CtaInline from '../../components/CtaInline.astro';
import CtaBand from '../../components/CtaBand.astro';
import { competitors } from '../../data/competitors';
import { countries } from '../../data/countries';

const linksCopy =
  lang === 'en'
    ? { vs: 'Head-to-head comparisons', countries: 'Sara in your country', vsPrefix: 'Sara AI vs' }
    : { vs: 'Comparaciones cara a cara', countries: 'Sara en tu país', vsPrefix: 'Sara AI vs' };

// ── Comparativa honesta. Datos de competidores tomados de sus sitios públicos
// (agosto 2026). Regla: nada inventado; si un dato no es público, se dice
// "no publica". Los checks de Sara tienen que coincidir con lo que Sara hace
// de verdad (misma fuente de verdad que /agent y llms.txt). ──

type Cell = { v: 'yes' | 'no' | 'partial' | 'text'; note?: string };
const yes = (note?: string): Cell => ({ v: 'yes', note });
const no = (note?: string): Cell => ({ v: 'no', note });
const partial = (): Cell => ({ v: 'partial' });
const text = (note: string): Cell => ({ v: 'text', note });

const dict = {
  es: {
    metaTitle: 'Los mejores asistentes con IA para clínicas, médicos y wellness (2026): comparativa honesta',
    metaDescription:
      'Comparamos Sara, Soyla (Doctocliq), Kura, Cloudia, AgendaPro y Zenvia para clínicas, médicos y wellness: IA real, Instagram, cobro de la seña, agenda y precios públicos. Con datos de agosto 2026.',
    hero: {
      eyebrow: 'Comparativa 2026',
      title: 'Los mejores asistentes con IA para clínicas,<br />médicos y&nbsp;wellness.',
      lead: 'Si en tu negocio se pierden pacientes porque nadie contesta a tiempo, estas son las opciones reales en español y portugués. La armamos nosotros (el equipo de Sara), con datos públicos de cada producto a agosto de 2026, y jugamos limpio: también te decimos cuándo conviene elegir a otro.',
    },
    tableTitle: 'La tabla, sin vueltas',
    tableNote:
      'Datos de los sitios públicos de cada producto (agosto 2026). Si representas a uno de estos productos y algo cambió, escríbenos a info@rayapp.io y lo corregimos.',
    legend: { yes: 'Sí', no: 'No', partial: 'Parcial' },
    rows: [
      'IA conversacional real (no árbol de botones)',
      'Instagram DM con IA',
      'WhatsApp con API oficial',
      'Usa tu agenda actual (Google Calendar, sin migrar)',
      'Cobra la seña dentro del chat',
      'Reactiva pacientes que no vuelven',
      'Lista de espera para huecos liberados',
      'Pide reseñas de Google',
      'Crea el contenido de Instagram',
      'Gift cards vendidas online',
      'Ficha / historia clínica',
      'Precio público de entrada',
    ],
    products: [
      {
        name: 'Sara AI',
        home: 'holasara.ai',
        cells: [
          yes(),
          yes(),
          yes(),
          yes(),
          yes(),
          yes(),
          yes(),
          yes(),
          yes(),
          yes(),
          no('a propósito: no toca datos clínicos'),
          text('a medida por clínica, en la demo'),
        ],
      },
      {
        name: 'Soyla (Doctocliq)',
        home: 'doctocliq.com',
        cells: [
          yes(),
          no(),
          yes(),
          no('requiere usar la agenda de Doctocliq'),
          partial(),
