      'Creates your Instagram content',
      'Gift cards sold online',
      'Patient records / EHR',
      'Public entry price',
    ],
    products: [
      {
        name: 'Sara AI',
        home: 'holasara.ai',
        cells: [
          yes(),
          yes(),
          yes(),
          yes(),
          yes(),
          yes(),
          yes(),
          yes(),
          yes(),
          yes(),
          no('on purpose: it never touches clinical data'),
          text('tailored per clinic, shared in the demo'),
        ],
      },
      {
        name: 'Soyla (Doctocliq)',
        home: 'doctocliq.com',
        cells: [
          yes(),
          no(),
          yes(),
          no('requires using the Doctocliq calendar'),
          partial(),
          partial(),
          no(),
          no(),
          no(),
          no(),
          yes('dental charting, e-invoicing'),
          text('suite from US$19; Soyla apart'),
        ],
      },
      {
        name: 'Kura',
        home: 'getkura.ai',
        cells: [
          yes(),
          no(),
          yes(),
          no('own calendar; HIS only on Enterprise'),
          no(),
