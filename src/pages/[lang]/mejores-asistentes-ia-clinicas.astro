        a: 'Of the six compared, only Sara collects the deposit inside the chat before confirming the appointment. The others hand off to external links, charge when booking in their system, or do not charge at all. A paid deposit is what lowers no-shows the most.',
      },
      {
        q: 'How much does an AI assistant for clinics cost?',
        a: `Public prices as of August 2026 range from ~R$49-80 per month (Cloudia, flow-based with AI sold apart) to US$130 plus channel costs (Zenvia). Kura publishes €59.99 per professional per month. Sara doesn't publish pricing: the plan is built per clinic and shared in the demo, with the conversation, payment collection and marketing included.`,
      },
      {
        q: 'What about patient records?',
        a: 'Sara does not read or write patient records, on purpose: it handles the conversation, the booking and the payment. If digitizing records is your priority, solve that with clinical software like Doctocliq or AgendaPro; Sara coexists with them because it does not compete for your calendar.',
      },
    ],
  },
}[lang];

// JSON-LD: FAQPage con las mismas preguntas visibles (nunca contenido distinto al de la página).
const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: dict.faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

// Iconos: ✓ (incluido), − (parcial), ✗ (no). El label textual queda en sr-only.
const icon: Record<'yes' | 'no' | 'partial', { d: string; cls: string }> = {
  yes: { d: 'M4 10.5l4 4 8-9', cls: 'text-pine-dark' },
  no: { d: 'M5.5 5.5l9 9M14.5 5.5l-9 9', cls: 'text-salvia/35' },
  partial: { d: 'M5 10h10', cls: 'text-ink/45' },
};
---

<Layout lang={lang} title={dict.metaTitle} description={dict.metaDescription} schema={schema}>
  <Header lang={lang} />

  <PageHero lang={lang} eyebrow={dict.hero.eyebrow} title={dict.hero.title} lead={dict.hero.lead} />

  <!-- Tabla comparativa -->
  <section class="border-t border-line">
    <div class="reveal mx-auto max-w-6xl px-5 py-20">
      <h2 class="font-serif text-3xl font-black leading-tight text-balance md:text-4xl">{dict.tableTitle}</h2>
      <div class="mt-8 overflow-x-auto rounded-2xl border border-line">
        <table class="w-full min-w-[880px] border-collapse text-sm">
          <thead>
            <tr class="border-b border-line bg-mint/[0.07] text-left">
              <th class="px-4 py-3 font-semibold text-ink"></th>
              {
                dict.products.map((p, i) => (
                  <th class={`px-4 py-3 font-semibold whitespace-nowrap ${i === 0 ? 'text-pine-dark' : 'text-ink'}`}>
                    {p.name}
                    <span class="mt-0.5 block text-xs font-normal text-salvia">{p.home}</span>
                  </th>
                ))
              }
            </tr>
          </thead>
          <tbody class="divide-y divide-line">
            {
              dict.rows.map((row, r) => (
                <tr class={r % 2 ? 'bg-mint/[0.03]' : ''}>
                  <td class="max-w-[240px] px-4 py-3 font-medium text-ink">{row}</td>
                  {dict.products.map((p) => {
                    const c = p.cells[r];
                    return (
                      <td class="px-4 py-3 align-top">
                        {c.v === 'text' ? (
                          <span class="text-ink">{c.note}</span>
                        ) : (
                          <>
                            <svg class={`h-5 w-5 ${icon[c.v].cls}`} viewBox="0 0 20 20" fill="none" aria-hidden="true">
                              <path d={icon[c.v].d} stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                            <span class="sr-only">{dict.legend[c.v]}</span>
                            {c.v !== 'partial' && c.note && <span class="mt-1 block text-xs font-normal text-salvia">{c.note}</span>}
                          </>
                        )}
                      </td>
                    );
                  })}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-1 text-xs text-salvia">
        {(['yes', 'partial', 'no'] as const).map((k) => (
          <span class="inline-flex items-center gap-1.5">
            <svg class={`h-4 w-4 ${icon[k].cls}`} viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d={icon[k].d} stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            {dict.legend[k]}
          </span>
        ))}
      </p>
      <p class="mt-3 text-sm text-salvia">{dict.tableNote}</p>
    </div>
  </section>

  <CtaInline lang={lang} title={dict.ctaInline.title} cta={dict.ctaInline.cta} />

  <!-- Cuándo elegir cada uno -->
  <section class="border-t border-line">
    <div class="reveal mx-auto max-w-4xl px-5 py-20">
      <h2 class="font-serif text-3xl font-black leading-tight text-balance md:text-4xl" set:html={dict.versus.title} />
      <p class="mt-4 max-w-2xl text-lg text-salvia">{dict.versus.lead}</p>
      <div class="mt-10 grid gap-6 sm:grid-cols-2">
        {
          dict.versus.items.map((it, i) => (
            <div
              class={`rounded-2xl border p-6 ${i === dict.versus.items.length - 1 ? 'border-pine/30 bg-mint/[0.07] sm:col-span-2' : 'border-line'}`}
            >
              <h3 class="font-serif text-xl font-black text-ink">{it.name}</h3>
              <p class="mt-2 text-salvia">{it.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Links a los cara a cara y a las landings por país -->
  <section class="border-t border-line">
    <div class="reveal mx-auto max-w-4xl px-5 py-14">
      <div class="grid gap-8 sm:grid-cols-2">
        <div>
          <p class="mb-3 text-xs font-semibold uppercase tracking-[0.12em] text-salvia">{linksCopy.vs}</p>
          <ul class="flex flex-col gap-2">
            {
              competitors.map((c) => (
                <li>
                  <a href={L(`/sara-vs-${c.slug}`)} class="font-semibold text-pine-dark underline decoration-pine/30 underline-offset-4 transition-colors hover:decoration-pine">
                    {linksCopy.vsPrefix} {c.name}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <p class="mb-3 text-xs font-semibold uppercase tracking-[0.12em] text-salvia">{linksCopy.countries}</p>
          <ul class="flex flex-col gap-2">
            {
              countries.map((c) => (
                <li>
                  <a href={L(`/${c.slug}`)} class="font-semibold text-pine-dark underline decoration-pine/30 underline-offset-4 transition-colors hover:decoration-pine">
                    Sara AI · {c.name[lang]}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Prueba real -->
  <section class="border-t border-line">
    <div class="reveal mx-auto max-w-4xl px-5 py-20 text-center">
      <h2 class="font-serif text-3xl font-black leading-tight text-balance md:text-4xl" set:html={dict.proof.title} />
      <p class="mx-auto mt-4 max-w-2xl text-lg text-salvia">{dict.proof.body}</p>
      <a
        href={L('/caso')}
        class="mt-6 inline-block rounded-full border border-pine/30 px-6 py-3 font-semibold text-pine-dark transition-colors hover:bg-mint/20"
      >
        {dict.proof.cta}
      </a>
    </div>
  </section>

  <FeatureFaq lang={lang} items={dict.faq} />

  <CtaBand lang={lang} />
  <Footer lang={lang} />
</Layout>
