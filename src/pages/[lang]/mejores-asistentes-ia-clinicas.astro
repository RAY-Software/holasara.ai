          no(),
          no(),
          yes(),
          yes(),
          text('not published (~US$19-59 per third parties)'),
        ],
      },
      {
        name: 'Zenvia',
        home: 'zenvia.com',
        cells: [
          partial(),
          yes('channel available, no clinic focus'),
          yes('official Meta BSP'),
          no('no calendar: the clinic builds its own flows'),
          no('hands off to an external payment link'),
          partial(),
