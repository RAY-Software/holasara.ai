    alsoKicker: 'See also',
    also: [
      { href: '/seo-para-clinicas-de-estetica', label: 'Also for med spas' },
      { href: '/aeo', label: 'Show up in ChatGPT and AI search' },
      { href: '/negocios/odontologia', label: 'Sara for dental practices' },
    ],
    faqs: [
      { q: 'Does Mia replace my dental SEO agency?', a: "For what a practice needs every week, yes: a current Google Business Profile, articles that answer what patients search for, website metrics and reviews requested after every visit. What Mia doesn't do (link building, technical audits of your site's code) we say upfront. If you're paying an agency for that today, we compare it in the demo." },
      { q: 'What exactly does she do each week?', a: 'She checks how your profile showed up on Google and which pages on your site got visits, writes you a recap with two or three specific proposals (photos, a post, an article, a campaign if it makes sense) and, once you approve, runs them. The following week she tells you what each one brought.' },
      { q: 'Do I need a new website?', a: "No. Mia works on your current site and your Google Business Profile. If your practice doesn't have a website yet, we figure that out in the demo." },
      { q: 'How long until I see results?', a: "It depends on where your profile and your site start from. Google Business Profile changes usually show within weeks; content builds up over time. We don't promise rankings or timelines: what you do see, every Monday, is what Mia did and what it brought." },
      { q: 'Does she write and publish without my approval?', a: 'No. Mia proposes and prepares; you approve over chat. No article or post goes out without your ok, and you can ask for changes before it does.' },
      { q: 'Does she run Google Ads too?', a: 'Yes. When it makes sense (a slow week, a treatment you want to push), she proposes a Google Ads campaign with a budget and runs it once you approve. Same Mia.' },
      { q: 'How much does it cost?', a: "Pricing is built for each practice, depending on what the plan includes, and shared in the demo. It's a monthly subscription, with no fee per patient." },
    ],
  },
}[lang];

const { steps, estados, faqs, gbp, blog, tableRows, also } = dict;

// Path de estrella para la ficha de Google (5 estrellas llenas).
const star = 'M10 1.5l2.6 5.3 5.9.9-4.2 4.1 1 5.8L10 14.9l-5.3 2.7 1-5.8L1.5 7.7l5.9-.9z';
const gbpThumbs = ['/img/tenants/faceup.jpg', '/img/tenants/physiup.jpg', '/img/tenants/sorace.jpg'];
---

<Layout lang={lang} title={dict.metaTitle} description={dict.metaDescription}>
  <Header lang={lang} />
  <main>
    <PageHero
      lang={lang}
      eyebrow={dict.heroEyebrow}
      title={dict.heroTitle}
      lead={dict.heroLead}
      image="/img/hero/seo-dental-hero.jpg"
      imageAlt={dict.heroImageAlt}
      imageW={1024}
      imageH={768}
    />

    <!-- ══════════ TIRA DE MECÁNICA (no son stats: es lo que hace Mia) ══════════ -->
    <section class="border-b border-line bg-paper">
      <div class="mx-auto grid max-w-6xl gap-8 px-5 py-10 sm:grid-cols-3">
        <div class="py-2">
          <p class="font-serif text-lg font-black text-ink">{dict.strip[0].t}</p>
          <p class="mt-1 text-salvia">{dict.strip[0].b}</p>
        </div>
        <div class="py-2 sm:border-l sm:border-line sm:pl-8">
          <p class="font-serif text-lg font-black text-ink">{dict.strip[1].t}</p>
          <p class="mt-1 text-salvia">{dict.strip[1].b}</p>
        </div>
        <div class="py-2 sm:border-l sm:border-line sm:pl-8">
          <p class="font-serif text-lg font-black text-ink">{dict.strip[2].t}</p>
          <p class="mt-1 text-salvia">{dict.strip[2].b}</p>
        </div>
      </div>
    </section>

    <!-- ══════════ CÓMO LO HACE MIA · resumen semanal por WhatsApp ══════════ -->
    <section class="border-t border-line">
      <div class="reveal mx-auto grid max-w-6xl items-center gap-14 px-5 py-24 md:grid-cols-[1.05fr_0.95fr]">
        <div>
          <p class="mb-3 text-sm font-semibold uppercase tracking-[0.14em] text-pine-dark">{dict.howKicker}</p>
          <h2 class="font-serif text-3xl font-black leading-tight text-balance md:text-4xl" set:html={dict.howH2} />
          <p class="mt-5 text-lg text-salvia">
            {dict.howP1}
          </p>
          <p class="mt-4 text-salvia" set:html={dict.howP2} />
        </div>
        <div class="flex justify-center md:justify-end">
          <ConversationDemo
            lang={lang}
            channel="whatsapp"
            name="Mia"
            avatar="/equipo/mia-avatar.jpg"
            bubbles={dict.howBubbles}
          />
        </div>
      </div>
    </section>

    <!-- ══════════ CÓMO FUNCIONA · 3 tiempos (banda oscura) ══════════ -->
    <section class="border-t border-line bg-ink text-cream">
      <div class="reveal mx-auto max-w-6xl px-5 py-24">
        <h2 class="max-w-2xl font-serif text-3xl font-black leading-tight text-balance md:text-4xl" set:html={dict.stepsH2} />
        <div class="mt-14 grid gap-x-10 gap-y-12 md:grid-cols-3">
          {
            steps.map((s) => (
              <div>
                <div class="flex items-center gap-4">
                  <span class="font-serif text-4xl font-black text-mint tabular-nums">{s.n}</span>
                  <span class="h-px flex-1 bg-cream/15" />
                </div>
                <h3 class="mt-5 text-xl font-semibold text-cream">{s.title}</h3>
                <p class="mt-2 text-cream/65">{s.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ══════════ CAPACIDADES · filas alternadas (copy + visual) ══════════ -->
    <section class="border-t border-line">
      <div class="reveal mx-auto flex max-w-6xl flex-col gap-24 px-5 py-24">
        <!-- Fila 1 · Ficha de Google Business (tarjeta estilo ficha, solo HTML/Tailwind) -->
        <div id="google-business-profile">
          <FeatureRow
            eyebrow={dict.row1Eyebrow}
            title={dict.row1Title}
            body={dict.row1Body}
            points={dict.row1Points}
          >
            <div class="w-full max-w-sm rounded-2xl border border-line bg-white p-5 shadow-[0_12px_34px_-20px_rgba(20,38,31,0.32)]">
              <div class="flex items-start gap-3">
                <img src="/img/logos/google.svg" alt="" width="24" height="24" class="mt-0.5 h-6 w-6 shrink-0" loading="lazy" decoding="async" />
                <div class="min-w-0">
                  <p class="truncate font-semibold text-ink">{gbp.name}</p>
                  <div class="mt-0.5 flex items-center gap-1.5 text-sm">
                    <span class="font-semibold text-ink">{gbp.rating}</span>
                    <span class="flex items-center gap-px" aria-hidden="true">
                      {[0, 1, 2, 3, 4].map(() => (
                        <svg viewBox="0 0 20 20" class="h-3.5 w-3.5 fill-[#fbbc05]"><path d={star} /></svg>
                      ))}
                    </span>
                    <span class="text-salvia">{gbp.reviews}</span>
                  </div>
                  <p class="mt-0.5 text-xs text-salvia">
                    {gbp.type} · <span class="font-medium text-pine">{gbp.open}</span> · {gbp.closes}
                  </p>
                </div>
              </div>
              <div class="mt-4 grid grid-cols-3 gap-2">
                {
                  [gbp.call, gbp.directions, gbp.site].map((label, i) => (
                    <span class="flex items-center justify-center gap-1.5 rounded-full border border-line bg-white px-2 py-1.5 text-xs font-medium text-[#1a73e8]">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5 shrink-0" aria-hidden="true">
                        {i === 0 && <path d="M6.6 10.8a15 15 0 006.6 6.6l2.2-2.2a1 1 0 011-.24 11 11 0 003.5.56 1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.2.2 2.4.56 3.5a1 1 0 01-.24 1l-2.2 2.3z" />}
                        {i === 1 && <path d="M12 21s-6-5.3-6-10a6 6 0 0112 0c0 4.7-6 10-6 10zM12 11.5a1.5 1.5 0 100-3 1.5 1.5 0 000 3z" />}
                        {i === 2 && <path d="M12 3a9 9 0 100 18 9 9 0 000-18zM3 12h18M12 3c2.5 2.7 3.8 5.7 3.8 9s-1.3 6.3-3.8 9c-2.5-2.7-3.8-5.7-3.8-9S9.5 5.7 12 3z" />}
                      </svg>
                      <span class="truncate">{label}</span>
                    </span>
                  ))
                }
              </div>
              <div class="mt-4 grid grid-cols-3 gap-1.5">
                {
                  gbpThumbs.map((src) => (
                    <img src={src} alt="" width="96" height="72" class="aspect-[4/3] w-full rounded-lg object-cover" loading="lazy" decoding="async" />
                  ))
                }
              </div>
              <div class="mt-4 rounded-xl border border-pine/20 bg-mint/[0.08] p-3">
                <div class="flex items-center justify-between gap-2">
                  <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-pine-dark">
                    <span class="dot h-2 w-2"></span>{gbp.updated}
                  </span>
                  <span class="text-[11px] text-salvia">{gbp.updatedWhen}</span>
                </div>
                <ul class="mt-2 flex flex-wrap gap-x-3 gap-y-1 text-xs text-ink">
                  {gbp.bullets.map((b) => <li class="flex items-center gap-1"><span class="h-1 w-1 rounded-full bg-pine"></span>{b}</li>)}
                </ul>
              </div>
            </div>
          </FeatureRow>
        </div>

        <!-- Fila 2 · Contenido que responde (tarjeta de blog, estilo de las pieces de Mia) -->
        <FeatureRow
          flip
          eyebrow={dict.row2Eyebrow}
          title={dict.row2Title}
          body={dict.row2Body}
          points={dict.row2Points}
        >
          <div class="w-full max-w-sm overflow-hidden rounded-2xl border border-line bg-white shadow-[0_12px_34px_-20px_rgba(20,38,31,0.32)]">
            <img src="/img/mia/blog.jpg" alt="" width="640" height="360" class="aspect-[16/9] w-full object-cover" loading="lazy" decoding="async" />
            <div class="p-5">
              <p class="text-[10px] font-semibold uppercase tracking-[0.1em] text-salvia">{blog.kind}</p>
              <p class="mt-1.5 font-serif text-lg font-black leading-snug text-ink">{blog.title}</p>
              <p class="mt-2 text-sm text-salvia">{blog.body}</p>
              <div class="mt-4 flex flex-wrap items-center justify-between gap-2 border-t border-line pt-4">
                <span class="inline-flex items-center gap-1.5 rounded-full border border-line bg-paper px-2.5 py-1 text-xs font-semibold text-pine-dark">
                  <span class="dot h-2 w-2"></span>{blog.status}
                </span>
                <span class="text-[11px] text-salvia">{blog.by}</span>
              </div>
            </div>
          </div>
        </FeatureRow>

        <!-- Fila 3 · Agencia de SEO dental vs Mia (tabla a lo ancho, sin números) -->
        <div id="dental-seo-agency-vs-mia" class="flex flex-col gap-10">
          <div class="mx-auto max-w-2xl text-center">
            <p class="mb-3 text-sm font-semibold uppercase tracking-[0.14em] text-pine-dark">{dict.row3Eyebrow}</p>
            <h3 class="font-serif text-2xl font-black leading-tight text-balance md:text-3xl" set:html={dict.row3Title} />
            <p class="mt-4 text-lg text-salvia">{dict.row3Body}</p>
          </div>
          <div class="overflow-x-auto rounded-2xl border border-line bg-white">
            <table class="w-full min-w-[640px] border-collapse text-sm">
              <thead>
                <tr class="border-b border-line bg-paper text-left">
                  <th class="w-[26%] px-5 py-4"></th>
                  <th class="whitespace-nowrap px-5 py-4 font-semibold text-ink">{dict.tableAgency}</th>
                  <th class="whitespace-nowrap bg-mint/[0.08] px-5 py-4 font-semibold text-pine-dark">{dict.tableMia}</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-line">
                {
                  tableRows.map((r) => (
                    <tr>
                      <td class="px-5 py-4 align-top font-medium text-ink">{r.label}</td>
                      <td class="px-5 py-4 align-top text-salvia">{r.agency}</td>
                      <td class="bg-mint/[0.05] px-5 py-4 align-top text-ink" set:html={r.mia} />
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </div>

        <!-- Fila 4 · Reseñas: Sara la pide después de cada cita -->
        <FeatureRow
          flip
          eyebrow={dict.row4Eyebrow}
          title={dict.row4Title}
          body={dict.row4Body}
          points={dict.row4Points}
        >
          <ConversationDemo
            lang={lang}
            channel="whatsapp"
            bubbles={dict.row4Bubbles}
          />
        </FeatureRow>

        <!-- Fila 5 · Del clic a la cita: Sara agenda y cobra el anticipo -->
        <FeatureRow
          eyebrow={dict.row5Eyebrow}
          title={dict.row5Title}
          body={dict.row5Body}
          points={dict.row5Points}
        >
          <ConversationDemo
            lang={lang}
            channel="whatsapp"
            bubbles={dict.row5Bubbles}
          />
        </FeatureRow>
      </div>
    </section>

    <CtaInline title={dict.ctaInline} lang={lang} />

    <!-- ══════════ ASÍ SE VE EN TU PANEL · estados ══════════ -->
    <section class="border-t border-line bg-paper">
      <div class="reveal mx-auto max-w-6xl px-5 py-24">
        <p class="mb-3 text-sm font-semibold uppercase tracking-[0.14em] text-pine-dark">{dict.panelKicker}</p>
        <h2 class="max-w-2xl font-serif text-3xl font-black leading-tight text-balance md:text-4xl" set:html={dict.panelH2} />
        <p class="mt-5 max-w-2xl text-lg text-salvia" set:html={dict.panelLead} />
        <div class="mt-12 grid gap-6 md:grid-cols-2">
          {
            estados.map((e) => (
              <div class="flex items-start gap-4 rounded-xl border border-line bg-cream p-6">
                <span class="shrink-0 rounded-full border border-pine/20 bg-mint/[0.12] px-3 py-1.5 text-sm font-medium text-pine-dark">
                  {e.tag}
                </span>
                <p class="text-salvia">{e.desc}</p>
              </div>
            ))
          }
        </div>
        <p class="mt-12 flex flex-wrap items-center gap-x-2 gap-y-2 text-sm text-salvia">
          <span class="font-semibold uppercase tracking-[0.12em] text-pine-dark">{dict.alsoKicker}</span>
          {
            also.map((l, i) => (
              <>
                {i > 0 && <span aria-hidden="true">·</span>}
                <a href={L(l.href)} class="font-semibold text-pine-dark underline decoration-pine/30 underline-offset-4 transition-colors hover:decoration-pine">{l.label}</a>
              </>
            ))
          }
        </p>
      </div>
    </section>

    <FeatureFaq items={faqs} lang={lang} />

    <CtaBand lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>
