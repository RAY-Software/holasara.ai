---
import { getStaticPaths, toLocale } from '../../i18n/config';
export { getStaticPaths };
const lang = toLocale(Astro.params.lang);
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import InstagramShowcase from '../../components/mocks/InstagramShowcase.astro';
import ResultsChart from '../../components/mocks/ResultsChart.astro';
import IgPost from '../../components/mocks/IgPost.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import FeatureRow from '../../components/FeatureRow.astro';
import ConversationDemo from '../../components/ConversationDemo.astro';
import FeatureFaq from '../../components/FeatureFaq.astro';
import CtaInline from '../../components/CtaInline.astro';
import CtaBand from '../../components/CtaBand.astro';

// ── Copy por idioma. EN es traducción, no calco. ──
const dict = {
  es: {
    metaTitle: 'Instagram con IA · Sara también lleva tu Instagram',
    metaDescription:
      'Sara crea las publicaciones de tu clínica con tu marca, atiende a quien responde hasta agendar y te dice cada mes qué post trajo consultas. Del post a la cita cobrada.',
    heroEyebrow: 'Marketing · Instagram con IA',
    heroTitle: "Que cada publicación termine en una cita, <em class='text-pine-dark'>no en un like.</em>",
    heroLead:
      'Sara crea las publicaciones de tu clínica, atiende a quien responde hasta agendar y te dice qué funcionó. Tu marketing y tu agenda, por fin conectados.',
    heroImageAlt: 'Flat lay con un teléfono mostrando un feed de Instagram de clínica, una cámara y flores de salvia.',
    strip: [
      { t: 'Crea las publicaciones', b: 'Texto, imagen y calendario, con la marca de tu clínica.' },
      { t: 'Atiende a quien responde', b: 'Comentarios y mensajes, hasta dejar la cita agendada.' },
      { t: 'Te dice qué funcionó', b: 'Qué post trajo consultas y cuánto facturaste.' },
    ],
    howKicker: 'Cómo lo hace Sara',
    howH2: 'Del post a la cita, sin que el interés se&nbsp;enfríe.',
    howP:
      'La mayoría de las clínicas publica y ahí muere: el que comenta queda sin respuesta. Sara conecta la publicación con la conversación, y la conversación con la&nbsp;agenda.',
    flow: [
      { img: '/img/tenants/faceup.jpg', likes: '312', caption: '<b>clinicaaurora</b> Ácido hialurónico en labios: qué esperar la primera semana ✨', step: '1 · Sara publica', body: 'Una publicación de tu clínica sale en Instagram, con tu marca.' },
      { img: '/img/tenants/physiup.jpg', likes: '208', caption: '<b>clinicaaurora</b> Desliza para ver el paso a paso 👉', comment: '<b>camifer_</b> ¿Cuánto sale la valoración?', step: '2 · Alguien responde', body: 'Comenta o escribe, y Sara lo atiende al instante.' },
      { img: '/img/tenants/sorace.jpg', likes: '176', caption: '<b>clinicaaurora</b> Te escribimos por mensaje ahora mismo 💬', step: '3 · Reserva y paga', body: 'Agenda la cita y deja la seña. Confirmada.' },
    ],
    row1Eyebrow: 'Contenido',
    row1Title: "Publicaciones listas para salir, <em class='text-pine-dark'>con tu marca.</em>",
    row1Body:
      'Sara escribe el texto, elige la imagen y arma el calendario del mes con la identidad de tu clínica. Tú solo apruebas. Se acabó el “esta semana no publiqué nada”.',
    row1Points: [
      'Texto, imagen y calendario, hechos',
      'Con tu logo, tus colores y tu tono',
      'Nada sale sin tu aprobación',
    ],
    row1ImgAlt: 'Feed de Instagram de una clínica generado con IA: publicaciones con la marca, listas para salir.',
    row2Eyebrow: 'Del comentario a la cita',
    row2Title: "Al que responde, <em class='text-pine-dark'>lo agenda.</em>",
    row2Body:
      'Cuando alguien comenta o escribe por una publicación, Sara le responde por mensaje directo, sigue la conversación en privado y la lleva hasta la reserva. El interés que generó tu contenido no se pierde.',
    row2Points: [
      'Responde comentarios por mensaje directo',
      'Atiende, informa y propone una cita',
      'Del post a la reserva, sin cortar el hilo',
    ],
    row2Bubbles: [
      { who: 'out', text: '¡Hola! Vi tu comentario en la publicación 🙌 Te escribo por aquí. ¿Qué zona te interesa?', t: '19:40' },
      { who: 'in', text: 'La verdad me interesa el tratamiento del video', t: '19:52' },
      { who: 'out', text: '¡Genial! Es ideal para eso. Tenemos una primera sesión de prueba sin costo para que lo conozcas. ¿Te agendo?', t: '19:52' },
    ],
    row3Eyebrow: 'Con números claros',
    row3Title: "Y sabes qué post <em class='text-pine-dark'>trajo pacientes.</em>",
    row3Body:
      'Cada mes, en español claro: qué publicación generó más consultas y cuánto se facturó a partir de ahí. Dejas de publicar a ciegas y de medir por likes.',
    row3Points: [
      'Qué post trajo más consultas',
      'Cuánto facturaste a partir de cada uno',
      'En el panel, sin planillas',
    ],
    row3ImgAlt: 'Panel con las consultas y el valor generado por canal, incluida la actividad de Instagram.',
    ctaInline: 'Que cada publicación termine en una cita, no en un&nbsp;like.',
    faqs: [
      { q: '¿Sara publica sola o apruebo yo?', a: 'Sara prepara el texto, la imagen y el calendario. Apruebas antes de que salga; nada se publica sin tu ok.' },
      { q: '¿Usa la marca de mi clínica?', a: 'Sí. Las publicaciones salen con tu identidad: tu logo, tus colores y el tono de tu clínica.' },
      { q: '¿Qué pasa con los comentarios y mensajes?', a: 'Sara los atiende. A quien comenta o escribe por una publicación, lo lleva de la conversación hasta la cita agendada.' },
      { q: '¿Puedo saber qué publicación funcionó?', a: 'Cada mes tienes, en español claro, qué post trajo más consultas y cuánto se facturó. Sin planillas.' },
    ],
  },
  en: {
    metaTitle: 'AI Instagram · Sara runs your Instagram too',
    metaDescription:
      "Sara creates your clinic's posts with your brand, answers whoever responds all the way to booking, and tells you each month which post brought enquiries. From post to paid appointment.",
    heroEyebrow: 'Marketing · AI Instagram',
    heroTitle: "Make every post end in an appointment, <em class='text-pine-dark'>not a like.</em>",
    heroLead:
      "Sara creates your clinic's posts, answers whoever responds all the way to booking, and tells you what worked. Your marketing and your calendar, finally connected.",
    heroImageAlt: "Flat lay with a phone showing a clinic's Instagram feed, a camera and sage flowers.",
    strip: [
      { t: 'Creates the posts', b: "Copy, image and calendar, with your clinic's brand." },
      { t: 'Answers whoever responds', b: 'Comments and messages, all the way to a booked appointment.' },
      { t: 'Tells you what worked', b: 'Which post brought enquiries and how much you billed.' },
    ],
    howKicker: 'How Sara does it',
    howH2: 'From post to appointment, before the interest&nbsp;cools.',
    howP:
      "Most clinics post and that's where it dies: whoever comments gets no reply. Sara connects the post to the conversation, and the conversation to the&nbsp;calendar.",
    flow: [
      { img: '/img/tenants/faceup.jpg', likes: '312', caption: '<b>clinicaaurora</b> Lip hyaluronic acid: what to expect in week one ✨', step: '1 · Sara posts', body: 'A post from your clinic goes live on Instagram, with your brand.' },
      { img: '/img/tenants/physiup.jpg', likes: '208', caption: '<b>clinicaaurora</b> Swipe to see the step by step 👉', comment: '<b>camifer_</b> How much is the assessment?', step: '2 · Someone replies', body: 'They comment or message, and Sara answers instantly.' },
      { img: '/img/tenants/sorace.jpg', likes: '176', caption: '<b>clinicaaurora</b> We’re messaging you right now 💬', step: '3 · They book and pay', body: 'She books the appointment and takes the deposit. Confirmed.' },
    ],
    row1Eyebrow: 'Content',
    row1Title: "Posts ready to publish, <em class='text-pine-dark'>with your brand.</em>",
    row1Body:
      "Sara writes the copy, picks the image and builds the month's calendar with your clinic's identity. You just approve. No more “I didn't post anything this week.”",
    row1Points: [
      'Copy, image and calendar, done',
      'With your logo, your colors and your tone',
      'Nothing goes out without your approval',
    ],
    row1ImgAlt: "A clinic's AI-generated Instagram feed: on-brand posts, ready to publish.",
    row2Eyebrow: 'From comment to appointment',
    row2Title: "Whoever responds, <em class='text-pine-dark'>she books.</em>",
    row2Body:
      "When someone comments or messages a post, Sara replies via direct message, continues the conversation in private and carries it to a booking. The interest your content sparked doesn't get lost.",
    row2Points: [
      'Answers comments via direct message',
      'Responds, informs and proposes an appointment',
      'From post to booking, without breaking the thread',
    ],
    row2Bubbles: [
      { who: 'out', text: "Hi! I saw your comment on the post 🙌 I'm reaching out here. Which area are you interested in?", t: '7:40 pm' },
      { who: 'in', text: "Honestly I'm interested in the treatment from the video", t: '7:52 pm' },
      { who: 'out', text: "Great! It's perfect for that. We have a free trial session so you can get to know it. Want me to book you in?", t: '7:52 pm' },
    ],
    row3Eyebrow: 'With clear numbers',
    row3Title: "And you know which post <em class='text-pine-dark'>brought patients.</em>",
    row3Body:
      'Every month, in plain English: which post generated the most enquiries and how much it billed from there. You stop posting blind and measuring by likes.',
    row3Points: [
      'Which post brought the most enquiries',
      'How much you billed from each one',
      'In the dashboard, no spreadsheets',
    ],
    row3ImgAlt: 'Dashboard with enquiries and the value generated by channel, including Instagram activity.',
    ctaInline: 'Make every post end in an appointment, not a&nbsp;like.',
    faqs: [
      { q: 'Does Sara post on her own or do I approve?', a: 'Sara prepares the copy, the image and the calendar. You approve before it goes out; nothing is published without your ok.' },
      { q: "Does she use my clinic's brand?", a: "Yes. The posts go out with your identity: your logo, your colors and your clinic's tone." },
      { q: 'What happens with comments and messages?', a: 'Sara handles them. Whoever comments or messages a post, she takes from the conversation to a booked appointment.' },
      { q: 'Can I find out which post worked?', a: 'Every month you get, in plain English, which post brought the most enquiries and how much it billed. No spreadsheets.' },
    ],
  },
}[lang];

const { flow, faqs } = dict;
---

<Layout lang={lang}
  title={dict.metaTitle}
  description={dict.metaDescription}
>
  <Header lang={lang} />
  <main>
    <PageHero
      lang={lang}
      eyebrow={dict.heroEyebrow}
      title={dict.heroTitle}
      lead={dict.heroLead}
      image="/img/hero/instagram-hero.jpg"
      imageAlt={dict.heroImageAlt}
      imageW={1200}
      imageH={900}
    />

    <!-- ══════════ TIRA DE MECÁNICA ══════════ -->
    <section class="border-b border-line bg-paper">
      <div class="mx-auto grid max-w-6xl gap-8 px-5 py-10 sm:grid-cols-3">
        <div class="py-2">
          <p class="font-serif text-lg font-black text-ink">{dict.strip[0].t}</p>
          <p class="mt-1 text-salvia">{dict.strip[0].b}</p>
        </div>
        <div class="py-2 sm:border-l sm:border-line sm:pl-8">
          <p class="font-serif text-lg font-black text-ink">{dict.strip[1].t}</p>
          <p class="mt-1 text-salvia">{dict.strip[1].b}</p>
        </div>
        <div class="py-2 sm:border-l sm:border-line sm:pl-8">
          <p class="font-serif text-lg font-black text-ink">{dict.strip[2].t}</p>
          <p class="mt-1 text-salvia">{dict.strip[2].b}</p>
        </div>
      </div>
    </section>

    <!-- ══════════ CÓMO LO HACE SARA · del post a la cita ══════════ -->
    <section class="border-t border-line">
      <div class="reveal mx-auto max-w-6xl px-5 py-24">
        <p class="mb-3 text-sm font-semibold uppercase tracking-[0.14em] text-pine-dark">{dict.howKicker}</p>
        <h2 class="max-w-2xl font-serif text-3xl font-black leading-tight text-balance md:text-4xl" set:html={dict.howH2} />
        <p class="mt-5 max-w-2xl text-lg text-salvia" set:html={dict.howP} />
        <div class="mt-12 grid gap-6 sm:grid-cols-3">
          {
            flow.map((p) => (
              <div>
                <IgPost lang={lang} img={p.img} caption={p.caption} likes={p.likes} comment={p.comment} />
                <p class="mt-3 font-serif text-lg font-bold">{p.step}</p>
                <p class="text-salvia">{p.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ══════════ CAPACIDADES ══════════ -->
    <section class="border-t border-line">
      <div class="reveal mx-auto flex max-w-6xl flex-col gap-24 px-5 py-24">
        <div class="flex flex-col gap-12">
          <div class="mx-auto max-w-2xl text-center">
            <p class="mb-3 text-sm font-semibold uppercase tracking-[0.14em] text-pine-dark">
              {dict.row1Eyebrow}
            </p>
            <h3
              class="font-serif text-2xl font-black leading-tight text-balance md:text-3xl"
              set:html={dict.row1Title}
            />
            <p class="mt-4 text-lg text-salvia">{dict.row1Body}</p>
          </div>
          <InstagramShowcase lang={lang} class="w-full" />
        </div>

        <FeatureRow
          flip
          eyebrow={dict.row2Eyebrow}
          title={dict.row2Title}
          body={dict.row2Body}
          points={dict.row2Points}
        >
          <ConversationDemo
            lang={lang}
            channel="instagram"
            bubbles={dict.row2Bubbles}
          />
        </FeatureRow>

        <FeatureRow
          eyebrow={dict.row3Eyebrow}
          title={dict.row3Title}
          body={dict.row3Body}
          points={dict.row3Points}
        >
          <ResultsChart lang={lang} class="w-full max-w-full" />
        </FeatureRow>
      </div>
    </section>

    <CtaInline title={dict.ctaInline} lang={lang} />

    <FeatureFaq items={faqs} lang={lang} />

    <CtaBand lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>
