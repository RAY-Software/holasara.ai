---
import { getStaticPaths, toLocale } from '../../i18n/config';
export { getStaticPaths };
const lang = toLocale(Astro.params.lang);
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import AgendaPanel from '../../components/mocks/AgendaPanel.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import FeatureRow from '../../components/FeatureRow.astro';
import ConversationDemo from '../../components/ConversationDemo.astro';
import FeatureFaq from '../../components/FeatureFaq.astro';
import CtaInline from '../../components/CtaInline.astro';
import CtaBand from '../../components/CtaBand.astro';

// ── Copy por idioma. EN es traducción, no calco. ──
const dict = {
  es: {
    metaTitle: 'Reseñas · Sara',
    metaDescription:
      'Sara pide la reseña en el momento justo, con el link directo a tu Google, y registra quién hizo clic. Más reseñas de 5 estrellas, mejor reputación y más pacientes nuevos.',
    heroEyebrow: 'Marketing · Reseñas',
    heroTitle: "Más reseñas de 5 estrellas, <em class='text-pine-dark'>sin que las pidas.</em>",
    heroLead:
      'La reseña que hoy deja un paciente es la que mañana convence al próximo. Sara la pide en el momento justo, con el link directo a Google, y registra quién respondió.',
    heroImageAlt: 'Una paciente contenta mira cinco estrellas en su teléfono, en una clínica luminosa.',
    strip: [
      { t: 'En el momento justo', b: 'Después de la cita, cuando el paciente está contento.' },
      { t: 'Un solo clic', b: 'Link directo a tu Google. Sin buscar, sin fricción.' },
      { t: 'Con seguimiento', b: 'Sabes a quién se la pidió y quién hizo clic.' },
    ],
    comoKicker: 'Cómo lo hace Sara',
    comoH2: 'De una buena cita a una buena&nbsp;reseña.',
    comoLead:
      'La mayoría de los pacientes contentos nunca deja una reseña, no porque no quiera, sino porque nadie se la pide en el momento justo ni le facilita el paso. Sara hace las dos&nbsp;cosas.',
    demo1: [
      { who: 'out', text: 'Hola, Juan! ¿Cómo estuvo tu sesión? Si quedaste conforme, nos ayudarías un montón con una reseña en Google 🙏', t: '17:30' },
      { who: 'out', text: 'Te dejo el link directo, es un solo clic 👉 g.page/tu-clinica', t: '17:30' },
      { who: 'in', text: 'Listo, ya la dejé ⭐️⭐️⭐️⭐️⭐️', t: '20:04' },
      { who: 'out', text: '¡Mil gracias, Juan! Nos ayuda muchísimo 🙌', t: '20:04' },
    ],
    tiemposH2: 'La reputación deja de depender de la&nbsp;suerte.',
    steps: [
      { n: '01', title: 'Termina la cita', body: 'El paciente se va contento con su tratamiento.' },
      { n: '02', title: 'Sara pide la reseña', body: 'Un mensaje amable por WhatsApp, en la ventana en que sí responden, con el link directo a tu Google.' },
      { n: '03', title: 'Sube tu reputación', body: 'Más reseñas reales, mejor posición en Google y más pacientes nuevos que llegan solos.' },
    ],
    row1Eyebrow: 'Con seguimiento',
    row1Title: "Sabes a quién se la pidió <em class='text-pine-dark'>y quién hizo clic.</em>",
    row1Body:
      'No es un mensaje al vacío. Sara registra a quién le pidió la reseña y quién abrió el link. En el panel ves el ciclo completo, sin planillas ni adivinanzas.',
    row1Points: [
      'Reseña pedida, marcada por paciente',
      'Clic en el link, registrado',
      'El ciclo completo, en el panel',
    ],
    row1ImgAlt: 'Panel donde cada paciente muestra si se le pidió la reseña y si hizo clic en el link.',
    row2Eyebrow: 'Cierra el círculo',
    row2Title: "La reseña de hoy <em class='text-pine-dark'>trae al paciente de mañana.</em>",
    row2Body:
      'Más reseñas de 5 estrellas te hacen aparecer mejor en Google y le dan confianza a quien todavía no te eligió. Y ese próximo paciente también entra por Sara, que lo atiende y lo agenda.',
    row2Points: [
      'Mejor posición en tu búsqueda local',
      'Más confianza para el que aún no te conoce',
      'Y Sara atiende a ese nuevo paciente',
    ],
    demo2: [
      { who: 'in', text: 'Hola! Vi que tienen muy buenas reseñas 🙌 ¿hacen depilación de piernas?', t: '12:10' },
      { who: 'out', text: '¡Hola! Gracias 😊 Sí, hacemos piernas enteras. El pack de 6 sesiones está $6,900 y la primera es de prueba. ¿Te agendo?', t: '12:10' },
      { who: 'in', text: 'Sí, perfecto', t: '12:11' },
    ],
    ctaInline: 'Que cada paciente feliz deje una reseña&nbsp;nueva.',
    faqs: [
      { q: '¿Cuándo pide la reseña?', a: 'Después de la cita, en la ventana donde el paciente está más receptivo. El momento se ajusta a tu flujo.' },
      { q: '¿A dónde van las reseñas?', a: 'A tu ficha de Google Business, que es la que ve todo el que te busca. Sara deja el link directo para que sea un solo clic.' },
      { q: '¿Sara escribe las reseñas?', a: 'No. Las reseñas las escribe cada paciente, con su experiencia real. Sara solo se ocupa de pedirlas en el momento justo y facilitar el paso.' },
      { q: '¿Sabe quién dejó la reseña?', a: 'Sara registra a quién le pidió la reseña y quién hizo clic en el link. Ves el ciclo completo en el panel, sin planillas.' },
      { q: '¿Sirve para el SEO local?', a: 'Sí. Un flujo constante de reseñas nuevas y de buena calificación ayuda a que tu clínica aparezca mejor en las búsquedas de tu zona.' },
    ],
  },
  en: {
    metaTitle: 'Reviews · Sara',
    metaDescription:
      'Sara asks for the review at just the right time, with a direct link to your Google, and tracks who clicked. More 5-star reviews, a better reputation and more new patients.',
    heroEyebrow: 'Marketing · Reviews',
    heroTitle: "More 5-star reviews, <em class='text-pine-dark'>without you asking.</em>",
    heroLead:
      'The review a patient leaves today is what convinces the next one tomorrow. Sara asks for it at just the right time, with a direct link to Google, and tracks who responded.',
    heroImageAlt: 'A happy patient looks at five stars on her phone, in a bright clinic.',
    strip: [
      { t: 'At just the right time', b: 'After the appointment, when the patient is happy.' },
      { t: 'One single click', b: 'Direct link to your Google. No searching, no friction.' },
      { t: 'With tracking', b: 'You know who was asked and who clicked.' },
    ],
    comoKicker: 'How Sara does it',
    comoH2: 'From a good appointment to a good&nbsp;review.',
    comoLead:
      "Most happy patients never leave a review, not because they don't want to, but because no one asks at the right time or makes it easy. Sara does both&nbsp;things.",
    demo1: [
      { who: 'out', text: 'Hi Juan! How was your session? If you were happy with it, a Google review would help us a lot 🙏', t: '17:30' },
      { who: 'out', text: "Here's the direct link, it's just one click 👉 g.page/your-clinic", t: '17:30' },
      { who: 'in', text: 'Done, I already left it ⭐️⭐️⭐️⭐️⭐️', t: '20:04' },
      { who: 'out', text: 'Thank you so much, Juan! It helps us a ton 🙌', t: '20:04' },
    ],
    tiemposH2: 'Your reputation stops depending on&nbsp;luck.',
    steps: [
      { n: '01', title: 'The appointment ends', body: 'The patient leaves happy with their treatment.' },
      { n: '02', title: 'Sara asks for the review', body: 'A friendly WhatsApp message, in the window when they do reply, with the direct link to your Google.' },
      { n: '03', title: 'Your reputation climbs', body: 'More real reviews, a better spot on Google and more new patients who arrive on their own.' },
    ],
    row1Eyebrow: 'With tracking',
    row1Title: "You know who was asked <em class='text-pine-dark'>and who clicked.</em>",
    row1Body:
      "It's not a message into the void. Sara records who she asked for a review and who opened the link. In the dashboard you see the full cycle, with no spreadsheets or guesswork.",
    row1Points: [
      'Review request, marked per patient',
      'Link click, recorded',
      'The full cycle, in the dashboard',
    ],
    row1ImgAlt: 'A dashboard where each patient shows whether the review was requested and whether they clicked the link.',
    row2Eyebrow: 'Closes the loop',
    row2Title: "Today's review <em class='text-pine-dark'>brings tomorrow's patient.</em>",
    row2Body:
      "More 5-star reviews make you show up better on Google and build trust with whoever hasn't chosen you yet. And that next patient also comes in through Sara, who answers and books them.",
    row2Points: [
      'A better spot in your local search',
      "More trust for those who don't know you yet",
      'And Sara answers that new patient',
    ],
    demo2: [
      { who: 'in', text: 'Hi! I saw you have really good reviews 🙌 do you do leg hair removal?', t: '12:10' },
      { who: 'out', text: 'Hi! Thank you 😊 Yes, we do full legs. The 6-session pack is $6,900 and the first one is a trial. Shall I book you in?', t: '12:10' },
      { who: 'in', text: 'Yes, perfect', t: '12:11' },
    ],
    ctaInline: 'Turn every happy patient into a new&nbsp;review.',
    faqs: [
      { q: 'When does it ask for the review?', a: 'After the appointment, in the window when the patient is most receptive. The timing adjusts to your flow.' },
      { q: 'Where do the reviews go?', a: "To your Google Business profile, the one everyone who searches for you sees. Sara provides the direct link so it's a single click." },
      { q: 'Does Sara write the reviews?', a: 'No. Each patient writes their own review, from their real experience. Sara only takes care of asking at the right time and making the step easy.' },
      { q: 'Does it know who left the review?', a: 'Sara records who she asked for a review and who clicked the link. You see the full cycle in the dashboard, with no spreadsheets.' },
      { q: 'Does it help with local SEO?', a: 'Yes. A steady flow of new, well-rated reviews helps your clinic show up better in searches in your area.' },
    ],
  },
}[lang];

const { steps, faqs } = dict;
---

<Layout lang={lang}
  title={dict.metaTitle}
  description={dict.metaDescription}
>
  <Header lang={lang} />
  <main>
    <PageHero
      eyebrow={dict.heroEyebrow}
      title={dict.heroTitle}
      lead={dict.heroLead}
      image="/img/hero/resenas-hero.jpg"
      imageAlt={dict.heroImageAlt}
      imageW={1200}
      imageH={900}
      lang={lang}
    />

    <!-- ══════════ TIRA DE MECÁNICA ══════════ -->
    <section class="border-b border-line bg-paper">
      <div class="mx-auto grid max-w-6xl gap-8 px-5 py-10 sm:grid-cols-3">
        <div class="py-2">
          <p class="font-serif text-lg font-black text-ink">{dict.strip[0].t}</p>
          <p class="mt-1 text-salvia">{dict.strip[0].b}</p>
        </div>
        <div class="py-2 sm:border-l sm:border-line sm:pl-8">
          <p class="font-serif text-lg font-black text-ink">{dict.strip[1].t}</p>
          <p class="mt-1 text-salvia">{dict.strip[1].b}</p>
        </div>
        <div class="py-2 sm:border-l sm:border-line sm:pl-8">
          <p class="font-serif text-lg font-black text-ink">{dict.strip[2].t}</p>
          <p class="mt-1 text-salvia">{dict.strip[2].b}</p>
        </div>
      </div>
    </section>

    <!-- ══════════ CÓMO LO HACE SARA ══════════ -->
    <section class="border-t border-line">
      <div class="reveal mx-auto grid max-w-6xl items-center gap-14 px-5 py-24 md:grid-cols-[1.05fr_0.95fr]">
        <div>
          <p class="mb-3 text-sm font-semibold uppercase tracking-[0.14em] text-pine-dark">{dict.comoKicker}</p>
          <h2 class="font-serif text-3xl font-black leading-tight text-balance md:text-4xl" set:html={dict.comoH2} />
          <p class="mt-5 text-lg text-salvia" set:html={dict.comoLead} />
        </div>
        <div class="flex justify-center md:justify-end">
          <ConversationDemo
            channel="whatsapp"
            bubbles={dict.demo1}
            lang={lang}
          />
        </div>
      </div>
    </section>

    <!-- ══════════ CÓMO FUNCIONA · 3 tiempos ══════════ -->
    <section class="border-t border-line bg-ink text-cream">
      <div class="reveal mx-auto max-w-6xl px-5 py-24">
        <h2 class="max-w-2xl font-serif text-3xl font-black leading-tight text-balance md:text-4xl" set:html={dict.tiemposH2} />
        <div class="mt-14 grid gap-x-10 gap-y-12 md:grid-cols-3">
          {
            steps.map((s) => (
              <div>
                <div class="flex items-center gap-4">
                  <span class="font-serif text-4xl font-black text-mint tabular-nums">{s.n}</span>
                  <span class="h-px flex-1 bg-cream/15" />
                </div>
                <h3 class="mt-5 text-xl font-semibold text-cream">{s.title}</h3>
                <p class="mt-2 text-cream/65">{s.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ══════════ CAPACIDADES ══════════ -->
    <section class="border-t border-line">
      <div class="reveal mx-auto flex max-w-6xl flex-col gap-24 px-5 py-24">
        <FeatureRow
          eyebrow={dict.row1Eyebrow}
          title={dict.row1Title}
          body={dict.row1Body}
          points={dict.row1Points}
        >
          <AgendaPanel lang={lang} class="w-full" />
        </FeatureRow>

        <FeatureRow
          flip
          eyebrow={dict.row2Eyebrow}
          title={dict.row2Title}
          body={dict.row2Body}
          points={dict.row2Points}
        >
          <ConversationDemo
            channel="whatsapp"
            bubbles={dict.demo2}
            lang={lang}
          />
        </FeatureRow>
      </div>
    </section>

    <CtaInline title={dict.ctaInline} lang={lang} />

    <FeatureFaq items={faqs} lang={lang} />

    <CtaBand lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>
