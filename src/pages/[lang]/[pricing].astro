      { n: '0', label: 'per-booking fees' },
    ],
    teamKicker: 'Your AI team',
    teamH2: 'Three agents. <em class="text-pine-dark">You start with Sara.</em>',
    teamLead:
      'Sara is the way in and the only must-have. Mia and Daniel join when you need them, on the same account.',
    team: [
      {
        tag: 'Front desk',
        name: 'Sara',
        body: 'Answers on WhatsApp and Instagram, quotes prices, books the appointment and collects the deposit. Reminds, confirms and reschedules on her own.',
        price: fmt(SARA_BASE),
        unit: 'USD / calendar',
        featured: true,
      },
      {
        tag: 'Marketing',
        name: 'Mia',
        body: 'Brings the ideas, builds the pieces in your brand, posts on Instagram and fills the gaps in the calendar. Measures in appointments, not likes.',
        price: fmt(ADDON),
        unit: 'USD flat',
        featured: false,
      },
      {
        tag: 'Bookkeeping',
        name: 'Daniel',
        body: 'Closes the month, tells you the margin and catches the deposits that went uncollected. When money is pending, he hands it to Sara.',
