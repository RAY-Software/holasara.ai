---
import { localizedStaticPaths, toLocale, localePath } from '../../i18n/config';
// Slug localizado: /es/precios ↔ /en/pricing (src/i18n/slugs.ts).
export function getStaticPaths() {
  return localizedStaticPaths('pricing');
}
const lang = toLocale(Astro.params.lang);
const L = (p: string) => localePath(p, lang);
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FeatureFaq from '../../components/FeatureFaq.astro';
import CtaBand from '../../components/CtaBand.astro';
import ClientsStrip from '../../components/ClientsStrip.astro';
import { whatsappLink, whatsappText } from '../../lib/whatsapp';
import {
  BASE_PRICE,
  ADDONS,
  CATEGORY_ORDER,
  CALENDAR_TIERS,
  ANNUAL_MONTHS_CHARGED,
  accountTotal,
  amount,
  symbol,
  withSymbol,
  fmt,
  type Currency,
  type Category,
} from '../../data/pricing';

// /es es el mercado mexicano (precios en MXN); /en es el sitio de producto US (USD).
const currency: Currency = lang === 'en' ? 'USD' : 'MXN';
const sym = symbol(currency);

// Datos para la calculadora (client-side, una sola moneda). Precomputamos el total de la
// cuenta (plan base + calendarios extra) por cada nº de agendas, así el JS solo indexa.
const CALC_MAX = 20;
const DEFAULT_N = 3;
const ACCOUNT_TOTALS = Array.from({ length: CALC_MAX }, (_, i) => accountTotal(i + 1, currency));
const calcData = { totals: ACCOUNT_TOTALS, base: amount(BASE_PRICE, currency), sym, max: CALC_MAX };
const defaultTotal = ACCOUNT_TOTALS[DEFAULT_N - 1];
const defaultPer = Math.round(defaultTotal / DEFAULT_N);

// Precios de los tramos de calendario extra, en la moneda de la página (para la nota).
const calT = CALENDAR_TIERS.map((t) => sym + fmt(amount(t.price, currency)));

// ── Copy por idioma. EN es inglés nativo del producto US (canal SMS, no WhatsApp). ──
const dict = {
  es: {
    metaTitle: 'Precios · Sara',
    metaDescription:
      'Entra al precio de una agenda: plan base de $499 al mes con Sara. Suma solo lo que uses. Sin comisión por cita.',
    heroBadge: 'Sin llamada de ventas',
    heroTitle: 'Precios claros,<br />sin sorpresas.',
    heroLead1: 'Entras al precio de una agenda simple.',
    heroLead2: 'Sumas un equipo de trabajo solo cuando lo necesitas.',
    ctaStart: 'Empezar ahora',
    ctaTalk: 'Habla con Sara',
    ctaSub: 'Pon a Sara a atender, agendar y cobrar hoy mismo. Sin cambiar tu agenda ni tu forma de trabajar.',
    stats: [
      { n: withSymbol(BASE_PRICE, currency), label: 'plan base al mes' },
      { n: '0', label: 'comisión por cita' },
      { n: '7 días', label: 'gratis, sin tarjeta' },
    ],
    // Plan base + calculadora
    baseKicker: 'Plan base',
    baseH2: 'Empieza con Sara y una agenda.',
    baseLead:
      'Una agenda es un calendario reservable. El plan base incluye una; sumas más cuando entra otro profesional.',
    baseName: '1 agenda + Sara',
    baseUnit: 'MXN al mes, sin IVA',
    baseIncludes: [
      'Atención 24/7 en WhatsApp y web',
      'Agenda y agendamiento automático',
      'Recordatorios y recuperación de no-shows',
      'Cobro del anticipo en línea',
      'Sitio de reservas propio',
      'Sin permanencia y 7 días gratis',
    ],
    calResult: 'Tu cuenta, por mes',
    calAgendas: '¿Cuántas agendas?',
    calPerLabel: 'Costo por agenda',
    calNote: `Cada agenda extra cuesta ${calT[0]}, y baja a ${calT[1]} desde la 5ª y ${calT[2]} desde la 10ª.`,
    billMonthly: 'Mensual',
    billAnnual: 'Anual',
    billSave: '2 meses gratis',
    billAnnualNote: 'facturado anual',
    // Tres unidades
    unitsKicker: 'Cómo se cobran los add-ons',
    unitsH2: 'Tres formas de cobrar. Una sola regla.',
    unitsRule:
      'Lo que pasa dentro de cada local se cobra por local. Lo que es de toda la marca se paga una sola vez.',
    unitCards: [
      { tag: 'Por agenda', body: 'Cada profesional que atiende en paralelo suma su propia agenda. Es la unidad del plan base.' },
      { tag: 'Por local', body: 'Caja, inventario y la reseña de Google viven en el mostrador de cada sucursal, así que se cobran en cada una.' },
      { tag: 'Por marca', body: 'La web, el Instagram, la contabilidad, la voz y la API son de toda la clínica: una sola vez, tengas un local o mil.' },
    ],
    // Catálogo
    catKicker: 'Catálogo',
    catH2: 'Todo lo que Sara puede sumar.',
    catLead: 'Suma solo lo que uses. Al pagar anual, dos meses salen gratis en todo.',
    perMonth: 'al mes',
    units: { agenda: 'Por agenda', local: 'Por local', marca: 'Por marca' },
    categories: {
      capacidad: { name: 'Capacidad', sub: 'Más agendas y voz' },
      operacion: { name: 'Operación', sub: 'El mostrador de cada local' },
      crecimiento: { name: 'Crecimiento', sub: 'Que te encuentren y vuelvan' },
      dinero: { name: 'Dinero', sub: 'Cierra el mes y cobra antes' },
    } as Record<Category, { name: string; sub: string }>,
    addons: {
      voz: { name: 'Sara Voz: teléfono y SMS', desc: 'Contesta el teléfono hablando, agenda en la misma llamada y confirma por SMS. 300 minutos al mes incluidos.' },
      caja: { name: 'Caja y punto de venta', desc: 'Cobra en mostrador con efectivo, tarjeta o link de pago, y suma productos a la cuenta del tratamiento.' },
      inventario: { name: 'Inventario', desc: 'Descuenta el stock cada vez que se aplica un producto y te avisa antes de que se acabe.' },
      instagram: { name: 'Instagram con IA', desc: 'Propone, crea y publica el post, el reel y el blog con tu marca. Y agenda a quien comenta o pregunta.' },
      seo: { name: 'SEO y AEO', desc: 'Trabaja para que tu clínica aparezca en Google y para que ChatGPT te nombre cuando preguntan a dónde ir.' },
      resenas: { name: 'Reseñas en Google', desc: 'Le pide la reseña al paciente en el momento justo. Si llega una mala, te avisa a ti primero.' },
      soporte: { name: 'Soporte dedicado', desc: 'Un ejecutivo asignado, atención prioritaria y una revisión periódica de cómo va tu operación.' },
      api: { name: 'API e integraciones', desc: 'Conecta Sara con tu facturación, contabilidad o el ERP de la cadena. Los datos viajan solos.' },
      finanzas: { name: 'Finanzas y contabilidad', desc: 'Cierra el mes por ti: cuánto entró, cuánto te quedó y qué anticipos faltan por cobrar.' },
      giftcards: { name: 'Gift cards', desc: 'Vende tarjetas de regalo que tus pacientes compran en línea y canjean en la clínica.' },
    } as Record<string, { name: string; desc: string }>,
    faqTitle: 'Lo que suelen preguntar.',
    faqs: [
      { q: '¿Qué incluye el plan base?', a: 'Sara atendiendo, agendando y cobrando 24/7 en una agenda, con recordatorios, sitio de reservas y cobro del anticipo. Los add-ons son opcionales.' },
      { q: '¿Qué cuenta como una agenda?', a: 'Un calendario reservable. Si dos profesionales comparten el mismo calendario, es una sola agenda.' },
      { q: '¿Por qué unos add-ons se cobran por local y otros por marca?', a: 'Caja, inventario y la reseña de Google trabajan en el mostrador de cada local, así que se cobran ahí. La web, el Instagram o la contabilidad son de toda la clínica: se pagan una sola vez.' },
      { q: '¿Pago más por tener varias sucursales?', a: 'La agenda y Sara nunca se cobran por sucursal. Solo pagas por local los add-ons que trabajan en cada mostrador.' },
      { q: '¿Hay comisión por cita o por paciente nuevo?', a: 'No. Es una suscripción mensual, sin comisión por cita ni por paciente. El único consumo aparte son los minutos de voz.' },
      { q: '¿Toca mi historia clínica?', a: 'No. No se almacena historia clínica ni información médica. Eso queda donde está hoy.' },
    ],
  },
  en: {
    metaTitle: 'Pricing · Sara',
    metaDescription:
      'Start at the price of one calendar: a $29 base plan with Sara. Add only what you use. No per-booking fees.',
    heroBadge: 'No sales call',
    heroTitle: 'Clear pricing,<br />no surprises.',
    heroLead1: 'You start at the price of a simple calendar.',
    heroLead2: 'You add a working team only when you need one.',
    ctaStart: 'Start now',
    ctaTalk: 'Talk to Sara',
    ctaSub: 'Put Sara on your front desk today. Without changing how you work.',
    stats: [
      { n: withSymbol(BASE_PRICE, currency), label: 'base plan per month' },
      { n: '0', label: 'per-booking fees' },
      { n: '7 days', label: 'free, no card' },
    ],
    baseKicker: 'Base plan',
    baseH2: 'Start with Sara and one calendar.',
    baseLead:
      'A calendar is one bookable schedule. The base plan includes one; you add more when another provider comes on.',
    baseName: '1 calendar + Sara',
    baseUnit: 'USD per month',
    baseIncludes: [
      '24/7 answering on SMS and web',
      'Calendar and automatic booking',
      'Reminders and no-show recovery',
      'Online deposit collection',
      'Your own booking site',
      'No lock-in and a 7-day free trial',
    ],
    calResult: 'Your account, per month',
    calAgendas: 'How many calendars?',
    calPerLabel: 'Cost per calendar',
    calNote: `Each extra calendar is ${calT[0]}, dropping to ${calT[1]} from the 5th and ${calT[2]} from the 10th.`,
    billMonthly: 'Monthly',
    billAnnual: 'Annual',
    billSave: '2 months free',
    billAnnualNote: 'billed annually',
    unitsKicker: 'How add-ons are billed',
    unitsH2: 'Three ways to bill. One rule.',
    unitsRule:
      'What happens inside each location is billed per location. What belongs to the whole brand is paid once.',
    unitCards: [
      { tag: 'Per calendar', body: 'Every provider working in parallel adds their own calendar. It is the unit of the base plan.' },
      { tag: 'Per location', body: 'Register, inventory and the Google review live at each location’s counter, so they are billed at each one.' },
      { tag: 'Per account', body: 'The website, Instagram, accounting, voice and API belong to the whole clinic: once, whether you run one location or a thousand.' },
    ],
    catKicker: 'Catalog',
    catH2: 'Everything Sara can add.',
    catLead: 'Add only what you use. Pay annually and two months are free on everything.',
    perMonth: 'per month',
    units: { agenda: 'Per calendar', local: 'Per location', marca: 'Per account' },
    categories: {
      capacidad: { name: 'Capacity', sub: 'More calendars and voice' },
      operacion: { name: 'Operations', sub: 'Each location’s counter' },
      crecimiento: { name: 'Growth', sub: 'Get found and bring them back' },
      dinero: { name: 'Money', sub: 'Close the month, collect sooner' },
    } as Record<Category, { name: string; sub: string }>,
    addons: {
      voz: { name: 'Sara Voice: phone and SMS', desc: 'Answers the phone out loud, books on the call and confirms by text. 300 minutes a month included.' },
      caja: { name: 'Register and point of sale', desc: 'Takes payment at the counter with cash, card or pay link, and adds products to the visit total.' },
      inventario: { name: 'Inventory', desc: 'Draws down stock every time a product is used and warns you before you run out.' },
      instagram: { name: 'Instagram with AI', desc: 'Drafts, creates and posts the reel, post and blog in your brand. And books whoever comments or asks.' },
      seo: { name: 'SEO and AEO', desc: 'Works so your practice shows up on Google, and so ChatGPT names you when people ask where to go.' },
      resenas: { name: 'Google reviews', desc: 'Asks the patient for a review at the right moment. If a bad one comes in, it warns you first.' },
      soporte: { name: 'Dedicated support', desc: 'A named account manager, priority support and a regular review of how your operation is doing.' },
      api: { name: 'API and integrations', desc: 'Connects Sara to your billing, accounting or the chain’s ERP. Data moves on its own.' },
      finanzas: { name: 'Finance and accounting', desc: 'Closes the month for you: what came in, what you kept and which deposits are still owed.' },
      giftcards: { name: 'Gift cards', desc: 'Sell gift cards your patients buy online and redeem in the clinic.' },
    } as Record<string, { name: string; desc: string }>,
    faqTitle: 'What people usually ask.',
    faqs: [
      { q: 'What does the base plan include?', a: 'Sara answering, booking and collecting 24/7 on one calendar, with reminders, a booking site and deposit collection. Add-ons are optional.' },
      { q: 'What counts as one calendar?', a: 'A bookable calendar. If two providers share the same calendar, it is a single calendar.' },
      { q: 'Why are some add-ons billed per location and others per account?', a: 'Register, inventory and the Google review work at each location’s counter, so they are billed there. The website, Instagram or accounting belong to the whole clinic and are paid once.' },
      { q: 'Do I pay more for several locations?', a: 'The calendar and Sara are never billed per location. You only pay per location for the add-ons that work at each counter.' },
      { q: 'Is there a per-booking or per-patient fee?', a: 'No. It is a monthly subscription, with no per-booking or per-patient fee. The only metered use is voice minutes.' },
      { q: 'Does it touch my medical records?', a: 'No. No medical records or clinical information are stored. That stays where it is today.' },
    ],
  },
}[lang];

const { unitCards, faqs } = dict;
---

<Layout ogImage={`/og/pricing-${lang}.jpg`} lang={lang} title={dict.metaTitle} description={dict.metaDescription}>
  <Header lang={lang} />
  <main>
    <!-- ══════════ HERO (banda oscura) ══════════ -->
    <section class="border-b border-line-dark bg-ink text-cream">
      <div class="mx-auto max-w-5xl px-5 pb-16 pt-14">
        <a href={L('/')} class="inline-flex items-center gap-1.5 text-sm font-medium text-cream/60 transition-colors hover:text-cream">
          <span aria-hidden="true">←</span> {lang === 'en' ? 'Back to home' : 'Volver al inicio'}
        </a>

        <div class="mt-10 text-center">
          <p class="mb-6 inline-flex items-center gap-2.5 rounded-full border border-cream/20 px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.14em] text-cream/85">
            <span class="h-1.5 w-1.5 rounded-full bg-mint"></span>{dict.heroBadge}
          </p>
          <h1 class="mx-auto max-w-3xl font-serif text-5xl font-black leading-[1.04] tracking-tight text-balance md:text-6xl" set:html={dict.heroTitle} />
          <div class="mx-auto mt-7 max-w-2xl space-y-1 text-lg text-cream/75 md:text-xl">
            <p>{dict.heroLead1}</p>
            <p>{dict.heroLead2}</p>
          </div>
          <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
            <a
              href={L('/free-trial')}
              class="inline-flex items-center gap-2 rounded-full bg-mint px-7 py-3.5 text-base font-semibold text-ink transition-opacity hover:opacity-90"
            >
              {dict.ctaStart}
            </a>
            <a
              href={whatsappLink(whatsappText(lang))}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-2 rounded-full border border-cream/30 px-7 py-3.5 text-base font-semibold text-cream transition-colors hover:bg-cream/10"
            >
              {dict.ctaTalk}
            </a>
          </div>

          <!-- Stats -->
          <div class="mx-auto mt-14 grid max-w-xl grid-cols-3 gap-6 border-t border-cream/12 pt-8">
            {
              dict.stats.map((s) => (
                <div>
                  <p class="font-serif text-3xl font-black text-cream tabular-nums md:text-4xl">{s.n}</p>
                  <p class="mt-1.5 text-sm text-cream/60">{s.label}</p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════ PLAN BASE + CALCULADORA ══════════ -->
    <section class="border-b border-line bg-paper">
      <div class="reveal mx-auto max-w-6xl px-5 py-24">
        <p class="mb-3 text-sm font-semibold uppercase tracking-[0.14em] text-pine-dark">{dict.baseKicker}</p>
        <h2 class="max-w-2xl font-serif text-3xl font-black leading-tight text-balance md:text-4xl">{dict.baseH2}</h2>
        <p class="mt-5 max-w-2xl text-lg text-salvia">{dict.baseLead}</p>

        <!-- Toggle mensual / anual -->
        <div
          class="mt-8 inline-flex items-center gap-1 rounded-full border border-line bg-cream p-1"
          role="group"
          aria-label={`${dict.billMonthly} / ${dict.billAnnual}`}
        >
          <button type="button" data-billing="monthly" aria-pressed="true" class="bill-btn">{dict.billMonthly}</button>
          <button type="button" data-billing="annual" aria-pressed="false" class="bill-btn">
            {dict.billAnnual}
            <span class="bill-save">{dict.billSave}</span>
          </button>
        </div>

        <div class="mt-8 grid gap-5 lg:grid-cols-2">
          <!-- Card del plan base -->
          <div class="flex flex-col rounded-2xl border border-pine/50 bg-cream p-7 shadow-[0_16px_44px_-24px_rgba(20,38,31,0.4)]">
            <div class="flex items-center gap-3">
              <span class="h-11 w-11 shrink-0 overflow-hidden rounded-full border border-line bg-cream">
                <img src="/equipo/sara-avatar.jpg" alt="Sara" width="44" height="44" class="h-full w-full object-cover object-top" loading="lazy" decoding="async" />
              </span>
              <p class="font-serif text-xl font-black text-ink">{dict.baseName}</p>
            </div>
            <p class="mt-5 flex items-baseline gap-2">
              <span class="font-serif text-5xl font-black text-ink tabular-nums">
                <span class="text-3xl align-top">{sym}</span><span data-price data-monthly={calcData.base}>{fmt(calcData.base)}</span>
              </span>
              <s class="font-serif text-xl font-black text-salvia/50 tabular-nums" data-price-was hidden></s>
            </p>
            <p class="mt-0.5 text-sm text-salvia">
              {dict.baseUnit}<span class="text-pine-dark" data-annual-note hidden> · {dict.billAnnualNote}</span>
            </p>
            <ul class="mt-6 flex-1 space-y-2.5 text-sm text-ink">
              {
                dict.baseIncludes.map((f) => (
                  <li class="flex items-start gap-2.5">
                    <svg class="mt-0.5 h-4 w-4 shrink-0 text-pine" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                      <path d="M4 10.5 8 14.5 16 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    <span>{f}</span>
                  </li>
                ))
              }
            </ul>
            <a
              href={L('/free-trial')}
              class="mt-6 inline-flex items-center justify-center rounded-full bg-pine px-5 py-2.5 text-sm font-semibold text-cream transition-colors hover:bg-pine-dark"
            >
              {dict.ctaStart}
            </a>
          </div>

          <!-- Calculadora (plan base + calendarios) -->
          <div class="flex flex-col justify-between rounded-2xl border border-line bg-cream p-7" data-calc>
            <div>
              <div class="flex items-baseline justify-between gap-4">
                <label for="calc-agendas" class="text-sm font-semibold text-pine-dark">{dict.calAgendas}</label>
                <span class="font-serif text-4xl font-black text-ink tabular-nums" data-calc-n>{DEFAULT_N}</span>
              </div>
              <input
                id="calc-agendas"
                type="range"
                min="1"
                max={calcData.max}
                value={DEFAULT_N}
                step="1"
                class="mt-4 h-2 w-full cursor-pointer appearance-none rounded-full bg-line accent-pine"
                data-calc-range
                data-unit={dict.calAgendas}
                aria-label={dict.calAgendas}
                aria-valuetext={`${DEFAULT_N}`}
              />
              <div class="mt-1.5 flex justify-between text-xs text-salvia tabular-nums">
                <span>1</span><span>{calcData.max}</span>
              </div>
              <p class="mt-4 text-xs leading-relaxed text-salvia">{dict.calNote}</p>
            </div>

            <!-- Resultado -->
            <div class="mt-6 rounded-xl bg-ink p-6 text-cream">
              <p class="text-xs font-semibold uppercase tracking-[0.12em] text-cream/60">{dict.calResult}</p>
              <p class="mt-2 flex flex-wrap items-baseline gap-x-2 gap-y-1">
                <span class="font-serif text-5xl font-black tabular-nums">
                  <span class="text-3xl align-top">{sym}</span><span data-calc-total>{fmt(defaultTotal)}</span>
                </span>
                <s class="font-serif text-2xl font-black text-cream/40 tabular-nums" data-calc-total-was hidden></s>
                <span class="text-cream/70" data-annual-note hidden>· {dict.billAnnualNote}</span>
              </p>
              <p class="mt-5 flex items-center justify-between gap-4 border-t border-cream/15 pt-4 text-sm text-cream/70">
                <span>{dict.calPerLabel}</span>
                <span class="font-semibold text-cream tabular-nums">{sym}<span data-calc-per>{fmt(defaultPer)}</span></span>
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════ TRES UNIDADES · una regla ══════════ -->
    <section class="border-b border-line">
      <div class="reveal mx-auto max-w-6xl px-5 py-24">
        <p class="mb-3 text-sm font-semibold uppercase tracking-[0.14em] text-pine-dark">{dict.unitsKicker}</p>
        <h2 class="max-w-2xl font-serif text-3xl font-black leading-tight text-balance md:text-4xl">{dict.unitsH2}</h2>
        <p class="mt-5 max-w-2xl text-lg text-salvia">{dict.unitsRule}</p>

        <div class="mt-12 grid gap-4 sm:gap-5 md:grid-cols-3">
          {
            unitCards.map((u) => (
              <div class="rounded-2xl border border-line bg-paper p-6">
                <span class="inline-flex rounded-full bg-mint/[0.14] px-3 py-1 text-xs font-semibold uppercase tracking-[0.1em] text-pine-dark">
                  {u.tag}
                </span>
                <p class="mt-4 text-salvia">{u.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ══════════ CATÁLOGO DE ADD-ONS ══════════ -->
    <section class="border-b border-line bg-paper">
      <div class="reveal mx-auto max-w-6xl px-5 py-24">
        <p class="mb-3 text-sm font-semibold uppercase tracking-[0.14em] text-pine-dark">{dict.catKicker}</p>
        <h2 class="max-w-2xl font-serif text-3xl font-black leading-tight text-balance md:text-4xl">{dict.catH2}</h2>
        <p class="mt-5 max-w-2xl text-lg text-salvia">{dict.catLead}</p>

        <div class="mt-12 space-y-14">
          {
            CATEGORY_ORDER.map((cat: Category) => (
              <div>
                <div class="flex items-baseline gap-3 border-b border-line pb-3">
                  <h3 class="font-serif text-xl font-black text-ink">{dict.categories[cat].name}</h3>
                  <span class="text-sm text-salvia">{dict.categories[cat].sub}</span>
                </div>
                <div class="mt-6 grid gap-4 sm:gap-5 md:grid-cols-2">
                  {ADDONS.filter((a) => a.category === cat).map((a) => (
                    <div class="flex flex-col rounded-2xl border border-line bg-cream p-6">
                      <div class="flex items-start justify-between gap-4">
                        <p class="font-serif text-lg font-black text-ink">{dict.addons[a.id].name}</p>
                        <span class="shrink-0 rounded-full bg-mint/[0.14] px-2.5 py-1 text-xs font-semibold text-pine-dark">
                          {dict.units[a.unit]}
                        </span>
                      </div>
                      <p class="mt-3 flex-1 text-sm leading-relaxed text-salvia">{dict.addons[a.id].desc}</p>
                      <p class="mt-4 flex items-baseline gap-1.5 border-t border-line pt-4">
                        <span class="font-serif text-2xl font-black text-ink tabular-nums">{withSymbol(a.price, currency)}</span>
                        <span class="text-sm text-salvia">{dict.perMonth}</span>
                      </p>
                    </div>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <ClientsStrip lang={lang} />

    <FeatureFaq items={faqs} lang={lang} title={dict.faqTitle} />

    <CtaBand lang={lang} sub={dict.ctaSub} />
  </main>
  <Footer lang={lang} />
</Layout>

<style>
  input[type='range'][data-calc-range] {
    outline-offset: 4px;
  }
  input[type='range'][data-calc-range]::-webkit-slider-runnable-track {
    height: 8px;
    border-radius: 9999px;
  }
  input[type='range'][data-calc-range]::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 22px;
    height: 22px;
    margin-top: -7px;
    border-radius: 9999px;
    background: var(--color-pine);
    border: 3px solid #fff;
    box-shadow: 0 1px 4px rgba(20, 38, 31, 0.3);
    cursor: pointer;
  }
  input[type='range'][data-calc-range]::-moz-range-track {
    height: 8px;
    border-radius: 9999px;
    background: var(--color-line);
  }
  input[type='range'][data-calc-range]::-moz-range-thumb {
    width: 22px;
    height: 22px;
    border: 3px solid #fff;
    border-radius: 9999px;
    background: var(--color-pine);
    box-shadow: 0 1px 4px rgba(20, 38, 31, 0.3);
    cursor: pointer;
  }

  .bill-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    border-radius: 9999px;
    padding: 0.5rem 1.1rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-salvia);
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  .bill-btn[aria-pressed='true'] {
    background: var(--color-ink);
    color: var(--color-cream);
  }
  .bill-save {
    border-radius: 9999px;
    background: color-mix(in srgb, var(--color-mint) 22%, transparent);
    padding: 0.1rem 0.5rem;
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--color-pine-dark);
    white-space: nowrap;
  }
  .bill-btn[aria-pressed='true'] .bill-save {
    background: color-mix(in srgb, var(--color-mint) 88%, transparent);
    color: var(--color-ink);
  }
</style>

<script is:inline define:vars={{ calcData, annualCharged: ANNUAL_MONTHS_CHARGED }}>
  (function () {
    var nf = new Intl.NumberFormat('en-US');
    // 'monthly' | 'annual'. En anual el precio mensual equivalente lleva el descuento.
    var billing = 'monthly';
    function withBilling(m) {
      return billing === 'annual' ? Math.round((m * annualCharged) / 12) : m;
    }

    // ── Toggle de facturación: precio del plan base (card) + tachado ──
    var billBtns = document.querySelectorAll('[data-billing]');
    var priceEls = document.querySelectorAll('[data-price][data-monthly]');
    var annualNotes = document.querySelectorAll('[data-annual-note]');

    function renderPrices() {
      priceEls.forEach(function (el) {
        var m = parseInt(el.getAttribute('data-monthly'), 10);
        var was = el.closest('p') && el.closest('p').querySelector('[data-price-was]');
        el.textContent = nf.format(withBilling(m));
        if (was) {
          if (billing === 'annual') {
            was.textContent = nf.format(m);
            was.hidden = false;
          } else {
            was.hidden = true;
          }
        }
      });
      annualNotes.forEach(function (n) {
        n.hidden = billing !== 'annual';
      });
    }

    // ── Calculadora (plan base + calendarios extra) ──
    var root = document.querySelector('[data-calc]');
    var range = root && root.querySelector('[data-calc-range]');
    var nOut = root && root.querySelector('[data-calc-n]');
    var totalOut = root && root.querySelector('[data-calc-total]');
    var totalWas = root && root.querySelector('[data-calc-total-was]');
    var perOut = root && root.querySelector('[data-calc-per]');
    var unit = (range && range.getAttribute('data-unit')) || '';

    function renderCalc() {
      if (!root) return;
      var n = parseInt(range.value, 10) || 1;
      var monthly = calcData.totals[n - 1];
      var total = withBilling(monthly);
      nOut.textContent = String(n);
      totalOut.textContent = nf.format(total);
      perOut.textContent = nf.format(Math.round(total / n));
      // Tachado del total: el mensual sin descuento.
      if (totalWas) {
        if (billing === 'annual') {
          totalWas.textContent = calcData.sym + nf.format(monthly);
          totalWas.hidden = false;
        } else {
          totalWas.hidden = true;
        }
      }
      range.setAttribute('aria-valuenow', String(n));
      range.setAttribute('aria-valuetext', n + ' ' + unit);
    }

    function renderAll() {
      renderPrices();
      renderCalc();
    }

    billBtns.forEach(function (b) {
      b.addEventListener('click', function () {
        billing = b.getAttribute('data-billing');
        billBtns.forEach(function (x) {
          x.setAttribute('aria-pressed', x === b ? 'true' : 'false');
        });
        renderAll();
      });
    });

    if (range) range.addEventListener('input', renderCalc);

    renderAll();
  })();
</script>
