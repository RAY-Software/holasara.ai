        unit: 'USD flat',
        featured: false,
      },
    ],
    plansKicker: 'How you are billed',
    plansH2: 'A calendar is one bookable schedule.',
    plansLead:
      'If three providers at your practice each keep their own calendar, that is three calendars. Mia and Daniel are billed once per account, no matter how many calendars you have.',
    plansPopular: 'Most picked',
    plansAddon: 'Add-on',
    plansCta: 'Get started',
    billMonthly: 'Monthly',
