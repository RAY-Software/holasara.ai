---
import { localizedStaticPaths, toLocale, localePath } from '../../i18n/config';
// Slug localizado: /es/precios ↔ /en/pricing (src/i18n/slugs.ts).
export function getStaticPaths() {
  return localizedStaticPaths('pricing');
}
const lang = toLocale(Astro.params.lang);
const L = (p: string) => localePath(p, lang);
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FeatureFaq from '../../components/FeatureFaq.astro';
import CtaBand from '../../components/CtaBand.astro';
import { whatsappLink, whatsappText } from '../../lib/whatsapp';
import { SARA_START, SARA_TIERS, ADDON_MIA, ADDON_DANIEL, saraTotal, fmt } from '../../data/pricing';

// El precio base de Sara Full (agendas 1ª y 2ª) y el fijo de Mia/Daniel salen de la
// fuente única (data/pricing.ts), así la copy nunca se desincroniza de la calculadora.
const SARA_BASE = SARA_TIERS[0].price; // 129
const ADDON = ADDON_MIA; // 110

// Datos para la calculadora interactiva (client-side). Precomputamos el total de Sara
// por cada nº de agendas (1..MAX) desde la fuente única, así el JS del navegador solo
// indexa y suma los add-ons; no reimplementa la lógica de tramos.
const CALC_MAX = 30;
const DEFAULT_N = 3;
const SARA_TOTALS = Array.from({ length: CALC_MAX }, (_, i) => saraTotal(i + 1));
const calcData = { totals: SARA_TOTALS, mia: ADDON_MIA, daniel: ADDON_DANIEL, max: CALC_MAX };
// Valores por defecto server-render (para que la calculadora muestre algo sin JS).
const defaultSara = saraTotal(DEFAULT_N);
const defaultPer = Math.round(defaultSara / DEFAULT_N);

// ── Copy por idioma. EN es inglés nativo del producto US, no calco. ──
const dict = {
  es: {
    metaTitle: 'Precios · Sara',
    metaDescription:
      'Precios claros de Sara, sin sorpresas: desde 49 USD por agenda, con Mia y Daniel a 110 USD fijo cada uno. Sin comisión por cita.',
    heroBadge: 'Precios claros',
    heroTitle: 'El precio que ves<br />es el que pagas.',
    heroLead1: 'Sara atiende, agenda y cobra las 24 horas.',
    heroLead2: 'Mia trae pacientes. Daniel cuida el dinero.',
    heroLead3: 'Sumas a cada uno cuando lo necesitas.',
    ctaStart: 'Empezar ahora',
    ctaTalk: 'Habla con Sara',
    stats: [
      { n: fmt(SARA_START), label: 'USD por agenda' },
      { n: fmt(ADDON), label: 'Mia o Daniel, fijo' },
      { n: '0', label: 'comisión por cita' },
    ],
    teamKicker: 'Tu equipo con IA',
    teamH2: 'Tres agentes. <em class="text-pine-dark">Empiezas por Sara.</em>',
    teamLead:
      'Sara es la puerta de entrada y es lo único indispensable. Mia y Daniel se suman cuando los necesitas, sobre la misma cuenta.',
    team: [
      {
        tag: 'Recepción',
        name: 'Sara',
        body: 'Responde en WhatsApp e Instagram, informa precios, agenda la cita y cobra el anticipo. Recuerda, confirma y reprograma sola.',
        price: fmt(SARA_BASE),
        unit: 'USD / agenda',
        featured: true,
      },
      {
        tag: 'Marketing',
        name: 'Mia',
        body: 'Propone las ideas, crea las piezas con tu marca, publica en Instagram y llena los huecos de la agenda. Mide en citas, no en likes.',
        price: fmt(ADDON),
        unit: 'USD fijo',
        featured: false,
      },
      {
        tag: 'Finanzas',
        name: 'Daniel',
        body: 'Cierra el mes, te dice el margen y detecta los anticipos sin cobrar. Cuando hay dinero pendiente, se lo pasa a Sara.',
        price: fmt(ADDON),
        unit: 'USD fijo',
        featured: false,
      },
    ],
    plansKicker: 'Cómo se cobra',
    plansH2: 'Una agenda es un calendario reservable.',
    plansLead:
      'Si en tu clínica atienden tres profesionales con calendarios propios, son tres agendas. Mia y Daniel se cobran una sola vez por cuenta, sin importar cuántas agendas tengas.',
    plansCols: { plan: 'Plan', price: 'USD / mes', includes: 'Qué incluye' },
    plans: [
      {
        name: 'Sara Start',
        price: fmt(SARA_START),
        includes:
          'Atención 24/7 en WhatsApp y web, agendamiento automático, cobro de la consulta en línea, configuración autoservicio. Con tope mensual de conversaciones por agenda.',
      },
      {
        name: 'Sara Full',
        price: fmt(SARA_BASE),
        includes:
          'Todo lo de Start sin tope, más recordatorios automáticos, recuperación de no-shows, reprogramación automática y reportes de ocupación de agenda.',
      },
      {
        name: '+ Mia',
        price: fmt(ADDON),
        includes:
          'Captación de pacientes nuevos, reactivación de inactivos, campañas por WhatsApp, presencia en Google y buscadores con IA, reportes de origen.',
      },
      {
        name: '+ Daniel',
        price: fmt(ADDON),
        includes:
          'Control de ingresos y cobranzas, conciliación de pagos, reportes financieros mensuales y proyección de facturación.',
      },
    ],
    volKicker: 'Volumen',
    volH2: 'Cada agenda nueva cuesta menos.',
    volLead:
      'El precio baja agenda por agenda, no de golpe. Cada tramo fija el precio de las agendas que caen dentro de él, y las anteriores conservan el suyo.',
    tiers: [
      { label: 'Agendas 1ª y 2ª', price: fmt(SARA_TIERS[0].price), each: 'cada una' },
      { label: 'Agendas 3ª a 5ª', price: fmt(SARA_TIERS[1].price), each: 'cada una' },
      { label: 'Agendas 6ª a 10ª', price: fmt(SARA_TIERS[2].price), each: 'cada una' },
      { label: 'Agendas 11ª y más', price: fmt(SARA_TIERS[3].price), each: 'cada una' },
    ],
    volExampleBold: 'Ejemplo con tres agendas:',
    volExample:
      'la primera cuesta 129, la segunda 129 y la tercera 109. El total de Sara es 367 USD, no 327. El precio de 109 aplica solo a la tercera agenda, no a las tres.',
    calcKicker: 'Calculadora',
    calcH2: 'Calcula el precio de tu clínica.',
    calcLead: 'Mueve el control según cuántos calendarios reservables tienes y suma a Mia y a Daniel. El precio ya incluye los tramos por volumen.',
    calcAgendasLabel: '¿Cuántas agendas?',
    calcAddMia: '+ Mia',
    calcAddDaniel: '+ Daniel',
    calcResultKicker: 'Tu equipo, por mes',
    calcTotalUnit: 'USD / mes',
    calcSaraLabel: 'Sara',
    calcPerAgendaLabel: 'Costo por agenda',
    calcPerAgendaUnit: 'USD',
    calcUnitWord: 'agendas',
    scaleBold: 'Mia y Daniel no escalan.',
    scale:
      'Cuestan 110 USD cada uno en cualquier tamaño de cuenta. Cuantas más agendas tengas, mejor negocio resultan: en una clínica de 20 agendas, los dos juntos cuestan menos que dos agendas de Sara.',
    faqTitle: 'Lo que suelen preguntar.',
    faqs: [
      { q: '¿Qué cuenta como una agenda?', a: 'Un calendario reservable. Si dos profesionales comparten el mismo calendario, es una sola agenda.' },
      { q: '¿Puedo empezar solo con Sara?', a: 'Sí. Sara es la puerta de entrada. Mia y Daniel se suman cuando quieras, sobre la misma cuenta.' },
      { q: '¿Pago más por tener varias sucursales?', a: 'No. El precio depende de cuántos calendarios reservables tengas, no de cuántos locales.' },
      { q: '¿Cómo empiezo?', a: 'Contratas en línea, configuras la agenda y el WhatsApp, y Sara empieza a atender el mismo día.' },
      { q: '¿Qué pasa si sumo un profesional?', a: 'Se agrega una agenda al precio del tramo que corresponda, y baja el costo promedio de toda la cuenta.' },
      { q: '¿Toca mi historia clínica?', a: 'No. No se almacena historia clínica ni información médica. Eso queda donde está hoy.' },
    ],
  },
  en: {
    metaTitle: 'Pricing · Sara',
    metaDescription:
      'Clear Sara pricing, no surprises: from $49 per calendar, with Mia and Daniel at $110 flat each. No per-booking fees.',
    heroBadge: 'Clear pricing',
    heroTitle: 'The price you see<br />is the price you pay.',
    heroLead1: 'Sara answers, books and collects 24/7.',
    heroLead2: 'Mia brings patients in. Daniel watches the money.',
    heroLead3: 'You add each one when you need them.',
    ctaStart: 'Start now',
    ctaTalk: 'Talk to Sara',
    stats: [
      { n: fmt(SARA_START), label: 'USD per calendar' },
      { n: fmt(ADDON), label: 'Mia or Daniel, flat' },
      { n: '0', label: 'per-booking fees' },
    ],
    teamKicker: 'Your AI team',
    teamH2: 'Three agents. <em class="text-pine-dark">You start with Sara.</em>',
    teamLead:
      'Sara is the way in and the only must-have. Mia and Daniel join when you need them, on the same account.',
    team: [
      {
        tag: 'Front desk',
        name: 'Sara',
        body: 'Answers on WhatsApp and Instagram, quotes prices, books the appointment and collects the deposit. Reminds, confirms and reschedules on her own.',
        price: fmt(SARA_BASE),
        unit: 'USD / calendar',
        featured: true,
      },
      {
        tag: 'Marketing',
        name: 'Mia',
        body: 'Brings the ideas, builds the pieces in your brand, posts on Instagram and fills the gaps in the calendar. Measures in appointments, not likes.',
        price: fmt(ADDON),
        unit: 'USD flat',
        featured: false,
      },
      {
        tag: 'Bookkeeping',
        name: 'Daniel',
        body: 'Closes the month, tells you the margin and catches the deposits that went uncollected. When money is pending, he hands it to Sara.',
        price: fmt(ADDON),
        unit: 'USD flat',
        featured: false,
      },
    ],
    plansKicker: 'How you are billed',
    plansH2: 'A calendar is one bookable schedule.',
    plansLead:
      'If three providers at your practice each keep their own calendar, that is three calendars. Mia and Daniel are billed once per account, no matter how many calendars you have.',
    plansCols: { plan: 'Plan', price: 'USD / mo', includes: 'What it includes' },
    plans: [
      {
        name: 'Sara Start',
        price: fmt(SARA_START),
        includes:
          '24/7 answering on WhatsApp and web, automatic scheduling, online deposit collection, self-serve setup. With a monthly cap on conversations per calendar.',
      },
      {
        name: 'Sara Full',
        price: fmt(SARA_BASE),
        includes:
          'Everything in Start with no cap, plus automatic reminders, no-show recovery, automatic rescheduling and calendar-occupancy reports.',
      },
      {
        name: '+ Mia',
        price: fmt(ADDON),
        includes:
          'New-patient acquisition, win-back of lapsed patients, WhatsApp campaigns, presence on Google and AI search, source reports.',
      },
      {
        name: '+ Daniel',
        price: fmt(ADDON),
        includes:
          'Revenue and collections tracking, payment reconciliation, monthly financial reports and revenue projection.',
      },
    ],
    volKicker: 'Volume',
    volH2: 'Each new calendar costs less.',
    volLead:
      'The price drops calendar by calendar, not all at once. Each tier sets the price for the calendars that fall inside it, and the earlier ones keep theirs.',
    tiers: [
      { label: 'Calendars 1 and 2', price: fmt(SARA_TIERS[0].price), each: 'each' },
      { label: 'Calendars 3 to 5', price: fmt(SARA_TIERS[1].price), each: 'each' },
      { label: 'Calendars 6 to 10', price: fmt(SARA_TIERS[2].price), each: 'each' },
      { label: 'Calendars 11 and up', price: fmt(SARA_TIERS[3].price), each: 'each' },
    ],
    volExampleBold: 'Example with three calendars:',
    volExample:
      'the first costs 129, the second 129 and the third 109. Sara totals $367, not $327. The 109 price applies only to the third calendar, not to all three.',
    calcKicker: 'Calculator',
    calcH2: 'Price it for your practice.',
    calcLead: 'Move the control for how many bookable calendars you have and add Mia and Daniel. The price already includes the volume tiers.',
    calcAgendasLabel: 'How many calendars?',
    calcAddMia: '+ Mia',
    calcAddDaniel: '+ Daniel',
    calcResultKicker: 'Your team, per month',
    calcTotalUnit: 'USD / mo',
    calcSaraLabel: 'Sara',
    calcPerAgendaLabel: 'Cost per calendar',
    calcPerAgendaUnit: 'USD',
    calcUnitWord: 'calendars',
    scaleBold: 'Mia and Daniel do not scale.',
    scale:
      'They cost $110 each at any account size. The more calendars you have, the better the deal: at a 20-calendar practice, the two of them together cost less than two Sara calendars.',
    faqTitle: 'What people usually ask.',
    faqs: [
      { q: 'What counts as one calendar?', a: 'A bookable calendar. If two providers share the same calendar, it is a single calendar.' },
      { q: 'Can I start with just Sara?', a: 'Yes. Sara is the way in. Mia and Daniel join whenever you want, on the same account.' },
      { q: 'Do I pay more for having several locations?', a: 'No. The price depends on how many bookable calendars you have, not how many locations.' },
      { q: 'How do I get started?', a: 'You sign up online, set up the calendar and WhatsApp, and Sara starts answering the same day.' },
      { q: 'What happens if I add a provider?', a: 'One calendar is added at the price of the matching tier, and the average cost of the whole account goes down.' },
      { q: 'Does it touch my medical records?', a: 'No. No medical records or clinical information are stored. That stays where it is today.' },
    ],
  },
}[lang];

const { team, plans, tiers, faqs } = dict;
---

<Layout ogImage={`/og/pricing-${lang}.jpg`} lang={lang} title={dict.metaTitle} description={dict.metaDescription}>
  <Header lang={lang} />
  <main>
    <!-- ══════════ HERO (banda oscura) ══════════ -->
    <section class="border-b border-line-dark bg-ink text-cream">
      <div class="mx-auto max-w-6xl px-5 pb-16 pt-14">
        <a href={L('/')} class="mb-10 inline-flex items-center gap-1.5 text-sm font-medium text-cream/60 transition-colors hover:text-cream">
          <span aria-hidden="true">←</span> {lang === 'en' ? 'Back to home' : 'Volver al inicio'}
        </a>
        <p class="mb-6 inline-flex items-center gap-2.5 rounded-full border border-cream/20 px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.14em] text-cream/85">
          <span class="h-1.5 w-1.5 rounded-full bg-mint"></span>{dict.heroBadge}
        </p>
        <h1 class="max-w-4xl font-serif text-5xl font-black leading-[1.04] tracking-tight text-balance md:text-6xl" set:html={dict.heroTitle} />
        <div class="mt-7 space-y-1 text-lg text-cream/75 md:text-xl">
          <p>{dict.heroLead1}</p>
          <p>{dict.heroLead2}</p>
          <p>{dict.heroLead3}</p>
        </div>
        <div class="mt-9 flex flex-wrap items-center gap-3">
          <a
            href={L('/free-trial')}
            class="inline-flex items-center gap-2 rounded-full bg-mint px-7 py-3.5 text-base font-semibold text-ink transition-opacity hover:opacity-90"
          >
            {dict.ctaStart}
          </a>
          <a
            href={whatsappLink(whatsappText(lang))}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 rounded-full border border-cream/30 px-7 py-3.5 text-base font-semibold text-cream transition-colors hover:bg-cream/10"
          >
            {dict.ctaTalk}
          </a>
        </div>

        <!-- Stats -->
        <div class="mt-14 grid max-w-2xl grid-cols-3 gap-8 border-t border-cream/12 pt-8">
          {
            dict.stats.map((s) => (
              <div>
                <p class="font-serif text-4xl font-black text-cream tabular-nums md:text-5xl">{s.n}</p>
                <p class="mt-1.5 text-sm text-cream/60">{s.label}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ══════════ TU EQUIPO CON IA · 3 tarjetas ══════════ -->
    <section class="border-b border-line">
      <div class="reveal mx-auto max-w-6xl px-5 py-24">
        <p class="mb-3 text-sm font-semibold uppercase tracking-[0.14em] text-pine-dark">{dict.teamKicker}</p>
        <h2 class="max-w-2xl font-serif text-3xl font-black leading-tight text-balance md:text-4xl" set:html={dict.teamH2} />
        <p class="mt-5 max-w-2xl text-lg text-salvia">{dict.teamLead}</p>
        <div class="mt-12 grid gap-5 md:grid-cols-3">
          {
            team.map((m) => (
              <div
                class:list={[
                  'flex flex-col rounded-2xl border bg-cream p-7',
                  m.featured ? 'border-pine/40 shadow-[0_16px_44px_-24px_rgba(20,38,31,0.4)]' : 'border-line',
                ]}
              >
                <p class="text-xs font-semibold uppercase tracking-[0.14em] text-pine-dark">{m.tag}</p>
                <p class="mt-2 font-serif text-2xl font-black text-ink">{m.name}</p>
                <p class="mt-3 flex-1 text-salvia">{m.body}</p>
                <p class="mt-6 border-t border-line pt-4">
                  <span class="font-serif text-3xl font-black text-ink tabular-nums">{m.price}</span>
                  <span class="ml-1.5 text-sm text-salvia">{m.unit}</span>
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ══════════ CÓMO SE COBRA · tabla de planes ══════════ -->
    <section class="border-b border-line bg-paper">
      <div class="reveal mx-auto max-w-6xl px-5 py-24">
        <p class="mb-3 text-sm font-semibold uppercase tracking-[0.14em] text-pine-dark">{dict.plansKicker}</p>
        <h2 class="max-w-2xl font-serif text-3xl font-black leading-tight text-balance md:text-4xl">{dict.plansH2}</h2>
        <p class="mt-5 max-w-2xl text-lg text-salvia">{dict.plansLead}</p>

        <!-- Mobile: tarjetas apiladas (la columna "qué incluye" no entra en una tabla en pantallas chicas). -->
        <div class="mt-12 flex flex-col gap-4 sm:hidden">
          {
            plans.map((p) => (
              <div class="rounded-2xl border border-line bg-cream p-6">
                <div class="flex items-baseline justify-between gap-4 border-b border-line pb-4">
                  <span class="font-serif text-xl font-black text-ink">{p.name}</span>
                  <span class="shrink-0 whitespace-nowrap">
                    <span class="font-serif text-2xl font-black text-ink tabular-nums">{p.price}</span>
                    <span class="ml-1 text-xs text-salvia">{dict.plansCols.price}</span>
                  </span>
                </div>
                <p class="mt-4 text-salvia">{p.includes}</p>
              </div>
            ))
          }
        </div>

        <!-- Desktop: tabla. -->
        <div class="mt-12 hidden overflow-x-auto rounded-2xl border border-line bg-cream shadow-[0_16px_40px_-28px_rgba(20,38,31,0.32)] sm:block">
          <table class="w-full min-w-[640px] border-collapse text-left">
            <thead>
              <tr class="bg-ink text-cream">
                <th scope="col" class="px-6 py-4 text-xs font-semibold uppercase tracking-[0.12em]">{dict.plansCols.plan}</th>
                <th scope="col" class="whitespace-nowrap px-6 py-4 text-xs font-semibold uppercase tracking-[0.12em]">{dict.plansCols.price}</th>
                <th scope="col" class="px-6 py-4 text-xs font-semibold uppercase tracking-[0.12em]">{dict.plansCols.includes}</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-line">
              {
                plans.map((p, i) => (
                  <tr class={i % 2 ? 'bg-mint/[0.04]' : ''}>
                    <th scope="row" class="whitespace-nowrap px-6 py-5 text-left align-top font-serif text-lg font-black text-ink">{p.name}</th>
                    <td class="px-6 py-5 align-top">
                      <span class="font-serif text-xl font-black text-ink tabular-nums">{p.price}</span>
                    </td>
                    <td class="px-6 py-5 align-top text-salvia">{p.includes}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ══════════ VOLUMEN · tramos + ejemplo ══════════ -->
    <section class="border-b border-line">
      <div class="reveal mx-auto max-w-6xl px-5 py-24">
        <p class="mb-3 text-sm font-semibold uppercase tracking-[0.14em] text-pine-dark">{dict.volKicker}</p>
        <h2 class="max-w-2xl font-serif text-3xl font-black leading-tight text-balance md:text-4xl">{dict.volH2}</h2>
        <p class="mt-5 max-w-2xl text-lg text-salvia">{dict.volLead}</p>

        <div class="mt-12 grid grid-cols-2 gap-4 sm:gap-5 lg:grid-cols-4">
          {
            tiers.map((tr, i) => (
              <div
                class:list={[
                  'rounded-2xl border p-6',
                  i < 2 ? 'border-pine/30 bg-mint/[0.05]' : 'border-line bg-paper',
                ]}
              >
                <p class="text-sm font-semibold text-pine-dark">{tr.label}</p>
                <p class="mt-4 font-serif text-4xl font-black text-ink tabular-nums">{tr.price}</p>
                <p class="mt-1 text-sm text-salvia">{tr.each}</p>
              </div>
            ))
          }
        </div>

        <div class="mt-8 rounded-xl border-l-4 border-pine bg-paper p-6 text-salvia">
          <span class="font-semibold text-ink">{dict.volExampleBold}</span> {dict.volExample}
        </div>
      </div>
    </section>

    <!-- ══════════ CALCULADORA · tabla por nº de agendas ══════════ -->
    <section class="border-b border-line bg-paper">
      <div class="reveal mx-auto max-w-6xl px-5 py-24">
        <p class="mb-3 text-sm font-semibold uppercase tracking-[0.14em] text-pine-dark">{dict.calcKicker}</p>
        <h2 class="max-w-2xl font-serif text-3xl font-black leading-tight text-balance md:text-4xl">{dict.calcH2}</h2>
        <p class="mt-5 max-w-2xl text-lg text-salvia">{dict.calcLead}</p>

        <div
          class="mt-12 grid gap-6 rounded-2xl border border-line bg-cream p-6 shadow-[0_16px_40px_-28px_rgba(20,38,31,0.32)] md:grid-cols-2 md:gap-10 md:p-8"
          data-calc
        >
          <!-- Controles -->
          <div class="flex flex-col justify-center">
            <div class="flex items-baseline justify-between gap-4">
              <label for="calc-agendas" class="text-sm font-semibold text-pine-dark">{dict.calcAgendasLabel}</label>
              <span class="font-serif text-4xl font-black text-ink tabular-nums" data-calc-n>{DEFAULT_N}</span>
            </div>
            <input
              id="calc-agendas"
              type="range"
              min="1"
              max={calcData.max}
              value={DEFAULT_N}
              step="1"
              class="mt-4 h-2 w-full cursor-pointer appearance-none rounded-full bg-line accent-pine"
              data-calc-range
              data-unit={dict.calcUnitWord}
              aria-label={dict.calcAgendasLabel}
              aria-valuetext={`${DEFAULT_N} ${dict.calcUnitWord}`}
            />
            <div class="mt-1.5 flex justify-between text-xs text-salvia tabular-nums">
              <span>1</span><span>{calcData.max}</span>
            </div>
            <div class="mt-7 flex flex-wrap gap-3">
              <button type="button" data-calc-toggle="mia" aria-pressed="false" class="calc-chip">
                {dict.calcAddMia} <span class="calc-chip__price">{fmt(ADDON)}</span>
              </button>
              <button type="button" data-calc-toggle="daniel" aria-pressed="false" class="calc-chip">
                {dict.calcAddDaniel} <span class="calc-chip__price">{fmt(ADDON_DANIEL)}</span>
              </button>
            </div>
          </div>

          <!-- Resultado -->
          <div class="rounded-xl bg-ink p-6 text-cream">
            <p class="text-xs font-semibold uppercase tracking-[0.12em] text-cream/60">{dict.calcResultKicker}</p>
            <p class="mt-2 flex items-baseline gap-2">
              <span class="font-serif text-5xl font-black tabular-nums" data-calc-total>{fmt(defaultSara)}</span>
              <span class="text-cream/70">{dict.calcTotalUnit}</span>
            </p>
            <ul class="mt-5 space-y-2.5 text-sm">
              <li class="flex items-center justify-between gap-4">
                <span class="text-cream/80">{dict.calcSaraLabel}</span>
                <span class="tabular-nums text-cream" data-calc-sara>{fmt(defaultSara)}</span>
              </li>
              <li class="flex items-center justify-between gap-4" data-calc-row="mia" hidden>
                <span class="text-cream/80">Mia</span>
                <span class="tabular-nums text-cream">{fmt(ADDON)}</span>
              </li>
              <li class="flex items-center justify-between gap-4" data-calc-row="daniel" hidden>
                <span class="text-cream/80">Daniel</span>
                <span class="tabular-nums text-cream">{fmt(ADDON_DANIEL)}</span>
              </li>
            </ul>
            <p class="mt-4 flex items-center justify-between gap-4 border-t border-cream/15 pt-4 text-sm text-cream/70">
              <span>{dict.calcPerAgendaLabel}</span>
              <span><span class="font-semibold text-cream tabular-nums" data-calc-per>{fmt(defaultPer)}</span> {dict.calcPerAgendaUnit}</span>
            </p>
          </div>
        </div>

        <div class="mt-8 rounded-xl border-l-4 border-pine bg-cream p-6 text-salvia">
          <span class="font-semibold text-ink">{dict.scaleBold}</span> {dict.scale}
        </div>
      </div>
    </section>

    <FeatureFaq items={faqs} lang={lang} title={dict.faqTitle} />

    <CtaBand lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>

<style>
  .calc-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border-radius: 9999px;
    border: 1px solid var(--color-line);
    background: #fff;
    padding: 0.55rem 1.05rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-ink);
    cursor: pointer;
    transition: border-color 0.15s ease, background-color 0.15s ease, color 0.15s ease;
  }
  .calc-chip__price {
    color: var(--color-salvia);
    font-variant-numeric: tabular-nums;
  }
  .calc-chip:hover {
    border-color: color-mix(in srgb, var(--color-ink) 30%, transparent);
  }
  .calc-chip[aria-pressed='true'] {
    border-color: var(--color-pine);
    background: var(--color-pine);
    color: var(--color-cream);
  }
  .calc-chip[aria-pressed='true'] .calc-chip__price {
    color: color-mix(in srgb, var(--color-cream) 78%, transparent);
  }

  input[type='range'][data-calc-range] {
    outline-offset: 4px;
  }
  input[type='range'][data-calc-range]::-webkit-slider-runnable-track {
    height: 8px;
    border-radius: 9999px;
  }
  input[type='range'][data-calc-range]::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 22px;
    height: 22px;
    margin-top: -7px;
    border-radius: 9999px;
    background: var(--color-pine);
    border: 3px solid #fff;
    box-shadow: 0 1px 4px rgba(20, 38, 31, 0.3);
    cursor: pointer;
  }
  input[type='range'][data-calc-range]::-moz-range-track {
    height: 8px;
    border-radius: 9999px;
    background: var(--color-line);
  }
  input[type='range'][data-calc-range]::-moz-range-thumb {
    width: 22px;
    height: 22px;
    border: 3px solid #fff;
    border-radius: 9999px;
    background: var(--color-pine);
    box-shadow: 0 1px 4px rgba(20, 38, 31, 0.3);
    cursor: pointer;
  }
</style>

<script is:inline define:vars={{ calcData }}>
  (function () {
    var root = document.querySelector('[data-calc]');
    if (!root) return;
    var range = root.querySelector('[data-calc-range]');
    var nOut = root.querySelector('[data-calc-n]');
    var totalOut = root.querySelector('[data-calc-total]');
    var saraOut = root.querySelector('[data-calc-sara]');
    var perOut = root.querySelector('[data-calc-per]');
    var rowMia = root.querySelector('[data-calc-row="mia"]');
    var rowDaniel = root.querySelector('[data-calc-row="daniel"]');
    var toggles = root.querySelectorAll('[data-calc-toggle]');
    var unit = (range && range.getAttribute('data-unit')) || '';
    var nf = new Intl.NumberFormat('en-US');
    var state = { mia: false, daniel: false };

    function render() {
      var n = parseInt(range.value, 10) || 1;
      var sara = calcData.totals[n - 1];
      var total = sara + (state.mia ? calcData.mia : 0) + (state.daniel ? calcData.daniel : 0);
      nOut.textContent = String(n);
      saraOut.textContent = nf.format(sara);
      totalOut.textContent = nf.format(total);
      perOut.textContent = nf.format(Math.round(total / n));
      if (rowMia) rowMia.hidden = !state.mia;
      if (rowDaniel) rowDaniel.hidden = !state.daniel;
      range.setAttribute('aria-valuenow', String(n));
      range.setAttribute('aria-valuetext', n + ' ' + unit);
    }

    range.addEventListener('input', render);
    toggles.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var k = btn.getAttribute('data-calc-toggle');
        state[k] = !state[k];
        btn.setAttribute('aria-pressed', state[k] ? 'true' : 'false');
        render();
      });
    });
    render();
  })();
</script>
