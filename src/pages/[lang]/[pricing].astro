    heroTitle: 'Precios claros,<br />sin sorpresas.',
    heroLead1: 'Sara atiende, agenda y cobra las 24 horas.',
    heroLead2: 'Mia trae pacientes. Daniel cuida el dinero.',
    heroLead3: 'Sumas a cada uno cuando lo necesitas.',
    ctaStart: 'Empezar ahora',
    ctaTalk: 'Habla con Sara',
    stats: [
      { n: fmt(SARA_START), label: 'USD por agenda' },
      { n: fmt(ADDON), label: 'Mia o Daniel, fijo' },
      { n: '0', label: 'comisión por cita' },
