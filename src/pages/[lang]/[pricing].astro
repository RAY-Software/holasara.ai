const { team, saraPlans, addons, tiers, faqs } = dict;
---

<Layout ogImage={`/og/pricing-${lang}.jpg`} lang={lang} title={dict.metaTitle} description={dict.metaDescription}>
  <Header lang={lang} />
  <main>
    <!-- ══════════ HERO (banda oscura) ══════════ -->
    <section class="border-b border-line-dark bg-ink text-cream">
      <div class="mx-auto max-w-5xl px-5 pb-16 pt-14">
        <a href={L('/')} class="inline-flex items-center gap-1.5 text-sm font-medium text-cream/60 transition-colors hover:text-cream">
          <span aria-hidden="true">←</span> {lang === 'en' ? 'Back to home' : 'Volver al inicio'}
        </a>

        <div class="mt-10 text-center">
          <p class="mb-6 inline-flex items-center gap-2.5 rounded-full border border-cream/20 px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.14em] text-cream/85">
            <span class="h-1.5 w-1.5 rounded-full bg-mint"></span>{dict.heroBadge}
          </p>
          <h1 class="mx-auto max-w-3xl font-serif text-5xl font-black leading-[1.04] tracking-tight text-balance md:text-6xl" set:html={dict.heroTitle} />
          <div class="mx-auto mt-7 max-w-2xl space-y-1 text-lg text-cream/75 md:text-xl">
            <p>{dict.heroLead1}</p>
            <p>{dict.heroLead2}</p>
            <p>{dict.heroLead3}</p>
          </div>
          <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
            <a
              href={L('/free-trial')}
              class="inline-flex items-center gap-2 rounded-full bg-mint px-7 py-3.5 text-base font-semibold text-ink transition-opacity hover:opacity-90"
            >
              {dict.ctaStart}
            </a>
            <a
              href={whatsappLink(whatsappText(lang))}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-2 rounded-full border border-cream/30 px-7 py-3.5 text-base font-semibold text-cream transition-colors hover:bg-cream/10"
            >
              {dict.ctaTalk}
            </a>
          </div>

          <!-- Stats -->
          <div class="mx-auto mt-14 grid max-w-2xl grid-cols-3 gap-8 border-t border-cream/12 pt-8">
            {
              dict.stats.map((s) => (
                <div>
                  <p class="font-serif text-4xl font-black text-cream tabular-nums md:text-5xl">{s.n}</p>
                  <p class="mt-1.5 text-sm text-cream/60">{s.label}</p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════ TU EQUIPO CON IA · 3 tarjetas ══════════ -->
    <section class="border-b border-line">
      <div class="reveal mx-auto max-w-6xl px-5 py-24">
        <p class="mb-3 text-sm font-semibold uppercase tracking-[0.14em] text-pine-dark">{dict.teamKicker}</p>
        <h2 class="max-w-2xl font-serif text-3xl font-black leading-tight text-balance md:text-4xl" set:html={dict.teamH2} />
        <p class="mt-5 max-w-2xl text-lg text-salvia">{dict.teamLead}</p>
        <div class="mt-12 grid gap-5 md:grid-cols-3">
          {
            team.map((m) => (
              <div
                class:list={[
                  'flex flex-col rounded-2xl border bg-cream p-7',
                  m.featured ? 'border-pine/40 shadow-[0_16px_44px_-24px_rgba(20,38,31,0.4)]' : 'border-line',
                ]}
              >
                <p class="text-xs font-semibold uppercase tracking-[0.14em] text-pine-dark">{m.tag}</p>
                <p class="mt-2 font-serif text-2xl font-black text-ink">{m.name}</p>
                <p class="mt-3 flex-1 text-salvia">{m.body}</p>
                <p class="mt-6 border-t border-line pt-4">
                  <span class="font-serif text-3xl font-black text-ink tabular-nums">{m.price}</span>
                  <span class="ml-1.5 text-sm text-salvia">{m.unit}</span>
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ══════════ CÓMO SE COBRA · tabla de planes ══════════ -->
    <section class="border-b border-line bg-paper">
      <div class="reveal mx-auto max-w-6xl px-5 py-24">
        <p class="mb-3 text-sm font-semibold uppercase tracking-[0.14em] text-pine-dark">{dict.plansKicker}</p>
        <h2 class="max-w-2xl font-serif text-3xl font-black leading-tight text-balance md:text-4xl">{dict.plansH2}</h2>
        <p class="mt-5 max-w-2xl text-lg text-salvia">{dict.plansLead}</p>

        <!-- Toggle mensual / anual -->
        <div
          class="mt-10 inline-flex items-center gap-1 rounded-full border border-line bg-cream p-1"
          role="group"
          aria-label={`${dict.billMonthly} / ${dict.billAnnual}`}
        >
          <button type="button" data-billing="monthly" aria-pressed="true" class="bill-btn">{dict.billMonthly}</button>
          <button type="button" data-billing="annual" aria-pressed="false" class="bill-btn">
            {dict.billAnnual}
            <span class="bill-save">{dict.billSave}</span>
          </button>
        </div>

        <!-- Planes de Sara (pricing-cards) -->
        <div class="mt-8 grid gap-5 md:grid-cols-2">
          {
            saraPlans.map((p) => (
              <div
                class:list={[
                  'relative flex flex-col rounded-2xl border bg-cream p-7',
                  p.featured ? 'border-pine/50 shadow-[0_16px_44px_-24px_rgba(20,38,31,0.4)]' : 'border-line',
                ]}
              >
                {p.featured && (
                  <span class="absolute -top-3 left-7 rounded-full bg-pine px-3 py-1 text-xs font-semibold text-cream">
                    {dict.plansPopular}
                  </span>
                )}
                <p class="font-serif text-xl font-black text-ink">{p.name}</p>
                <p class="mt-3 flex items-baseline gap-2">
                  <span class="font-serif text-4xl font-black text-ink tabular-nums" data-price data-monthly={p.raw}>
                    {fmt(p.raw)}
                  </span>
                  <s class="font-serif text-xl font-black text-salvia/50 tabular-nums" data-price-was hidden></s>
                </p>
                <p class="mt-0.5 text-sm text-salvia">
                  {p.unit}<span class="text-pine-dark" data-annual-note hidden> · {dict.billAnnualNote}</span>
                </p>
                <ul class="mt-6 flex-1 space-y-2.5 text-sm text-ink">
                  {p.features.map((f) => (
                    <li class="flex items-start gap-2.5">
                      <svg class="mt-0.5 h-4 w-4 shrink-0 text-pine" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                        <path d="M4 10.5 8 14.5 16 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                      <span>{f}</span>
                    </li>
                  ))}
                </ul>
                {p.note && <p class="mt-4 text-xs text-salvia">{p.note}</p>}
                <a
                  href={L('/free-trial')}
                  class:list={[
                    'mt-6 inline-flex items-center justify-center rounded-full px-5 py-2.5 text-sm font-semibold transition-colors',
                    p.featured ? 'bg-pine text-cream hover:bg-pine-dark' : 'border border-line text-ink hover:border-ink/30',
                  ]}
                >
                  {dict.plansCta}
                </a>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ══════════ PRODUCTOS ADICIONALES · add-ons ══════════ -->
    <section class="border-b border-line">
      <div class="reveal mx-auto max-w-6xl px-5 py-24">
        <p class="mb-3 text-sm font-semibold uppercase tracking-[0.14em] text-pine-dark">{dict.additionalKicker}</p>
        <h2 class="max-w-2xl font-serif text-3xl font-black leading-tight text-balance md:text-4xl">{dict.additionalH2}</h2>
        <p class="mt-5 max-w-2xl text-lg text-salvia">{dict.additionalLead}</p>
        <div class="mt-12 grid gap-5 md:grid-cols-2">
          {
            addons.map((p) => (
              <div class="flex flex-col rounded-2xl border border-line bg-cream p-7 sm:flex-row sm:gap-7">
                <div class="sm:w-48 sm:shrink-0">
                  <span class="text-xs font-semibold uppercase tracking-[0.14em] text-pine-dark">{dict.plansAddon}</span>
                  <p class="mt-2 font-serif text-2xl font-black text-ink">{p.name}</p>
                  <p class="mt-2 text-salvia">{p.blurb}</p>
                  <p class="mt-4">
                    <span class="font-serif text-3xl font-black text-ink tabular-nums" data-price data-monthly={p.raw}>{fmt(p.raw)}</span>
                    <s class="ml-2 font-serif text-lg font-black text-salvia/50 tabular-nums" data-price-was hidden></s>
                    <span class="mt-0.5 block text-sm text-salvia">
                      {p.unit}<span class="text-pine-dark" data-annual-note hidden> · {dict.billAnnualNote}</span>
                    </span>
                  </p>
                </div>
                <ul class="mt-6 flex-1 space-y-2.5 text-sm text-ink sm:mt-0 sm:border-l sm:border-line sm:pl-7">
                  {p.features.map((f) => (
                    <li class="flex items-start gap-2.5">
                      <svg class="mt-0.5 h-4 w-4 shrink-0 text-pine" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                        <path d="M4 10.5 8 14.5 16 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                      <span>{f}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ══════════ VOLUMEN · tramos + ejemplo ══════════ -->
    <section class="border-b border-line">
      <div class="reveal mx-auto max-w-6xl px-5 py-24">
        <p class="mb-3 text-sm font-semibold uppercase tracking-[0.14em] text-pine-dark">{dict.volKicker}</p>
        <h2 class="max-w-2xl font-serif text-3xl font-black leading-tight text-balance md:text-4xl">{dict.volH2}</h2>
        <p class="mt-5 max-w-2xl text-lg text-salvia">{dict.volLead}</p>

        <div class="mt-12 grid grid-cols-2 gap-4 sm:gap-5 lg:grid-cols-4">
          {
            tiers.map((tr, i) => (
              <div
                class:list={[
                  'rounded-2xl border p-6',
                  i < 2 ? 'border-pine/30 bg-mint/[0.05]' : 'border-line bg-paper',
                ]}
              >
                <p class="text-sm font-semibold text-pine-dark">{tr.label}</p>
                <p class="mt-4 font-serif text-4xl font-black text-ink tabular-nums">{tr.price}</p>
                <p class="mt-1 text-sm text-salvia">{tr.each}</p>
              </div>
            ))
          }
        </div>

        <div class="mt-8 rounded-xl border-l-4 border-pine bg-paper p-6 text-salvia">
          <span class="font-semibold text-ink">{dict.volExampleBold}</span> {dict.volExample}
        </div>
      </div>
    </section>

    <!-- ══════════ CALCULADORA · tabla por nº de agendas ══════════ -->
    <section class="border-b border-line bg-paper">
      <div class="reveal mx-auto max-w-6xl px-5 py-24">
        <p class="mb-3 text-sm font-semibold uppercase tracking-[0.14em] text-pine-dark">{dict.calcKicker}</p>
        <h2 class="max-w-2xl font-serif text-3xl font-black leading-tight text-balance md:text-4xl">{dict.calcH2}</h2>
        <p class="mt-5 max-w-2xl text-lg text-salvia">{dict.calcLead}</p>

        <div
          class="mt-12 grid gap-6 rounded-2xl border border-line bg-cream p-6 shadow-[0_16px_40px_-28px_rgba(20,38,31,0.32)] md:grid-cols-2 md:gap-10 md:p-8"
          data-calc
        >
          <!-- Controles -->
          <div class="flex flex-col justify-center">
            <div class="mb-6">
              <p class="mb-2 text-sm font-semibold text-pine-dark">{dict.calcPlanLabel}</p>
              <div class="inline-flex items-center gap-1 rounded-full border border-line bg-paper p-1" role="group" aria-label={dict.calcPlanLabel}>
                <button type="button" data-plan="start" aria-pressed="true" class="bill-btn">Sara Start</button>
                <button type="button" data-plan="full" aria-pressed="false" class="bill-btn">Sara Full</button>
              </div>
            </div>
            <div class="flex items-baseline justify-between gap-4">
              <label for="calc-agendas" class="text-sm font-semibold text-pine-dark">{dict.calcAgendasLabel}</label>
              <span class="font-serif text-4xl font-black text-ink tabular-nums" data-calc-n>{DEFAULT_N}</span>
            </div>
            <input
              id="calc-agendas"
              type="range"
              min="1"
              max={calcData.max}
              value={DEFAULT_N}
              step="1"
              class="mt-4 h-2 w-full cursor-pointer appearance-none rounded-full bg-line accent-pine"
              data-calc-range
              data-unit={dict.calcUnitWord}
              aria-label={dict.calcAgendasLabel}
              aria-valuetext={`${DEFAULT_N} ${dict.calcUnitWord}`}
            />
            <div class="mt-1.5 flex justify-between text-xs text-salvia tabular-nums">
              <span>1</span><span>{calcData.max}</span>
            </div>
            <div class="mt-7 flex flex-wrap gap-3">
              <button type="button" data-calc-toggle="mia" aria-pressed="false" class="calc-chip">
                {dict.calcAddMia} <span class="calc-chip__price">{fmt(ADDON)}</span>
              </button>
              <button type="button" data-calc-toggle="daniel" aria-pressed="false" class="calc-chip">
                {dict.calcAddDaniel} <span class="calc-chip__price">{fmt(ADDON_DANIEL)}</span>
              </button>
            </div>
          </div>

          <!-- Resultado -->
          <div class="rounded-xl bg-ink p-6 text-cream">
            <p class="text-xs font-semibold uppercase tracking-[0.12em] text-cream/60">{dict.calcResultKicker}</p>
            <p class="mt-2 flex flex-wrap items-baseline gap-x-2 gap-y-1">
              <span class="font-serif text-5xl font-black tabular-nums" data-calc-total>{fmt(defaultSara)}</span>
              <s class="font-serif text-2xl font-black text-cream/40 tabular-nums" data-calc-total-was hidden></s>
              <span class="text-cream/70">
                {dict.calcTotalUnit}<span class="text-cream/50" data-annual-note hidden> · {dict.billAnnualNote}</span>
              </span>
            </p>
            <ul class="mt-5 space-y-2.5 text-sm">
              <li class="flex items-center justify-between gap-4">
                <span class="text-cream/80" data-calc-sara-label>Sara Start</span>
                <span class="tabular-nums text-cream" data-calc-sara>{fmt(defaultSara)}</span>
              </li>
              <li class="flex items-center justify-between gap-4" data-calc-row="mia" hidden>
                <span class="text-cream/80">Mia</span>
                <span class="tabular-nums text-cream" data-price data-monthly={ADDON}>{fmt(ADDON)}</span>
              </li>
              <li class="flex items-center justify-between gap-4" data-calc-row="daniel" hidden>
                <span class="text-cream/80">Daniel</span>
                <span class="tabular-nums text-cream" data-price data-monthly={ADDON_DANIEL}>{fmt(ADDON_DANIEL)}</span>
              </li>
            </ul>
            <p class="mt-4 flex items-center justify-between gap-4 border-t border-cream/15 pt-4 text-sm text-cream/70">
              <span>{dict.calcPerAgendaLabel}</span>
              <span><span class="font-semibold text-cream tabular-nums" data-calc-per>{fmt(defaultPer)}</span> {dict.calcPerAgendaUnit}</span>
            </p>
          </div>
        </div>

        <div class="mt-8 rounded-xl border-l-4 border-pine bg-cream p-6 text-salvia">
          <span class="font-semibold text-ink">{dict.scaleBold}</span> {dict.scale}
        </div>
      </div>
    </section>

    <ClientsStrip lang={lang} />

    <FeatureFaq items={faqs} lang={lang} title={dict.faqTitle} />

    <CtaBand lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>

<style>
  .calc-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border-radius: 9999px;
    border: 1px solid var(--color-line);
    background: #fff;
    padding: 0.55rem 1.05rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-ink);
    cursor: pointer;
    transition: border-color 0.15s ease, background-color 0.15s ease, color 0.15s ease;
  }
  .calc-chip__price {
    color: var(--color-salvia);
    font-variant-numeric: tabular-nums;
  }
  .calc-chip:hover {
    border-color: color-mix(in srgb, var(--color-ink) 30%, transparent);
  }
  .calc-chip[aria-pressed='true'] {
    border-color: var(--color-pine);
    background: var(--color-pine);
    color: var(--color-cream);
  }
  .calc-chip[aria-pressed='true'] .calc-chip__price {
    color: color-mix(in srgb, var(--color-cream) 78%, transparent);
  }

  input[type='range'][data-calc-range] {
    outline-offset: 4px;
  }
  input[type='range'][data-calc-range]::-webkit-slider-runnable-track {
    height: 8px;
    border-radius: 9999px;
  }
  input[type='range'][data-calc-range]::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 22px;
    height: 22px;
    margin-top: -7px;
    border-radius: 9999px;
    background: var(--color-pine);
    border: 3px solid #fff;
    box-shadow: 0 1px 4px rgba(20, 38, 31, 0.3);
    cursor: pointer;
  }
  input[type='range'][data-calc-range]::-moz-range-track {
    height: 8px;
    border-radius: 9999px;
    background: var(--color-line);
  }
  input[type='range'][data-calc-range]::-moz-range-thumb {
    width: 22px;
    height: 22px;
    border: 3px solid #fff;
    border-radius: 9999px;
    background: var(--color-pine);
    box-shadow: 0 1px 4px rgba(20, 38, 31, 0.3);
    cursor: pointer;
  }

  .bill-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    border-radius: 9999px;
    padding: 0.5rem 1.1rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-salvia);
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  .bill-btn[aria-pressed='true'] {
    background: var(--color-ink);
    color: var(--color-cream);
  }
  .bill-save {
    border-radius: 9999px;
    background: color-mix(in srgb, var(--color-mint) 22%, transparent);
    padding: 0.1rem 0.5rem;
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--color-pine-dark);
    white-space: nowrap;
  }
  .bill-btn[aria-pressed='true'] .bill-save {
    background: color-mix(in srgb, var(--color-mint) 88%, transparent);
    color: var(--color-ink);
  }
</style>

<script is:inline define:vars={{ calcData, annualCharged: ANNUAL_MONTHS_CHARGED }}>
  (function () {
    var nf = new Intl.NumberFormat('en-US');
    // 'monthly' | 'annual'. En anual el precio mensual equivalente lleva el descuento.
    var billing = 'monthly';
    function withBilling(m) {
      return billing === 'annual' ? Math.round((m * annualCharged) / 12) : m;
    }

    // ── Toggle de facturación: precios de las cards (data-price/data-monthly + tachado) ──
    var billBtns = document.querySelectorAll('[data-billing]');
    var priceEls = document.querySelectorAll('[data-price][data-monthly]');
    var annualNotes = document.querySelectorAll('[data-annual-note]');

    function renderPrices() {
      priceEls.forEach(function (el) {
        var m = parseInt(el.getAttribute('data-monthly'), 10);
        var was = el.parentElement.querySelector('[data-price-was]');
        el.textContent = nf.format(withBilling(m));
        if (was) {
          if (billing === 'annual') {
            was.textContent = nf.format(m);
            was.hidden = false;
          } else {
            was.hidden = true;
          }
        }
      });
      annualNotes.forEach(function (n) {
        n.hidden = billing !== 'annual';
      });
    }

    // ── Calculadora ──
    var root = document.querySelector('[data-calc]');
    var range = root && root.querySelector('[data-calc-range]');
    var nOut = root && root.querySelector('[data-calc-n]');
    var totalOut = root && root.querySelector('[data-calc-total]');
    var totalWas = root && root.querySelector('[data-calc-total-was]');
    var saraOut = root && root.querySelector('[data-calc-sara]');
    var perOut = root && root.querySelector('[data-calc-per]');
    var rowMia = root && root.querySelector('[data-calc-row="mia"]');
    var rowDaniel = root && root.querySelector('[data-calc-row="daniel"]');
    var saraLabelOut = root && root.querySelector('[data-calc-sara-label]');
    var planBtns = root ? root.querySelectorAll('[data-plan]') : [];
    var unit = (range && range.getAttribute('data-unit')) || '';
    var state = { mia: false, daniel: false };
    var plan = 'start'; // 'start' (49 por agenda, plano) | 'full' (tramos por volumen)

    // Sara Start = 49 x nº de agendas (plano). Sara Full = total con tramos por volumen.
    function saraMonthlyFor(n) {
      return plan === 'full' ? calcData.totals[n - 1] : calcData.start * n;
    }

    function renderCalc() {
      if (!root) return;
      var n = parseInt(range.value, 10) || 1;
      var saraM = saraMonthlyFor(n);
      // Sumamos las partes ya con el descuento aplicado, así el total coincide con las filas.
      var saraNow = withBilling(saraM);
      var total = saraNow + (state.mia ? withBilling(calcData.mia) : 0) + (state.daniel ? withBilling(calcData.daniel) : 0);
      nOut.textContent = String(n);
      saraOut.textContent = nf.format(saraNow);
      totalOut.textContent = nf.format(total);
      perOut.textContent = nf.format(Math.round(total / n));
      if (saraLabelOut) saraLabelOut.textContent = plan === 'full' ? 'Sara Full' : 'Sara Start';
      if (rowMia) rowMia.hidden = !state.mia;
      if (rowDaniel) rowDaniel.hidden = !state.daniel;
      // Tachado del total: el mensual sin descuento.
      if (totalWas) {
        if (billing === 'annual') {
          var monthly = saraM + (state.mia ? calcData.mia : 0) + (state.daniel ? calcData.daniel : 0);
          totalWas.textContent = nf.format(monthly);
          totalWas.hidden = false;
        } else {
          totalWas.hidden = true;
        }
      }
      range.setAttribute('aria-valuenow', String(n));
      range.setAttribute('aria-valuetext', n + ' ' + unit);
    }

    function renderAll() {
      renderPrices();
      renderCalc();
    }

    billBtns.forEach(function (b) {
      b.addEventListener('click', function () {
        billing = b.getAttribute('data-billing');
        billBtns.forEach(function (x) {
          x.setAttribute('aria-pressed', x === b ? 'true' : 'false');
        });
        renderAll();
      });
    });

    if (range) range.addEventListener('input', renderCalc);
    planBtns.forEach(function (b) {
      b.addEventListener('click', function () {
        plan = b.getAttribute('data-plan');
        planBtns.forEach(function (x) {
          x.setAttribute('aria-pressed', x === b ? 'true' : 'false');
        });
        renderCalc();
      });
    });
    if (root) {
      root.querySelectorAll('[data-calc-toggle]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var k = btn.getAttribute('data-calc-toggle');
          state[k] = !state[k];
          btn.setAttribute('aria-pressed', state[k] ? 'true' : 'false');
          renderCalc();
        });
      });
    }

    renderAll();
  })();
</script>
