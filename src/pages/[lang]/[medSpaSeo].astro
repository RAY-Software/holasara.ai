      { who: 'out', text: "Saturday 10:30 am or 11:45 am. A deposit locks it in and comes off the treatment. Here's the link:", link: 'pay.rayhealth.app/c/aurora-5302', t: '7:50 pm' },
      { who: 'in', text: '10:30. Paid', t: '7:53 pm' },
      { who: 'out', text: "Payment received. Saturday 10:30 am confirmed. I'll text you the day before as a reminder.", t: '7:53 pm' },
    ],
    ctaInline: 'Get found on Google and picked on&nbsp;Instagram.',
    panelKicker: 'How it looks in your dashboard',
    panelH2: 'Every week leaves a&nbsp;trail.',
    panelLead:
      'In the dashboard you see what Mia did and what Sara closed: the updated profile, the published post and article, and the consult that came out of&nbsp;them.',
    estados: [
      { tag: 'Profile updated', desc: 'Mia added photos or fixed details on your Google Business Profile this week.' },
      { tag: 'Post published', desc: 'The Instagram post went live with your brand, on the day and time you approved.' },
      { tag: 'Article published', desc: "This week's article is on your site, FAQs included." },
      { tag: 'Consult booked', desc: 'Sara answered whoever found you and left the consult booked with the deposit.' },
    ],
    related:
      `Mia does dental SEO too: <a class="font-medium text-pine-dark underline decoration-pine/30 underline-offset-4 hover:decoration-pine" href="${L('/seo-dental')}">also for dental offices</a>. And Sara answers and books for <a class="font-medium text-pine-dark underline decoration-pine/30 underline-offset-4 hover:decoration-pine" href="${L('/negocios/medicina-estetica')}">medical aesthetics clinics</a> and <a class="font-medium text-pine-dark underline decoration-pine/30 underline-offset-4 hover:decoration-pine" href="${L('/negocios/estetica-spa')}">aesthetics and spa businesses</a>.`,
    faqs: [
      { q: 'Does Mia replace my med spa SEO agency?', a: "It depends on what your agency does today. What Mia does, she does end to end and every week: Google Business Profile, articles on your site, Instagram, Google Ads campaigns when they pay off, and your site metrics. You can use her instead of an agency or add her for what the agency doesn't cover. We look at your case in the demo." },
      { q: 'What does Mia do each week?', a: 'She reviews how people searched for you and what happened with your profile, your site and your Instagram. She messages you a recap with a concrete proposal: fresh photos for the profile, an article, a post, a seasonal campaign. You approve over chat and she runs it and publishes it. The following Monday she tells you what it brought.' },
      { q: 'Instagram or Google, which matters more for a med spa?', a: 'Both, which is why Mia runs both. Google is where people search once they already want the treatment (“botox near me”); Instagram is where they look at your work before choosing you. A med spa that shows up on the map with a dead feed loses half the journey.' },
      { q: 'How long until I see results?', a: "It depends on your area, your competition and where your profile and site stand today. The Google Business Profile is usually the first thing to move, because it's what Mia fixes first; content takes longer to add up. What you do get from week one is the recap: you know what was done and what's bringing people in. We don't promise rankings or timelines." },
      { q: 'Does she publish without my approval?', a: 'No. Mia prepares the article, the post or the photos and shows them to you in the dashboard or over WhatsApp. Nothing gets published without your ok.' },
      { q: 'What about seasonal campaigns?', a: "When it pays off, Mia builds and runs Google Ads campaigns: laser hair removal before summer, Botox before the holidays, a slow week that needs filling. She pitches the campaign with a budget, you adjust or approve it, and she tells you what it brought. If it doesn't pay off, she won't pitch it." },
      { q: 'How much does it cost?', a: "Pricing is put together for each practice, based on country and size, and shared in the demo. It's a flat monthly subscription, no per-appointment commission and no agency hours." },
    ],
  },
}[lang];

const { steps, estados, faqs, gbp, ig, blog, cmpHead, cmpRows } = dict;
---

<Layout ogImage={`/og/med-spa-seo-${lang}.jpg`} lang={lang} title={dict.metaTitle} description={dict.metaDescription}>
  <Header lang={lang} />
  <main>
    <PageHero
      lang={lang}
      eyebrow={dict.heroEyebrow}
      title={dict.heroTitle}
      lead={dict.heroLead}
      image="/img/hero/seo-estetica-hero.jpg"
      imageAlt={dict.heroImageAlt}
      imageW={1024}
      imageH={768}
    />

    <!-- ══════════ TIRA DE MECÁNICA (lo que hace Mia, no stats) ══════════ -->
    <section class="border-b border-line bg-paper">
      <div class="mx-auto grid max-w-6xl gap-8 px-5 py-10 sm:grid-cols-3">
        <div class="py-2">
          <p class="font-serif text-lg font-black text-ink">{dict.strip[0].t}</p>
          <p class="mt-1 text-salvia">{dict.strip[0].b}</p>
        </div>
        <div class="py-2 sm:border-l sm:border-line sm:pl-8">
          <p class="font-serif text-lg font-black text-ink">{dict.strip[1].t}</p>
          <p class="mt-1 text-salvia">{dict.strip[1].b}</p>
        </div>
        <div class="py-2 sm:border-l sm:border-line sm:pl-8">
          <p class="font-serif text-lg font-black text-ink">{dict.strip[2].t}</p>
          <p class="mt-1 text-salvia">{dict.strip[2].b}</p>
        </div>
      </div>
    </section>

    <!-- ══════════ CÓMO LO HACE MIA · resumen semanal por WhatsApp ══════════ -->
    <section class="border-t border-line">
      <div class="reveal mx-auto grid max-w-6xl items-center gap-14 px-5 py-24 md:grid-cols-[1.05fr_0.95fr]">
        <div>
          <p class="mb-3 text-sm font-semibold uppercase tracking-[0.14em] text-pine-dark">{dict.howKicker}</p>
          <h2 class="font-serif text-3xl font-black leading-tight text-balance md:text-4xl" set:html={dict.howH2} />
          <p class="mt-5 text-lg text-salvia">
            {dict.howP1}
          </p>
          <p class="mt-4 text-salvia" set:html={dict.howP2} />
        </div>
        <div class="flex justify-center md:justify-end">
          <ConversationDemo
            lang={lang}
            channel="whatsapp"
            name="Mia"
            avatar="/equipo/mia-avatar.jpg"
            bubbles={dict.howBubbles}
          />
        </div>
      </div>
    </section>

    <!-- ══════════ CÓMO FUNCIONA · 3 tiempos (banda oscura) ══════════ -->
    <section class="border-t border-line bg-ink text-cream">
      <div class="reveal mx-auto max-w-6xl px-5 py-24">
        <h2 class="max-w-2xl font-serif text-3xl font-black leading-tight text-balance md:text-4xl" set:html={dict.stepsH2} />
        <div class="mt-14 grid gap-x-10 gap-y-12 md:grid-cols-3">
          {
            steps.map((s) => (
              <div>
                <div class="flex items-center gap-4">
                  <span class="font-serif text-4xl font-black text-mint tabular-nums">{s.n}</span>
                  <span class="h-px flex-1 bg-cream/15" />
                </div>
                <h3 class="mt-5 text-xl font-semibold text-cream">{s.title}</h3>
                <p class="mt-2 text-cream/65">{s.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ══════════ CAPACIDADES · filas alternadas (copy + visual) ══════════ -->
    <section class="border-t border-line">
      <div class="reveal mx-auto flex max-w-6xl flex-col gap-24 px-5 py-24">
        <!-- Fila 1 · Ficha de Google (tarjeta estilo ficha, solo HTML/Tailwind) -->
        <div id="google-business-profile" class="scroll-mt-24">
          <FeatureRow
            eyebrow={dict.row1Eyebrow}
            title={dict.row1Title}
            body={dict.row1Body}
            points={dict.row1Points}
          >
            <figure class="w-full max-w-sm overflow-hidden rounded-xl border border-line bg-white shadow-[0_10px_30px_-20px_rgba(20,38,31,0.28)]">
              <div class="grid grid-cols-3 gap-0.5">
                <img src="/img/tenants/faceup.jpg" alt="" class="aspect-[4/3] w-full object-cover" loading="lazy" decoding="async" />
                <img src="/img/tenants/physiup.jpg" alt="" class="aspect-[4/3] w-full object-cover" loading="lazy" decoding="async" />
                <img src="/img/tenants/sorace.jpg" alt="" class="aspect-[4/3] w-full object-cover" loading="lazy" decoding="async" />
              </div>
              <div class="px-4 pb-4 pt-3">
                <div class="flex items-start gap-3">
                  <img src="/img/logos/google.svg" alt="" width="20" height="20" class="mt-0.5 h-5 w-5 shrink-0" loading="lazy" decoding="async" />
                  <div class="min-w-0">
                    <p class="text-base font-semibold leading-tight text-ink">{gbp.name}</p>
                    <p class="mt-0.5 text-xs text-salvia">{gbp.cat}</p>
                  </div>
                </div>
                <div class="mt-2.5 flex items-center gap-1.5 text-sm">
                  <span class="font-medium text-ink">{gbp.rating}</span>
                  <span class="tracking-tight text-[#fbbc04]" aria-hidden="true">★★★★★</span>
                  <span class="text-salvia">({gbp.count})</span>
                </div>
                <p class="mt-1 text-sm">
                  <span class="font-medium text-[#188038]">{gbp.open}</span>
                  <span class="text-salvia"> · {gbp.closes}</span>
                </p>
                <div class="mt-3 grid grid-cols-3 gap-2 text-xs font-medium text-[#1a73e8]">
                  <span class="flex flex-col items-center gap-1 rounded-lg border border-line py-2">
                    <svg viewBox="0 0 24 24" fill="none" class="h-4 w-4" aria-hidden="true"><path d="M6.6 10.8a15 15 0 006.6 6.6l2.2-2.2a1 1 0 011-.24 11 11 0 003.5.56 1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.2.2 2.4.56 3.5a1 1 0 01-.24 1l-2.2 2.3z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" /></svg>
                    {gbp.call}
                  </span>
                  <span class="flex flex-col items-center gap-1 rounded-lg border border-line py-2">
                    <svg viewBox="0 0 24 24" fill="none" class="h-4 w-4" aria-hidden="true"><path d="M12 2l10 10-10 10L2 12 12 2z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" /><path d="M9 13v-2h5V9l3 3-3 3v-2H9z" fill="currentColor" /></svg>
                    {gbp.directions}
                  </span>
                  <span class="flex flex-col items-center gap-1 rounded-lg border border-line py-2">
                    <svg viewBox="0 0 24 24" fill="none" class="h-4 w-4" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8" /><path d="M3 12h18M12 3c3 3.5 3 14.5 0 18M12 3c-3 3.5-3 14.5 0 18" stroke="currentColor" stroke-width="1.8" /></svg>
                    {gbp.website}
                  </span>
                </div>
                <p class="mt-3 inline-flex items-center gap-1.5 rounded-full border border-pine/20 bg-mint/[0.12] px-2.5 py-1 text-xs font-medium text-pine-dark">
                  <span class="h-1.5 w-1.5 rounded-full bg-mint"></span>
                  {gbp.updated}
                </p>
              </div>
            </figure>
          </FeatureRow>
        </div>

        <!-- Fila 2 · Google e Instagram, juntos (post de estética) -->
        <FeatureRow
          flip
          eyebrow={dict.row2Eyebrow}
          title={dict.row2Title}
          body={dict.row2Body}
          points={dict.row2Points}
        >
          <IgPost lang={lang} img="/img/tenants/faceup.jpg" caption={ig.caption} likes={ig.likes} comment={ig.comment} class="w-full max-w-sm" />
        </FeatureRow>

        <!-- Fila 3 · Contenido que responde antes de la valoración (tarjeta de blog) -->
        <FeatureRow
          eyebrow={dict.row3Eyebrow}
          title={dict.row3Title}
          body={dict.row3Body}
          points={dict.row3Points}
        >
          <figure class="w-full max-w-sm overflow-hidden rounded-xl border border-line bg-white shadow-[0_10px_30px_-20px_rgba(20,38,31,0.28)]">
            <img src="/img/mia/blog.jpg" alt="" class="aspect-[16/10] w-full object-cover" loading="lazy" decoding="async" />
            <div class="p-5">
              <p class="text-xs font-semibold uppercase tracking-[0.14em] text-pine-dark">{blog.kind}</p>
              <p class="mt-2 font-serif text-xl font-black leading-snug text-ink">{blog.title}</p>
              <p class="mt-2 text-sm text-salvia">{blog.excerpt}</p>
              <p class="mt-4 text-xs font-semibold uppercase tracking-[0.14em] text-salvia">{blog.faqLabel}</p>
              <ul class="mt-2 flex flex-col gap-1.5 text-sm text-ink">
                {
                  blog.faqs.map((q) => (
                    <li class="flex items-start gap-2">
                      <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-mint" />
                      <span>{q}</span>
                    </li>
                  ))
                }
              </ul>
              <div class="mt-4 flex items-center justify-between gap-3 border-t border-line pt-3 text-xs">
                <span class="inline-flex items-center gap-1.5 font-medium text-pine-dark">
                  <span class="h-1.5 w-1.5 rounded-full bg-mint"></span>
                  {blog.status}
                </span>
                <span class="text-salvia">{blog.by}</span>
              </div>
            </div>
          </figure>
        </FeatureRow>

        <!-- Fila 4 · Agencia vs Mia (tabla inline, sin números) -->
        <FeatureRow
          flip
          eyebrow={dict.row4Eyebrow}
          title={dict.row4Title}
          body={dict.row4Body}
        >
          <div class="w-full overflow-x-auto rounded-2xl border border-line bg-white">
            <table class="w-full min-w-[440px] border-collapse text-sm">
              <thead>
                <tr class="border-b border-line bg-mint/[0.07] text-left">
                  <th class="px-4 py-3"></th>
                  <th class="whitespace-nowrap px-4 py-3 font-semibold text-ink">{cmpHead.agency}</th>
                  <th class="whitespace-nowrap px-4 py-3 font-semibold text-pine-dark">{cmpHead.mia}</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-line">
                {
                  cmpRows.map((row, r) => (
                    <tr class={r % 2 ? 'bg-mint/[0.03]' : ''}>
                      <td class="px-4 py-3 align-top font-medium text-ink">{row.label}</td>
                      <td class="px-4 py-3 align-top text-salvia">{row.agency}</td>
                      <td class="px-4 py-3 align-top text-ink">{row.mia}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </FeatureRow>

        <!-- Fila 5 · De la búsqueda a la valoración agendada (Sara cobra el anticipo) -->
        <FeatureRow
          eyebrow={dict.row5Eyebrow}
          title={dict.row5Title}
          body={dict.row5Body}
          points={dict.row5Points}
        >
          <ConversationDemo
            lang={lang}
            channel="whatsapp"
            bubbles={dict.row5Bubbles}
          />
        </FeatureRow>
      </div>
    </section>

    <CtaInline title={dict.ctaInline} lang={lang} />

    <!-- ══════════ ASÍ SE VE EN TU PANEL · estados ══════════ -->
    <section class="border-t border-line bg-paper">
      <div class="reveal mx-auto max-w-6xl px-5 py-24">
        <p class="mb-3 text-sm font-semibold uppercase tracking-[0.14em] text-pine-dark">{dict.panelKicker}</p>
        <h2 class="max-w-2xl font-serif text-3xl font-black leading-tight text-balance md:text-4xl" set:html={dict.panelH2} />
        <p class="mt-5 max-w-2xl text-lg text-salvia" set:html={dict.panelLead} />
        <div class="mt-12 grid gap-6 md:grid-cols-2">
          {
            estados.map((e) => (
              <div class="flex items-start gap-4 rounded-xl border border-line bg-cream p-6">
                <span class="shrink-0 rounded-full border border-pine/20 bg-mint/[0.12] px-3 py-1.5 text-sm font-medium text-pine-dark">
                  {e.tag}
                </span>
                <p class="text-salvia">{e.desc}</p>
              </div>
            ))
          }
        </div>
        <p class="mt-12 max-w-2xl text-salvia" set:html={dict.related} />
      </div>
    </section>

    <FeatureFaq items={faqs} lang={lang} />

    <CtaBand lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>
