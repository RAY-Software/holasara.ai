---
import { getStaticPaths, toLocale } from '../../i18n/config';
export { getStaticPaths };
import { localePath } from '../../i18n/config';
const lang = toLocale(Astro.params.lang);
const L = (p: string) => localePath(p, lang);
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SaraSelect from '../../components/SaraSelect.astro';
import PlacesAutocomplete from '../../components/PlacesAutocomplete.astro';
import ClientsStrip from '../../components/ClientsStrip.astro';
import { WHATSAPP_AR, WHATSAPP_MX, SRC_TAG, whatsappLink } from '../../lib/whatsapp';

// Endpoint opcional para el lead (Zapier/Make catch hook). Si no está seteado,
// el formulario hace handoff a WhatsApp con un resumen prellenado, así siempre
// funciona sin backend. Cuando quieras CRM, setea PUBLIC_DEMO_ENDPOINT en Vercel.
const DEMO_ENDPOINT = import.meta.env.PUBLIC_DEMO_ENDPOINT ?? '';

// ── Copy por idioma. EN es traducción, no calco. ──
const dict = {
  es: {
    metaTitle: 'Pide tu demo · Sara',
    metaDescription:
      'Agenda una demo de Sara con tu propia clínica: mira cómo atiende WhatsApp e Instagram, agenda y cobra el anticipo, en vivo.',
    back: 'Volver al inicio',
    kicker: 'Pide tu demo',
    h1: 'Mira a Sara <span class="whitespace-nowrap">atender <em class="text-pine-dark">tu</em> clínica.</span>',
    heroSub:
      'No es una presentación con diapositivas. Cargamos tus tratamientos y pruebas una consulta real: Sara responde, agenda y cobra el anticipo frente a ti.',
    proofBadge: 'Ya trabaja aquí',
    stat1: 'consultas atendidas sin recepción',
    stat2: 'citas agendadas por Sara',
    roleLabel: '¿Cuál es tu rol?',
    roleOptions: [
      { value: 'Dueño/a', label: 'Dueño/a de la clínica' },
      { value: 'Director/a médico', label: 'Director/a médico' },
      { value: 'Gerencia/Administración', label: 'Gerencia o administración' },
      { value: 'Recepción', label: 'Recepción' },
      { value: 'Otro', label: 'Otro' },
    ],
    // Estos cuatro venden a Sara, no a la demo. La demo ya está vendida arriba, en el H1
    // y la bajada: quien llega desde un anuncio no conoce el producto y no le sirve que
    // le expliquemos cómo es la reunión antes de saber qué hace ella.
    benefits: [
      {
        t: 'Contesta la consulta de las 23:41',
        b: 'Responde en el momento por WhatsApp, Instagram y el chat de tu web. De noche, los fines de semana y en los picos. La clínica que responde primero se queda con el paciente.',
      },
      {
        t: 'Informa y aconseja, no da botones',
        b: 'Explica tratamientos, da precios reales y arma la propuesta que conviene, con el tono de tu clínica. Nunca inventa nada.',
      },
      {
        t: 'Agenda y cobra en la misma conversación',
        b: 'Reserva sobre tu disponibilidad real, sin dobles reservas, y toma el anticipo con un link de pago seguro. Después recuerda, confirma y reofrece los huecos que se liberan.',
      },
      {
        t: 'Se suma sin que cambies nada',
        b: 'Trabaja sobre tu WhatsApp y el Google Calendar que ya usas. No migras datos ni toca tu historia clínica.',
      },
    ],
    formTitle: 'Cuéntanos de tu\u00a0clínica',
    formSub: 'Te escribimos el mismo día para coordinar. Sin compromiso.',
    nameLabel: 'Nombre y apellido',
    clinicLabel: 'Nombre de la clínica',
    clinicHint: 'Empieza a escribir y elígela de la lista.',
    phoneLabel: 'WhatsApp',
    phonePlaceholder: '+52 …',
    emailLabel: 'Email',
    emailOptional: '(opcional)',
    consent: 'Acepto que Sara me contacte por WhatsApp o email para coordinar la demo.',
    submit: 'Pedir mi demo',
    waPrompt: '¿Prefieres escribir ahora?',
    waLink: 'Habla con Sara por WhatsApp',
    waFallbackMsg: 'Hola Sara, quiero una demo para mi clínica.',
    successTitle: 'Listo, lo recibimos.',
    successBody: 'Te escribimos hoy mismo por WhatsApp para coordinar la demo con tu clínica.',
    script: {
      sending: 'Enviando…',
      errRequired: 'Completa los campos requeridos para pedir tu demo.',
      errEmail: 'Revisa el email: no parece válido.',
      errConsent: 'Necesitamos tu OK para contactarte y coordinar la demo.',
      waIntro: 'Hola Sara, quiero una demo para mi clínica.',
      labelClinic: 'Clínica',
      labelName: 'Nombre',
      labelRole: 'Rol',
    },
  },
  en: {
    metaTitle: 'Book your demo · Sara',
    metaDescription:
      'Book a Sara demo with your own clinic: see how she handles WhatsApp and Instagram, books and collects the deposit, live.',
    back: 'Back to home',
    kicker: 'Book a demo',
    h1: 'Watch Sara <span class="whitespace-nowrap">handle <em class="text-pine-dark">your</em> clinic.</span>',
    heroSub:
      "This isn't a slideshow. We load your treatments and run a real enquiry: Sara replies, books and collects the deposit right in front of you.",
    proofBadge: 'Already working here',
    stat1: 'enquiries handled without a front desk',
    stat2: 'appointments booked by Sara',
    roleLabel: "What's your role?",
    roleOptions: [
      { value: 'Owner', label: 'Clinic owner' },
      { value: 'Medical director', label: 'Medical director' },
      { value: 'Management/Admin', label: 'Management or admin' },
      { value: 'Front desk', label: 'Front desk' },
      { value: 'Other', label: 'Other' },
    ],
    benefits: [
      {
        t: 'Answers the 11:41 pm enquiry',
        b: 'Replies instantly on WhatsApp, Instagram and your website chat. At night, on weekends and during peak hours. The clinic that answers first keeps the patient.',
      },
      {
        t: 'Informs and advises, no buttons',
        b: "Explains treatments, gives real prices and puts together the right proposal, in your clinic's tone. She never makes anything up.",
      },
      {
        t: 'Books and charges in the same conversation',
        b: 'Books on your real availability, with no double bookings, and takes the deposit through a secure payment link. Then she reminds, confirms and re-offers the slots that open up.',
      },
      {
        t: 'Fits in without you changing a thing',
        b: 'She works on your WhatsApp and the Google Calendar you already use. You migrate no data and she never touches your medical records.',
      },
    ],
    formTitle: 'Tell us about your clinic',
    formSub: 'We write you the same day to set it up. No commitment.',
    nameLabel: 'Full name',
    clinicLabel: 'Clinic name',
    clinicHint: 'Start typing and pick it from the list.',
    phoneLabel: 'WhatsApp',
    phonePlaceholder: '+52 …',
    emailLabel: 'Email',
    emailOptional: '(optional)',
    consent: 'I agree to let Sara contact me by WhatsApp or email to set up the demo.',
    submit: 'Book my demo',
    waPrompt: 'Prefer to write now?',
    waLink: 'Talk to Sara on WhatsApp',
    waFallbackMsg: 'Hi Sara, I want a demo for my clinic.',
    successTitle: 'Done, we got it.',
    successBody: "We'll write you today on WhatsApp to set up the demo with your clinic.",
    script: {
      sending: 'Sending…',
      errRequired: 'Please complete the required fields to book your demo.',
      errEmail: "Check the email: it doesn't look valid.",
      errConsent: 'We need your OK to contact you and set up the demo.',
      waIntro: 'Hi Sara, I want a demo for my clinic.',
      labelClinic: 'Clinic',
      labelName: 'Name',
      labelRole: 'Role',
    },
  },
}[lang];

const roleOptions = dict.roleOptions;
const benefits = dict.benefits;
---

<Layout ogImage={`/og/demo-${lang}.jpg`} lang={lang}
  title={dict.metaTitle}
  description={dict.metaDescription}
>
  <Header lang={lang} />

  <main class="bg-paper">
    <div class="mx-auto max-w-6xl px-5 py-14 md:py-20">
      <a href={L('/')} class="mb-8 inline-flex items-center gap-1.5 text-sm font-medium text-salvia transition-colors hover:text-ink">
        <span aria-hidden="true">←</span> {dict.back}
      </a>

      <div class="grid gap-12 md:grid-cols-[0.95fr_1.05fr] md:gap-16 md:items-start">
        <!-- ─── Izquierda: por qué + prueba real ─── -->
        <div>
          <p class="mb-4 flex items-center gap-2.5 text-sm font-semibold uppercase tracking-[0.14em] text-pine-dark">
            <span class="dot h-2 w-2"></span> {dict.kicker}
          </p>
          <h1 class="font-serif text-4xl font-black leading-[1.05] tracking-tight text-balance md:text-5xl" set:html={dict.h1} />
          <p class="mt-6 max-w-xl text-lg text-salvia">{dict.heroSub}</p>

          <!-- Prueba real: ViaLaser (no inventamos testimonios) -->
          <div class="mt-10 rounded-xl border border-line bg-cream p-7">
            <div class="flex items-center gap-3">
              <img src="/img/vialaser-logo.png" width="398" height="126" alt="ViaLaser" class="h-7 w-auto" loading="lazy" />
              <span class="text-sm font-medium text-salvia">{dict.proofBadge}</span>
            </div>
            <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
              <div>
                <p class="font-serif text-3xl font-black text-pine-dark tabular-nums md:text-4xl">114</p>
                <p class="mt-1 text-xs leading-tight text-salvia">{dict.stat1}</p>
              </div>
              <div>
                <p class="font-serif text-3xl font-black text-pine-dark tabular-nums md:text-4xl">7/10</p>
                <p class="mt-1 text-xs leading-tight text-salvia">{dict.stat2}</p>
              </div>
            </div>
          </div>

          <ul class="mt-8 grid gap-5 sm:grid-cols-2">
            {
              benefits.map((x) => (
                <li>
                  <h3 class="text-[15px] font-semibold text-ink">{x.t}</h3>
                  <p class="mt-1 text-sm text-salvia">{x.b}</p>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- ─── Derecha: formulario ─── -->
        <div class="rounded-2xl border border-line bg-cream p-7 shadow-[0_10px_30px_-20px_rgba(20,38,31,0.28)] md:p-9">
          <h2 class="font-serif text-2xl font-black text-ink">{dict.formTitle}</h2>
          <p class="mt-2 text-sm text-salvia">{dict.formSub}</p>

          <form id="demo-form" class="mt-7 flex flex-col gap-5" novalidate data-endpoint={DEMO_ENDPOINT}>
            <SaraSelect name="role" label={dict.roleLabel} options={roleOptions} required lang={lang} />

            <div>
              <label for="name" class="mb-1.5 block text-sm font-medium text-ink">{dict.nameLabel}</label>
              <input id="name" name="name" type="text" autocomplete="name" required class="w-full rounded-xl border border-line bg-white px-3.5 py-2.5 text-ink focus:border-pine focus:outline-none focus:ring-2 focus:ring-pine/25" />
            </div>

            <div>
              <label for="clinic" class="mb-1.5 block text-sm font-medium text-ink">{dict.clinicLabel}</label>
              <input
                id="clinic"
                name="clinic"
                type="text"
                autocomplete="off"
                required
                data-places-autocomplete
                data-hint="clinic-hint"
                data-country="auto"
                data-target-place-id="clinic_place_id"
                data-target-address="clinic_address"
                class="w-full rounded-xl border border-line bg-white px-3.5 py-2.5 text-ink focus:border-pine focus:outline-none focus:ring-2 focus:ring-pine/25"
              />
              <p id="clinic-hint" class="mt-1 hidden text-xs text-salvia">{dict.clinicHint}</p>
              <input type="hidden" name="clinic_place_id" id="clinic_place_id" />
              <input type="hidden" name="clinic_address" id="clinic_address" />
            </div>

            <div>
              <label for="phone" class="mb-1.5 block text-sm font-medium text-ink">{dict.phoneLabel}</label>
              <input id="phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" placeholder={dict.phonePlaceholder} required class="w-full rounded-xl border border-line bg-white px-3.5 py-2.5 text-ink focus:border-pine focus:outline-none focus:ring-2 focus:ring-pine/25" />
            </div>

            <div>
              <label for="email" class="mb-1.5 block text-sm font-medium text-ink">
                {dict.emailLabel} <span class="font-normal text-salvia">{dict.emailOptional}</span>
              </label>
              <input id="email" name="email" type="email" autocomplete="email" class="w-full rounded-xl border border-line bg-white px-3.5 py-2.5 text-ink focus:border-pine focus:outline-none focus:ring-2 focus:ring-pine/25" />
            </div>

            <!-- Atribución: se rellenan al enviar, desde la URL o la cookie sara_click -->
            <input type="hidden" name="gclid" id="f_gclid" />
            <input type="hidden" name="wbraid" id="f_wbraid" />
            <input type="hidden" name="gbraid" id="f_gbraid" />
            <input type="hidden" name="fbclid" id="f_fbclid" />

            <label class="flex items-start gap-3 text-sm text-salvia">
              <input type="checkbox" name="consent" required class="mt-1 h-4 w-4 shrink-0 rounded border-line text-pine focus:ring-pine/25" />
              <span>{dict.consent}</span>
            </label>

            <p id="demo-error" class="hidden rounded-xl border border-red-300 bg-red-50 px-4 py-3 text-sm text-red-700"></p>

            <button
              type="submit"
              id="demo-submit"
              class="mt-1 inline-flex items-center justify-center gap-2 rounded-full bg-pine px-6 py-3.5 text-base font-semibold text-cream transition-colors hover:bg-pine-dark disabled:cursor-not-allowed disabled:opacity-60"
            >
              {dict.submit}
            </button>

            <p class="text-center text-xs text-salvia">
              {dict.waPrompt} <a href={whatsappLink(dict.waFallbackMsg)} data-wa-fallback class="font-semibold text-pine-dark underline">{dict.waLink}</a>.
            </p>
          </form>

          <!-- Estado de éxito -->
          <div id="demo-success" class="hidden">
            <div class="grid place-items-center py-6 text-center">
              <span class="grid h-14 w-14 place-items-center rounded-full bg-mint">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M5 13l4 4L19 7" stroke="#14261F" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
              <h2 class="mt-5 font-serif text-2xl font-black text-ink">{dict.successTitle}</h2>
              <p class="mt-2 max-w-sm text-salvia">{dict.successBody}</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <ClientsStrip lang={lang} />

  <Footer lang={lang} />

  <script is:inline define:vars={{ WHATSAPP_AR, WHATSAPP_MX, SRC_TAG, T: dict.script }}>
    (function () {
      var form = document.getElementById('demo-form');
      if (!form) return;
      var btn = document.getElementById('demo-submit');
      var errBox = document.getElementById('demo-error');
      var endpoint = form.getAttribute('data-endpoint') || '';

      // Ruteo AR/MX (mismo criterio que el resto del sitio)
      var IS_AR = false;
      try {
        var tz = (Intl.DateTimeFormat().resolvedOptions().timeZone) || '';
        IS_AR = /America\/Argentina/.test(tz) || /^es-AR/i.test(navigator.language || '');
      } catch (e) {}
      var WA = IS_AR ? WHATSAPP_AR : WHATSAPP_MX;

      // El autocompletado del campo clínica vive en <PlacesAutocomplete />: le pega a
      // nuestro /api/places-autocomplete, así que la key de Google no viaja al cliente.

      // ── Atribución ──────────────────────────────────────────────────────────
      // Click-ids de la URL; si no vienen, de la cookie sara_click (90 días) que
      // deja el script del Layout. Sirven para dos cosas: subir la conversión
      // offline cuando el lead cierra, y arrastrar el token al handoff de WhatsApp.
      var CLICK_KEYS = ['gclid', 'wbraid', 'gbraid', 'fbclid'];

      function clickIds() {
        var out = {};
        var p = new URLSearchParams(location.search);
        var found = false;
        CLICK_KEYS.forEach(function (k) {
          out[k] = p.get(k) || '';
          if (out[k]) found = true;
        });
        if (found) return out;
        var m = document.cookie.match('(^|;)\\s*sara_click\\s*=\\s*([^;]+)');
        var raw = m ? decodeURIComponent(m.pop()) : '';
        CLICK_KEYS.forEach(function (k) {
          var mm = raw.match(new RegExp('\\[' + k + ':([^\\]]+)\\]'));
          out[k] = mm ? mm[1] : '';
        });
        return out;
      }

      function clickToken(ids) {
        return CLICK_KEYS.filter(function (k) {
          return ids[k];
        })
          .map(function (k) {
            return '[' + k + ':' + ids[k] + ']';
          })
          .join('');
      }

      // ── Enhanced Conversions ────────────────────────────────────────────────
      // gtag hashea (SHA-256) del lado del cliente; nosotros solo normalizamos.
      // Teléfono a E.164: si no trae +, le anteponemos el código del país detectado.
      function normPhone(raw) {
        var s = String(raw || '').trim();
        if (s.charAt(0) === '+') return '+' + s.slice(1).replace(/\D/g, '');
        var d = s.replace(/\D/g, '');
        if (!d) return '';
        var cc = IS_AR ? '54' : '52';
        if (d.length > 10 && d.indexOf(cc) === 0) return '+' + d;
        return '+' + cc + d;
      }

      function setUserData(data) {
        try {
          if (!window.gtag) return;
          var ud = {};
          var mail = String(data.email || '').trim().toLowerCase();
          var tel = normPhone(data.phone);
          if (mail) ud.email = mail;
          if (tel) ud.phone_number = tel;
          if (ud.email || ud.phone_number) gtag('set', 'user_data', ud);
        } catch (e) {}
      }

      function showError(msg) {
        errBox.textContent = msg;
        errBox.classList.remove('hidden');
      }

      // Dispara los eventos de lead y llama a cb() cuando Ads confirmó (o a los 900 ms,
      // lo que pase primero). Sin esto, el redirect a WhatsApp mata el request de
      // conversión antes de que salga y se pierden leads en el reporte.
      function fireLead(data, cb) {
        var done = false;
        function once() {
          if (done) return;
          done = true;
          if (cb) cb();
        }

        try { if (window.fbq) fbq('track', 'Lead', { content_name: 'demo-page' }); } catch (e) {}

        var c = window.__saraTrack;
        var hasAds = !!(window.gtag && c && c.adsId && c.demoLabel);

        try {
          if (window.gtag) {
            setUserData(data);
            gtag('event', 'generate_lead', {
              event_category: 'engagement',
              event_label: 'demo-page',
              transport_type: 'beacon',
            });
            gtag('event', 'demo_solicitada', {
              event_category: 'engagement',
              event_label: 'demo-page',
              value: 1,
              transport_type: 'beacon',
            });
            if (hasAds) {
              gtag('event', 'conversion', {
                send_to: c.adsId + '/' + c.demoLabel,
                event_callback: once,
              });
            }
          }
        } catch (e) {}

        if (hasAds) setTimeout(once, 900);
        else once();
      }

      function waHandoff(data, token) {
        var msg =
          T.waIntro + '\n' +
          '• ' + T.labelClinic + ': ' + (data.clinic || '-') + '\n' +
          '• ' + T.labelName + ': ' + (data.name || '-') + '\n' +
          '• ' + T.labelRole + ': ' + (data.role || '-');
        msg += '\n' + SRC_TAG + (token || '');
        return 'https://wa.me/' + WA + '?text=' + encodeURIComponent(msg);
      }

      // El link de fallback abre WhatsApp directo. Le ponemos el marcador acá porque el
      // enhance() del Layout ya corrió cuando seteamos este href, así que no lo tocaría.
      var fb = form.querySelector('[data-wa-fallback]');
      if (fb)
        fb.setAttribute(
          'href',
          'https://wa.me/' + WA + '?text=' + encodeURIComponent(T.waIntro + ' ' + SRC_TAG)
        );

      form.addEventListener('submit', function (ev) {
        ev.preventDefault();
        errBox.classList.add('hidden');

        // Click-ids frescos justo antes de leer el form
        var ids = clickIds();
        CLICK_KEYS.forEach(function (k) {
          var el = document.getElementById('f_' + k);
          if (el) el.value = ids[k];
        });

        var fd = new FormData(form);
        var data = Object.fromEntries(fd.entries());

        // Validación mínima. Email es opcional, pero si lo escriben tiene que ser válido.
        if (!data.role || !data.name || !data.phone || !data.clinic) {
          return showError(T.errRequired);
        }
        if (data.email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(String(data.email))) {
          return showError(T.errEmail);
        }
        if (!fd.get('consent')) {
          return showError(T.errConsent);
        }

        btn.disabled = true;
        btn.textContent = T.sending;

        var token = clickToken(ids);

        function showSuccess() {
          form.classList.add('hidden');
          var ok = document.getElementById('demo-success');
          if (ok) ok.classList.remove('hidden');
        }

        var payload = Object.assign({}, data, {
          source_page: 'demo',
          region: IS_AR ? 'AR' : 'MX',
          page_url: location.href,
          ts: new Date().toISOString(),
        });

        if (endpoint) {
          fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          })
            .then(function (r) {
              if (!r.ok) throw new Error('bad status');
              fireLead(data);
              showSuccess();
            })
            .catch(function () {
              // Si el endpoint falla, no perdemos el lead: handoff a WhatsApp
              fireLead(data, function () {
                window.location.href = waHandoff(data, token);
              });
            });
        } else {
          // Sin backend configurado: handoff a WhatsApp con el resumen
          fireLead(data, function () {
            window.location.href = waHandoff(data, token);
          });
        }
      });
    })();
  </script>
  <PlacesAutocomplete />
</Layout>
