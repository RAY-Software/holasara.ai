// (src/i18n/slugs.ts). Landing SEO: "recordatorio de citas por whatsapp" (MX) y
// "appointment reminders" / "medical appointment reminder service" (US).
export function getStaticPaths() {
  return localizedStaticPaths('reminders');
}
const lang = toLocale(Astro.params.lang);
const L = (p: string) => localePath(p, lang);
