          dict.strip.map((s, i) => (
            <div class={`py-2 ${i > 0 ? 'sm:border-l sm:border-line sm:pl-8' : ''}`}>
              <p class="font-serif text-lg font-black text-ink">{s.t}</p>
              <p class="mt-1 text-salvia">{s.b}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- ══════════ CÓMO LO HACE SARA · recordatorio real ══════════ -->
    <section class="border-t border-line">
      <div class="reveal mx-auto grid max-w-6xl items-center gap-14 px-5 py-24 md:grid-cols-[1.05fr_0.95fr]">
        <div>
          <p class="mb-3 text-sm font-semibold uppercase tracking-[0.14em] text-pine-dark">{dict.howKicker}</p>
          <h2 class="font-serif text-3xl font-black leading-tight text-balance md:text-4xl" set:html={dict.howH2} />
          <p class="mt-5 text-lg text-salvia">{dict.howP1}</p>
          <p class="mt-4 text-salvia" set:html={dict.howP2} />
        </div>
        <div class="flex justify-center md:justify-end">
          <ConversationDemo lang={lang} channel="whatsapp" bubbles={dict.howBubbles} animate />
        </div>
      </div>
    </section>

    <!-- ══════════ CÓMO FUNCIONA · 3 tiempos (banda oscura) ══════════ -->
    <section class="border-t border-line bg-ink text-cream">
      <div class="reveal mx-auto max-w-6xl px-5 py-24">
        <h2 class="max-w-2xl font-serif text-3xl font-black leading-tight text-balance md:text-4xl" set:html={dict.stepsH2} />
        <div class="mt-14 grid gap-x-10 gap-y-12 md:grid-cols-3">
          {
            steps.map((s) => (
              <div>
                <div class="flex items-center gap-4">
                  <span class="font-serif text-4xl font-black text-mint tabular-nums">{s.n}</span>
                  <span class="h-px flex-1 bg-cream/15" />
                </div>
                <h3 class="mt-5 text-xl font-semibold text-cream">{s.title}</h3>
                <p class="mt-2 text-cream/65">{s.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ══════════ CAPACIDADES · filas alternadas (copy + chat real) ══════════ -->
    <section class="border-t border-line">
      <div class="reveal mx-auto flex max-w-6xl flex-col gap-24 px-5 py-24">
        <FeatureRow eyebrow={dict.row1Eyebrow} title={dict.row1Title} body={dict.row1Body} points={dict.row1Points}>
          <ConversationDemo lang={lang} channel="whatsapp" bubbles={dict.row1Bubbles} />
        </FeatureRow>

        <FeatureRow flip eyebrow={dict.row2Eyebrow} title={dict.row2Title} body={dict.row2Body} points={dict.row2Points}>
          <ConversationDemo lang={lang} channel="whatsapp" bubbles={dict.row2Bubbles} />
        </FeatureRow>

        <div id="medicas" class="scroll-mt-24">
          <FeatureRow eyebrow={dict.row3Eyebrow} title={dict.row3Title} body={dict.row3Body} points={dict.row3Points}>
            <ConversationDemo lang={lang} channel="whatsapp" bubbles={dict.row3Bubbles} />
          </FeatureRow>
        </div>

        <div id="dentales" class="scroll-mt-24">
          <FeatureRow flip eyebrow={dict.row4Eyebrow} title={dict.row4Title} body={dict.row4Body} points={dict.row4Points}>
            <ConversationDemo lang={lang} channel="whatsapp" bubbles={dict.row4Bubbles} />
          </FeatureRow>
        </div>

        <div id="anticipo" class="scroll-mt-24">
          <FeatureRow eyebrow={dict.row5Eyebrow} title={dict.row5Title} body={dict.row5Body} points={dict.row5Points}>
            <ConversationDemo lang={lang} channel="whatsapp" bubbles={dict.row5Bubbles} />
          </FeatureRow>
        </div>
      </div>
    </section>

    <CtaInline title={dict.ctaInline} lang={lang} />

    <!-- ══════════ ASÍ SE VE EN TU PANEL · estados ══════════ -->
    <section class="border-t border-line bg-paper">
      <div class="reveal mx-auto max-w-6xl px-5 py-24">
        <p class="mb-3 text-sm font-semibold uppercase tracking-[0.14em] text-pine-dark">{dict.panelKicker}</p>
        <h2 class="max-w-2xl font-serif text-3xl font-black leading-tight text-balance md:text-4xl" set:html={dict.panelH2} />
        <p class="mt-5 max-w-2xl text-lg text-salvia" set:html={dict.panelLead} />
        <div class="mt-12 grid gap-6 md:grid-cols-2">
          {
            estados.map((e) => (
              <div class="flex items-start gap-4 rounded-xl border border-line bg-cream p-6">
                <span class="shrink-0 rounded-full border border-pine/20 bg-mint/[0.12] px-3 py-1.5 text-sm font-medium text-pine-dark">
                  {e.tag}
                </span>
                <p class="text-salvia">{e.desc}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <FeatureFaq items={faqs} lang={lang} />

    <CtaBand lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>
