    howBubbles: [
      { who: 'out', text: 'Hola, Juli! Soy Sara. Quedó pendiente tu cita de cavado y no quería que se te pase. Tengo miércoles 19:30 o 20:00. ¿Te viene bien alguno?', t: '10:03' },
      { who: 'in', text: 'Uy sí, se me había pasado 🙈 el de las 19:30 me sirve', t: '18:22' },
