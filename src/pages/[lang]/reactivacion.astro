---
import { getStaticPaths, toLocale } from '../../i18n/config';
export { getStaticPaths };
const lang = toLocale(Astro.params.lang);
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import AgendaPanel from '../../components/mocks/AgendaPanel.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import FeatureRow from '../../components/FeatureRow.astro';
import ConversationDemo from '../../components/ConversationDemo.astro';
import FeatureFaq from '../../components/FeatureFaq.astro';
import CtaInline from '../../components/CtaInline.astro';
import CtaBand from '../../components/CtaBand.astro';

// ── Copy por idioma. EN es traducción, no calco. ──
const dict = {
  es: {
    metaTitle: 'Lista de espera y reactivación · Sara',
    metaDescription:
      'Sara llena los huecos de cancelaciones con la lista de espera y trae de vuelta, uno por uno, a los pacientes que no vuelven hace meses. Con criterio, y cobrando el anticipo.',
    heroEyebrow: 'Agenda · Lista de espera y reactivación',
    heroTitle: "La hora que se libera <em class='text-pine-dark'>no se pierde.</em>",
    heroLead:
      'Una cancelación no tiene por qué ser un hueco vacío, y un paciente que no vuelve no está perdido. Sara persigue cada cita que quedó en el aire y vuelve a llenar la agenda, uno por uno.',
    heroImageAlt: 'Un rincón de tratamiento luminoso con un sillón junto a la ventana: ningún espacio queda vacío.',
    strip: [
      { t: 'Reintenta hasta que responde', b: 'Varios seguimientos con criterio, sin volverse spam.' },
      { t: 'Ofrece dos horarios concretos', b: 'No pregunta al aire: propone y cierra en el mismo chat.' },
      { t: 'Cobra el anticipo', b: 'La hora vuelve ocupada y ya pagada, no de palabra.' },
    ],
