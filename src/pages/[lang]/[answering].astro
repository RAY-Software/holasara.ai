    estados: [
      { tag: '📞 Call', desc: 'Sara answered an incoming call. Logged with the time and duration.' },
      { tag: '📝 Summary', desc: 'A text summary of what was said, to read in seconds.' },
      { tag: 'Booked', desc: 'The appointment was scheduled during the call, in your Google Calendar.' },
      { tag: '✅ Confirmed', desc: 'The patient confirmed and the deposit was collected through the link she texted.' },
