const { faqs, saraDoes, context, payments, marketing, posts, impl } = dict;

// Overlay del hero: el circuito de Sara, sin recepción. Con logos reales de plataformas.
const dot = 'inline-block h-6 w-6 shrink-0';
const gWA = `<img src="/img/logos/whatsapp.svg" class="${dot}" alt="WhatsApp" loading="eager" decoding="async" />`;
const gIG = `<img src="/img/logos/instagram.svg" class="${dot}" alt="Instagram" loading="eager" decoding="async" />`;
const gG = `<img src="/img/logos/google.svg" class="${dot}" alt="Google" loading="eager" decoding="async" />`;
const svgAgenda =
  '<svg class="h-7 w-7 text-pine" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="4.5" width="18" height="16" rx="2.5" stroke="currentColor" stroke-width="1.8"/><path d="M3 9.5h18M8 2.5v4M16 2.5v4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>';
const svgSena =
  '<svg class="h-7 w-7 text-pine" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="2.5" y="5.5" width="19" height="13" rx="2.5" stroke="currentColor" stroke-width="1.8"/><path d="M2.5 9.8h19" stroke="currentColor" stroke-width="1.8"/></svg>';
const svgResena =
  '<svg class="h-7 w-7" viewBox="0 0 24 24" fill="#f5b50a" aria-hidden="true"><path d="M12 3.5l2.6 5.27 5.82.85-4.21 4.1.99 5.8L12 16.8 6.8 19.52l.99-5.8-4.21-4.1 5.82-.85z"/></svg>';

// Los 5 pasos, en anillo. Etiquetas cortas + logo real. Posición sobre un círculo (radio 34%).
const loop = [
  { icon: `<span class="flex items-center gap-1">${gG}${gIG}</span>`, t: dict.loop[0] },
  { icon: `<span class="flex items-center gap-1">${gWA}${gIG}</span>`, t: dict.loop[1] },
  { icon: svgAgenda, t: dict.loop[2] },
  { icon: svgSena, t: dict.loop[3] },
  { icon: svgResena, t: dict.loop[4] },
].map((s, i) => {
  const a = ((-90 + i * 72) * Math.PI) / 180;
  return { ...s, x: 50 + 34 * Math.cos(a), y: 50 + 34 * Math.sin(a) };
});
---

<Layout lang={lang}>
  <Header lang={lang} />

  <main>
    <!-- ══════════ HERO ══════════ -->
    <section class="relative overflow-hidden">
      <div
        class="pointer-events-none absolute -right-32 -top-40 h-[520px] w-[520px] rounded-full opacity-60 blur-3xl"
        style="background: radial-gradient(circle, color-mix(in srgb, var(--color-mint) 40%, transparent), transparent 70%);"
        aria-hidden="true"
      >
      </div>

      <div class="mx-auto grid max-w-6xl items-center gap-14 px-5 py-20 md:grid-cols-[1.05fr_0.95fr] md:py-24">
        <div>
          <p class="mb-6 flex items-center gap-2.5 text-sm font-semibold uppercase tracking-[0.14em] text-pine-dark">
            <span class="dot h-2 w-2"></span>
            {dict.heroKicker}
          </p>
          <h1 class="font-serif font-black leading-[1.05] tracking-tight text-[clamp(1.5rem,8vw,3.75rem)]">
            <span class="block whitespace-nowrap">{dict.heroH1[0]}</span>
            <span class="block whitespace-nowrap">{dict.heroH1[1]}</span>
            <span class="block whitespace-nowrap text-pine-dark">{dict.heroH1[2]}</span>
            <span class="block whitespace-nowrap text-pine-dark">{dict.heroH1[3]}</span>
          </h1>
          <p class="mt-7 max-w-xl text-lg text-salvia" set:html={dict.heroSub} />

          <div class="mt-9 flex flex-wrap items-center gap-3">
            <a
              href={L('/demo')}
              class="inline-flex items-center gap-2 rounded-full bg-pine px-6 py-3 text-base font-semibold text-cream transition-colors hover:bg-pine-dark"
            >
              {dict.demoCta}
            </a>
            {/* CTA secundario del hero. Cuando el flag está ON → "Escanear mi
                negocio" (grader.rayapp.ai, product=servicios). Mientras corren
                las campañas de Ads (flag OFF) cae a "Habla con Sara" para no
                filtrar tráfico pago a un embudo sin el tag de Ads — ver
                src/lib/flags.ts (SHOW_GRADER_CTA). NO quitar el param product. */}
            {SHOW_GRADER_CTA ? (
              <a
                href="https://grader.rayapp.ai/?product=servicios&utm_source=hero&utm_medium=website&utm_campaign=holasara"
                class="inline-flex items-center gap-2 rounded-full border border-line px-6 py-3 text-base font-semibold text-ink transition-colors hover:border-ink/30"
              >
                {dict.scanCta}
              </a>
            ) : (
              <a
                href={whatsappLink(whatsappText(lang))}
                target="_blank"
                rel="noopener"
                class="inline-flex items-center gap-2 rounded-full border border-line px-6 py-3 text-base font-semibold text-ink transition-colors hover:border-ink/30"
              >
                {dict.talkCta}
              </a>
            )}
          </div>
        </div>

        <div class="flex justify-center md:justify-end">
          <div class="relative w-full max-w-lg rounded-3xl border border-line bg-gradient-to-br from-cream to-mint/40 p-7 shadow-[0_24px_60px_-30px_rgba(20,38,31,0.4)] sm:p-8">
            <div class="relative mx-auto aspect-square w-full max-w-[19rem]">
              <!-- Anillo del loop: círculo punteado con flecha, gira y vuelve al paso 1 -->
              <svg class="pointer-events-none absolute inset-0 h-full w-full text-pine/40" viewBox="0 0 100 100" fill="none" aria-hidden="true">
                <defs>
                  <marker id="loopArrow" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="5.5" markerHeight="5.5" orient="auto">
                    <path d="M0 0 10 5 0 10z" fill="currentColor" />
                  </marker>
                </defs>
                <path d="M62.7 18.5 A34 34 0 1 1 37.3 18.5" stroke="currentColor" stroke-width="1.2" stroke-dasharray="1.4 3" stroke-linecap="round" marker-end="url(#loopArrow)" />
              </svg>
              <!-- Centro: el thumb de Sara (el mismo del webchat), eje de su circuito -->
              <div class="absolute inset-0 grid place-items-center">
                <img
                  src="/agents/sara-thumb.png"
                  width="280"
                  height="280"
                  alt="Sara"
                  class="h-[5.5rem] w-[5.5rem] rounded-full border-2 border-cream object-cover shadow-[0_6px_18px_-8px_rgba(20,38,31,0.5)]"
                  loading="eager"
                  decoding="async"
                />
              </div>
              {
                loop.map((n, i) => (
                  <div class="absolute -translate-x-1/2 -translate-y-1/2" style={`left:${n.x}%;top:${n.y}%`}>
                    <div class="relative grid h-16 w-16 place-items-center rounded-full border border-line bg-cream shadow-[0_6px_16px_-8px_rgba(20,38,31,0.45)]">
                      <span class="absolute -left-1.5 -top-1.5 grid h-5 w-5 place-items-center rounded-full bg-pine text-[11px] font-bold text-cream tabular-nums">{i + 1}</span>
                      <span class="flex items-center" set:html={n.icon} />
                    </div>
                    <span
                      class:list={[
                        'absolute w-max text-[13px] font-semibold leading-tight text-ink',
                        i === 0 && 'bottom-full left-1/2 mb-2 max-w-[6.5rem] -translate-x-1/2 text-center',
                        i === 1 && 'left-full top-1/2 ml-2 max-w-[5rem] -translate-y-1/2 text-left',
                        i === 4 && 'right-full top-1/2 mr-2 max-w-[5rem] -translate-y-1/2 text-right',
                        (i === 2 || i === 3) && 'left-1/2 top-full mt-2 max-w-[6.5rem] -translate-x-1/2 text-center',
                      ]}
                    >
                      {n.t}
                    </span>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>

    <ClientsStrip tone="paper" lang={lang} />

    <!-- ══════════ VIDEO ══════════ -->
    <section id="video" class="border-t border-line bg-paper">
      <div class="reveal mx-auto max-w-5xl px-5 py-24 text-center">
        <p class="mb-3 text-sm font-semibold uppercase tracking-[0.14em] text-pine-dark">{dict.videoKicker}</p>
        <h2 class="mx-auto max-w-2xl font-serif text-4xl font-black leading-tight text-balance md:text-5xl" set:html={dict.videoH2} />

        <!-- Video demo: portada liviana (thumbnail YouTube); el iframe se carga recién al clic -->
        <div
          id="video-embed"
          data-yt="-HAjxKXeltI"
          class="group relative mt-10 aspect-video cursor-pointer overflow-hidden rounded-2xl border border-line bg-ink shadow-[0_16px_40px_-26px_rgba(20,38,31,0.38)]"
        >
          <img
            src="https://img.youtube.com/vi/-HAjxKXeltI/maxresdefault.jpg"
            alt={dict.videoAlt}
            class="absolute inset-0 h-full w-full object-cover opacity-95 transition group-hover:opacity-100"
            loading="lazy"
            decoding="async"
          />
          <button
            type="button"
            class="absolute inset-0 flex items-center justify-center bg-ink/25 transition group-hover:bg-ink/15"
            aria-label={dict.videoPlay}
          >
            <span class="grid h-20 w-20 place-items-center rounded-full bg-mint shadow-lg transition-transform duration-300 group-hover:scale-110">
              <svg width="26" height="30" viewBox="0 0 26 30" fill="none" aria-hidden="true">
                <path d="M25 13.27a2 2 0 0 1 0 3.46L3 29.32A2 2 0 0 1 0 27.6V2.4A2 2 0 0 1 3 .68l22 12.6Z" fill="#14261F" />
              </svg>
            </span>
          </button>
        </div>
      </div>
    </section>

    <script is:inline>
      (function () {
        var el = document.getElementById('video-embed');
        if (!el) return;
        el.addEventListener('click', function () {
          var id = el.getAttribute('data-yt');
          el.innerHTML =
            '<iframe class="absolute inset-0 h-full w-full" src="https://www.youtube-nocookie.com/embed/' +
            id +
            '?autoplay=1&rel=0" title="Sara" frameborder="0" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>';
        });
      })();
    </script>

    <!-- ══════════ EL CONTEXTO (banda oscura) ══════════ -->
    <section class="bg-ink text-cream">
      <div class="reveal mx-auto max-w-6xl px-5 py-24 md:py-28">
        <div class="max-w-3xl">
          <p class="mb-4 flex items-center gap-2.5 text-sm font-semibold uppercase tracking-[0.14em] text-mint">
            <span class="h-2 w-2 rounded-full bg-mint"></span>{dict.ctxKicker}
          </p>
          <h2 class="font-serif text-4xl font-black leading-tight text-balance md:text-5xl" set:html={dict.ctxH2} />
          <p class="mt-5 text-lg text-cream/70" set:html={dict.ctxSub} />
        </div>

        <div class="mt-16 grid gap-x-10 gap-y-12 md:grid-cols-3">
          {
            context.map((c) => (
              <div>
                <div class="flex items-center gap-4">
                  <span class="font-serif text-4xl font-black text-mint tabular-nums">{c.n}</span>
                  <span class="h-px flex-1 bg-cream/15" />
                </div>
                <h3 class="mt-5 text-xl font-semibold text-cream">{c.title}</h3>
                <p class="mt-2 text-cream/65">{c.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ══════════ CONOCE A SARA ══════════ -->
    <section id="sara" class="border-t border-line bg-paper">
      <div class="reveal mx-auto grid max-w-6xl gap-14 px-5 py-24 md:grid-cols-[0.85fr_1.15fr] md:items-center">
        <div>
          <p class="mb-3 text-sm font-semibold uppercase tracking-[0.14em] text-pine-dark">{dict.saraKicker}</p>
          <h2 class="font-serif text-4xl font-black leading-tight text-balance md:text-5xl" set:html={dict.saraH2} />
          <p class="mt-5 text-lg text-salvia">{dict.saraSub}</p>
          <ul class="mt-8 flex flex-col gap-3.5">
            {
              saraDoes.map((item) => (
                <li class="flex items-start gap-3">
                  <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-mint" />
                  <span class="text-ink">{item}</span>
                </li>
              ))
            }
          </ul>
          <a
            href={L('/sara')}
            class="mt-8 inline-flex items-center gap-1.5 text-base font-semibold text-pine-dark transition-colors hover:text-ink"
          >
            {dict.saraMore} <span aria-hidden="true">→</span>
          </a>
        </div>

        <div class="flex justify-center md:justify-end">
          <SaraChatShowcase lang={lang} class="w-full max-w-sm" />
        </div>
      </div>
    </section>

    <!-- ══════════ MARKETING ══════════ -->
    <section class="border-t border-line bg-paper">
      <div class="reveal mx-auto max-w-6xl px-5 py-24">
        <p class="mb-3 text-sm font-semibold uppercase tracking-[0.14em] text-pine-dark">{dict.mktKicker}</p>
        <h2 class="max-w-2xl font-serif text-4xl font-black leading-tight text-balance md:text-5xl" set:html={dict.mktH2} />
        <p class="mt-5 max-w-2xl text-lg text-salvia" set:html={dict.mktSub} />
        <a
          href={L('/instagram')}
          class="mt-5 inline-flex items-center gap-1.5 text-base font-semibold text-pine-dark transition-colors hover:text-ink"
        >
          {dict.mktMore} <span aria-hidden="true">→</span>
        </a>

        <div class="mt-14 grid gap-10 md:grid-cols-[0.68fr_1.32fr] md:items-stretch">
          <div class="flex h-full flex-col gap-6">
            {
              marketing.map((m) => (
                <div class="flex flex-1 flex-col justify-center rounded-xl border border-line bg-cream p-7">
                  <h3 class="text-xl font-semibold">{m.title}</h3>
                  <p class="mt-2 text-salvia">{m.body}</p>
                </div>
              ))
            }
          </div>
          <div class="flex justify-center md:justify-end">
            <InstagramShowcase lang={lang} class="w-full" />
          </div>
        </div>

        <div class="mt-14">
          <p class="text-sm font-semibold uppercase tracking-wide text-pine-dark">{dict.postsKicker}</p>
          <div class="mt-6 grid gap-6 sm:grid-cols-3">
            {
              posts.map((p) => (
                <div>
                  <IgPost lang={lang} img={p.img} caption={p.caption} likes={p.likes} comment={p.comment} />
                  <p class="mt-3 font-serif text-lg font-bold">{p.step}</p>
                  <p class="text-salvia">{p.body}</p>
                </div>
              ))
            }
          </div>
          <p class="mt-8 text-lg text-salvia" set:html={dict.postsClose} />
        </div>
      </div>
    </section>

    <!-- ══════════ SPOTLIGHT · OPERADORA ══════════ -->
    <section class="border-t border-line">
      <div class="reveal mx-auto max-w-6xl px-5 py-24">
        <div class="mx-auto max-w-3xl text-center">
          <p class="mb-3 text-sm font-semibold uppercase tracking-[0.14em] text-pine-dark">{dict.spotKicker}</p>
          <h2 class="font-serif text-4xl font-black leading-tight text-balance md:text-5xl" set:html={dict.spotH2} />
          <p class="mx-auto mt-5 max-w-xl text-lg text-salvia">{dict.spotBody}</p>
        </div>
        <div class="mx-auto mt-8 grid max-w-3xl gap-3 sm:grid-cols-3">
          {
            dict.spotlightQuotes.map((q) => (
              <div class="rounded-xl border border-line bg-paper px-4 py-3 text-center font-accent text-base italic text-pine-dark">
                {q}
              </div>
            ))
          }
        </div>
        <div class="mt-12 flex justify-center">
          <OperatorPanel lang={lang} class="w-full" />
        </div>
      </div>
    </section>

    <!-- CTA intercalado -->
    <CtaInline title={dict.ctaInline1} lang={lang} />

    <!-- ══════════ COBROS ══════════ -->
    <section id="cobros" class="border-t border-line">
      <div class="reveal mx-auto max-w-6xl px-5 py-24">
        <div class="mx-auto max-w-3xl text-center">
          <p class="mb-3 text-sm font-semibold uppercase tracking-[0.14em] text-pine-dark">{dict.cobrosKicker}</p>
          <h2 class="font-serif text-4xl font-black leading-tight text-balance md:text-5xl" set:html={dict.cobrosH2} />
          <p class="mx-auto mt-5 max-w-xl text-lg text-salvia">{dict.cobrosSub}</p>
        </div>
        <div class="mt-12 flex justify-center">
          <PaymentsPanel lang={lang} class="w-full" />
        </div>
        <div class="mx-auto mt-12 grid max-w-4xl gap-6 sm:grid-cols-3">
          {
            payments.map((p, i) => (
              <div>
                <span class="font-accent text-xl italic text-pine-dark">{`0${i + 1}`}</span>
                <h3 class="mt-1 text-lg font-semibold">{p.title}</h3>
                <p class="mt-1 text-salvia">{p.body}</p>
              </div>
            ))
          }
        </div>
        <div class="mt-8 text-center">
          <a
            href={L('/cobros')}
            class="inline-flex items-center gap-1.5 text-base font-semibold text-pine-dark transition-colors hover:text-ink"
          >
            {dict.cobrosMore} <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>

    <!-- CTA intercalado -->
    <CtaInline title={dict.ctaInline2} cta={dict.ctaInline2Cta} lang={lang} />

    <!-- ══════════ IMPLEMENTACIÓN ══════════ -->
    <section class="border-t border-line">
      <div class="reveal mx-auto grid max-w-6xl gap-14 px-5 py-24 md:grid-cols-[0.85fr_1.15fr] md:items-center">
        <div>
          <p class="mb-3 text-sm font-semibold uppercase tracking-[0.14em] text-pine-dark">{dict.implKicker}</p>
          <h2 class="font-serif text-3xl font-black leading-tight text-balance md:text-4xl">
            {dict.implH2}
          </h2>
          <div class="mt-8 flex flex-col gap-6">
            {
              impl.map((it) => (
                <div>
                  <h3 class="text-lg font-semibold">{it.title}</h3>
                  <p class="mt-1 text-salvia">{it.body}</p>
                </div>
              ))
            }
          </div>
          <a
            href={L('/implementacion')}
            class="mt-8 inline-flex items-center gap-1.5 text-base font-semibold text-pine-dark transition-colors hover:text-ink"
          >
            {dict.implMore} <span aria-hidden="true">→</span>
          </a>
        </div>
        <div class="flex justify-center md:justify-end">
          <CalendarSyncPanel lang={lang} class="w-full" />
        </div>
      </div>
    </section>

    <!-- ══════════ CASO REAL ══════════ -->
    <section id="caso" class="border-t border-line bg-paper">
      <div class="reveal mx-auto grid max-w-6xl gap-14 px-5 py-24 md:grid-cols-[0.85fr_1.15fr] md:items-center">
        <div>
          <p class="mb-4 text-sm font-semibold uppercase tracking-[0.14em] text-pine-dark">{dict.caseKicker}</p>
          <img src="/img/vialaser-logo.png" width="398" height="126" alt="ViaLaser" class="mb-6 h-9 w-auto" loading="lazy" />
          <h2 class="font-serif text-4xl font-black leading-tight text-balance md:text-5xl" set:html={dict.caseH2} />
          <div class="mt-10 flex flex-col gap-8">
            <div>
              <p class="font-serif text-5xl font-black text-pine-dark tabular-nums">114</p>
              <p class="mt-1 text-salvia">{dict.caseStat1}</p>
            </div>
            <div>
              <p class="font-serif text-5xl font-black text-pine-dark tabular-nums">{dict.caseStat2Num}</p>
              <p class="mt-1 text-salvia">{dict.caseStat2}</p>
            </div>
          </div>
          <a
            href={L('/caso')}
            class="mt-8 inline-flex items-center gap-1.5 text-base font-semibold text-pine-dark transition-colors hover:text-ink"
          >
            {dict.caseMore} <span aria-hidden="true">→</span>
          </a>
        </div>
        <div class="flex justify-center md:justify-end">
          <ResultsChart lang={lang} class="w-full max-w-full" />
        </div>
      </div>
    </section>

    <FeatureFaq items={faqs} lang={lang} />

    <!-- ══════════ CTA FINAL ══════════ -->
    <CtaBand lang={lang} />
  </main>

  <Footer lang={lang} />
</Layout>
