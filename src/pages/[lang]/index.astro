---
import { getStaticPaths, toLocale } from '../../i18n/config';
export { getStaticPaths };
import { localePath } from '../../i18n/config';
const lang = toLocale(Astro.params.lang);
const L = (p: string) => localePath(p, lang);
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import InstagramShowcase from '../../components/mocks/InstagramShowcase.astro';
import ResultsChart from '../../components/mocks/ResultsChart.astro';
import MockFrame from '../../components/MockFrame.astro';
import Footer from '../../components/Footer.astro';
import CtaBand from '../../components/CtaBand.astro';
import CtaInline from '../../components/CtaInline.astro';
import ClientsStrip from '../../components/ClientsStrip.astro';
import FeatureFaq from '../../components/FeatureFaq.astro';
import { whatsappLink, whatsappText } from '../../lib/whatsapp';
import { SHOW_GRADER_CTA } from '../../lib/flags';
import { getTeam, getMember } from '../../data/team';
import AgentKicker from '../../components/AgentKicker.astro';
import ConversationDemo from '../../components/ConversationDemo.astro';
import SceneStoryboard from '../../components/SceneStoryboard.astro';

// ── Copy por idioma. EN es traducción, no calco. ──
const dict = {
  es: {
    faqs: [
      { q: '¿Se nota que es una inteligencia artificial?', a: 'Sara se presenta con naturalidad y responde con el tono de tu clínica. El paciente siente que lo atiende alguien que sabe, no un bot con botones.' },
      { q: '¿Usa mi número de WhatsApp actual?', a: 'Sara atiende sobre una línea de WhatsApp Business conectada a tu clínica. Coordinamos el número en la implementación; no tienes que cambiar de teléfono personal.' },
      { q: '¿Reemplaza a mi recepción?', a: 'La libera de lo repetitivo: responder lo mismo, confirmar citas, perseguir pagos. Tu equipo se dedica al paciente que está en la clínica.' },
      { q: '¿Toca mi historia clínica?', a: 'No. No se almacena historia clínica ni información médica de tus pacientes. Eso queda donde está hoy.' },
      { q: '¿Qué necesito para empezar?', a: 'Conectar tu Google Calendar y una línea de WhatsApp. La implementación la hacemos contigo; no migras datos ni cambias de sistema.' },
      { q: '¿Puedo empezar solo con Sara?', a: 'Sí. Sara es la puerta de entrada. Mia y Daniel se suman cuando quieras, sobre la misma cuenta.' },
    ],
    saraDoes: [
      'Responde en el momento, en WhatsApp e Instagram.',
      'Informa tratamientos, precios y disponibilidad real.',
      'Agenda la cita y cobra la consulta o el anticipo.',
      'Recuerda, confirma y reprograma sin que nadie intervenga.',
      'Reactiva pacientes que no vuelven hace meses.',
    ],
    context: [
      { n: '01', title: 'Escriben, no llaman', body: 'El primer contacto entra por WhatsApp o Instagram, y casi siempre fuera del horario de recepción.' },
      { n: '02', title: 'Esperan minutos, no horas', body: 'Si la respuesta llega al día siguiente, el interés ya se enfrió y la decisión ya se tomó.' },
      { n: '03', title: 'Agendan con el primero', body: 'Comparan pocas opciones y reservan en la clínica que responde antes.' },
    ],
    payments: [
      { title: 'Anticipo en línea al reservar', body: 'Compromete la cita y adelanta el flujo de caja. Baja la ausencia desde el primer mes.' },
      { title: 'Consulta cobrada por adelantado', body: 'El paciente paga cuando agenda, no cuando llega. Tu hora deja de ser gratis.' },
      { title: 'Gift cards', body: 'Tu paciente le regala un tratamiento a alguien que no te conoce. Cobras hoy y ganas un paciente nuevo que no te costó publicidad.' },
    ],
    marketing: [
      { title: 'Publicaciones listas para salir', body: 'Mia escribe el texto, elige la imagen y arma el calendario con la marca de tu clínica. Tú solo apruebas.' },
      { title: 'El post termina en una cita', body: 'Quien comenta o escribe por una publicación, Sara lo atiende y lo agenda. Sin que el interés se enfríe.' },
      { title: 'Sabes qué funcionó', body: 'Cada mes, en español claro: qué publicación trajo más consultas y cuánto facturaste. Sin planillas.' },
    ],
    spotlightQuotes: ['“Bloquea mi agenda el viernes.”', '“Pasa a Juan al jueves 10.”', '“Reagenda a todos los del martes.”'],
    heroKicker: 'La recepcionista con IA para clínicas, médicos y wellness',
    heroH1: ['Más pacientes.', 'Más facturación.', 'Todo automático,', 'las 24 horas.'],
    heroSub: 'Sara responde, agenda, cobra el anticipo y baja las ausencias, por WhatsApp, Instagram, SMS y teléfono. Sin cambiar tu agenda ni tocar tu historia&nbsp;clínica. Y su equipo te avisa cuando hay algo que&nbsp;decidir.',
    heroImgAlt: 'Sara, Mia y Daniel, el equipo con IA de tu clínica. Sara al frente.',
    demoCta: 'Pedir demo',
    scanCta: 'Escanear mi negocio',
    talkCta: 'Habla con Sara',
    videoKicker: 'En acción',
    videoH2: 'Mira a Sara en 60&nbsp;segundos.',
    videoAlt: 'Video: Sara en acción, en 60 segundos',
    videoPlay: 'Reproducir el video de Sara',
    ctxKicker: 'El contexto',
    ctxH2: 'Tu paciente ya decidió <em class="text-mint">cómo</em> quiere&nbsp;agendar.',
    ctxSub: 'Espera lo mismo que en cualquier otro servicio: respuesta inmediata. La clínica que responde primero se queda con el&nbsp;paciente.',
    saraKicker: 'Conoce a Sara',
    saraH2: '23:41 entra.<br /><em class="text-pine-dark">23:43 pagada<br />y agendada.</em>',
    saraSub: 'Trabaja de noche, los fines de semana y en los picos. Sin sumar una persona más a recepción.',
    saraMore: 'Conoce más sobre Sara',
    saraImgAlt: 'Conversación de WhatsApp: una paciente consulta de madrugada y Sara responde, agenda y cobra el anticipo.',
    mktH2: 'Mia lleva tu&nbsp;marketing.',
    mktSub: 'Crea y publica los posts de tu clínica, corre tus campañas de Google y cuida tu ficha de Google Business. A quien responde, lo atiende Sara hasta&nbsp;agendar.',
    mktMore: 'Ver cómo Mia lleva tu Instagram',
    mktImgAlt: 'Feed de Instagram de una clínica generado con IA: publicaciones con la marca, listas para salir.',
    mktMeet: 'Conoce a Mia',
    teamKicker: 'Tu equipo con IA',
    teamLine: 'Sara atiende. Mia trae pacientes. Daniel cuida el dinero. Los tres trabajan solos y te&nbsp;escriben.',
    teamMore: 'Conoce al equipo',
    teamMeetPrefix: 'Conoce a',
    saraRole: 'Recepción',
    miaRole: 'Marketing',
    danielRole: 'Finanzas',
    danielH3: 'Daniel te escribe con los números.',
    danielPoints: ['Cuánto facturaste y cuánto te quedó', 'Qué anticipos faltan cobrar', 'Qué tratamiento deja más margen'],
    danielMore: 'Conoce a Daniel',
    spotH2: 'Y le pides cosas<br /><em class="text-pine-dark">por WhatsApp.</em>',
    spotMore: 'Ver el modo operador',
    spotBody: 'Gestiona la agenda entera y notifica a cada paciente. Las 24 horas.',
    spotImgAlt: 'Sara gestiona la agenda de la semana y reprograma todas las citas del martes, avisando a cada paciente.',
    ctaInline1: 'Cada consulta que no respondes a tiempo, agenda en&nbsp;otra clínica.',
    cobrosH2: 'Sabes cuánto ganas.<br /><em class="text-pine-dark">Y qué te deja&nbsp;más.</em>',
    cobrosSub: 'Daniel es el director financiero de tu clínica: cierra el mes, te dice el margen y hacia dónde va el que viene. Y cuando hay dinero por cobrar, se lo pasa a&nbsp;Sara.',
    cobrosFormsKicker: 'Lo que Sara cobra por ti',
    cobrosMore: 'Ver todas las formas de cobrar',
    cobrosImgAlt: 'Panel de cobros: anticipos, consultas y gift cards cobrados por Sara, todos sin recepción.',
    ctaInline2: 'Ve a Sara atendiendo tu clínica, en vivo.',
    ctaInline2Cta: 'Pedir mi demo',
    caseKicker: 'Caso de éxito',
    caseH2: 'Ya está <span class="whitespace-nowrap">funcionando en</span><br />clínicas reales.',
    caseStat1: 'conversaciones atendidas por Sara, sin que recepción tocara nada.',
    caseStat2Num: '7 de 10',
    caseStat2: 'citas agendadas por Sara en WhatsApp, Instagram y la web.',
    caseMore: 'Ver el caso de ViaLaser',
    caseImgAlt: 'Citas de ViaLaser por canal y conversaciones por semana atendidas por Sara.',
  },
  en: {
    faqs: [
      { q: 'Can people tell it’s an AI?', a: 'Sara introduces herself naturally and replies in your clinic’s tone. Patients feel they’re talking to someone who knows their stuff, not a bot with buttons.' },
      { q: 'Does she use my current WhatsApp number?', a: 'Sara works over a WhatsApp Business line connected to your clinic. We sort out the number during onboarding; you don’t have to change your personal phone.' },
      { q: 'Does she replace my front desk?', a: 'She frees it from the repetitive part: answering the same questions, confirming appointments, chasing payments. Your team focuses on the patient who’s in the clinic.' },
      { q: 'Does she touch my medical records?', a: 'No. No medical history or clinical information about your patients is stored. That stays exactly where it is today.' },
      { q: 'What do I need to get started?', a: 'Connect your Google Calendar and a WhatsApp line. We handle onboarding with you; you don’t migrate data or switch systems.' },
      { q: 'Can I start with just Sara?', a: 'Yes. Sara is the way in. Mia and Daniel join whenever you want, on the same account.' },
    ],
    saraDoes: [
      'Replies instantly, on WhatsApp and Instagram.',
      'Explains treatments, prices and real availability.',
      'Books the appointment and collects the consult fee or deposit.',
      'Reminds, confirms and reschedules with no one stepping in.',
      'Wins back patients who haven’t returned in months.',
    ],
    context: [
      { n: '01', title: 'They message, they don’t call', body: 'First contact comes in over WhatsApp or Instagram, almost always outside front-desk hours.' },
      { n: '02', title: 'They wait minutes, not hours', body: 'If the reply lands the next day, the interest has cooled and the decision is already made.' },
      { n: '03', title: 'They book with whoever answers first', body: 'They compare a handful of options and book at the clinic that replies soonest.' },
    ],
    payments: [
      { title: 'Online deposit at booking', body: 'Commits the appointment and brings cash flow forward. Cuts no-shows from the first month.' },
      { title: 'Consult paid in advance', body: 'The patient pays when they book, not when they arrive. Your time stops being free.' },
      { title: 'Gift cards', body: 'Your patient gifts a treatment to someone who doesn’t know you yet. You get paid today and gain a new patient that cost you no advertising.' },
    ],
    marketing: [
      { title: 'Posts ready to publish', body: 'Mia writes the copy, picks the image and builds the calendar with your clinic’s brand. You just approve.' },
      { title: 'The post ends in an appointment', body: 'Whoever comments or messages a post, Sara answers and books them. Before the interest cools.' },
      { title: 'You know what worked', body: 'Every month, in plain English: which post brought the most enquiries and how much you billed. No spreadsheets.' },
    ],
    spotlightQuotes: ['“Block my calendar on Friday.”', '“Move Juan to Thursday at 10.”', '“Reschedule everyone from Tuesday.”'],
    heroKicker: 'AI receptionist for clinics, doctors & wellness',
    heroH1: ['More patients.', 'More revenue.', 'All automatic,', 'around the clock.'],
    heroSub: 'Sara answers, books, collects the deposit and cuts no-shows, on WhatsApp, Instagram, SMS and the phone. Without changing your calendar or touching your medical&nbsp;records. And her team lets you know when there is something to&nbsp;decide.',
    heroImgAlt: 'Sara, Mia and Daniel, your clinic’s AI team. Sara up front.',
    demoCta: 'Book a demo',
    scanCta: 'Scan my business',
    talkCta: 'Talk to Sara',
    videoKicker: 'In action',
    videoH2: 'See Sara in 60&nbsp;seconds.',
    videoAlt: 'Video: Sara in action, in 60 seconds',
    videoPlay: 'Play the Sara video',
    ctxKicker: 'The context',
    ctxH2: 'They already decided<br /><em class="text-mint">how</em> to book.',
    ctxSub: 'They expect what they get everywhere else: an instant reply. The clinic that answers first keeps the&nbsp;patient.',
    saraKicker: 'Meet Sara',
    saraH2: '11:41 pm, enquiry.<br /><em class="text-pine-dark">11:43 pm, booked.</em>',
    saraSub: 'She works nights, weekends and peak hours. Without adding one more person to the front desk.',
    saraMore: 'Learn more about Sara',
    saraImgAlt: 'WhatsApp conversation: a patient enquires in the middle of the night and Sara replies, books and collects the deposit.',
    mktH2: 'Mia runs your&nbsp;marketing.',
    mktSub: 'She creates and posts your clinic’s content, runs your Google campaigns and looks after your Google Business profile. Whoever replies, Sara takes it from there to a&nbsp;booking.',
    mktMore: 'See how Mia runs your Instagram',
    mktImgAlt: 'A clinic’s AI-generated Instagram feed: on-brand posts, ready to publish.',
    mktMeet: 'Meet Mia',
    teamKicker: 'Your AI team',
    teamLine: 'Sara answers. Mia brings in patients. Daniel minds the money. All three work on their own and message&nbsp;you.',
    teamMore: 'Meet the team',
    teamMeetPrefix: 'Meet',
    saraRole: 'Reception',
    miaRole: 'Marketing',
    danielRole: 'Finance',
    danielH3: 'Daniel messages you with the numbers.',
    danielPoints: ['What you billed and what you kept', 'Which deposits are still owed', 'Which treatment leaves the most margin'],
    danielMore: 'Meet Daniel',
    spotH2: 'And you ask her<br /><em class="text-pine-dark">for things on WhatsApp.</em>',
    spotMore: 'See operator mode',
    spotBody: 'She manages the entire calendar and notifies every patient. Around the clock.',
    spotImgAlt: 'Sara manages the week’s calendar and reschedules every Tuesday appointment, notifying each patient.',
    ctaInline1: 'Every enquiry you don’t answer in time books at&nbsp;another clinic.',
    cobrosH2: 'You know what you earn.<br /><em class="text-pine-dark">And what earns you&nbsp;most.</em>',
    cobrosSub: 'Daniel is your clinic’s finance director: he closes the month, tells you the margin and where next month is heading. And when there is money to collect, he hands it to&nbsp;Sara.',
    cobrosFormsKicker: 'What Sara collects for you',
    cobrosMore: 'See all the ways to get paid',
    cobrosImgAlt: 'Payments dashboard: deposits, consults and gift cards collected by Sara, all without a front desk.',
    ctaInline2: 'See Sara running your clinic, live.',
    ctaInline2Cta: 'Book my demo',
    caseKicker: 'Success story',
    caseH2: 'It’s already <span class="whitespace-nowrap">running in</span><br />real clinics.',
    caseStat1: 'conversations handled by Sara, without the front desk touching a thing.',
    caseStat2Num: '7 of 10',
    caseStat2: 'appointments booked by Sara across WhatsApp, Instagram and the web.',
    caseMore: 'See the ViaLaser case',
    caseImgAlt: 'ViaLaser appointments by channel and conversations per week handled by Sara.',
  },
}[lang];

const { faqs, saraDoes, context, payments, marketing } = dict;

// El equipo (Sara, Mia, Daniel): caras y roles para el hero, la intro y los kickers de
// cada acto. Fuente única: team.ts. Daniel además presta su chat al Acto 3.
const team = getTeam(lang);
const byId = Object.fromEntries(team.map((m) => [m.id, m])) as Record<string, (typeof team)[number]>;
const sara = getMember('sara', lang)!;
const daniel = getMember('daniel', lang)!;
---

<Layout ogImage={`/og/home-${lang}.jpg`} lang={lang}>
  <Header lang={lang} />

  <main>
    <!-- ══════════ HERO ══════════ -->
    <section class="relative overflow-hidden">
      <div
        class="pointer-events-none absolute -right-32 -top-40 h-[520px] w-[520px] rounded-full opacity-60 blur-3xl"
        style="background: radial-gradient(circle, color-mix(in srgb, var(--color-mint) 40%, transparent), transparent 70%);"
        aria-hidden="true"
      >
      </div>

      <div class="mx-auto grid max-w-6xl items-center gap-14 px-5 py-20 md:grid-cols-[1.05fr_0.95fr] md:py-24">
        <div>
          <p class="mb-6 flex items-center gap-2.5 text-sm font-semibold uppercase tracking-[0.14em] text-pine-dark">
            <span class="dot h-2 w-2"></span>
            {dict.heroKicker}
          </p>
          <h1 class="font-serif font-black leading-[1.05] tracking-tight text-[clamp(1.5rem,8vw,3.75rem)]">
            <span class="block whitespace-nowrap">{dict.heroH1[0]}</span>
            <span class="block whitespace-nowrap">{dict.heroH1[1]}</span>
            <span class="block whitespace-nowrap text-pine-dark">{dict.heroH1[2]}</span>
            <span class="block whitespace-nowrap text-pine-dark">{dict.heroH1[3]}</span>
          </h1>
          <p class="mt-7 max-w-xl text-lg text-salvia" set:html={dict.heroSub} />

          <div class="mt-9 flex flex-wrap items-center gap-3">
            <a
              href={L('/demo')}
              class="inline-flex items-center gap-2 rounded-full bg-pine px-6 py-3 text-base font-semibold text-cream transition-colors hover:bg-pine-dark"
            >
              {dict.demoCta}
            </a>
            {/* CTA secundario del hero. Cuando el flag está ON → "Escanear mi
                negocio" (grader.rayapp.ai, product=servicios). Mientras corren
                las campañas de Ads (flag OFF) cae a "Habla con Sara" para no
                filtrar tráfico pago a un embudo sin el tag de Ads — ver
                src/lib/flags.ts (SHOW_GRADER_CTA). NO quitar el param product. */}
            {SHOW_GRADER_CTA ? (
              <a
                href="https://grader.rayapp.ai/?product=servicios&utm_source=hero&utm_medium=website&utm_campaign=holasara"
                class="inline-flex items-center gap-2 rounded-full border border-line px-6 py-3 text-base font-semibold text-ink transition-colors hover:border-ink/30"
              >
                {dict.scanCta}
              </a>
            ) : (
              <a
                href={whatsappLink(whatsappText(lang))}
                target="_blank"
                rel="noopener"
                class="inline-flex items-center gap-2 rounded-full border border-line px-6 py-3 text-base font-semibold text-ink transition-colors hover:border-ink/30"
              >
                {dict.talkCta}
              </a>
            )}
          </div>
        </div>

        <div class="flex justify-center md:justify-end">
          <!-- El equipo, Sara al frente: tres retratos reales (los mismos de /equipo). -->
          <div class="relative w-full max-w-lg">
            <div class="relative mx-auto aspect-[5/4] w-full max-w-[30rem]" role="img" aria-label={dict.heroImgAlt}>
              <div class="absolute left-0 top-4 w-[44%] -rotate-6 overflow-hidden rounded-2xl border border-line bg-cream shadow-[0_18px_40px_-24px_rgba(20,38,31,0.45)]">
                <img src={byId.daniel.poster} width="464" height="688" alt="" loading="eager" decoding="async" class="aspect-[3/4] w-full object-cover object-top" />
                <span class="absolute top-3 left-3 flex items-center gap-1.5 whitespace-nowrap rounded-full bg-cream/95 px-3 py-1.5 text-xs font-semibold text-ink shadow">
                  <span class="dot h-2 w-2"></span>{byId.daniel.name}<span class="hidden sm:inline"> · {dict.danielRole}</span>
                </span>
              </div>
              <div class="absolute right-0 top-4 w-[44%] rotate-6 overflow-hidden rounded-2xl border border-line bg-cream shadow-[0_18px_40px_-24px_rgba(20,38,31,0.45)]">
                <img src={byId.mia.poster} width="464" height="688" alt="" loading="eager" decoding="async" class="aspect-[3/4] w-full object-cover object-top" />
                <span class="absolute top-3 right-3 flex items-center gap-1.5 whitespace-nowrap rounded-full bg-cream/95 px-3 py-1.5 text-xs font-semibold text-ink shadow">
                  <span class="dot h-2 w-2"></span>{byId.mia.name}<span class="hidden sm:inline"> · {dict.miaRole}</span>
                </span>
              </div>
              <div class="absolute bottom-0 left-1/2 w-[54%] -translate-x-1/2 overflow-hidden rounded-3xl border-2 border-cream bg-cream shadow-[0_28px_60px_-28px_rgba(20,38,31,0.55)]">
                <img src={byId.sara.poster} width="464" height="688" alt="" loading="eager" decoding="async" class="aspect-[3/4] w-full object-cover object-top" />
                <span class="absolute bottom-3 left-1/2 flex -translate-x-1/2 items-center gap-1.5 whitespace-nowrap rounded-full bg-cream/95 px-3 py-1.5 text-xs font-semibold text-ink shadow">
                  <span class="dot h-2 w-2"></span>{byId.sara.name}<span class="hidden sm:inline"> · {dict.saraRole}</span>
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <ClientsStrip tone="paper" lang={lang} />

    <!-- ══════════ VIDEO ══════════ -->
    <section id="video" class="border-t border-line bg-paper">
      <div class="reveal mx-auto max-w-5xl px-5 py-24 text-center">
        <p class="mb-3 text-sm font-semibold uppercase tracking-[0.14em] text-pine-dark">{dict.videoKicker}</p>
        <h2 class="mx-auto max-w-2xl font-serif text-4xl font-black leading-tight text-balance md:text-5xl" set:html={dict.videoH2} />

        <!-- Video demo: portada liviana (thumbnail YouTube); el iframe se carga recién al clic -->
        <div
          id="video-embed"
          data-yt="-HAjxKXeltI"
          class="group relative mt-10 aspect-video cursor-pointer overflow-hidden rounded-2xl border border-line bg-ink shadow-[0_16px_40px_-26px_rgba(20,38,31,0.38)]"
        >
          <img
            src="https://img.youtube.com/vi/-HAjxKXeltI/maxresdefault.jpg"
            alt={dict.videoAlt}
            class="absolute inset-0 h-full w-full object-cover opacity-95 transition group-hover:opacity-100"
            loading="lazy"
            decoding="async"
          />
          <button
            type="button"
            class="absolute inset-0 flex items-center justify-center bg-ink/25 transition group-hover:bg-ink/15"
            aria-label={dict.videoPlay}
          >
            <span class="grid h-20 w-20 place-items-center rounded-full bg-mint shadow-lg transition-transform duration-300 group-hover:scale-110">
              <svg width="26" height="30" viewBox="0 0 26 30" fill="none" aria-hidden="true">
                <path d="M25 13.27a2 2 0 0 1 0 3.46L3 29.32A2 2 0 0 1 0 27.6V2.4A2 2 0 0 1 3 .68l22 12.6Z" fill="#14261F" />
              </svg>
            </span>
          </button>
        </div>
      </div>
    </section>

    <script is:inline>
      (function () {
        var el = document.getElementById('video-embed');
        if (!el) return;
        el.addEventListener('click', function () {
          var id = el.getAttribute('data-yt');
          el.innerHTML =
            '<iframe class="absolute inset-0 h-full w-full" src="https://www.youtube-nocookie.com/embed/' +
            id +
            '?autoplay=1&rel=0" title="Sara" frameborder="0" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>';
        });
      })();
    </script>

    <!-- ══════════ EL CONTEXTO (banda oscura) ══════════ -->
    <section class="bg-ink text-cream">
      <div class="reveal mx-auto max-w-6xl px-5 py-24 md:py-28">
        <div class="max-w-3xl">
          <p class="mb-4 flex items-center gap-2.5 text-sm font-semibold uppercase tracking-[0.14em] text-mint">
            <span class="h-2 w-2 rounded-full bg-mint"></span>{dict.ctxKicker}
          </p>
          <h2 class="font-serif text-4xl font-black leading-tight text-balance md:text-5xl" set:html={dict.ctxH2} />
          <p class="mt-5 text-lg text-cream/70" set:html={dict.ctxSub} />
        </div>

        <div class="mt-16 grid gap-x-10 gap-y-12 md:grid-cols-3">
          {
            context.map((c) => (
              <div>
                <div class="flex items-center gap-4">
                  <span class="font-serif text-4xl font-black text-mint tabular-nums">{c.n}</span>
                  <span class="h-px flex-1 bg-cream/15" />
                </div>
                <h3 class="mt-5 text-xl font-semibold text-cream">{c.title}</h3>
                <p class="mt-2 text-cream/65">{c.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ══════════ TU EQUIPO (intro de los tres actos) ══════════ -->
    <section id="equipo" class="border-t border-line">
      <div class="reveal mx-auto flex max-w-6xl flex-col gap-6 px-5 py-14 md:flex-row md:items-center md:justify-between">
