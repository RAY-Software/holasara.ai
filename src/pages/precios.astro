---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FeatureFaq from '../components/FeatureFaq.astro';
import CtaBand from '../components/CtaBand.astro';
import { whatsappLink } from '../lib/whatsapp';

const includes = [
  'Sara atendiendo WhatsApp e Instagram 24/7',
  'Agenda automática con tu Google Calendar',
  'Recordatorios, confirmación y lista de espera',
  'Cobro de anticipo y consulta',
  'Gift cards en tu web',
  'Instagram con IA y pedido de reseñas',
  'Modo operador para tu equipo',
  'Panel con resultados por canal',
];

const faqs = [
  { q: '¿Cobran comisión por turno?', a: 'No. Es una suscripción mensual fija. Los turnos que agende Sara no te suman una comisión por transacción.' },
  { q: '¿El precio es el mismo en todos los países?', a: 'No. Se ajusta al país y la moneda de tu clínica. En la demo te pasamos el precio exacto para tu caso.' },
  { q: '¿Hay contrato de permanencia?', a: 'Trabajamos con un modelo simple y sin letra chica. Los detalles los vemos en la demo, con todo claro antes de empezar.' },
  { q: '¿Qué necesito para arrancar?', a: 'Conectar tu Google Calendar y una línea de WhatsApp. La implementación la hacemos contigo; no migras datos ni tocas tu historia clínica.' },
];
---

<Layout
  title="Precios · Sara"
  description="Un plan que incluye todo lo que hace Sara, con precio por país y sin comisión por turno. Pide tu precio en una demo."
>
  <Header />
  <main>
    <section class="border-b border-line">
      <div class="mx-auto max-w-3xl px-5 pb-16 pt-14 text-center">
        <p class="mb-4 flex items-center justify-center gap-2.5 text-sm font-semibold uppercase tracking-[0.14em] text-pine-dark">
          <span class="dot h-2 w-2"></span> Precios
        </p>
        <h1 class="font-serif text-4xl font-black leading-[1.05] tracking-tight text-balance md:text-6xl">
          Un plan. Todo lo que hace&nbsp;Sara.
        </h1>
        <p class="mx-auto mt-6 max-w-xl text-lg text-salvia">
          Sin planes confusos ni comisión por turno. Una suscripción mensual, con precio ajustado a
          tu país, que incluye a Sara completa.
        </p>
      </div>
    </section>

    <section class="border-b border-line bg-paper">
      <div class="mx-auto grid max-w-5xl gap-8 px-5 py-20 md:grid-cols-[1.1fr_0.9fr] md:items-center">
        <div>
          <h2 class="font-serif text-3xl font-black leading-tight text-balance md:text-4xl">Todo incluido, sin&nbsp;sorpresas.</h2>
          <ul class="mt-8 grid gap-3.5 sm:grid-cols-2">
            {
              includes.map((x) => (
                <li class="flex items-start gap-3">
                  <span class="mt-1 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-mint">
                    <svg width="12" height="12" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                      <path d="M4 10.5 8 14.5 16 6" stroke="#14261F" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </span>
                  <span class="text-ink">{x}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="rounded-2xl border border-pine/20 bg-white p-8 text-center shadow-[0_16px_40px_-24px_rgba(20,38,31,0.35)]">
          <p class="text-sm font-semibold uppercase tracking-[0.12em] text-pine-dark">Tu precio, a medida</p>
          <p class="mt-4 font-serif text-3xl font-black leading-tight text-ink">Te lo pasamos en la&nbsp;demo.</p>
          <p class="mt-3 text-salvia">Según tu país y tu clínica, sin vueltas. En la misma demo ves a Sara funcionando con tus datos.</p>
          <a
            href="/demo"
            class="mt-7 inline-flex w-full items-center justify-center rounded-full bg-pine px-6 py-3.5 text-base font-semibold text-cream transition-colors hover:bg-pine-dark"
          >
            Pedir mi precio
          </a>
          <a
            href={whatsappLink()}
            target="_blank"
            rel="noopener"
            class="mt-3 inline-flex w-full items-center justify-center gap-2 rounded-full border border-line px-6 py-3 text-base font-semibold text-ink transition-colors hover:border-ink/30"
          >
            <span class="dot h-2 w-2"></span> Preguntar por WhatsApp
          </a>
        </div>
      </div>
    </section>

    <FeatureFaq items={faqs} />

    <CtaBand />
  </main>
  <Footer />
</Layout>
