---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SaraSelect from '../components/SaraSelect.astro';
import ClientsStrip from '../components/ClientsStrip.astro';
import { WHATSAPP_AR, WHATSAPP_MX } from '../lib/whatsapp';

// Endpoint opcional para el lead (Zapier/Make catch hook). Si no está seteado,
// el formulario hace handoff a WhatsApp con un resumen prellenado, así siempre
// funciona sin backend. Cuando quieras CRM, setea PUBLIC_DEMO_ENDPOINT en Vercel.
const DEMO_ENDPOINT = import.meta.env.PUBLIC_DEMO_ENDPOINT ?? '';
// Google Places (browser key, referrer-restricted). Si no está seteada, el campo
// clínica queda como input de texto normal (degradación elegante, como RAY).
const GOOGLE_MAPS_KEY = import.meta.env.PUBLIC_GOOGLE_MAPS_API_KEY ?? '';

const roleOptions = [
  { value: 'Dueño/a', label: 'Dueño/a de la clínica' },
  { value: 'Director/a médico', label: 'Director/a médico' },
  { value: 'Gerencia/Administración', label: 'Gerencia o administración' },
  { value: 'Recepción', label: 'Recepción' },
  { value: 'Otro', label: 'Otro' },
];

const benefits = [
  {
    t: 'La ves con tu propia clínica',
    b: 'Le pasamos tus tratamientos y tu forma de agendar. En la demo, Sara responde como si ya trabajara ahí.',
  },
  {
    t: 'Una consulta real, de punta a punta',
    b: 'Escribes como un paciente. Sara informa, agenda y cobra el anticipo frente a ti.',
  },
  {
    t: 'Sin instalar nada',
    b: 'No migras datos ni tocas tu historia clínica. Se conecta con el Google Calendar que ya usas.',
  },
  {
    t: 'Te decimos si te conviene',
    b: 'Si tu volumen no da para Sara, te lo decimos. No perdemos tu tiempo ni el nuestro.',
  },
];
---

<Layout
  title="Pide tu demo · Sara"
  description="Agendá una demo de Sara con tu propia clínica: mirá cómo atiende WhatsApp e Instagram, agenda y cobra el anticipo, en vivo."
>
  <Header />

  <main class="bg-paper">
    <div class="mx-auto max-w-6xl px-5 py-14 md:py-20">
      <a href="/" class="mb-8 inline-flex items-center gap-1.5 text-sm font-medium text-salvia transition-colors hover:text-ink">
        <span aria-hidden="true">←</span> Volver al inicio
      </a>

      <div class="grid gap-12 md:grid-cols-[0.95fr_1.05fr] md:gap-16 md:items-start">
        <!-- ─── Izquierda: por qué + prueba real ─── -->
        <div>
          <p class="mb-4 flex items-center gap-2.5 text-sm font-semibold uppercase tracking-[0.14em] text-pine-dark">
            <span class="dot h-2 w-2"></span> Pide tu demo
          </p>
          <h1 class="font-serif text-4xl font-black leading-[1.05] tracking-tight text-balance md:text-5xl">
            Mira a Sara atender <em class="text-pine-dark">tu</em> clínica.
          </h1>
          <p class="mt-6 max-w-xl text-lg text-salvia">
            No es una presentación con diapositivas. Cargamos tus tratamientos y pruebas una
            consulta real: Sara responde, agenda y cobra el anticipo frente a ti.
          </p>

          <!-- Prueba real: ViaLaser (no inventamos testimonios) -->
          <div class="mt-10 rounded-xl border border-line bg-cream p-7">
            <div class="flex items-center gap-3">
              <img src="/img/vialaser-logo.png" width="398" height="126" alt="ViaLaser" class="h-7 w-auto" loading="lazy" />
              <span class="text-sm font-medium text-salvia">Ya trabaja acá</span>
            </div>
            <div class="mt-6 grid grid-cols-3 gap-4">
              <div>
                <p class="font-serif text-3xl font-black text-pine-dark tabular-nums md:text-4xl">114</p>
                <p class="mt-1 text-xs leading-tight text-salvia">consultas atendidas sin recepción</p>
              </div>
              <div>
                <p class="font-serif text-3xl font-black text-pine-dark tabular-nums md:text-4xl">7/10</p>
                <p class="mt-1 text-xs leading-tight text-salvia">citas agendadas por Sara</p>
              </div>
              <div>
                <p class="font-serif text-3xl font-black text-pine-dark tabular-nums md:text-4xl">US$1.071</p>
                <p class="mt-1 text-xs leading-tight text-salvia">en citas, atribuidas por canal</p>
              </div>
            </div>
          </div>

          <ul class="mt-8 grid gap-5 sm:grid-cols-2">
            {
              benefits.map((x) => (
                <li>
                  <h3 class="text-[15px] font-semibold text-ink">{x.t}</h3>
                  <p class="mt-1 text-sm text-salvia">{x.b}</p>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- ─── Derecha: formulario ─── -->
        <div class="rounded-2xl border border-line bg-cream p-7 shadow-[0_10px_30px_-20px_rgba(20,38,31,0.28)] md:p-9">
          <h2 class="font-serif text-2xl font-black text-ink">Cuéntanos de tu clínica</h2>
          <p class="mt-2 text-sm text-salvia">Te escribimos el mismo día para coordinar. Sin compromiso.</p>

          <form id="demo-form" class="mt-7 flex flex-col gap-5" novalidate data-endpoint={DEMO_ENDPOINT}>
            <SaraSelect name="role" label="¿Cuál es tu rol?" options={roleOptions} required />

            <div>
              <label for="name" class="mb-1.5 block text-sm font-medium text-ink">Nombre y apellido</label>
              <input id="name" name="name" type="text" autocomplete="name" required class="w-full rounded-xl border border-line bg-white px-3.5 py-2.5 text-ink focus:border-pine focus:outline-none focus:ring-2 focus:ring-pine/25" />
            </div>

            <div>
              <label for="clinic" class="mb-1.5 block text-sm font-medium text-ink">Nombre de la clínica</label>
              <input id="clinic" name="clinic" type="text" autocomplete="off" required class="w-full rounded-xl border border-line bg-white px-3.5 py-2.5 text-ink focus:border-pine focus:outline-none focus:ring-2 focus:ring-pine/25" />
              <p id="clinic-hint" class="mt-1 hidden text-xs text-salvia">Empieza a escribir y elígela de la lista.</p>
              <input type="hidden" name="clinic_place_id" id="clinic_place_id" />
              <input type="hidden" name="clinic_address" id="clinic_address" />
            </div>

            <div>
              <label for="phone" class="mb-1.5 block text-sm font-medium text-ink">WhatsApp</label>
              <input id="phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" placeholder="+52 …" required class="w-full rounded-xl border border-line bg-white px-3.5 py-2.5 text-ink focus:border-pine focus:outline-none focus:ring-2 focus:ring-pine/25" />
            </div>

            <div>
              <label for="email" class="mb-1.5 block text-sm font-medium text-ink">
                Email <span class="font-normal text-salvia">(opcional)</span>
              </label>
              <input id="email" name="email" type="email" autocomplete="email" class="w-full rounded-xl border border-line bg-white px-3.5 py-2.5 text-ink focus:border-pine focus:outline-none focus:ring-2 focus:ring-pine/25" />
            </div>

            <!-- Atribución: se rellenan al enviar, desde la URL o la cookie sara_click -->
            <input type="hidden" name="gclid" id="f_gclid" />
            <input type="hidden" name="wbraid" id="f_wbraid" />
            <input type="hidden" name="gbraid" id="f_gbraid" />
            <input type="hidden" name="fbclid" id="f_fbclid" />

            <label class="flex items-start gap-3 text-sm text-salvia">
              <input type="checkbox" name="consent" required class="mt-1 h-4 w-4 shrink-0 rounded border-line text-pine focus:ring-pine/25" />
              <span>Acepto que Sara me contacte por WhatsApp o email para coordinar la demo.</span>
            </label>

            <p id="demo-error" class="hidden rounded-xl border border-red-300 bg-red-50 px-4 py-3 text-sm text-red-700"></p>

            <button
              type="submit"
              id="demo-submit"
              class="mt-1 inline-flex items-center justify-center gap-2 rounded-full bg-pine px-6 py-3.5 text-base font-semibold text-cream transition-colors hover:bg-pine-dark disabled:cursor-not-allowed disabled:opacity-60"
            >
              Pedir mi demo
            </button>

            <p class="text-center text-xs text-salvia">
              ¿Prefieres escribir ahora? <a href="/" data-wa-fallback class="font-semibold text-pine-dark underline">Habla con Sara por WhatsApp</a>.
            </p>
          </form>

          <!-- Estado de éxito -->
          <div id="demo-success" class="hidden">
            <div class="grid place-items-center py-6 text-center">
              <span class="grid h-14 w-14 place-items-center rounded-full bg-mint">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M5 13l4 4L19 7" stroke="#14261F" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
              <h2 class="mt-5 font-serif text-2xl font-black text-ink">Listo, lo recibimos.</h2>
              <p class="mt-2 max-w-sm text-salvia">Te escribimos hoy mismo por WhatsApp para coordinar la demo con tu clínica.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <ClientsStrip />

  <Footer />

  <script is:inline define:vars={{ WHATSAPP_AR, WHATSAPP_MX, GOOGLE_MAPS_KEY }}>
    (function () {
      var form = document.getElementById('demo-form');
      if (!form) return;
      var btn = document.getElementById('demo-submit');
      var errBox = document.getElementById('demo-error');
      var endpoint = form.getAttribute('data-endpoint') || '';

      // Ruteo AR/MX (mismo criterio que el resto del sitio)
      var IS_AR = false;
      try {
        var tz = (Intl.DateTimeFormat().resolvedOptions().timeZone) || '';
        IS_AR = /America\/Argentina/.test(tz) || /^es-AR/i.test(navigator.language || '');
      } catch (e) {}
      var WA = IS_AR ? WHATSAPP_AR : WHATSAPP_MX;

      // ── Google Places autocomplete en el campo clínica (degradación elegante) ──
      // Si no hay key o la API no carga, el input queda como texto normal.
      (function initClinicAutocomplete() {
        if (!GOOGLE_MAPS_KEY) return; // sin key → input normal
        var input = document.getElementById('clinic');
        var placeIdEl = document.getElementById('clinic_place_id');
        var addressEl = document.getElementById('clinic_address');
        var hint = document.getElementById('clinic-hint');
        if (!input) return;

        function attach() {
          try {
            var ac = new google.maps.places.Autocomplete(input, {
              types: ['establishment'],
              fields: ['name', 'place_id', 'formatted_address'],
              componentRestrictions: { country: IS_AR ? ['ar'] : ['mx', 'ar'] },
            });
            ac.addListener('place_changed', function () {
              var p = ac.getPlace() || {};
              if (p.name) input.value = p.name;
              if (placeIdEl) placeIdEl.value = p.place_id || '';
              if (addressEl) addressEl.value = p.formatted_address || '';
            });
            // typing manual limpia la selección previa
            input.addEventListener('input', function () {
              if (placeIdEl) placeIdEl.value = '';
              if (addressEl) addressEl.value = '';
            });
            if (hint) hint.classList.remove('hidden');
          } catch (e) {}
        }

        if (window.google && window.google.maps && window.google.maps.places) {
          attach();
        } else {
          var s = document.createElement('script');
          s.src =
            'https://maps.googleapis.com/maps/api/js?key=' +
            encodeURIComponent(GOOGLE_MAPS_KEY) +
            '&libraries=places&v=weekly&loading=async';
          s.async = true;
          s.defer = true;
          s.onload = function () {
            // poll hasta que Places esté disponible
            var tries = 0;
            (function poll() {
              if (window.google && window.google.maps && window.google.maps.places) attach();
              else if (tries++ < 50) setTimeout(poll, 100);
            })();
          };
          document.head.appendChild(s);
        }
      })();

      // ── Atribución ──────────────────────────────────────────────────────────
      // Click-ids de la URL; si no vienen, de la cookie sara_click (90 días) que
      // deja el script del Layout. Sirven para dos cosas: subir la conversión
      // offline cuando el lead cierra, y arrastrar el token al handoff de WhatsApp.
      var CLICK_KEYS = ['gclid', 'wbraid', 'gbraid', 'fbclid'];

      function clickIds() {
        var out = {};
        var p = new URLSearchParams(location.search);
        var found = false;
        CLICK_KEYS.forEach(function (k) {
          out[k] = p.get(k) || '';
          if (out[k]) found = true;
        });
        if (found) return out;
        var m = document.cookie.match('(^|;)\\s*sara_click\\s*=\\s*([^;]+)');
        var raw = m ? decodeURIComponent(m.pop()) : '';
        CLICK_KEYS.forEach(function (k) {
          var mm = raw.match(new RegExp('\\[' + k + ':([^\\]]+)\\]'));
          out[k] = mm ? mm[1] : '';
        });
        return out;
      }

      function clickToken(ids) {
        return CLICK_KEYS.filter(function (k) {
          return ids[k];
        })
          .map(function (k) {
            return '[' + k + ':' + ids[k] + ']';
          })
          .join('');
      }

      // ── Enhanced Conversions ────────────────────────────────────────────────
      // gtag hashea (SHA-256) del lado del cliente; nosotros solo normalizamos.
      // Teléfono a E.164: si no trae +, le anteponemos el código del país detectado.
      function normPhone(raw) {
        var s = String(raw || '').trim();
        if (s.charAt(0) === '+') return '+' + s.slice(1).replace(/\D/g, '');
        var d = s.replace(/\D/g, '');
        if (!d) return '';
        var cc = IS_AR ? '54' : '52';
        if (d.length > 10 && d.indexOf(cc) === 0) return '+' + d;
        return '+' + cc + d;
      }

      function setUserData(data) {
        try {
          if (!window.gtag) return;
          var ud = {};
          var mail = String(data.email || '').trim().toLowerCase();
          var tel = normPhone(data.phone);
          if (mail) ud.email = mail;
          if (tel) ud.phone_number = tel;
          if (ud.email || ud.phone_number) gtag('set', 'user_data', ud);
        } catch (e) {}
      }

      function showError(msg) {
        errBox.textContent = msg;
        errBox.classList.remove('hidden');
      }

      // Dispara los eventos de lead y llama a cb() cuando Ads confirmó (o a los 900 ms,
      // lo que pase primero). Sin esto, el redirect a WhatsApp mata el request de
      // conversión antes de que salga y se pierden leads en el reporte.
      function fireLead(data, cb) {
        var done = false;
        function once() {
          if (done) return;
          done = true;
          if (cb) cb();
        }

        try { if (window.fbq) fbq('track', 'Lead', { content_name: 'demo-page' }); } catch (e) {}

        var c = window.__saraTrack;
        var hasAds = !!(window.gtag && c && c.adsId && c.demoLabel);

        try {
          if (window.gtag) {
            setUserData(data);
            gtag('event', 'generate_lead', {
              event_category: 'engagement',
              event_label: 'demo-page',
              transport_type: 'beacon',
            });
            gtag('event', 'demo_solicitada', {
              event_category: 'engagement',
              event_label: 'demo-page',
              value: 1,
              transport_type: 'beacon',
            });
            if (hasAds) {
              gtag('event', 'conversion', {
                send_to: c.adsId + '/' + c.demoLabel,
                event_callback: once,
              });
            }
          }
        } catch (e) {}

        if (hasAds) setTimeout(once, 900);
        else once();
      }

      function waHandoff(data, token) {
        var msg =
          'Hola Sara, quiero una demo para mi clínica.\n' +
          '• Clínica: ' + (data.clinic || '-') + '\n' +
          '• Nombre: ' + (data.name || '-') + '\n' +
          '• Rol: ' + (data.role || '-');
        if (token) msg += '\n' + token;
        return 'https://wa.me/' + WA + '?text=' + encodeURIComponent(msg);
      }

      // El link de fallback abre WhatsApp directo (el Layout le inyecta el token)
      var fb = form.querySelector('[data-wa-fallback]');
      if (fb) fb.setAttribute('href', 'https://wa.me/' + WA + '?text=' + encodeURIComponent('Hola Sara, quiero una demo para mi clínica.'));

      form.addEventListener('submit', function (ev) {
        ev.preventDefault();
        errBox.classList.add('hidden');

        // Click-ids frescos justo antes de leer el form
        var ids = clickIds();
        CLICK_KEYS.forEach(function (k) {
          var el = document.getElementById('f_' + k);
          if (el) el.value = ids[k];
        });

        var fd = new FormData(form);
        var data = Object.fromEntries(fd.entries());

        // Validación mínima. Email es opcional, pero si lo escriben tiene que ser válido.
        if (!data.role || !data.name || !data.phone || !data.clinic) {
          return showError('Completa los campos requeridos para pedir tu demo.');
        }
        if (data.email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(String(data.email))) {
          return showError('Revisa el email: no parece válido.');
        }
        if (!fd.get('consent')) {
          return showError('Necesitamos tu OK para contactarte y coordinar la demo.');
        }

        btn.disabled = true;
        btn.textContent = 'Enviando…';

        var token = clickToken(ids);

        function showSuccess() {
          form.classList.add('hidden');
          var ok = document.getElementById('demo-success');
          if (ok) ok.classList.remove('hidden');
        }

        var payload = Object.assign({}, data, {
          source_page: 'demo',
          region: IS_AR ? 'AR' : 'MX',
          page_url: location.href,
          ts: new Date().toISOString(),
        });

        if (endpoint) {
          fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          })
            .then(function (r) {
              if (!r.ok) throw new Error('bad status');
              fireLead(data);
              showSuccess();
            })
            .catch(function () {
              // Si el endpoint falla, no perdemos el lead: handoff a WhatsApp
              fireLead(data, function () {
                window.location.href = waHandoff(data, token);
              });
            });
        } else {
          // Sin backend configurado: handoff a WhatsApp con el resumen
          fireLead(data, function () {
            window.location.href = waHandoff(data, token);
          });
        }
      });
    })();
  </script>
</Layout>
