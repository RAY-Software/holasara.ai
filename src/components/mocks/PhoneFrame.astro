---
// Marco de iPhone (bezel, Dynamic Island, barra de estado, cabecera y tab bar) para
// los mocks de la app Sara AI. La pantalla va en el slot. Fiel a los screenshots del
// App Store: barra de estado y cabecera blancas, cuerpo gris "paper", tabs abajo.
// Alto fijo por aspect-ratio: lo que no entra se recorta, como en un teléfono real.
import { defaultLocale, type Locale } from '../../i18n/config';

export type Tab = 'panel' | 'today' | 'agenda' | 'clients' | 'sara';

interface Props {
  lang?: Locale;
  /** Título centrado de la cabecera (p. ej. "Panel"). Sin él, no hay cabecera. */
  title?: string;
  /** Chevron de volver, a la izquierda del título. */
  back?: boolean;
  /** Tab activa de la barra inferior. Sin ella, no se pinta la barra. */
  tab?: Tab;
  /** Contador rojo sobre la tab de Sara (chats que piden un humano). */
  badge?: number;
  class?: string;
}
const { lang = defaultLocale, title, back = false, tab, badge, class: cls = '' } = Astro.props;
const hasHeaderRight = Astro.slots.has('header-right');

const labels: Record<Tab, string> =
  lang === 'en'
    ? { panel: 'Dashboard', today: 'Today', agenda: 'Schedule', clients: 'Clients', sara: 'Sara' }
    : { panel: 'Panel', today: 'Hoy', agenda: 'Agenda', clients: 'Clientes', sara: 'Sara' };
const tabs: Tab[] = ['panel', 'today', 'agenda', 'clients', 'sara'];
const icons: Record<Tab, string> = {
  panel: '<path d="M5 19v-8M10 19V5M15 19v-6M20 19V9" />',
  today:
    '<rect x="4" y="5" width="16" height="15" rx="2.5" /><path d="M4 10h16M9 3v4M15 3v4" /><rect x="8" y="13" width="3.2" height="3.2" rx=".7" fill="currentColor" stroke="none" />',
  agenda:
    '<rect x="4" y="5" width="16" height="15" rx="2.5" /><path d="M4 10h16M9 3v4M15 3v4M8 14h2M11 14h2M14 14h2M8 17h2M11 17h2" />',
  clients:
    '<circle cx="9" cy="8.5" r="3" /><circle cx="16.5" cy="9.5" r="2.3" /><path d="M3.5 19c0-3 2.5-5 5.5-5s5.5 2 5.5 5M14.5 19c0-2.3 1.5-4 3.5-4s3.5 1.7 3.5 4" />',
  sara: '<path d="M12 4c-4.6 0-8 3-8 6.8 0 2 1 3.8 2.6 5L6 20l4.2-1.6c.6.1 1.2.2 1.8.2 4.6 0 8-3 8-6.8S16.6 4 12 4z" />',
};
---

<figure class={`phone ${cls}`}>
  <div class="phone__screen">
    <div class="phone__status">
      <span class="phone__time">9:41</span>
      <span class="phone__island" aria-hidden="true"></span>
      <span class="phone__signal" aria-hidden="true">
        <svg viewBox="0 0 18 12" fill="currentColor"><rect x="0" y="8" width="3" height="4" rx=".7" /><rect x="5" y="5.5" width="3" height="6.5" rx=".7" /><rect x="10" y="3" width="3" height="9" rx=".7" /><rect x="15" y="0" width="3" height="12" rx=".7" /></svg>
        <svg viewBox="0 0 16 12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M1.5 4.2a10 10 0 0 1 13 0M4 7a6.5 6.5 0 0 1 8 0M6.5 9.6a3 3 0 0 1 3 0" /></svg>
        <svg viewBox="0 0 28 12" fill="none"><rect x=".75" y=".75" width="23" height="10.5" rx="3" stroke="currentColor" stroke-opacity=".4" stroke-width="1.5" /><rect x="2.5" y="2.5" width="19.5" height="7" rx="1.8" fill="#3fe08a" /><path d="M26 4.2v3.6a2 2 0 0 0 0-3.6z" fill="currentColor" fill-opacity=".4" /></svg>
      </span>
    </div>

    {
      title && (
        <div class="phone__header">
          {back && (
            <span class="phone__back" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 6 8.5 12l6 6" /></svg>
            </span>
          )}
          <span class="phone__title">{title}</span>
          {hasHeaderRight && (
            <span class="phone__right" aria-hidden="true">
              <slot name="header-right" />
            </span>
          )}
        </div>
      )
    }

    <div class="phone__body">
      <slot />
    </div>

    {
      tab && (
        <nav class="phone__tabs" aria-hidden="true">
          {tabs.map((t) => (
            <span class:list={['phone__tab', t === tab && 'is-active']}>
              <span class="phone__tab-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={icons[t]} />
                {t === 'sara' && badge ? <i class="phone__badge">{badge}</i> : null}
              </span>
              {labels[t]}
            </span>
          ))}
        </nav>
      )
    }
  </div>
</figure>

<style>
  .phone {
    width: 100%;
    max-width: 19.5rem;
    margin: 0;
    padding: 0.55rem;
    border-radius: 2.8rem;
    background: #0d0d0d;
    box-shadow: 0 28px 64px -30px rgba(20, 38, 31, 0.6);
    font-family: -apple-system, BlinkMacSystemFont, 'Inter Variable', 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    color: #14261f;
  }
  .phone__screen {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    aspect-ratio: 390 / 790;
    border-radius: 2.3rem;
    background: #fff;
  }

  .phone__status {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 2.7rem;
    padding: 0.55rem 1.35rem 0;
    font-size: 0.82rem;
    font-weight: 600;
  }
  .phone__island {
    position: absolute;
    left: 50%;
    top: 0.6rem;
    width: 5.5rem;
    height: 1.55rem;
    transform: translateX(-50%);
    border-radius: 999px;
    background: #000;
  }
  .phone__signal {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }
  .phone__signal svg {
    height: 0.7rem;
    width: auto;
  }

  .phone__header {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem 2.6rem 0.65rem;
    border-bottom: 1px solid #e4e8e4;
    font-size: 0.95rem;
    font-weight: 600;
  }
  .phone__back,
  .phone__right {
    position: absolute;
    top: 50%;
    display: grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    transform: translateY(-50%);
    border-radius: 999px;
    background: #f1f3f2;
  }
  .phone__back {
    left: 0.8rem;
  }
  .phone__right {
    right: 0.8rem;
    background: transparent;
  }
  .phone__back svg,
  .phone__right :global(svg) {
    width: 1.05rem;
    height: 1.05rem;
  }
  .phone__title {
    white-space: nowrap;
  }

  .phone__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.55rem;
    min-height: 0;
    overflow: hidden;
    padding: 0.75rem 0.75rem 0.5rem;
    background: #f6f8f7;
  }

  .phone__tabs {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    padding: 0.5rem 0.35rem 1.1rem;
    border-top: 1px solid #e4e8e4;
    background: #fff;
  }
  .phone__tab {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
    font-size: 0.58rem;
    font-weight: 500;
    color: #8a948d;
  }
  .phone__tab.is-active {
    color: #1a6349;
  }
  .phone__tab-icon {
    position: relative;
    display: grid;
    place-items: center;
  }
  .phone__tab-icon svg {
    width: 1.3rem;
    height: 1.3rem;
  }
  .phone__badge {
    position: absolute;
    top: -0.4rem;
    right: -0.55rem;
    display: grid;
    place-items: center;
    min-width: 1rem;
    height: 1rem;
    padding: 0 0.25rem;
    border-radius: 999px;
    background: #e5484d;
    color: #fff;
    font-size: 0.55rem;
    font-style: normal;
    font-weight: 700;
  }
</style>
