---
// Mock del panel de cobros de Sara (reemplaza /img/cobros.jpg).
// HTML/CSS nítido y bilingüe: header de marca, 4 KPI tiles, lista "Cobros
// recientes" (14 filas con pill de tipo, nombre, canal, monto y estado) y
// columna "Gift cards" con la tarjeta de regalo verde->amarillo + stat cards.
// Datos fieles al mockup original (RAY Health / Clínica Aurora).
import { defaultLocale, type Locale } from '../../i18n/config';

interface Props {
  lang?: Locale;
  class?: string;
}
const { lang = defaultLocale, class: cls = '' } = Astro.props;

const en = lang === 'en';
const t = {
  brand: 'RAY Health',
  section: en ? 'Payments' : 'Cobros',
  month: en ? 'July 2026' : 'Julio 2026',
  kpis: [
    { v: 'US$ 4.860', l: en ? 'collected this month' : 'cobrado este mes' },
    { v: '68', l: en ? 'deposits & consults' : 'anticipos y consultas' },
    { v: '14', l: en ? 'gift cards sold' : 'gift cards vendidas' },
    { v: 'US$ 1.680', l: en ? 'in unused gift cards' : 'en gift cards sin usar' },
  ],
  recentTitle: en ? 'Recent payments' : 'Cobros recientes',
  recentNote: en ? 'all by Sara, no front desk' : 'todos por Sara, sin recepción',
  paid: en ? 'Paid' : 'Pagado',
  tags: {
    deposit: en ? 'Deposit' : 'Anticipo',
    consult: en ? 'Consult' : 'Consulta',
    giftcard: 'Gift card',
  },
  giftTitle: 'Gift cards',
  giftClinic: 'CLÍNICA AURORA',
  giftFor: en ? 'For Julieta' : 'Para Julieta',
  giftFrom: en ? 'From Camila Ferrer' : 'De parte de Camila Ferrer',
  giftCode: 'AURORA-7F2K-9QB',
  stats: [
    { v: 'US$ 1.680', l: en ? 'collected in advance, still unused' : 'cobrados por adelantado, todavía sin usar' },
    { v: en ? '9 of 14' : '9 de 14', l: en ? 'went to people who were not patients' : 'fueron para personas que no eran pacientes' },
    { v: 'US$ 120', l: en ? 'average gift card ticket' : 'ticket promedio de una gift card' },
    { v: '0', l: en ? 'calls to collect or chase a payment' : 'llamadas para cobrar o perseguir un pago' },
  ],
};

// Colores de pill por tipo: Anticipo=azul, Consulta=verde, Gift card=morado.
const tagStyle: Record<string, string> = {
  deposit: 'bg-[#eaf1fe] text-[#2f5bd6]',
  consult: 'bg-[#e7f6ec] text-[#1f9d55]',
  giftcard: 'bg-[#f2ecfb] text-[#8250c8]',
};

// Cada fila: tipo · nombre · canal · hora (hoy/ayer se traducen; fechas y
// montos idénticos en ambos idiomas).
type Tag = 'deposit' | 'consult' | 'giftcard';
const rows: { tag: Tag; name: string; channel: string; when: { es: string; en: string }; amount: string }[] = [
  { tag: 'deposit', name: 'Camila Ferrer', channel: 'WhatsApp', when: { es: 'hoy 23:43', en: 'today 23:43' }, amount: 'US$ 45' },
  { tag: 'consult', name: 'Martín Ocampo', channel: 'Instagram', when: { es: 'hoy 19:12', en: 'today 19:12' }, amount: 'US$ 45' },
  { tag: 'giftcard', name: 'Julieta Pérez', channel: 'Web', when: { es: 'hoy 17:40', en: 'today 17:40' }, amount: 'US$ 120' },
  { tag: 'deposit', name: 'Lucía Bentancur', channel: 'WhatsApp', when: { es: 'ayer 21:05', en: 'yesterday 21:05' }, amount: 'US$ 60' },
  { tag: 'deposit', name: 'Rocío Silveira', channel: 'Web', when: { es: 'ayer 18:22', en: 'yesterday 18:22' }, amount: 'US$ 45' },
  { tag: 'giftcard', name: 'Nicolás Gómez', channel: 'Instagram', when: { es: 'ayer 12:10', en: 'yesterday 12:10' }, amount: 'US$ 80' },
  { tag: 'deposit', name: 'Ana Cardoso', channel: 'WhatsApp', when: { es: '27/7 20:48', en: '27/7 20:48' }, amount: 'US$ 45' },
  { tag: 'consult', name: 'Diego Arrieta', channel: 'WhatsApp', when: { es: '27/7 09:31', en: '27/7 09:31' }, amount: 'US$ 45' },
  { tag: 'deposit', name: 'Paula Nogueira', channel: 'Instagram', when: { es: '26/7 22:14', en: '26/7 22:14' }, amount: 'US$ 60' },
  { tag: 'giftcard', name: 'Sofía Márquez', channel: 'WhatsApp', when: { es: '26/7 19:03', en: '26/7 19:03' }, amount: 'US$ 150' },
];
---

<figure
  class={`w-full min-w-0 max-w-5xl overflow-hidden rounded-2xl border border-line bg-[#f4f6f9] shadow-[0_18px_50px_-24px_rgba(20,38,31,0.4)] ${cls}`}
  aria-label={en ? 'Sara payments dashboard' : 'Panel de cobros de Sara'}
>
  <!-- Header de marca -->
  <div class="flex items-center gap-3 border-b border-line bg-white px-5 py-4 sm:px-6">
    <span class="grid h-9 w-9 shrink-0 place-content-center rounded-lg bg-[#2f5bd6] text-base font-black text-white">R</span>
    <span class="flex flex-wrap items-baseline gap-x-2 text-[15px]">
      <span class="font-bold text-ink">{t.brand}</span>
      <span class="text-salvia">· {t.section} · {t.month}</span>
    </span>
  </div>

  <div class="min-w-0 p-4 sm:p-5">
    <!-- KPI tiles -->
    <div class="grid grid-cols-2 gap-3 lg:grid-cols-4">
      {
        t.kpis.map((k) => (
          <div class="rounded-xl border border-line bg-white px-4 py-3.5">
            <p class="font-serif text-2xl font-black leading-tight text-ink tabular-nums">{k.v}</p>
            <p class="mt-1 text-[13px] text-salvia">{k.l}</p>
          </div>
        ))
      }
    </div>

    <!-- Cuerpo: lista de cobros + columna gift cards -->
    <div class="mt-3 grid min-w-0 gap-3 lg:grid-cols-[1.7fr_1fr]">
      <!-- Cobros recientes -->
      <section class="min-w-0 overflow-hidden rounded-xl border border-line bg-white">
        <div class="flex min-w-0 flex-wrap items-center justify-between gap-3 border-b border-line px-5 py-4">
          <h3 class="text-base font-bold text-ink">{t.recentTitle}</h3>
          <span class="text-right text-[13px] text-salvia">{t.recentNote}</span>
        </div>
        <ul>
          {
            rows.map((r, i) => (
              <li class={`flex min-w-0 items-center gap-2 px-4 py-3 sm:gap-3 sm:px-5 ${i > 0 ? 'border-t border-line/70' : ''}`}>
                <span class={`w-[4.6rem] shrink-0 rounded-full px-2 py-1 text-center text-xs font-semibold sm:w-[74px] sm:px-2.5 ${tagStyle[r.tag]}`}>
                  {t.tags[r.tag]}
                </span>
                <span class="min-w-0 flex-1">
                  <span class="block truncate text-[15px] font-bold text-ink">{r.name}</span>
                  <span class="block truncate text-[13px] text-salvia">
                    {r.channel} · {en ? r.when.en : r.when.es}
                  </span>
                </span>
                <span class="shrink-0 text-right">
                  <span class="block text-[15px] font-bold text-ink tabular-nums">{r.amount}</span>
                  <span class="block text-[13px] font-semibold text-[#1f9d55]">{t.paid}</span>
                </span>
              </li>
            ))
          }
        </ul>
      </section>

      <!-- Gift cards -->
      <section class="min-w-0 overflow-hidden rounded-xl border border-line bg-white p-5">
        <h3 class="mb-4 text-base font-bold text-ink">{t.giftTitle}</h3>

        <!-- Tarjeta de regalo (gradiente verde -> amarillo) -->
        <div
          class="rounded-2xl p-5 text-[#0f2a14] shadow-[0_10px_26px_-14px_rgba(90,140,20,0.6)]"
          style="background:linear-gradient(115deg,#6fd44a 0%,#a6d92f 42%,#e9c93a 100%)"
        >
          <p class="text-xs font-bold uppercase tracking-[0.12em] opacity-90">{t.giftClinic}</p>
          <p class="font-serif text-3xl font-black leading-none tabular-nums">US$ 120</p>
          <p class="mt-3 text-[15px]">{t.giftFor}</p>
          <p class="text-[15px]">{t.giftFrom}</p>
          <p
            class="mt-4 rounded-lg py-2.5 text-center text-[15px] font-bold tracking-wide"
            style="background:rgba(255,255,255,0.55)"
          >
            {t.giftCode}
          </p>
        </div>

        <!-- Stat cards -->
        <div class="mt-4 space-y-3">
          {
            t.stats.map((s) => (
              <div class="rounded-xl border border-line bg-[#fafbfc] px-4 py-3">
                <p class="font-serif text-xl font-black leading-tight text-ink tabular-nums">{s.v}</p>
                <p class="mt-1 text-[13px] text-salvia">{s.l}</p>
              </div>
            ))
          }
        </div>
      </section>
    </div>
  </div>
</figure>
