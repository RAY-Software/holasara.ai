---
// Mock del panel de operador de Sara (reemplaza /img/operador.jpg).
// HTML/CSS nitido y bilingue, fiel al original: barra superior "RAY Health",
// a la izquierda una tarjeta de agenda con 10 citas reprogramadas y chips
// azules, y a la derecha un chat de WhatsApp con Sara en modo operador que
// cierra con una tarjeta "Resumen de la gestion". Reusa el look de WhatsApp
// (fondo beige punteado, burbujas verdes a la derecha, blancas a la izquierda).
import { defaultLocale, type Locale } from '../../i18n/config';

interface Props {
  lang?: Locale;
  class?: string;
}
const { lang = defaultLocale, class: cls = '' } = Astro.props;

const en = lang === 'en';

const t = {
  brand: 'RAY Health',
  topMeta: en ? 'Schedule · Week of Jul 28' : 'Agenda · Semana del 28/7',
  dayTitle: en ? 'Tuesday Jul 29' : 'Martes 29/7',
  daySub: en ? '10 appointments · all rescheduled' : '10 citas · todas reprogramadas',
  online: en ? 'online' : 'en línea',
  compose: en ? 'Message' : 'Mensaje',
  summaryTitle: en ? 'MANAGEMENT SUMMARY' : 'RESUMEN DE LA GESTIÓN',
  summaryFoot: en ? 'Tuesday Jul 29 stays closed.' : 'El martes 29/7 queda cerrado.',
};

// Chip de reprogramacion: destino jueves 31/7 al mismo horario.
const chipTo = en ? 'Thu Jul 31' : 'jue 31/7';

// Tratamientos ES/EN.
const tx = {
  valoracion: en ? 'Assessment' : 'Valoración',
  acido: en ? 'Hyaluronic acid' : 'Ácido hialurónico',
  toxina: en ? 'Botulinum toxin' : 'Toxina botulínica',
  peeling: 'Peeling',
  meso: en ? 'Mesotherapy' : 'Mesoterapia',
  limpieza: en ? 'Facial cleansing' : 'Limpieza facial',
};

// 10 citas: hora, paciente, tratamiento. Nombres y horas se mantienen.
const rows = [
  { time: '09:00', name: 'Camila Ferrer', treat: tx.valoracion },
  { time: '09:45', name: 'Martín Ocampo', treat: tx.acido },
  { time: '10:30', name: 'Lucía Bentancur', treat: tx.toxina },
  { time: '11:15', name: 'Rocío Silveira', treat: tx.peeling },
  { time: '14:00', name: 'Diego Arrieta', treat: tx.meso },
  { time: '14:45', name: 'Paula Nogueira', treat: tx.limpieza },
  { time: '15:30', name: 'Ana Cardoso', treat: tx.valoracion },
  { time: '16:15', name: 'Julián Ferrari', treat: tx.acido },
];

// Burbujas del chat. who: 'out' = dueño (verde, der) · 'in' = Sara (blanco, izq).
const bubbles = en
  ? [
      { who: 'out', html: 'Reschedule everyone from Tuesday', t: '08:12' },
      { who: 'in', html: 'Done. I moved all 10 appointments to Thursday Jul 31 at the same times and messaged each patient on WhatsApp.', t: '08:12' },
      { who: 'in', html: 'Two asked for a different time, I already reassigned them. Should I block Tuesday?', t: '08:12' },
      { who: 'out', html: 'Yes, block it', t: '08:13' },
    ]
  : [
      { who: 'out', html: 'Reagenda a todos los del martes', t: '08:12' },
      { who: 'in', html: 'Listo. Moví las 10 citas al jueves 31/7 en el mismo horario y le avisé a cada paciente por WhatsApp.', t: '08:12' },
      { who: 'in', html: 'Dos pidieron otro horario, ya se los reasigné. ¿Bloqueo el martes?', t: '08:12' },
      { who: 'out', html: 'Sí, bloquéalo', t: '08:13' },
    ];

const summaryItems = en
  ? ['10 appointments rescheduled', '10 patients notified', '0 reception calls']
  : ['10 citas reprogramadas', '10 pacientes notificados', '0 llamadas de recepción'];

const tick =
  '<svg class="op-tick" viewBox="0 0 18 12" fill="none" aria-hidden="true"><path d="M1 6.6l3.1 3.1L10.4 2.6" stroke="#53bdeb" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M6.4 9.7L12.7 2.6" stroke="#53bdeb" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>';
---

<figure class={`op w-full min-w-0 max-w-5xl overflow-hidden rounded-2xl border border-line bg-white shadow-[0_20px_60px_-30px_rgba(20,38,31,0.45)] ${cls}`} aria-label={en ? 'Sara operator panel' : 'Panel de operador de Sara'}>
  <!-- Barra superior -->
  <div class="flex items-center gap-2.5 border-b border-line bg-white px-4 py-3 sm:px-5">
    <span class="grid h-8 w-8 shrink-0 place-content-center rounded-lg bg-[#2563eb] font-serif text-sm font-black text-white">R</span>
    <span class="font-semibold text-ink">{t.brand}</span>
    <span class="truncate text-sm text-salvia">· {t.topMeta}</span>
  </div>

  <!-- Cuerpo: 2 columnas -->
  <div class="grid min-w-0 gap-4 bg-paper p-4 sm:p-5 lg:grid-cols-2">
    <!-- ── Izquierda: agenda del dia ── -->
    <div class="min-w-0 rounded-2xl border border-line bg-white p-4 shadow-[0_10px_30px_-24px_rgba(20,38,31,0.4)] sm:p-5">
      <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1 pb-3">
        <h3 class="font-serif text-lg font-black text-ink">{t.dayTitle}</h3>
        <span class="text-sm text-salvia">{t.daySub}</span>
      </div>
      <ul>
        {
          rows.map((r, i) => (
            <li class={`flex flex-wrap items-center gap-x-3 gap-y-1.5 py-3 ${i > 0 ? 'border-t border-line/70' : ''}`}>
              <span class="w-12 shrink-0 font-semibold tabular-nums text-ink">{r.time}</span>
              <span class="min-w-0 flex-1">
                <span class="block truncate font-semibold text-ink">{r.name}</span>
                <span class="block truncate text-sm text-salvia">{r.treat}</span>
              </span>
              <span class="max-w-full basis-full whitespace-nowrap rounded-full bg-[#eaf1fe] px-3 py-1 text-xs font-semibold tabular-nums text-[#2563eb] sm:ml-auto sm:basis-auto">
                → {chipTo} · {r.time}
              </span>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- ── Derecha: chat de WhatsApp (modo operador) ── -->
    <div class="op-wa flex min-w-0 flex-col overflow-hidden rounded-2xl border border-line">
      <!-- Header -->
      <div class="op-head">
        <span class="op-photo" aria-hidden="true">S</span>
        <span class="op-id">
          <span class="op-name">Sara</span>
          <span class="op-online">{t.online}</span>
        </span>
        <span class="op-icons">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17 10.5V7a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h12a1 1 0 001-1v-3.5l4 4v-11l-4 4z"/></svg>
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15 15 0 006.6 6.6l2.2-2.2a1 1 0 011-.24 11 11 0 003.5.56 1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.2.2 2.4.56 3.5a1 1 0 01-.24 1l-2.2 2.3z"/></svg>
        </span>
      </div>

      <!-- Body -->
      <div class="op-body">
        {
          bubbles.map((b) => (
            <div class={`op-msg ${b.who === 'out' ? 'op-out' : 'op-in'}`}>
              <span class="op-txt">{b.html}</span>
              <span class="op-meta">
                {b.t}
                {b.who === 'out' && <span set:html={tick} />}
              </span>
            </div>
          ))
        }

        <!-- Tarjeta resumen -->
        <div class="op-msg op-in op-summary">
          <span class="op-sum-title">{t.summaryTitle}</span>
          <ul class="op-sum-list">
            {summaryItems.map((it) => (
              <li><span class="op-check" aria-hidden="true">✓</span>{it}</li>
            ))}
          </ul>
          <span class="op-sum-foot">{t.summaryFoot}</span>
          <span class="op-meta">
            08:13
            <span set:html={tick} />
          </span>
        </div>
      </div>

      <!-- Compose -->
      <div class="op-compose">
        <svg class="op-plus" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        <span class="op-field">{t.compose}</span>
        <svg class="op-cam" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 8h3l2-2h6l2 2h3v11H4z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><circle cx="12" cy="13" r="3" stroke="currentColor" stroke-width="1.6"/></svg>
        <svg class="op-mic" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 15a3 3 0 003-3V6a3 3 0 00-6 0v6a3 3 0 003 3zM6 12a6 6 0 0012 0M12 18v3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
    </div>
  </div>
</figure>

<style>
  .op {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  }

  /* Chat WhatsApp */
  .op-wa {
    background: #ece5dd;
    color: #111b21;
    min-height: 100%;
  }
  .op-head {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.55rem 0.9rem;
    background: #f7f4ef;
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  }
  .op-photo {
    display: grid;
    place-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: linear-gradient(135deg, #7c9885, #4f6b57);
    color: #fff;
    font-weight: 700;
    font-size: 1.05rem;
    flex: none;
  }
  .op-id { display: flex; flex-direction: column; line-height: 1.2; margin-right: auto; min-width: 0; }
  .op-name { font-weight: 700; font-size: 1.02rem; }
  .op-online { font-size: 0.78rem; color: #667781; }
  .op-icons { display: flex; gap: 1.1rem; color: #1c88ff; }
  .op-icons svg { width: 22px; height: 22px; }

  .op-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0.9rem 0.8rem 1.1rem;
    background-color: #ece5dd;
    background-image: radial-gradient(rgba(11, 20, 26, 0.045) 1px, transparent 1px);
    background-size: 16px 16px;
  }
  .op-msg {
    max-width: 82%;
    padding: 0.45rem 0.6rem 0.34rem;
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    font-size: 0.92rem;
    line-height: 1.4;
    box-shadow: 0 1px 0.5px rgba(11, 20, 26, 0.13);
    word-break: break-word;
  }
  .op-in { align-self: flex-start; background: #fff; border-top-left-radius: 2px; }
  .op-out { align-self: flex-end; background: #d9fdd3; border-top-right-radius: 2px; }
  .op-meta {
    align-self: flex-end;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin-top: 0.1rem;
    font-size: 0.66rem;
    color: #667781;
  }
  .op-meta :global(.op-tick) { width: 16px; height: 11px; }

  .op-summary { max-width: 90%; gap: 0.35rem; padding: 0.6rem 0.7rem 0.4rem; }
  .op-sum-title {
    font-weight: 800;
    font-size: 0.74rem;
    letter-spacing: 0.06em;
    color: #0a7a35;
  }
  .op-sum-list { display: flex; flex-direction: column; gap: 0.22rem; }
  .op-sum-list li { display: flex; align-items: center; gap: 0.4rem; font-size: 0.9rem; }
  .op-check {
    display: grid;
    place-content: center;
    width: 17px;
    height: 17px;
    border-radius: 4px;
    background: #25d366;
    color: #fff;
    font-size: 0.7rem;
    font-weight: 800;
    flex: none;
  }
  .op-sum-foot { font-size: 0.9rem; color: #111b21; }

  .op-compose {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.6rem 0.8rem;
    background: #f7f4ef;
    color: #8696a0;
  }
  .op-plus { width: 22px; height: 22px; flex: none; }
  .op-field {
    flex: 1;
    background: #fff;
    border-radius: 999px;
    padding: 0.55rem 0.9rem;
    font-size: 0.9rem;
    color: #8696a0;
  }
  .op-cam, .op-mic { width: 22px; height: 22px; flex: none; }
</style>
