---
// Mock de un teléfono con una conversación en ChatGPT (interfaz reconocible + logo
// oficial de OpenAI en la cabecera y como avatar de la respuesta). Uso nominativo:
// muestra cómo aparece la clínica cuando un paciente pregunta en ChatGPT, igual que
// el sitio ya muestra los logos de WhatsApp, Instagram y Google. Equivalente de
// ConversationDemo para la página de AEO.
interface Props {
  title: string;
  q: string;
  a: string;
  sourcesLabel: string;
  sources: string[];
  compose: string;
  disclaimer: string;
  class?: string;
}
const { title, q, a, sourcesLabel, sources, compose, disclaimer, class: cls = '' } = Astro.props;
// Logo oficial de OpenAI (marca de OpenAI; se usa de forma nominativa).
const openaiPath =
  'M22.2819 9.8211a5.9847 5.9847 0 0 0-.5157-4.9108 6.0462 6.0462 0 0 0-6.5098-2.9A6.0651 6.0651 0 0 0 4.9807 4.1818a5.9847 5.9847 0 0 0-3.9977 2.9 6.0462 6.0462 0 0 0 .7427 7.0966 5.98 5.98 0 0 0 .511 4.9107 6.051 6.051 0 0 0 6.5146 2.9001A5.9847 5.9847 0 0 0 13.2599 24a6.0557 6.0557 0 0 0 5.7718-4.2058 5.9894 5.9894 0 0 0 3.9977-2.9001 6.0557 6.0557 0 0 0-.7476-7.0729zm-9.022 12.6081a4.4755 4.4755 0 0 1-2.8764-1.0408l.1419-.0804 4.7783-2.7582a.7948.7948 0 0 0 .3927-.6813v-6.7369l2.02 1.1686a.071.071 0 0 1 .038.052v5.5826a4.504 4.504 0 0 1-4.4945 4.4944zm-9.6607-4.1254a4.4708 4.4708 0 0 1-.5346-3.0137l.142.0852 4.783 2.7582a.7712.7712 0 0 0 .7806 0l5.8428-3.3685v2.3324a.0804.0804 0 0 1-.0332.0615L9.74 19.9502a4.4992 4.4992 0 0 1-6.1408-1.6464zM2.3408 7.8956a4.485 4.485 0 0 1 2.3655-1.9728V11.6a.7664.7664 0 0 0 .3879.6765l5.8144 3.3543-2.0201 1.1685a.0757.0757 0 0 1-.071 0l-4.8303-2.7865A4.504 4.504 0 0 1 2.3408 7.872zm16.5963 3.8558L13.1038 8.364 15.1192 7.2a.0757.0757 0 0 1 .071 0l4.8303 2.7913a4.4944 4.4944 0 0 1-.6765 8.1042v-5.6772a.79.79 0 0 0-.407-.667zm2.0107-3.0231l-.142-.0852-4.7735-2.7818a.7759.7759 0 0 0-.7854 0L9.409 9.2297V6.8974a.0662.0662 0 0 1 .0284-.0615l4.8303-2.7866a4.4992 4.4992 0 0 1 6.6802 4.66zM8.3065 12.863l-2.02-1.1638a.0804.0804 0 0 1-.038-.0567V6.0742a4.4992 4.4992 0 0 1 7.3757-3.4537l-.142.0805L8.704 5.459a.7948.7948 0 0 0-.3927.6813zm1.0976-2.3654l2.602-1.4998 2.6069 1.4998v2.9994l-2.5974 1.4997-2.6067-1.4997z';
---

<figure class={`w-full max-w-[21rem] rounded-[2.4rem] bg-[#0d0d0d] p-2.5 shadow-[0_24px_60px_-28px_rgba(20,38,31,0.55)] ${cls}`}>
  <div class="overflow-hidden rounded-[1.9rem] bg-white text-[#0d0d0d]" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
    <!-- status bar -->
    <div class="flex items-center justify-between px-6 pb-1 pt-3 text-[11px] font-semibold">
      <span>9:41</span>
      <span class="flex items-center gap-1" aria-hidden="true">
        <span class="inline-block h-2 w-2 rounded-full bg-black/70"></span>
        <span class="inline-block h-2 w-2 rounded-full bg-black/70"></span>
        <span class="inline-block h-2.5 w-5 rounded-sm border border-black/60"></span>
      </span>
    </div>
    <!-- cabecera ChatGPT (logo oficial de OpenAI) -->
    <div class="flex items-center gap-2.5 px-4 py-2">
      <svg viewBox="0 0 24 24" fill="currentColor" class="h-6 w-6 text-[#0d0d0d]" role="img" aria-label="ChatGPT"><path d={openaiPath} /></svg>
      <span class="flex items-center gap-1 text-[15px] font-semibold">
        {title}
        <svg viewBox="0 0 24 24" fill="none" class="h-4 w-4 text-[#8e8ea0]" aria-hidden="true"><path d="M8 10l4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </span>
      <svg viewBox="0 0 24 24" fill="none" class="ml-auto h-5 w-5 text-[#0d0d0d]" aria-hidden="true"><path d="M4 20h4l10.5-10.5a2.1 2.1 0 0 0-3-3L5 17v3z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" /></svg>
    </div>
    <!-- conversación -->
    <div class="flex flex-col gap-5 px-4 pb-3 pt-4">
      <p class="ml-auto max-w-[82%] rounded-[1.25rem] bg-[#f4f4f4] px-4 py-2.5 text-[14px] leading-snug">{q}</p>
      <div class="flex gap-2.5">
        <span class="mt-0.5 grid h-7 w-7 shrink-0 place-items-center rounded-full border border-[#e5e5e5]" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4 text-[#0d0d0d]"><path d={openaiPath} /></svg>
        </span>
        <div class="min-w-0">
          <p class="text-[14px] leading-relaxed">{a}</p>
          <div class="mt-3 flex flex-wrap items-center gap-x-2 gap-y-1">
            <span class="text-[11px] font-semibold uppercase tracking-wide text-[#8e8ea0]">{sourcesLabel}</span>
            {sources.map((src) => <span class="inline-flex items-center gap-1.5 rounded-full border border-[#e5e5e5] px-2 py-0.5 text-[11px] text-[#0d0d0d]"><span class="h-1.5 w-1.5 rounded-full bg-[#1f7a5c]" />{src}</span>)}
          </div>
          <div class="mt-3 flex gap-3 text-[#8e8ea0]" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" class="h-4 w-4"><rect x="8" y="8" width="11" height="11" rx="2" stroke="currentColor" stroke-width="1.7" /><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2" stroke="currentColor" stroke-width="1.7" /></svg>
            <svg viewBox="0 0 24 24" fill="none" class="h-4 w-4"><path d="M7 11v9H4v-9h3zm3 9h7.5a2 2 0 0 0 2-1.6l1.2-6A2 2 0 0 0 18.7 10H14l.8-3.7A1.5 1.5 0 0 0 12.2 5L10 11v9z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" /></svg>
            <svg viewBox="0 0 24 24" fill="none" class="h-4 w-4"><path d="M17 13V4h3v9h-3zm-3-9H6.5a2 2 0 0 0-2 1.6l-1.2 6A2 2 0 0 0 5.3 14H10l-.8 3.7A1.5 1.5 0 0 0 11.8 19L14 13V4z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" /></svg>
            <svg viewBox="0 0 24 24" fill="none" class="h-4 w-4"><path d="M4 12a8 8 0 0 1 14-5.3M20 12a8 8 0 0 1-14 5.3M18 3v4h-4M6 21v-4h4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" /></svg>
          </div>
        </div>
      </div>
    </div>
    <!-- barra de escritura -->
    <div class="px-3 pb-1 pt-2">
      <div class="flex items-center gap-2 rounded-full border border-[#e5e5e5] bg-white px-2 py-1.5 shadow-[0_2px_8px_rgba(0,0,0,0.05)]">
        <span class="grid h-8 w-8 place-items-center rounded-full text-[#0d0d0d]" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" class="h-5 w-5"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg></span>
        <span class="flex-1 text-[13px] text-[#8e8ea0]">{compose}</span>
        <svg viewBox="0 0 24 24" fill="none" class="h-5 w-5 text-[#0d0d0d]" aria-hidden="true"><rect x="9" y="3" width="6" height="11" rx="3" stroke="currentColor" stroke-width="1.7" /><path d="M5 11a7 7 0 0 0 14 0M12 18v3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" /></svg>
        <span class="grid h-8 w-8 place-items-center rounded-full bg-[#0d0d0d] text-white" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" class="h-4 w-4"><path d="M12 20V5M6 11l6-6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
      </div>
      <p class="mt-1.5 text-center text-[10px] text-[#8e8ea0]">{disclaimer}</p>
    </div>
    <div class="mx-auto mb-2 h-1 w-24 rounded-full bg-black/25" aria-hidden="true"></div>
  </div>
</figure>
