---
// Mock de una llamada telefónica real atendida por Sara, con transcripción en vivo.
// Es el equivalente en VOZ del ConversationDemo (chat): mismo rol de perspectiva,
// pero encuadrado como pantalla de llamada + transcripción.
//   who: 'out' = Sara (habla la IA) · 'in' = quien llama (paciente)
//
// Uso:
//   <CallDemo lang={lang} name="Sara" status="En llamada"
//     turns={[{ who:'out', text:'…' }, { who:'in', text:'…' }]} />

interface Turn {
  who: 'in' | 'out';
  text: string;
}
import { defaultLocale, type Locale } from '../../i18n/config';
interface Props {
  name?: string;
  avatar?: string;
  timer?: string;
  turns: Turn[];
  lang?: Locale;
}
const {
  name = 'Sara',
  avatar = '/agents/sara-thumb.png',
  timer = '00:47',
  turns,
  lang = defaultLocale,
} = Astro.props;
const ui =
  lang === 'en'
    ? { status: 'On call', live: 'Live transcript', caller: 'Caller', mute: 'Mute', keypad: 'Keypad', speaker: 'Speaker' }
    : { status: 'En llamada', live: 'Transcripción en vivo', caller: 'Quien llama', mute: 'Silenciar', keypad: 'Teclado', speaker: 'Altavoz' };
---

<figure class="call">
  <!-- Pantalla de llamada -->
  <div class="call__screen">
    <div class="call__top">
      <span class="call__rec"><span class="call__recdot" aria-hidden="true"></span>{ui.status}</span>
      <span class="call__timer tabular-nums">{timer}</span>
    </div>

    <div class="call__id">
      <span class="call__avatar">
        <img src={avatar} alt={name} width="72" height="72" loading="lazy" decoding="async" />
      </span>
      <span class="call__name">{name}</span>
      <span class="call__wave" aria-hidden="true">
        <i></i><i></i><i></i><i></i><i></i><i></i><i></i>
      </span>
    </div>

    <div class="call__actions" aria-hidden="true">
      <span class="call__btn"><svg viewBox="0 0 24 24" fill="none"><path d="M4 4l16 16M11 5.1A7 7 0 0119 12M8 8a11 11 0 003.5 3.5M9.5 4.2A4 4 0 0113 4c1.2 0 2.4.2 3.5.56a1 1 0 011 1V9a1 1 0 01-1 1" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg><em>{ui.mute}</em></span>
      <span class="call__btn"><svg viewBox="0 0 24 24" fill="none"><circle cx="6" cy="6" r="1.4" fill="currentColor"/><circle cx="12" cy="6" r="1.4" fill="currentColor"/><circle cx="18" cy="6" r="1.4" fill="currentColor"/><circle cx="6" cy="12" r="1.4" fill="currentColor"/><circle cx="12" cy="12" r="1.4" fill="currentColor"/><circle cx="18" cy="12" r="1.4" fill="currentColor"/><circle cx="6" cy="18" r="1.4" fill="currentColor"/><circle cx="12" cy="18" r="1.4" fill="currentColor"/><circle cx="18" cy="18" r="1.4" fill="currentColor"/></svg><em>{ui.keypad}</em></span>
      <span class="call__btn"><svg viewBox="0 0 24 24" fill="none"><path d="M4 9v6h4l5 4V5L8 9H4z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M16.5 8.5a5 5 0 010 7M19 6a8 8 0 010 12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg><em>{ui.speaker}</em></span>
    </div>
  </div>

  <!-- Transcripción en vivo -->
  <div class="call__transcript">
    <div class="call__tlabel"><span class="call__tdot" aria-hidden="true"></span>{ui.live}</div>
    {
      turns.map((turn) => (
        <div class={`turn ${turn.who === 'out' ? 'turn--sara' : 'turn--caller'}`}>
          <span class="turn__who">{turn.who === 'out' ? name : ui.caller}</span>
          <p class="turn__text">{turn.text}</p>
        </div>
      ))
    }
  </div>
</figure>

<style>
  .call {
    width: 100%;
    max-width: 22rem;
    border-radius: 22px;
    overflow: hidden;
    border: 1px solid var(--color-line, #e4e8e4);
    background: #fff;
    box-shadow: 0 16px 40px -22px rgba(20, 38, 31, 0.4);
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  }

  /* ── Pantalla de llamada (oscura) ─────────────── */
  .call__screen {
    background: radial-gradient(120% 120% at 50% 0%, #1c3a2d 0%, #0f1f18 60%, #0b1712 100%);
    color: #eaf2ed;
    padding: 1.05rem 1.1rem 1.2rem;
  }
  .call__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.72rem;
  }
  .call__rec {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    letter-spacing: 0.02em;
    color: #cfe6da;
  }
  .call__recdot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #3fe08a;
    box-shadow: 0 0 0 0 rgba(63, 224, 138, 0.6);
    animation: callpulse 1.8s infinite;
  }
  @keyframes callpulse {
    0% { box-shadow: 0 0 0 0 rgba(63, 224, 138, 0.55); }
    70% { box-shadow: 0 0 0 0.55em rgba(63, 224, 138, 0); }
    100% { box-shadow: 0 0 0 0 rgba(63, 224, 138, 0); }
  }
  .call__timer {
    color: #9fb8ab;
    font-size: 0.72rem;
  }

  .call__id {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.55rem;
    padding: 1.35rem 0 1.15rem;
  }
  .call__avatar {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    overflow: hidden;
    display: block;
    line-height: 0;
    border: 2px solid rgba(63, 224, 138, 0.5);
    box-shadow: 0 0 0 6px rgba(63, 224, 138, 0.1);
  }
  .call__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .call__name {
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: 0.01em;
  }
  .call__wave {
    display: inline-flex;
    align-items: flex-end;
    gap: 3px;
    height: 16px;
  }
  .call__wave i {
    width: 3px;
    border-radius: 3px;
    background: #3fe08a;
    opacity: 0.85;
    animation: wave 1.1s ease-in-out infinite;
  }
  .call__wave i:nth-child(1) { height: 40%; animation-delay: 0s; }
  .call__wave i:nth-child(2) { height: 75%; animation-delay: 0.12s; }
  .call__wave i:nth-child(3) { height: 100%; animation-delay: 0.24s; }
  .call__wave i:nth-child(4) { height: 55%; animation-delay: 0.36s; }
  .call__wave i:nth-child(5) { height: 90%; animation-delay: 0.48s; }
  .call__wave i:nth-child(6) { height: 45%; animation-delay: 0.6s; }
  .call__wave i:nth-child(7) { height: 70%; animation-delay: 0.72s; }
  @keyframes wave {
    0%, 100% { transform: scaleY(0.5); }
    50% { transform: scaleY(1); }
  }

  .call__actions {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.9rem;
    max-width: 15rem;
    margin: 0 auto;
  }
  .call__btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    color: #cfe6da;
    font-size: 0.62rem;
  }
  .call__btn svg {
    width: 46px;
    height: 46px;
    padding: 0.7rem;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    color: #eaf2ed;
  }

  /* ── Transcripción ───────────────────────────── */
  .call__transcript {
    background: #fff;
    padding: 0.95rem 0.95rem 1.05rem;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }
  .call__tlabel {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.68rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-salvia, #5e6b62);
  }
  .call__tdot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #3fe08a;
  }
  .turn {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .turn__who {
    font-size: 0.66rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .turn__text {
    font-size: 0.86rem;
    line-height: 1.4;
    color: #14261f;
    border-radius: 12px;
    padding: 0.5rem 0.65rem;
  }
  .turn--sara .turn__who { color: var(--color-pine-dark, #1a6349); }
  .turn--sara .turn__text {
    background: rgba(63, 224, 138, 0.12);
    border: 1px solid rgba(31, 122, 92, 0.18);
  }
  .turn--caller .turn__who { color: var(--color-salvia, #5e6b62); }
  .turn--caller .turn__text {
    background: #f2f4f2;
    border: 1px solid var(--color-line, #e4e8e4);
  }

  @media (prefers-reduced-motion: reduce) {
    .call__recdot, .call__wave i { animation: none; }
  }
</style>
