---
// Mock del buscador de dominios de Sara (reemplaza /img/domain-comprar.jpg).
// Ventana estilo macOS: "Consigue tu dominio", input con "pielstudio" + botón
// Buscar, y 3 resultados (primero destacado en verde con "incluye configuración").
// Bilingüe ES/EN; dominios, precios y "primer año" fieles al mockup (PielStudio).
import { defaultLocale, type Locale } from '../../i18n/config';

interface Props {
  lang?: Locale;
  class?: string;
}
const { lang = defaultLocale, class: cls = '' } = Astro.props;
const en = lang === 'en';

const t = {
  win: en ? 'PielStudio · Website · Domain' : 'PielStudio · Sitio web · Dominio',
  title: en ? 'Get your domain' : 'Consigue tu dominio',
  sub: en
    ? 'Search for any name you want. The price is for the first year and includes setup: your site is left up and running on its own.'
    : 'Busca el nombre que quieras. El precio es por el primer año e incluye la configuración: tu sitio queda funcionando solo.',
  query: 'pielstudio',
  search: en ? 'Search' : 'Buscar',
  year: en ? 'first year' : 'primer año',
  choose: en ? 'Choose' : 'Elegir',
  availPlus: en ? 'Available · setup included' : 'Disponible · incluye configuración',
  avail: en ? 'Available' : 'Disponible',
  footer: en
    ? 'We take care of the setup. If you already have a domain, you connect it under “I already have a domain”.'
    : 'La configuración la dejamos lista nosotros. Si ya tienes un dominio, lo conectas en «Ya tengo dominio».',
};

const rows = [
  { domain: 'pielstudio.com', price: '$290', featured: true },
  { domain: 'pielstudio.mx', price: '$390', featured: false },
  { domain: 'pielstudio.clinic', price: '$640', featured: false },
];
---

<figure
  class={`w-full max-w-3xl overflow-hidden rounded-2xl border border-line bg-white shadow-[0_18px_50px_-24px_rgba(20,38,31,0.4)] ${cls}`}
  aria-label={en ? 'Sara domain search' : 'Buscador de dominios de Sara'}
>
  <!-- Chrome estilo macOS -->
  <div class="flex items-center gap-3 border-b border-line bg-[#f7f8fa] px-4 py-3">
    <span class="flex gap-2" aria-hidden="true">
      <span class="h-3 w-3 rounded-full bg-[#ff5f57]"></span>
      <span class="h-3 w-3 rounded-full bg-[#febc2e]"></span>
      <span class="h-3 w-3 rounded-full bg-[#28c840]"></span>
    </span>
    <span class="text-sm font-semibold text-salvia">{t.win}</span>
  </div>

  <div class="p-4 sm:p-6">
    <h3 class="text-xl font-bold text-ink">{t.title}</h3>
    <p class="mt-1.5 max-w-2xl text-sm text-salvia">{t.sub}</p>

    <!-- Buscador -->
    <div class="mt-5 flex flex-col gap-3 sm:flex-row">
      <div class="flex-1 rounded-xl border border-line px-4 py-3 text-[15px] text-ink">{t.query}</div>
      <span class="inline-flex shrink-0 items-center justify-center gap-2 rounded-xl bg-[#3b6ef2] px-6 py-3 text-[15px] font-bold text-white">
        <span aria-hidden="true">🔍</span>{t.search}
      </span>
    </div>

    <!-- Resultados -->
    <div class="mt-4 space-y-3">
      {
        rows.map((r) => (
          <div
            class={`flex flex-wrap items-center gap-3 rounded-xl border px-4 py-4 ${
              r.featured ? 'border-[#bfe3c9] bg-[#f2faf4]' : 'border-line bg-white'
            }`}
          >
            <div class="min-w-0 flex-1">
              <p class="text-[17px] font-bold text-ink">{r.domain}</p>
              <p class="mt-0.5 text-sm font-semibold text-[#1f9d55]">
                ✓ {r.featured ? t.availPlus : t.avail}
              </p>
            </div>
            <div class="shrink-0 text-right">
              <p class="text-lg font-bold text-ink tabular-nums">{r.price}</p>
              <p class="text-xs text-salvia">{t.year}</p>
            </div>
            <span
              class={`shrink-0 whitespace-nowrap rounded-lg px-5 py-2.5 text-sm font-bold ${
                r.featured ? 'bg-[#3b6ef2] text-white' : 'border border-[#3b6ef2] text-[#3b6ef2]'
              }`}
            >
              {t.choose}
            </span>
          </div>
        ))
      }
    </div>

    <p class="mt-5 text-sm text-salvia">{t.footer}</p>
  </div>
</figure>
