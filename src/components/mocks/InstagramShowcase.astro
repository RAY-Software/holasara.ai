---
// Mock del showcase de Instagram de Mia (reemplaza /img/instagram.jpg).
// HTML/CSS nítido y bilingüe, fiel al composite original: a la izquierda un
// teléfono con el PERFIL de Instagram de Clínica Aurora (status bar, avatar con
// anillo, stats, bio, highlights, tabs y grid 3col con mix de fotos y tiles de
// color con texto); a la derecha una columna de cards (pill de título, 4 pasos
// numerados y card azul de "24 citas").
import { defaultLocale, type Locale } from '../../i18n/config';

interface Props {
  lang?: Locale;
  class?: string;
}
const { lang = defaultLocale, class: cls = '' } = Astro.props;

const en = lang === 'en';
const t = {
  handle: 'clinicaaurora',
  posts: en ? 'posts' : 'publicaciones',
  followers: en ? 'followers' : 'seguidores',
  following: en ? 'following' : 'seguidos',
  name: en ? 'Clínica Aurora · Aesthetic medicine' : 'Clínica Aurora · Medicina estética',
  bio: en
    ? 'Assessment with Dr. Ruiz. Natural results, nothing overdone.'
    : 'Valoración con la Dra. Ruiz. Resultados naturales, sin excesos.',
  link: 'clinicaaurora.com/agenda',
  highlights: en
    ? ['Treatments', 'Team', 'FAQ', 'Assessment']
    : ['Tratamientos', 'Equipo', 'Preguntas', 'Valoración'],
  pill: en ? 'Your feed, on autopilot' : 'Tu feed, en piloto automático',
  steps: en
    ? [
        { n: '1', title: 'Learns from your feed', sub: 'tone, topics and your photos', icon: 'ig' },
        { n: '2', title: 'Writes and designs', sub: 'copy, hashtags and image', icon: 'ray' },
        { n: '3', title: 'You approve', sub: 'nothing goes out without your OK', icon: 'check' },
        { n: '4', title: 'Posts and replies', sub: 'whoever comments, talks to Sara', icon: 'chat' },
      ]
    : [
        { n: '1', title: 'Aprende de tu feed', sub: 'tono, temas y tus fotos', icon: 'ig' },
        { n: '2', title: 'Escribe y diseña', sub: 'texto, hashtags e imagen', icon: 'ray' },
        { n: '3', title: 'Tú apruebas', sub: 'nada sale sin tu visto bueno', icon: 'check' },
        { n: '4', title: 'Publica y responde', sub: 'quien comenta, habla con Sara', icon: 'chat' },
      ],
  citasNum: en ? '24 appointments' : '24 citas',
  citasSub: en
    ? 'attributed to your posts · last 90 days'
    : 'atribuidas a tus publicaciones · últimos 90 días',
};

// Grid del feed (12 tiles, 3 columnas). type: 'photo' usa una img de tenant;
// tiles de color reproducen el texto del mockup (kicker + título bilingües).
type Tile =
  | { type: 'photo'; src: string }
  | { type: 'color'; bg: 'blue' | 'green' | 'yellow' | 'white'; kicker: { es: string; en: string }; title: { es: string; en: string } };

const tiles: Tile[] = [
  { type: 'photo', src: '/img/tenants/faceup.jpg' },
  {
    type: 'color',
    bg: 'blue',
    kicker: { es: '¿SABÍAS QUE?', en: 'DID YOU KNOW?' },
    title: { es: 'La toxina no congela la cara', en: 'Botox doesn’t freeze your face' },
  },
  { type: 'photo', src: '/img/tenants/drreyes.jpg' },
  {
    type: 'color',
    bg: 'green',
    kicker: { es: 'MITO vs REALIDAD', en: 'MYTH vs REALITY' },
    title: { es: '“Se nota enseguida”', en: '“It shows right away”' },
  },
  { type: 'photo', src: '/img/tenants/sorace.jpg' },
  {
    type: 'color',
    bg: 'white',
    kicker: { es: 'ÁCIDO HIALURÓNICO', en: 'HYALURONIC ACID' },
    title: { es: 'Qué esperar la 1ª semana', en: 'What to expect in week 1' },
  },
  {
    type: 'color',
    bg: 'yellow',
    kicker: { es: '5 PREGUNTAS', en: '5 QUESTIONS' },
    title: { es: 'Antes de tu primera valoración', en: 'Before your first assessment' },
  },
  { type: 'photo', src: '/img/tenants/physiup.jpg' },
  {
    type: 'color',
    bg: 'blue',
    kicker: { es: 'AGOSTO', en: 'AUGUST' },
    title: { es: 'Valoración con la Dra. Ruiz', en: 'Assessment with Dr. Ruiz' },
  },
  {
    type: 'color',
    bg: 'white',
    kicker: { es: 'PASO A PASO', en: 'STEP BY STEP' },
    title: { es: 'Cómo es una consulta', en: 'What a consult is like' },
  },
  {
    type: 'color',
    bg: 'blue',
    kicker: { es: '¿CUÁNTO DURA?', en: 'HOW LONG?' },
    title: { es: 'El ácido mes a mes', en: 'Filler month by month' },
  },
  {
    type: 'color',
    bg: 'green',
    kicker: { es: 'CUIDADOS', en: 'AFTERCARE' },
    title: { es: 'Después del peeling', en: 'After a peel' },
  },
];
---

<figure
  class={`ig grid min-w-0 gap-5 md:grid-cols-2 md:items-start ${cls}`}
  aria-label={en ? 'Instagram profile managed by Mia' : 'Perfil de Instagram gestionado por Mia'}
>
  <!-- ============ IZQUIERDA: teléfono con perfil de Instagram ============ -->
  <div class="ig-phone mx-auto w-full max-w-[22rem] overflow-hidden rounded-[30px] border border-line bg-white text-ink shadow-[0_24px_60px_-30px_rgba(20,38,31,0.45)]">
    <!-- Status bar -->
    <div class="flex items-center justify-between px-5 pb-1 pt-3">
      <span class="text-sm font-bold text-ink">9:41</span>
      <span class="text-ink">
        <svg viewBox="0 0 26 13" fill="none" aria-hidden="true" class="h-3 w-6">
          <rect x="0.5" y="0.5" width="22" height="12" rx="3" stroke="currentColor"></rect>
          <rect x="2" y="2" width="17" height="9" rx="1.5" fill="currentColor"></rect>
          <rect x="23.5" y="4" width="2" height="5" rx="1" fill="currentColor"></rect>
        </svg>
      </span>
    </div>

    <!-- Handle -->
    <div class="flex items-center justify-between px-5 pb-3 pt-1">
      <span class="text-lg font-black tracking-tight text-ink">{t.handle}</span>
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" class="h-6 w-6 text-ink">
        <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
      </svg>
    </div>

    <!-- Avatar + stats -->
    <div class="flex items-center gap-4 px-5">
      <span class="ig-ring shrink-0">
        <img
          src="/img/tenants/drreyes.jpg"
          alt=""
          width="72"
          height="72"
          class="h-[68px] w-[68px] rounded-full border-2 border-white object-cover"
          loading="lazy"
          decoding="async"
        />
      </span>
      <div class="flex flex-1 justify-around text-center">
        <span class="block">
          <span class="block text-lg font-black leading-none text-ink tabular-nums">128</span>
          <span class="mt-1 block text-[13px] text-salvia">{t.posts}</span>
        </span>
        <span class="block">
          <span class="block text-lg font-black leading-none text-ink tabular-nums">4.812</span>
          <span class="mt-1 block text-[13px] text-salvia">{t.followers}</span>
        </span>
        <span class="block">
          <span class="block text-lg font-black leading-none text-ink tabular-nums">212</span>
          <span class="mt-1 block text-[13px] text-salvia">{t.following}</span>
        </span>
      </div>
    </div>

    <!-- Nombre, bio, link -->
    <div class="px-5 pt-3">
      <p class="text-[15px] font-bold text-ink">{t.name}</p>
      <p class="mt-0.5 text-[14px] leading-snug text-ink/80">{t.bio}</p>
      <p class="mt-0.5 text-[14px] font-semibold text-[#2f6fe0]">{t.link}</p>
    </div>

    <!-- Highlights -->
    <div class="flex justify-between gap-2 px-5 pb-3 pt-4">
      {
        t.highlights.map((h, i) => (
          <span class="flex w-[56px] shrink-0 flex-col items-center gap-1.5">
            <span class="grid h-[56px] w-[56px] place-content-center overflow-hidden rounded-full border border-line bg-cream">
              {i === 0 && (
                <svg viewBox="0 0 24 24" fill="none" class="h-6 w-6 text-salvia" aria-hidden="true">
                  <rect x="4" y="4" width="16" height="16" rx="3" stroke="currentColor" stroke-width="1.6" />
                  <path d="M4 15l4-4 3 3 4-5 5 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              )}
              {i === 1 && (
                <svg viewBox="0 0 24 24" fill="none" class="h-6 w-6 text-salvia" aria-hidden="true">
                  <circle cx="9" cy="9" r="3" stroke="currentColor" stroke-width="1.6" />
                  <path d="M3.5 19a5.5 5.5 0 0111 0M15 7a3 3 0 010 6M17 19a5.5 5.5 0 00-3-4.9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                </svg>
              )}
              {i === 2 && (
                <svg viewBox="0 0 24 24" fill="none" class="h-6 w-6 text-salvia" aria-hidden="true">
                  <path d="M9 9a3 3 0 115.8 1c-.5 1.2-1.8 1.6-2.3 2.5-.2.4-.3.9-.3 1.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                  <circle cx="12" cy="18" r="1" fill="currentColor" />
                </svg>
              )}
              {i === 3 && (
                <svg viewBox="0 0 24 24" fill="none" class="h-6 w-6 text-salvia" aria-hidden="true">
                  <path d="M7 3h10a2 2 0 012 2v14l-3-2-4 2-4-2-3 2V5a2 2 0 012-2z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
                </svg>
              )}
            </span>
            <span class="max-w-[56px] truncate text-[12px] text-ink">{h}</span>
          </span>
        ))
      }
    </div>

    <!-- Tabs -->
    <div class="grid grid-cols-3 border-t border-line">
      <span class="flex justify-center border-b-2 border-ink py-2.5 text-ink">
        <svg viewBox="0 0 24 24" fill="none" class="h-5 w-5" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="1.5" stroke="currentColor" stroke-width="1.8"></rect>
          <path d="M9 3v18M15 3v18M3 9h18M3 15h18" stroke="currentColor" stroke-width="1.8"></path>
        </svg>
      </span>
      <span class="flex justify-center py-2.5 text-salvia">
        <svg viewBox="0 0 24 24" fill="none" class="h-5 w-5" aria-hidden="true">
          <rect x="4" y="4" width="16" height="16" rx="2.5" stroke="currentColor" stroke-width="1.7"></rect>
          <path d="M4 9h16" stroke="currentColor" stroke-width="1.7"></path>
        </svg>
      </span>
      <span class="flex justify-center py-2.5 text-salvia">
        <svg viewBox="0 0 24 24" fill="none" class="h-5 w-5" aria-hidden="true">
          <rect x="3.5" y="6" width="17" height="13" rx="2" stroke="currentColor" stroke-width="1.7"></rect>
          <path d="M8 6l1.5-2h5L16 6" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"></path>
          <circle cx="12" cy="12.5" r="3" stroke="currentColor" stroke-width="1.7"></circle>
        </svg>
      </span>
    </div>

    <!-- Grid del feed -->
    <div class="grid grid-cols-3 gap-px bg-line">
      {
        tiles.map((tile) =>
          tile.type === 'photo' ? (
            <span class="ig-tile bg-cream">
              <img src={tile.src} alt="" class="h-full w-full object-cover" loading="lazy" decoding="async" />
            </span>
          ) : (
            <span class={`ig-tile ig-text ig-${tile.bg}`}>
              <span class="ig-kicker">{en ? tile.kicker.en : tile.kicker.es}</span>
              <span class="ig-title">{en ? tile.title.en : tile.title.es}</span>
            </span>
          )
        )
      }
    </div>
  </div>

  <!-- ============ DERECHA: columna de cards ============ -->
  <div class="flex flex-col gap-3">
    <!-- Pill de título -->
    <div class="rounded-full border border-line bg-white px-6 py-4 text-center shadow-[0_10px_30px_-20px_rgba(20,38,31,0.4)]">
      <span class="text-base font-bold text-ink">{t.pill}</span>
    </div>

    <!-- Pasos numerados -->
    {
      t.steps.map((s) => (
        <div class="flex items-center gap-4 rounded-2xl border border-line bg-white px-5 py-4 shadow-[0_10px_30px_-22px_rgba(20,38,31,0.4)]">
          <span class="grid h-9 w-9 shrink-0 place-content-center rounded-lg bg-[#2f6fe0] text-base font-black text-white tabular-nums">
            {s.n}
          </span>
          <span class="min-w-0">
            <span class="block text-[17px] font-black leading-tight text-ink">{s.title}</span>
            <span class="mt-0.5 flex items-center gap-2 text-[14px] text-salvia">
              {s.icon === 'ig' && (
                <svg viewBox="0 0 24 24" fill="none" class="h-[18px] w-[18px] shrink-0 text-[#c1358b]" aria-hidden="true">
                  <rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.8" />
                  <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.8" />
                  <circle cx="17" cy="7" r="1.1" fill="currentColor" />
                </svg>
              )}
              {s.icon === 'ray' && (
                <span class="grid h-[18px] w-[18px] shrink-0 place-content-center rounded-[5px] bg-[#2f6fe0] text-[11px] font-black text-white">
                  R
                </span>
              )}
              {s.icon === 'check' && (
                <svg viewBox="0 0 24 24" fill="none" class="h-[18px] w-[18px] shrink-0" aria-hidden="true">
                  <circle cx="12" cy="12" r="10" fill="#1f9d55" />
                  <path d="M7.5 12.5l3 3 6-6.5" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              )}
              {s.icon === 'chat' && (
                <span class="flex shrink-0 items-center gap-1">
                  <svg viewBox="0 0 24 24" fill="none" class="h-[18px] w-[18px] text-[#c1358b]" aria-hidden="true">
                    <rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.8" />
                    <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.8" />
                    <circle cx="17" cy="7" r="1.1" fill="currentColor" />
                  </svg>
                  <svg viewBox="0 0 24 24" fill="none" class="h-[18px] w-[18px]" aria-hidden="true">
                    <circle cx="12" cy="12" r="10" fill="#25d366" />
                    <path d="M8 15.5l-.6 2.2 2.3-.6a5 5 0 10-1.7-1.6z" fill="#fff" />
                  </svg>
                </span>
              )}
              <span class="min-w-0">{s.sub}</span>
            </span>
          </span>
        </div>
      ))
    }

    <!-- Card azul: 24 citas -->
    <div class="rounded-2xl bg-[#2f6fe0] px-6 py-6 text-center text-white shadow-[0_16px_40px_-22px_rgba(47,111,224,0.9)]">
      <p class="font-serif text-3xl font-black leading-none tabular-nums">{t.citasNum}</p>
      <p class="mt-2 text-[14px] text-white/85">{t.citasSub}</p>
    </div>
  </div>
</figure>

<style>
  .ig {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  }

  /* Anillo con gradiente de Instagram alrededor del avatar */
  .ig-ring {
    display: inline-grid;
    place-content: center;
    padding: 2.5px;
    border-radius: 9999px;
    background: linear-gradient(45deg, #f9ce34 0%, #ee2a7b 45%, #6228d7 100%);
  }

  /* Tiles cuadrados del feed */
  .ig-tile {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }
  .ig-text {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 0.6rem;
  }
  .ig-kicker {
    font-size: 0.56rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.85;
  }
  .ig-title {
    margin-top: 0.15rem;
    font-size: 0.82rem;
    font-weight: 800;
    line-height: 1.15;
  }

  .ig-blue {
    background: #2f6fe0;
    color: #fff;
  }
  .ig-blue .ig-kicker {
    color: #cfe0fb;
    opacity: 1;
  }
  .ig-green {
    background: linear-gradient(150deg, #5fd06a 0%, #a6e05a 100%);
    color: #0f2a14;
  }
  .ig-green .ig-kicker {
    color: #12451f;
    opacity: 0.9;
  }
  .ig-yellow {
    background: #f4c025;
    color: #4a3708;
  }
  .ig-yellow .ig-kicker {
    color: #6b5210;
    opacity: 0.95;
  }
  .ig-white {
    background: #ffffff;
    color: #16241d;
    border: 1px solid var(--color-line, #e6e2d9);
  }
  .ig-white .ig-kicker {
    color: #2f6fe0;
    opacity: 1;
  }
</style>
