];
---

<figure
  class={`w-full max-w-5xl overflow-hidden rounded-2xl border border-line bg-[#f4f6f9] shadow-[0_18px_50px_-24px_rgba(20,38,31,0.4)] ${cls}`}
  aria-label={en ? 'Sara weekly schedule board' : 'Tablero de agenda semanal de Sara'}
>
  <!-- Header de marca -->
  <div class="flex items-center gap-3 border-b border-line bg-white px-5 py-4 sm:px-6">
    <span class="grid h-9 w-9 shrink-0 place-content-center rounded-lg bg-[#2f6fe0] text-base font-black text-white">R</span>
    <span class="flex flex-wrap items-baseline gap-x-2 text-[15px]">
      <span class="font-bold text-ink">{t.brand}</span>
      <span class="text-salvia">· {t.section} · {t.week}</span>
    </span>
  </div>

  <div class="p-4 sm:p-5">
    <!-- KPI tiles -->
    <div class="grid grid-cols-2 gap-3 lg:grid-cols-4">
      {
        t.kpis.map((k) => (
          <div class="rounded-xl border border-line bg-white px-4 py-3.5">
            <p class="font-serif text-2xl font-black leading-tight text-ink tabular-nums">{k.v}</p>
            <p class="mt-1 text-[13px] text-salvia">{k.l}</p>
          </div>
        ))
      }
    </div>

    <!-- Columnas por día -->
    <div class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
      {
        days.map((d) => (
          <section class="rounded-xl border border-line bg-white p-3">
            <div class="mb-2.5 flex items-center justify-between gap-2 border-b border-line pb-2">
              <span class="text-sm font-bold text-ink">{d.label}</span>
              <span class="grid h-5 min-w-5 place-content-center rounded-full bg-[#eaf0fd] px-1.5 text-xs font-bold text-[#2f6fe0] tabular-nums">
                {d.count}
              </span>
            </div>
            <ul class="space-y-2">
              {d.appts.map((a) => (
                <li
                  class="rounded-md border-l-[3px] px-2.5 py-1.5"
                  style={`border-color:${statusStyle[a.status].border};background:${statusStyle[a.status].bg}`}
                >
                  <p class="text-xs font-bold text-ink tabular-nums">{a.time}</p>
                  <p class="truncate text-[13px] font-semibold leading-tight text-ink">{a.name}</p>
                  <p class="truncate text-[11px] leading-tight text-salvia">{a.sub}</p>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>

    <!-- Leyenda -->
    <div class="mt-3 flex flex-wrap gap-x-5 gap-y-2 rounded-xl border border-line bg-white px-4 py-3">
      {
        t.legend.map((g) => (
          <span class="flex items-center gap-1.5 text-xs font-medium text-salvia">
            <span class="h-2.5 w-2.5 rounded-[3px]" style={`background:${dotColor[g.key as Status]}`} />
            {g.l}
          </span>
        ))
      }
    </div>
  </div>
</figure>
