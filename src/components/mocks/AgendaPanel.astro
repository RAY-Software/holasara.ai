    { v: '31', l: en ? 'with deposit collected' : 'con anticipo cobrado' },
    { v: '2', l: en ? 'gaps resold from the waitlist' : 'huecos revendidos desde la lista de espera' },
    { v: '0', l: en ? 'front desk calls' : 'llamadas de recepción' },
