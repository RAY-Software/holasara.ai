  paid: { border: '#1f9d55', bg: '#eaf6ec' },
  confirmed: { border: '#2f6fe0', bg: '#eaf0fd' },
  reminder: { border: '#e0952f', bg: '#fdf1e0' },
  waitlist: { border: '#8250c8', bg: '#f3ecfb' },
};
const dotColor: Record<Status, string> = {
  paid: '#1f9d55',
  confirmed: '#2f6fe0',
  reminder: '#e0952f',
  waitlist: '#8250c8',
};

// Tratamientos ES -> EN.
