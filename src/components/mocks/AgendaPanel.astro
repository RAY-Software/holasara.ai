// (Lun a Vie) con tarjetas de cita coloreadas por estado y leyenda al pie.
// Datos fieles al mockup original (RAY Health).
import { defaultLocale, type Locale } from '../../i18n/config';

interface Props {
  lang?: Locale;
  class?: string;
}
const { lang = defaultLocale, class: cls = '' } = Astro.props;

const en = lang === 'en';
