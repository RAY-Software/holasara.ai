      { time: '14:00', name: 'Diego A.', sub: tr.clean, status: 'confirmed' },
      { time: '14:45', name: 'Elena Q.', sub: tr.ctrl, status: 'paid' },
      { time: '15:30', name: 'Ana C.', sub: tr.ah, status: 'paid' },
      { time: '16:15', name: 'Hugo D.', sub: tr.val, status: 'reminder' },
      { time: '17:00', name: 'Nadia W.', sub: tr.peel, status: 'paid' },
    ],
  },
  {
    label: en ? 'Tue Jul 29' : 'Mar 29/7',
    count: 9,
    appts: [
      { time: '09:00', name: 'Sofía M.', sub: tr.peel, status: 'paid' },
      { time: '09:45', name: 'León T.', sub: tr.meso, status: 'confirmed' },
      { time: '10:30', name: 'Julián F.', sub: tr.clean, status: 'reminder' },
      { time: '11:15', name: 'Paula N.', sub: tr.ctrl, status: 'paid' },
      { time: '12:00', name: 'Ivo R.', sub: tr.ah, status: 'paid' },
      { time: '14:00', name: 'Clara Z.', sub: tr.val, status: 'paid' },
      { time: '14:45', name: 'Ignacio P.', sub: tr.peel, status: 'confirmed' },
      { time: '15:30', name: 'Mora L.', sub: tr.val, status: 'paid' },
      { time: '16:15', name: 'Valentina R.', sub: tr.tox, status: 'paid' },
