      { time: '14:00', name: 'Facundo I.', sub: tr.ah, status: 'confirmed' },
      { time: '14:45', name: 'Lara G.', sub: tr.val, status: 'paid' },
      { time: '15:30', name: 'Guadalupe H.', sub: tr.peel, status: 'waitlist' },
      { time: '16:15', name: 'Lautaro N.', sub: tr.val, status: 'paid' },
