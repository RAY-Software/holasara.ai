  legend: [
    { key: 'paid', l: en ? 'Deposit paid' : 'Anticipo pagado' },
    { key: 'confirmed', l: en ? 'Confirmed' : 'Confirmada' },
    { key: 'reminder', l: en ? 'Reminder sent' : 'Recordatorio enviado' },
    { key: 'waitlist', l: en ? 'From waitlist' : 'Desde lista de espera' },
