---
import Wordmark from './Wordmark.astro';
import { whatsappLink } from '../lib/whatsapp';
const year = new Date().getFullYear();
---

<footer class="border-t border-line-dark bg-ink text-cream">
  <div class="mx-auto max-w-6xl px-5 py-16">
    <div class="flex flex-col gap-10 md:flex-row md:items-end md:justify-between">
      <div class="max-w-md">
        <Wordmark class="text-3xl" dark />
        <p class="mt-4 text-lg text-cream/70">La recepción que nunca cierra.</p>
        <a
          href={whatsappLink()}
          target="_blank"
          rel="noopener"
          class="mt-6 inline-flex items-center gap-2 rounded-full bg-mint px-5 py-2.5 text-sm font-semibold text-ink transition-opacity hover:opacity-90"
        >
          Hablá con Sara
        </a>
      </div>
      <div class="text-sm text-cream/60">
        <p>La secretaria con IA de tu clínica.</p>
        <p class="mt-1">WhatsApp · Instagram · Agenda · Cobros</p>
      </div>
    </div>

    <div class="mt-14 flex flex-col gap-2 border-t border-cream/10 pt-6 text-xs text-cream/45 md:flex-row md:justify-between">
      <p>© {year} Sara. Todos los derechos reservados.</p>
      <p>Hecho para clínicas de LATAM.</p>
    </div>
  </div>
</footer>
