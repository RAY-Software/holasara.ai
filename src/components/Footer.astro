---
import Wordmark from './Wordmark.astro';
import { whatsappLink, whatsappText } from '../lib/whatsapp';
import { getProductLinks, getIndustryLinks, getSizeLinks } from '../data/nav';
import { defaultLocale, localePath, type Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

interface Props {
  lang?: Locale;
}
const { lang = defaultLocale } = Astro.props;
const t = useTranslations(lang);
const productLinks = getProductLinks(lang);
const industryLinks = getIndustryLinks(lang);
const sizeLinks = getSizeLinks(lang);
const L = (p: string) => localePath(p, lang);
const year = new Date().getFullYear();
---

<footer class="border-t border-line-dark bg-ink text-cream">
  <div class="mx-auto max-w-6xl px-5 py-16">
    <div class="flex flex-col gap-12 md:flex-row md:items-start md:justify-between">
      <div class="max-w-sm">
        <Wordmark class="text-3xl" dark />
        <p class="mt-4 text-lg text-cream/70">{t('footer.tagline')}</p>
        <a
          href={whatsappLink(whatsappText(lang))}
          target="_blank"
          rel="noopener"
          class="mt-6 inline-flex items-center gap-2 rounded-full bg-mint px-5 py-2.5 text-sm font-semibold text-ink transition-opacity hover:opacity-90"
        >
          {t('footer.talkToSara')}
        </a>
      </div>
      <div class="grid grid-cols-2 gap-10 text-sm text-cream/70 sm:grid-cols-[1.6fr_1fr_1fr_1.2fr] md:w-[44rem] md:shrink-0 [&_li>a]:sm:whitespace-nowrap">
        <nav aria-label={t('footer.features')}>
          <p class="mb-3 text-xs font-semibold uppercase tracking-[0.12em] text-cream/45">{t('footer.features')}</p>
          <ul class="flex flex-col gap-2.5">
            {
              productLinks.map((it) => (
                <li>
                  <a href={L(it.href)} class="transition-colors hover:text-cream">{it.name}</a>
                </li>
              ))
            }
          </ul>
        </nav>
        <nav aria-label={t('footer.business')}>
          <p class="mb-3 text-xs font-semibold uppercase tracking-[0.12em] text-cream/45">{t('footer.business')}</p>
          <ul class="flex flex-col gap-2.5">
            {
              industryLinks.map((it) => (
                <li>
                  <a href={L(it.href)} class="transition-colors hover:text-cream">{it.name}</a>
                </li>
              ))
            }
          </ul>
        </nav>
        <nav aria-label={t('footer.bySize')}>
          <p class="mb-3 text-xs font-semibold uppercase tracking-[0.12em] text-cream/45">{t('footer.bySize')}</p>
          <ul class="flex flex-col gap-2.5">
            {
              sizeLinks.map((it) => (
                <li>
                  <a href={L(it.href)} class="transition-colors hover:text-cream">{it.name}</a>
                </li>
              ))
            }
          </ul>
        </nav>
        <nav aria-label={t('footer.company')}>
          <p class="mb-3 text-xs font-semibold uppercase tracking-[0.12em] text-cream/45">{t('footer.company')}</p>
          <ul class="flex flex-col gap-2.5">
            <li><a href={L('/nosotros')} class="transition-colors hover:text-cream">{t('footer.about')}</a></li>
            <li><a href={L('/caso')} class="transition-colors hover:text-cream">{t('footer.cases')}</a></li>
            <li><a href={L('/mejores-asistentes-ia-clinicas')} class="transition-colors hover:text-cream">{t('footer.compare')}</a></li>
            <li><a href={L('/terminos')} class="transition-colors hover:text-cream">{t('footer.terms')}</a></li>
            <li><a href={L('/privacidad')} class="transition-colors hover:text-cream">{t('footer.privacy')}</a></li>
          </ul>
        </nav>
      </div>
    </div>

    <div class="mt-14 flex flex-col gap-2 border-t border-cream/10 pt-6 text-xs text-cream/45 md:flex-row md:justify-between">
      <p>© {year} Sara, {t('footer.productOf')} {t('footer.rights')}</p>
      <p class="flex flex-wrap gap-x-4 gap-y-1">
        <a href={L('/terminos')} class="transition-colors hover:text-cream/80">{t('footer.termsShort')}</a>
        <a href={L('/privacidad')} class="transition-colors hover:text-cream/80">{t('footer.privacyShort')}</a>
        <a href="mailto:info@rayapp.io" class="transition-colors hover:text-cream/80">info@rayapp.io</a>
      </p>
    </div>
  </div>
</footer>
