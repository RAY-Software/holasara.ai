---
import Wordmark from './Wordmark.astro';
import { whatsappLink } from '../lib/whatsapp';
const year = new Date().getFullYear();
---

<footer class="border-t border-line-dark bg-ink text-cream">
  <div class="mx-auto max-w-6xl px-5 py-16">
    <div class="flex flex-col gap-10 md:flex-row md:items-end md:justify-between">
      <div class="max-w-md">
        <Wordmark class="text-3xl" dark />
        <p class="mt-4 text-lg text-cream/70">La recepción que nunca cierra.</p>
        <a
          href={whatsappLink()}
          target="_blank"
          rel="noopener"
          class="mt-6 inline-flex items-center gap-2 rounded-full bg-mint px-5 py-2.5 text-sm font-semibold text-ink transition-opacity hover:opacity-90"
        >
          Habla con Sara
        </a>
      </div>
      <nav class="text-sm text-cream/70" aria-label="Enlaces de la empresa">
        <p class="mb-3 text-xs font-semibold uppercase tracking-[0.12em] text-cream/45">Sara</p>
        <ul class="flex flex-col gap-2.5">
          <li><a href="/nosotros" class="transition-colors hover:text-cream">Nosotros</a></li>
          <li><a href="/caso" class="transition-colors hover:text-cream">Casos</a></li>
          <li><a href="/precios" class="transition-colors hover:text-cream">Precios</a></li>
          <li><a href="/terminos" class="transition-colors hover:text-cream">Términos y condiciones</a></li>
          <li><a href="/privacidad" class="transition-colors hover:text-cream">Política de privacidad</a></li>
        </ul>
      </nav>
    </div>

    <div class="mt-14 flex flex-col gap-2 border-t border-cream/10 pt-6 text-xs text-cream/45 md:flex-row md:justify-between">
      <p>© {year} Sara, un producto de BotBit, Inc. (RAY). Todos los derechos reservados.</p>
      <p class="flex flex-wrap gap-x-4 gap-y-1">
        <a href="/terminos" class="transition-colors hover:text-cream/80">Términos</a>
        <a href="/privacidad" class="transition-colors hover:text-cream/80">Privacidad</a>
        <a href="mailto:info@rayapp.io" class="transition-colors hover:text-cream/80">info@rayapp.io</a>
      </p>
    </div>
  </div>
</footer>
