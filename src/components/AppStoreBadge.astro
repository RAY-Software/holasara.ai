---
// Badge "Consíguelo en el App Store" / "Download on the App Store", con la forma y
// el logo del badge oficial de Apple (negro, borde fino, dos líneas de texto). Va
// dibujado en HTML+SVG en vez de la imagen oficial para que escale nítido y se
// traduzca solo con el idioma. Link a la app (src/lib/app.ts) con campaign token.
import { defaultLocale, type Locale } from '../i18n/config';
import { appStoreUrl } from '../lib/app';

interface Props {
  lang?: Locale;
  /** Campaign token de App Analytics: de dónde salió el clic (hero, footer…). */
  campaign?: string;
  /** Alto del badge. `md` (48px) para heroes, `sm` (40px, el mínimo de Apple) para el footer. */
  size?: 'sm' | 'md';
  class?: string;
}
const { lang = defaultLocale, campaign = 'website', size = 'md', class: cls = '' } = Astro.props;
const t =
  lang === 'en'
    ? { top: 'Download on the', store: 'App Store', aria: 'Download Sara AI on the App Store' }
    : { top: 'Consíguelo en el', store: 'App Store', aria: 'Descargar Sara AI en el App Store' };
---

<a
  href={appStoreUrl(campaign)}
  target="_blank"
  rel="noopener"
  aria-label={t.aria}
  class:list={['app-badge', size === 'sm' ? 'app-badge--sm' : 'app-badge--md', cls]}
>
  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="app-badge__logo">
    <path
      d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"
    />
  </svg>
  <span class="app-badge__text">
    <span class="app-badge__top">{t.top}</span>
    <span class="app-badge__store">{t.store}</span>
  </span>
</a>

<style>
  .app-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border-radius: 0.55rem;
    background: #000;
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.35);
    font-family: -apple-system, BlinkMacSystemFont, 'Inter Variable', 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    line-height: 1;
    white-space: nowrap;
    transition: opacity 0.15s ease;
  }
  .app-badge:hover {
    opacity: 0.88;
  }
  .app-badge--md {
    height: 3rem;
    padding: 0 0.9rem 0 0.7rem;
  }
  .app-badge--sm {
    height: 2.5rem;
    padding: 0 0.75rem 0 0.6rem;
  }
  .app-badge__logo {
    flex: none;
  }
  .app-badge--md .app-badge__logo {
    width: 1.7rem;
    height: 1.7rem;
  }
  .app-badge--sm .app-badge__logo {
    width: 1.4rem;
    height: 1.4rem;
  }
  .app-badge__text {
    display: flex;
    flex-direction: column;
    gap: 0.12rem;
  }
  .app-badge__top {
    font-weight: 500;
    letter-spacing: 0.01em;
  }
  .app-badge__store {
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .app-badge--md .app-badge__top {
    font-size: 0.66rem;
  }
  .app-badge--md .app-badge__store {
    font-size: 1.3rem;
  }
  .app-badge--sm .app-badge__top {
    font-size: 0.56rem;
  }
  .app-badge--sm .app-badge__store {
    font-size: 1.08rem;
  }
</style>
