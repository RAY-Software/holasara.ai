---
import type { ProductIcon } from '../data/nav';

interface Props {
  name?: ProductIcon;
  size?: number;
}
const { name = 'chat', size = 24 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {name === 'spark' && (
    <>
      <path d="M12 3.5 13.4 9l5.6 1.4L13.4 12 12 17.5 10.6 12 5 10.4 10.6 9z" />
      <path d="M18.5 4.5v3M20 6h-3" />
    </>
  )}
  {name === 'chat' && (
    <>
      <path d="M6.5 17.5 4 20V8.5A2.5 2.5 0 0 1 6.5 6h11A2.5 2.5 0 0 1 20 8.5v6A2.5 2.5 0 0 1 17.5 17H6.5z" />
      <path d="M8 10.5h8M8 13.5h5" />
    </>
  )}
  {name === 'phone' && (
    <path d="M7.2 3.8c.4-.4 1.1-.5 1.6-.2l2.1 1.3c.5.3.7.9.6 1.5l-.4 2.1c-.1.5.1 1 .5 1.3l2.9 2.9c.3.4.8.6 1.3.5l2.1-.4c.6-.1 1.2.1 1.5.6l1.3 2.1c.3.5.2 1.2-.2 1.6l-1.3 1.3c-.7.7-1.7 1-2.7.7-2.4-.7-4.6-2.3-6.6-4.3s-3.6-4.2-4.3-6.6c-.3-1 0-2 .7-2.7L7.2 3.8z" />
  )}
  {name === 'headset' && (
    <>
      <path d="M4.5 13V11a7.5 7.5 0 0 1 15 0v2" />
      <path d="M4.5 13.5v3A1.5 1.5 0 0 0 6 18h1v-5H6a1.5 1.5 0 0 0-1.5 1.5zM17 13h1a1.5 1.5 0 0 1 1.5 1.5v3A1.5 1.5 0 0 1 18 19h-1v-6z" />
      <path d="M17 19c0 1.4-1.3 2.5-3 2.5" />
    </>
  )}
  {name === 'refresh' && (
    <>
      <path d="M4 12a8 8 0 0 1 13.2-6.1L20 8.5" />
      <path d="M20 4v4.5h-4.5" />
      <path d="M20 12a8 8 0 0 1-13.2 6.1L4 15.5" />
      <path d="M4 20v-4.5h4.5" />
    </>
  )}
  {name === 'calendar' && (
    <>
      <rect x="3.5" y="5" width="17" height="15.5" rx="2" />
      <path d="M8 3.5v3M16 3.5v3M3.5 10h17" />
    </>
  )}
  {name === 'card' && (
    <>
      <rect x="2.5" y="5.5" width="19" height="13" rx="2" />
      <path d="M2.5 10h19M6.5 14.5h4" />
    </>
  )}
  {name === 'gift' && (
    <>
      <rect x="4" y="11" width="16" height="9.5" rx="1.2" />
      <path d="M4 15.5h16M12 11v9.5M12 11c-2.2 0-4-1.4-4-3.1S10.2 6 12 8.2C13.8 6 16 6.2 16 7.9S14.2 11 12 11z" />
    </>
  )}
  {name === 'camera' && (
    <>
      <path d="M4.5 8.5h2.2l1.4-2h7.8l1.4 2H19.5A1.5 1.5 0 0 1 21 10v8a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 18v-8a1.5 1.5 0 0 1 1.5-1.5z" />
      <circle cx="12" cy="14" r="3.2" />
    </>
  )}
  {name === 'star' && (
    <path d="M12 3.8 14.2 9l5.6.5-4.2 3.7 1.3 5.4L12 15.8 7.1 18.6l1.3-5.4L4.2 9.5 9.8 9z" />
  )}
</svg>
