---
import Wordmark from './Wordmark.astro';
import { getProductGroups, getIndustryLinks, getSizeLinks, getTopLinks } from '../data/nav';
import { getTeam } from '../data/team';
import { SHOW_GRADER_CTA } from '../lib/flags';
import { defaultLocale, localePath, locales, type Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

interface Props {
  lang?: Locale;
}
const { lang = defaultLocale } = Astro.props;
const t = useTranslations(lang);

const productGroups = getProductGroups(lang);
const industryLinks = getIndustryLinks(lang);
const sizeLinks = getSizeLinks(lang);
const topLinks = getTopLinks(lang);
const team = getTeam(lang);
// Etiquetas del mega menú de Equipo (no hay claves i18n dedicadas para esto).
const teamNav =
  lang === 'en'
    ? { label: 'Team', all: 'Meet the whole team', action: 'In action' }
    : { label: 'Equipo', all: 'Conoce a todo el equipo', action: 'En acción' };
const L = (p: string) => localePath(p, lang);

// Switcher ES/EN: alterna el segmento de idioma del path actual, preservando la ruta.
const stripLocale = Astro.url.pathname.replace(/^\/(es|en)(?=\/|$)/, '') || '/';
const langHref = (l: Locale) => `/${l}${stripLocale === '/' ? '' : stripLocale}`;
---

<header class="z-50">
  <div class="sticky top-0 z-50 border-b border-line/70 bg-cream/90 backdrop-blur-md">
    <div class="relative mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-3.5">
    <a href={L('/')} class="flex items-center" aria-label={t('header.homeAria')}>
      <Wordmark class="text-[1.9rem]" />
    </a>

    <!-- ─── Nav desktop ─── -->
    <nav class="hidden items-center gap-1 lg:flex">
      <!-- Producto (mega menú, hover-intent con delay via JS) -->
      <div class="group" data-mega>
        <button
          type="button"
          class="inline-flex items-center gap-1 rounded-full px-3.5 py-2 text-sm font-medium text-salvia transition-colors hover:text-ink group-hover:text-ink"
          aria-haspopup="true"
        >
          {t('nav.product')}
          <svg class="mega-chevron h-3.5 w-3.5 transition-transform" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M5 7.5 10 12.5 15 7.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>

        <!-- Panel: full-width; visibilidad manejada por JS (is-open) con delay de cierre -->
        <div
          class="mega-panel invisible absolute left-0 right-0 top-full z-50 translate-y-1 pt-3 opacity-0 transition duration-150 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100"
        >
          <div class="mx-auto grid w-[min(100%,1024px)] gap-8 rounded-2xl border border-line bg-white p-8 shadow-[0_24px_60px_-24px_rgba(20,38,31,0.4)] md:grid-cols-[1fr_280px]">
            <div class="grid grid-cols-2 gap-x-10 gap-y-9 sm:grid-cols-4">
              {
                productGroups.map((g) => (
                  <div>
                    <p class="mb-4 text-xs font-semibold uppercase tracking-[0.12em] text-pine-dark">{g.label}</p>
                    <ul class="flex flex-col gap-6">
                      {g.items.map((it) => (
                        <li>
                          <a href={L(it.href)} class="group/link block">
                            <span class="block text-sm font-semibold leading-snug text-ink transition-colors group-hover/link:text-pine-dark">
                              {it.name}
                            </span>
                            <span class="mt-1 block text-xs leading-snug text-salvia">{it.desc}</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))
              }
            </div>

            <!-- Promo: imagen de ViaLaser (caso real) -->
            <a href={L('/caso')} class="group/case relative flex min-h-[280px] overflow-hidden rounded-xl bg-ink">
              <img
                src="/img/vialaser-chart.jpg"
                alt={t('header.caseImgAlt')}
                class="absolute inset-0 h-full w-full object-cover opacity-90 transition duration-300 group-hover/case:scale-[1.04]"
                loading="lazy"
                decoding="async"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/55 to-ink/5"></div>
              <div class="relative mt-auto p-5">
                <p class="text-xs font-semibold uppercase tracking-[0.12em] text-mint">{t('header.caseKicker')}</p>
                <p class="mt-1 font-serif text-lg font-black leading-tight text-cream">{t('header.caseTitleProduct')}</p>
                <span class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-cream">
                  {t('header.caseCta')} <span aria-hidden="true">→</span>
                </span>
              </div>
            </a>
          </div>
        </div>
      </div>

      <!-- Negocios (mega menú: para quién es Sara, por industria y por tamaño) -->
      <div class="group" data-mega>
        <button
          type="button"
          class="inline-flex items-center gap-1 rounded-full px-3.5 py-2 text-sm font-medium text-salvia transition-colors hover:text-ink group-hover:text-ink"
          aria-haspopup="true"
        >
          {t('nav.business')}
          <svg class="mega-chevron h-3.5 w-3.5 transition-transform" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M5 7.5 10 12.5 15 7.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>

        <div
          class="mega-panel invisible absolute left-0 right-0 top-full z-50 translate-y-1 pt-3 opacity-0 transition duration-150 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100"
        >
          <div class="mx-auto grid w-[min(100%,880px)] gap-8 rounded-2xl border border-line bg-white p-8 shadow-[0_24px_60px_-24px_rgba(20,38,31,0.4)] md:grid-cols-[1fr_1fr_280px]">
            <div>
              <p class="mb-4 text-xs font-semibold uppercase tracking-[0.12em] text-pine-dark">{t('nav.byIndustry')}</p>
              <ul class="flex flex-col gap-6">
                {
                  industryLinks.map((it) => (
                    <li>
                      <a href={L(it.href)} class="group/link block">
                        <span class="block text-sm font-semibold leading-snug text-ink transition-colors group-hover/link:text-pine-dark">
                          {it.name}
                        </span>
                        <span class="mt-1 block text-xs leading-snug text-salvia">{it.desc}</span>
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>

            <div>
              <p class="mb-4 text-xs font-semibold uppercase tracking-[0.12em] text-pine-dark">{t('nav.bySize')}</p>
              <ul class="flex flex-col gap-6">
                {
                  sizeLinks.map((it) => (
                    <li>
                      <a href={L(it.href)} class="group/link block">
                        <span class="block text-sm font-semibold leading-snug text-ink transition-colors group-hover/link:text-pine-dark">
                          {it.name}
                        </span>
                        <span class="mt-1 block text-xs leading-snug text-salvia">{it.desc}</span>
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>

            <!-- Promo: caso real ViaLaser (misma imagen que el panel de Producto) -->
            <a href={L('/caso')} class="group/case relative flex min-h-[240px] overflow-hidden rounded-xl bg-ink">
              <img
                src="/img/vialaser-chart.jpg"
                alt={t('header.caseImgAlt')}
                class="absolute inset-0 h-full w-full object-cover opacity-90 transition duration-300 group-hover/case:scale-[1.04]"
                loading="lazy"
                decoding="async"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/55 to-ink/5"></div>
              <div class="relative mt-auto p-5">
                <p class="text-xs font-semibold uppercase tracking-[0.12em] text-mint">{t('header.caseKicker')}</p>
                <p class="mt-1 font-serif text-lg font-black leading-tight text-cream">{t('header.caseTitleBusiness')}</p>
                <span class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-cream">
                  {t('header.caseCta')} <span aria-hidden="true">→</span>
                </span>
              </div>
            </a>
          </div>
        </div>
      </div>

      <!-- Equipo (mega menú: los tres personajes) -->
      <div class="group" data-mega>
        <button
          type="button"
          class="inline-flex items-center gap-1 rounded-full px-3.5 py-2 text-sm font-medium text-salvia transition-colors hover:text-ink group-hover:text-ink"
          aria-haspopup="true"
        >
          {teamNav.label}
          <svg class="mega-chevron h-3.5 w-3.5 transition-transform" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M5 7.5 10 12.5 15 7.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>

        <div
          class="mega-panel invisible absolute left-0 right-0 top-full z-50 translate-y-1 pt-3 opacity-0 transition duration-150 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100"
        >
          <div class="mx-auto grid w-[min(100%,880px)] gap-8 rounded-2xl border border-line bg-white p-8 shadow-[0_24px_60px_-24px_rgba(20,38,31,0.4)] md:grid-cols-[1fr_280px]">
            <div class="flex flex-col">
              <div class="flex flex-1 flex-col justify-center gap-1.5">
                {
                  team.map((m) => (
                    <a href={L(m.href)} class="group/link -mx-3 flex items-center gap-4 rounded-xl px-3 py-2.5 transition-colors hover:bg-paper">
                      <span class="relative h-[74px] w-16 shrink-0 overflow-hidden rounded-lg bg-cream">
                        <img src={m.poster} alt={m.name} loading="lazy" decoding="async" class="h-full w-full object-cover object-top" />
                      </span>
                      <span class="min-w-0">
                        <span class="block text-[15px] font-semibold leading-snug text-ink transition-colors group-hover/link:text-pine-dark">
                          {m.name} <span class="font-normal text-salvia">· {m.role}</span>
                        </span>
                        <span class="mt-1 block text-[13px] leading-snug text-salvia">{m.oneliner}</span>
                      </span>
                    </a>
                  ))
                }
              </div>
              <a href={L('/equipo')} class="mt-5 inline-flex items-center gap-1.5 border-t border-line pt-5 text-sm font-semibold text-pine-dark transition-colors hover:text-ink">
                {teamNav.all} <span aria-hidden="true">→</span>
              </a>
            </div>

            <!-- Rail "En acción": retratos grandes en crossfade (patrón diezX) -->
            <div class="hidden flex-col border-l border-line pl-8 md:flex">
              <p class="mb-3 text-xs font-semibold uppercase tracking-[0.12em] text-pine-dark">{teamNav.action}</p>
              <div class="team-rail relative h-[270px] w-full overflow-hidden rounded-xl bg-ink">
                {
                  team.map((m, i) => (
                    <a href={L(m.href)} class="team-rail__slide absolute inset-0" style={`animation-delay:${i * 3}s`}>
                      <img
                        src={m.poster}
                        alt={`${m.name} · ${m.role}`}
                        loading="lazy"
                        decoding="async"
                        class="h-full w-full object-cover object-top"
                      />
                      <span class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-ink/80 to-transparent px-4 pb-3 pt-10">
                        <span class="block text-sm font-bold text-cream">{m.name}</span>
                        <span class="block text-xs text-cream/75">{m.role}</span>
                      </span>
                    </a>
                  ))
                }
              </div>
            </div>
          </div>
        </div>
      </div>

      {
        topLinks.map((l) => (
          <a href={L(l.href)} class="rounded-full px-3.5 py-2 text-sm font-medium text-salvia transition-colors hover:text-ink">
            {l.name}
          </a>
        ))
      }
    </nav>

    <!-- ─── CTAs desktop ─── -->
    <div class="hidden items-center gap-2.5 lg:flex">
      <!-- Switcher ES/EN -->
      <div class="flex items-center rounded-full border border-line p-0.5 text-xs font-semibold" role="group" aria-label={t('lang.switch')}>
        {
          locales.map((l) => (
            <a
              href={langHref(l)}
              data-astro-prefetch={false}
              class={`rounded-full px-2.5 py-1 uppercase tracking-wide transition-colors ${
                l === lang ? 'bg-ink text-cream' : 'text-salvia hover:text-ink'
              }`}
              aria-current={l === lang ? 'true' : undefined}
              hreflang={l}
            >
              {l}
            </a>
          ))
        }
      </div>
      {/* CTA al grader — `product=servicios` activa la variante Sara
          (cookie + CTAs de demo a holasara.ai/demo). NO quitar el param. */}
      {SHOW_GRADER_CTA && (
        <a
          href="https://grader.rayapp.ai/?product=servicios&utm_source=header&utm_medium=website&utm_campaign=holasara"
          class="inline-flex items-center gap-2 rounded-full border border-line px-4 py-2 text-sm font-semibold text-ink transition-colors hover:border-ink/30"
        >
          {t('header.scanCta')}
        </a>
      )}
      <a
        href={L('/demo')}
        class="inline-flex items-center gap-2 rounded-full bg-pine px-4 py-2 text-sm font-semibold text-cream transition-colors hover:bg-pine-dark"
      >
        {t('header.demoCta')}
      </a>
    </div>

    <!-- ─── Toggle mobile ─── -->
    <button
      id="nav-toggle"
      type="button"
      class="inline-flex h-10 w-10 items-center justify-center rounded-full text-ink lg:hidden"
      aria-label={t('header.openMenu')}
      aria-expanded="false"
      aria-controls="mobile-nav"
    >
      <svg id="nav-open-icon" class="h-6 w-6" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
      </svg>
      <svg id="nav-close-icon" class="hidden h-6 w-6" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
      </svg>
    </button>
    </div>
  </div>

  <!-- ─── Dropdown mobile: panel en flujo bajo la barra (como RAY). La página scrollea. ─── -->
  <div
    id="mobile-nav"
    class="hidden overflow-visible border-t border-line bg-cream shadow-[0_16px_40px_-12px_rgba(20,38,31,0.28)] lg:hidden"
  >
    <div class="px-4 pb-4 pt-3">
      <nav class="flex flex-col">
        <!-- Producto -->
        <div data-accordion="product">
          <button
            type="button"
            data-accordion-btn
            class="flex min-h-11 w-full items-center justify-between px-3 py-2 text-left text-base font-medium text-ink"
            aria-expanded="false"
            aria-controls="mobile-acc-product"
          >
            {t('nav.product')}
            <svg data-accordion-chevron class="h-4 w-4 text-salvia transition-transform duration-200" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M5 7.5 10 12.5 15 7.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
          <div id="mobile-acc-product" data-accordion-panel class="hidden pb-2 pl-1">
            {
              productGroups.map((g) => (
                <div class="pt-2">
                  <p class="px-2 pb-1 text-xs font-semibold uppercase tracking-[0.12em] text-pine-dark">{g.label}</p>
                  <ul class="flex flex-col">
                    {g.items.map((it) => (
                      <li>
                        <a href={L(it.href)} class="block rounded-lg px-2 py-2.5">
                          <span class="block text-sm font-semibold leading-snug text-ink">{it.name}</span>
                          {it.desc && <span class="mt-0.5 block text-xs leading-snug text-salvia">{it.desc}</span>}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </div>
        </div>

        <!-- Negocios -->
        <div data-accordion="business">
          <button
            type="button"
            data-accordion-btn
            class="flex min-h-11 w-full items-center justify-between px-3 py-2 text-left text-base font-medium text-ink"
            aria-expanded="false"
            aria-controls="mobile-acc-business"
          >
            {t('nav.business')}
            <svg data-accordion-chevron class="h-4 w-4 text-salvia transition-transform duration-200" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M5 7.5 10 12.5 15 7.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
          <div id="mobile-acc-business" data-accordion-panel class="hidden pb-2 pl-1">
            <div class="pt-2">
              <p class="px-2 pb-1 text-xs font-semibold uppercase tracking-[0.12em] text-pine-dark">{t('nav.byIndustry')}</p>
              <ul class="flex flex-col">
                {
                  industryLinks.map((it) => (
                    <li>
                      <a href={L(it.href)} class="block rounded-lg px-2 py-2.5">
                        <span class="block text-sm font-semibold leading-snug text-ink">{it.name}</span>
                        {it.desc && <span class="mt-0.5 block text-xs leading-snug text-salvia">{it.desc}</span>}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>
            <div class="pt-3">
              <p class="px-2 pb-1 text-xs font-semibold uppercase tracking-[0.12em] text-pine-dark">{t('nav.bySize')}</p>
              <ul class="flex flex-col">
                {
                  sizeLinks.map((it) => (
                    <li>
                      <a href={L(it.href)} class="block rounded-lg px-2 py-2.5">
                        <span class="block text-sm font-semibold leading-snug text-ink">{it.name}</span>
                        {it.desc && <span class="mt-0.5 block text-xs leading-snug text-salvia">{it.desc}</span>}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </div>

        <!-- Equipo -->
        <div data-accordion="team">
          <button
            type="button"
            data-accordion-btn
            class="flex min-h-11 w-full items-center justify-between px-3 py-2 text-left text-base font-medium text-ink"
            aria-expanded="false"
            aria-controls="mobile-acc-team"
          >
            {teamNav.label}
            <svg data-accordion-chevron class="h-4 w-4 text-salvia transition-transform duration-200" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M5 7.5 10 12.5 15 7.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
          <div id="mobile-acc-team" data-accordion-panel class="hidden pb-2 pl-1">
            <ul class="flex flex-col pt-1">
              {
                team.map((m) => (
                  <li>
                    <a href={L(m.href)} class="block rounded-lg px-2 py-2.5">
                      <span class="block text-sm font-semibold leading-snug text-ink">
                        {m.name} <span class="font-normal text-salvia">· {m.role}</span>
                      </span>
                      {m.oneliner && <span class="mt-0.5 block text-xs leading-snug text-salvia">{m.oneliner}</span>}
                    </a>
                  </li>
                ))
              }
              <li>
                <a href={L('/equipo')} class="block rounded-lg px-2 py-2.5 text-sm font-semibold text-pine-dark">
                  {teamNav.all}
                </a>
              </li>
            </ul>
          </div>
        </div>

        {
          topLinks.map((l) => (
            <a href={L(l.href)} class="flex min-h-11 items-center px-3 py-2 text-base font-medium text-ink">
              {l.name}
            </a>
          ))
        }
      </nav>

      <div class="mt-2 border-t border-line pt-4">
        <p class="mb-2 px-3 text-xs font-semibold uppercase tracking-[0.12em] text-salvia">{t('lang.switch')}</p>
        <div class="flex gap-2" role="group" aria-label={t('lang.switch')}>
          {
            locales.map((l) => (
              <a
                href={langHref(l)}
                data-astro-prefetch={false}
                class={`flex min-h-[44px] flex-1 items-center justify-center space-x-2 rounded-md px-4 py-3 text-sm ${
                  l === lang ? 'bg-pine text-cream' : 'bg-white text-ink'
                }`}
                aria-current={l === lang ? 'true' : undefined}
                hreflang={l}
              >
                <span class="text-lg" aria-hidden="true">{l === 'es' ? '🇪🇸' : '🇺🇸'}</span>
                <span class="font-medium">{l === 'es' ? t('lang.es') : t('lang.en')}</span>
              </a>
            ))
          }
        </div>
      </div>

      <div class="mt-4 border-t border-line pt-4">
        <a
          href={L('/demo')}
          class="inline-flex min-h-11 w-full items-center justify-center text-base font-medium text-pine"
        >
          {t('header.demoCta')}
        </a>
        {SHOW_GRADER_CTA && (
          <a
            href="https://grader.rayapp.ai/?product=servicios&utm_source=header&utm_medium=website&utm_campaign=holasara"
            class="mt-2 inline-flex min-h-[52px] w-full items-center justify-center rounded-lg bg-pine px-5 text-base font-semibold text-cream"
          >
            {t('header.scanCta')}
          </a>
        )}
      </div>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    var btn = document.getElementById('nav-toggle');
    var panel = document.getElementById('mobile-nav');
    var openI = document.getElementById('nav-open-icon');
    var closeI = document.getElementById('nav-close-icon');
    if (!btn || !panel) return;

    function isOpen() {
      return !panel.classList.contains('hidden');
    }

    var accordions = panel.querySelectorAll('[data-accordion]');

    function setAccordionOpen(el, open) {
      el.classList.toggle('is-open', open);
      var trigger = el.querySelector('[data-accordion-btn]');
      var pane = el.querySelector('[data-accordion-panel]');
      if (trigger) trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
      if (pane) pane.classList.toggle('hidden', !open);
    }

    function collapseAccordions() {
      accordions.forEach(function (el) {
        setAccordionOpen(el, false);
      });
    }

    accordions.forEach(function (el) {
      var trigger = el.querySelector('[data-accordion-btn]');
      if (!trigger) return;
      trigger.addEventListener('click', function () {
        setAccordionOpen(el, !el.classList.contains('is-open'));
      });
    });

    function setOpen(open) {
      panel.classList.toggle('hidden', !open);
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      openI.classList.toggle('hidden', open);
      closeI.classList.toggle('hidden', !open);
      if (!open) collapseAccordions();
    }

    btn.addEventListener('click', function () {
      setOpen(!isOpen());
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && isOpen()) {
        setOpen(false);
        btn.focus();
      }
    });

    window.addEventListener('resize', function () {
      if (isOpen() && window.matchMedia('(min-width: 1024px)').matches) {
        setOpen(false);
      }
    });
  })();
</script>

<style>
  [data-accordion].is-open [data-accordion-chevron] {
    transform: rotate(180deg);
  }

  /* Estado abierto del mega menú (lo togglea el JS con delay de cierre) */
  [data-mega].is-open .mega-panel {
    visibility: visible;
    opacity: 1;
    transform: translateY(0);
  }
  [data-mega].is-open .mega-chevron {
    transform: rotate(180deg);
  }

  /* Rail "En acción" del panel Equipo: crossfade CSS puro (sin JS), 3 retratos
     de 3s cada uno en un loop de 9s, desfasados por animation-delay. */
  .team-rail__slide {
    opacity: 0;
    animation: team-rail-fade 9s infinite;
  }
  @keyframes team-rail-fade {
    0% { opacity: 0; }
    4% { opacity: 1; }
    33% { opacity: 1; }
    38% { opacity: 0; }
    100% { opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .team-rail__slide {
      animation: none;
    }
    .team-rail__slide:first-child {
      opacity: 1;
    }
  }
</style>

<script is:inline>
  // Hover-intent: abre al entrar, y al salir espera un poco antes de cerrar, así
  // el puntero puede cruzar el hueco entre el botón y el panel sin que se cierre.
  // Al abrir uno, los demás se cierran AL INSTANTE (sin esperar su delay), para
  // que nunca se vean dos paneles superpuestos.
  (function () {
    var megas = document.querySelectorAll('[data-mega]');
    function closeOthers(current) {
      megas.forEach(function (other) {
        if (other !== current) other.classList.remove('is-open');
      });
    }
    megas.forEach(function (el) {
      var t;
      function open() { clearTimeout(t); closeOthers(el); el.classList.add('is-open'); }
      function scheduleClose() { clearTimeout(t); t = setTimeout(function () { el.classList.remove('is-open'); }, 260); }
      el.addEventListener('mouseenter', open);
      el.addEventListener('mouseleave', scheduleClose);
      el.addEventListener('focusin', open);
      el.addEventListener('focusout', scheduleClose);
      el.addEventListener('keydown', function (e) { if (e.key === 'Escape') { clearTimeout(t); el.classList.remove('is-open'); } });
      // al hacer clic en un link del panel, cerrar de una
      el.querySelectorAll('a').forEach(function (a) {
        a.addEventListener('click', function () { clearTimeout(t); el.classList.remove('is-open'); });
      });
    });
  })();
</script>
