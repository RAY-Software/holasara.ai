---
// Carrusel de clientes reales ("ya trabajan con Sara"). Prueba social honesta:
// fotos reales de cada clínica (bajadas de sus sitios en prod) + nombre y rubro,
// sin métricas inventadas (las métricas reales de ViaLaser viven en /caso).
// Marquee suave estilo tira de casos, pausa al hover, respeta reduced-motion.
import { defaultLocale, type Locale } from '../i18n/config';
interface Props {
  label?: string;
  tone?: 'light' | 'paper';
  lang?: Locale;
}
const { lang = defaultLocale, tone = 'paper' } = Astro.props;
const { label = lang === 'en' ? 'Clinics already working with Sara' : 'Clínicas que ya trabajan con Sara' } = Astro.props;

type Client = { name: string; tag: string; img: string; alt: string };

const tags =
  lang === 'en'
    ? {
        laser: 'Laser hair removal',
        facial: 'Facial aesthetics',
        rhino: 'Rhinoplasty',
        physio: 'Physiotherapy',
        surgery: 'Plastic & aesthetic surgery',
      }
    : {
        laser: 'Depilación láser',
        facial: 'Estética facial',
        rhino: 'Rinoplastia',
        physio: 'Fisioterapia',
        surgery: 'Cirugía plástica y estética',
      };

const alts =
  lang === 'en'
    ? {
        vialaser: 'Front desk of the ViaLaser laser hair removal center',
        faceup: 'Facial treatment at the FaceUp clinic',
        drreyes: 'Facial profile illustrating rhinoplasty at DrReyes',
        physiup: 'Physiup, physiotherapy and movement center',
        sorace: 'Consultation at Dres. Sorace & Mendoza, plastic surgery',
      }
    : {
        vialaser: 'Recepción del centro de depilación láser ViaLaser',
        faceup: 'Tratamiento facial en la clínica FaceUp',
        drreyes: 'Perfil facial que ilustra la rinoplastia en DrReyes',
        physiup: 'Physiup, centro de fisioterapia y movimiento',
        sorace: 'Consulta en Dres. Sorace & Mendoza, cirugía plástica',
      };

const clients: Client[] = [
  { name: 'ViaLaser', tag: tags.laser, img: '/img/tenants/vialaser.jpg', alt: alts.vialaser },
  { name: 'FaceUp', tag: tags.facial, img: '/img/tenants/faceup.jpg', alt: alts.faceup },
  { name: 'DrReyes', tag: tags.rhino, img: '/img/tenants/drreyes.jpg', alt: alts.drreyes },
  { name: 'Physiup', tag: tags.physio, img: '/img/tenants/physiup.jpg', alt: alts.physiup },
  { name: 'Sorace & Mendoza', tag: tags.surgery, img: '/img/tenants/sorace.jpg', alt: alts.sorace },
];
// Duplicamos para un loop continuo sin cortes.
const loop = [...clients, ...clients];
const bg = tone === 'light' ? 'bg-white' : 'bg-paper';
const edge = tone === 'light' ? 'from-white' : 'from-paper';
---

<section class={`overflow-hidden border-y border-line ${bg}`} aria-label={label}>
  <div class="mx-auto max-w-6xl px-5 pt-9">
    <p class="text-center text-xs font-semibold uppercase tracking-[0.16em] text-salvia">{label}</p>
  </div>

  <div class="clients-marquee relative mt-7 pb-9">
    <!-- Máscaras de degradé en los bordes -->
    <div class={`pointer-events-none absolute inset-y-0 left-0 z-10 w-14 bg-gradient-to-r ${edge} to-transparent sm:w-20`}></div>
    <div class={`pointer-events-none absolute inset-y-0 right-0 z-10 w-14 bg-gradient-to-l ${edge} to-transparent sm:w-20`}></div>

    <ul class="clients-track flex w-max gap-4 px-5 sm:gap-5">
      {
        loop.map((c, i) => (
          <li
            class="relative aspect-[4/3] w-[260px] shrink-0 overflow-hidden rounded-2xl border border-line shadow-[0_10px_30px_-20px_rgba(20,38,31,0.35)] md:w-[300px]"
            aria-hidden={i >= clients.length ? 'true' : undefined}
          >
            <img
              src={c.img}
              alt={i >= clients.length ? '' : c.alt}
              class="absolute inset-0 h-full w-full object-cover"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-ink/85 via-ink/25 to-transparent" />
            <div class="absolute inset-x-0 bottom-0 p-4 text-white">
              <h3 class="font-serif text-lg font-black leading-tight tracking-tight drop-shadow-sm">{c.name}</h3>
              <p class="mt-0.5 text-xs font-semibold uppercase tracking-[0.12em] text-mint">{c.tag}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .clients-track {
    animation: clients-scroll 32s linear infinite;
    will-change: transform;
  }
  .clients-marquee:hover .clients-track {
    animation-play-state: paused;
  }
  /* -50% = ancho de una copia del set (duplicado arriba) → loop perfecto */
  @keyframes clients-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .clients-marquee {
      overflow-x: auto;
    }
    .clients-track {
      animation: none;
    }
  }
</style>
