---
interface Props {
  class?: string;
  dark?: boolean; // true when on a dark (tinta bosque) background
}
const { class: cls = '', dark = false } = Astro.props;
---

<span class={`font-serif inline-flex items-start leading-none tracking-tight ${dark ? 'text-cream' : 'text-ink'} ${cls}`}>
  Sara<span class="dot ml-[0.05em] mt-[0.16em] h-[0.13em] w-[0.13em]" aria-hidden="true"></span>
</span>
