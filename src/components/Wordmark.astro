---
interface Props {
  class?: string;
  dark?: boolean; // true cuando va sobre fondo oscuro
}
const { class: cls = '', dark = false } = Astro.props;
---

<span
  class={`font-display inline-flex items-center gap-[0.10em] leading-none ${dark ? 'text-cream' : 'text-ink'} ${cls}`}
  style="font-weight:900; letter-spacing:-0.06em;"
>
  sara<span class="caret" aria-hidden="true"></span>
</span>
