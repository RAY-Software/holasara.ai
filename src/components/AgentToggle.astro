---
// Switch flotante Humano / Agente en el borde izquierdo (patrón de konghq.com).
// Presente en las dos vistas para que una persona o un LLM descubran la alternativa.
// Los hrefs se corrigen en runtime desde location (el rewrite de ?mode=agent preserva
// el path), así funciona igual en cualquier página sin lógica server-side.
interface Props {
  active?: 'human' | 'agent';
}
const { active = 'human' } = Astro.props;
const path = Astro.url.pathname === '/agent' ? '/' : Astro.url.pathname;
const humanHref = path;
const agentHref = `${path}?mode=agent`;
---

<nav class="agent-toggle" aria-label="Cambiar entre vista humana y de agente">
  <a
    class="agent-toggle__opt"
    data-role="human"
    href={humanHref}
    rel="nofollow"
    title="Vista humana"
    aria-label="Vista humana"
    aria-current={active === 'human' ? 'true' : undefined}
  >
    <svg class="agent-toggle__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="8" r="3.6" />
      <path d="M5.5 20c0-3.6 3-5.6 6.5-5.6s6.5 2 6.5 5.6" />
    </svg>
  </a>
  <a
    class="agent-toggle__opt"
    data-role="agent"
    href={agentHref}
    rel="nofollow"
    title="Vista de agente (Markdown para IA)"
    aria-label="Vista de agente"
    aria-current={active === 'agent' ? 'true' : undefined}
  >
    <svg class="agent-toggle__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="4.5" y="8.5" width="15" height="10.5" rx="2.5" />
      <path d="M12 8.5v-3" />
      <circle cx="12" cy="4.4" r="1.1" />
      <path d="M9.2 13.2h.01M14.8 13.2h.01" />
      <path d="M2.6 13v3M21.4 13v3" />
    </svg>
  </a>
</nav>

<style>
  /* Rail de iconos, discreto. Vive en el gutter izquierdo que reserva global.css
     (.mx-auto.px-5) → nunca pisa el contenido. Sin texto: la etiqueta va en title
     (tooltip) + aria-label (lectores de pantalla). Semi-transparente en reposo
     para no competir con el contenido; se afirma al hover. */
  .agent-toggle {
    position: fixed;
    left: 0;
    top: 50%;
    z-index: 50;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15rem;
    padding: 0.3rem 0.25rem;
    border: 1px solid rgba(34, 48, 41, 0.6);
    border-left: 0;
    border-radius: 0 0.6rem 0.6rem 0;
    background: rgba(11, 20, 16, 0.5);
    backdrop-filter: blur(6px);
    opacity: 0.7;
    transition: opacity 0.18s ease, background-color 0.18s ease;
  }
  .agent-toggle:hover,
  .agent-toggle:focus-within {
    opacity: 1;
    background: rgba(11, 20, 16, 0.85);
  }
  .agent-toggle__opt {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.32rem;
    border-radius: 0.45rem;
    color: #8a978d;
    text-decoration: none;
    transition: color 0.15s ease, background-color 0.15s ease;
  }
  .agent-toggle__icon {
    width: 1.05rem;
    height: 1.05rem;
    display: block;
  }
  .agent-toggle__opt:hover { color: #e6ebe7; }
  .agent-toggle__opt[aria-current='true'] {
    color: #0b1410;
    background: #3fe08a;
  }
</style>

<script is:inline>
  // El rewrite de ?mode=agent conserva el path en la URL → recalculamos los destinos
  // desde location para que "Humano" vuelva a la página real y "Agente" la abra en modo agente.
  (function () {
    var path = location.pathname === '/agent' ? '/' : location.pathname;
    var h = document.querySelector('.agent-toggle__opt[data-role="human"]');
    var a = document.querySelector('.agent-toggle__opt[data-role="agent"]');
    if (h) h.setAttribute('href', path);
    if (a) a.setAttribute('href', path + '?mode=agent');
  })();
</script>
