---
// Switch flotante Humano / Agente en el borde izquierdo (patrón de konghq.com).
// Presente en las dos vistas para que una persona o un LLM descubran la alternativa.
// Los hrefs se corrigen en runtime desde location (el rewrite de ?mode=agent preserva
// el path), así funciona igual en cualquier página sin lógica server-side.
interface Props {
  active?: 'human' | 'agent';
}
const { active = 'human' } = Astro.props;
const path = Astro.url.pathname === '/agent' ? '/' : Astro.url.pathname;
const humanHref = path;
const agentHref = `${path}?mode=agent`;
---

<nav class="agent-toggle" aria-label="Cambiar entre vista humana y de agente">
  <a
    class="agent-toggle__opt"
    data-role="human"
    href={humanHref}
    rel="nofollow"
    aria-current={active === 'human' ? 'true' : undefined}
  >
    <span class="agent-toggle__dot" aria-hidden="true"></span>
    <span class="agent-toggle__label">Humano</span>
  </a>
  <a
    class="agent-toggle__opt"
    data-role="agent"
    href={agentHref}
    rel="nofollow"
    aria-current={active === 'agent' ? 'true' : undefined}
  >
    <span class="agent-toggle__dot" aria-hidden="true"></span>
    <span class="agent-toggle__label">Agente</span>
  </a>
</nav>

<style>
  /* En reposo el rail es slim (solo los puntos) y cabe dentro del gutter de 20px
     del sitio → no pisa el H1 del hero. Al hover/focus se expande y revela las
     etiquetas Humano/Agente. */
  .agent-toggle {
    position: fixed;
    left: 0;
    top: 50%;
    z-index: 50;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
    padding: 0.7rem 0.3rem;
    border: 1px solid #223029;
    border-left: 0;
    border-radius: 0 0.7rem 0.7rem 0;
    background: rgba(11, 20, 16, 0.72);
    backdrop-filter: blur(6px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.22);
    transition: background-color 0.18s ease, padding 0.18s ease;
  }
  .agent-toggle:hover,
  .agent-toggle:focus-within {
    padding: 0.9rem 0.45rem;
    background: rgba(11, 20, 16, 0.92);
  }
  .agent-toggle__opt {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    text-decoration: none;
  }
  .agent-toggle__dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 9999px;
    background: #566459;
    transition: background-color 0.15s ease, box-shadow 0.15s ease;
  }
  .agent-toggle__label {
    writing-mode: vertical-rl;
    text-orientation: upright;
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    color: #7c8a80;
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition: max-height 0.2s ease, opacity 0.2s ease, color 0.15s ease;
  }
  .agent-toggle:hover .agent-toggle__label,
  .agent-toggle:focus-within .agent-toggle__label {
    max-height: 6rem;
    opacity: 1;
  }
  .agent-toggle__opt:hover .agent-toggle__dot { background: #9aa89e; }
  .agent-toggle__opt:hover .agent-toggle__label { color: #d6ddd7; }
  .agent-toggle__opt[aria-current='true'] .agent-toggle__dot {
    background: #3fe08a;
    box-shadow: 0 0 0 3px rgba(63, 224, 138, 0.18);
  }
  .agent-toggle__opt[aria-current='true'] .agent-toggle__label { color: #f3f6f4; }
</style>

<script is:inline>
  // El rewrite de ?mode=agent conserva el path en la URL → recalculamos los destinos
  // desde location para que "Humano" vuelva a la página real y "Agente" la abra en modo agente.
  (function () {
    var path = location.pathname === '/agent' ? '/' : location.pathname;
    var h = document.querySelector('.agent-toggle__opt[data-role="human"]');
    var a = document.querySelector('.agent-toggle__opt[data-role="agent"]');
    if (h) h.setAttribute('href', path);
    if (a) a.setAttribute('href', path + '?mode=agent');
  })();
</script>
