---
// FAQ con <details> nativo (accesible, sin JS). Reusable en páginas de feature.
interface QA {
  q: string;
  a: string;
}
import { defaultLocale, type Locale } from '../i18n/config';
interface Props {
  title?: string;
  items: QA[];
  lang?: Locale;
  /** Emite el JSON-LD FAQPage con las mismas preguntas visibles. Pasar `false`
   *  en páginas que ya lo publican por su cuenta vía <Layout schema>. */
  schema?: boolean;
}
const { lang = defaultLocale, items, schema = true } = Astro.props;

// JSON-LD: FAQPage para que Google y los asistentes de IA (AEO) lean las preguntas.
// Va en el body; es válido para schema.org y Google lo acepta igual que en <head>.
const strip = (s: string) => s.replace(/<[^>]+>/g, '').replace(/&nbsp;/g, ' ').trim();
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((it) => ({
    '@type': 'Question',
    name: strip(it.q),
    acceptedAnswer: { '@type': 'Answer', text: strip(it.a) },
  })),
};
const { title = lang === 'en' ? 'Frequently asked questions' : 'Preguntas frecuentes' } = Astro.props;
---

<section class="border-t border-line">
  {schema && items.length > 0 && <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />}
  <div class="reveal mx-auto max-w-3xl px-5 py-24 max-lg:pr-20 max-lg:pb-28">
    <h2 class="font-serif text-3xl font-black leading-tight text-balance md:text-4xl">{title}</h2>
    <div class="mt-10 divide-y divide-line border-t border-line">
      {
        items.map((it) => (
          <details class="group">
            <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 py-4 text-lg font-semibold text-ink [&::-webkit-details-marker]:hidden">
              <span class="min-w-0 flex-1 text-left">{it.q}</span>
              <svg class="h-5 w-5 shrink-0 text-salvia transition-transform group-open:rotate-45" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <path d="M10 4v12M4 10h12" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
              </svg>
            </summary>
            <p class="mt-3 pb-5 text-salvia">{it.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
