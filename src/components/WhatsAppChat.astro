---
// Mock de conversación de WhatsApp con Sara. El corazón visual del hero.
const bubbles = [
  { who: 'in', text: 'Hola, vi lo de depilación láser. ¿Cuánto sale full piernas?', t: '23:41' },
  { who: 'out', text: '¡Hola! Full piernas está US$180 la sesión, y tenemos un pack de 6 con descuento. ¿Te muestro horarios para esta semana?', t: '23:41' },
  { who: 'in', text: 'Dale, algo de tarde', t: '23:42' },
  { who: 'out', text: 'Perfecto. Tengo jueves 17:30 o viernes 18:00. Reservás con una seña de US$30 y queda confirmado. ¿Cuál te queda mejor?', t: '23:42' },
  { who: 'in', text: 'Jueves', t: '23:43' },
  { who: 'out', text: '¡Listo! Jueves 17:30 reservado ✅ Te paso el link de pago y te llega el recordatorio un día antes.', t: '23:43' },
];
---

<div class="w-full max-w-sm rounded-3xl border border-line bg-paper p-4 shadow-[0_20px_50px_-24px_rgba(20,38,31,0.45)]">
  <div class="mb-4 flex items-center gap-3 border-b border-line pb-4">
    <div
      class="grid h-10 w-10 place-items-center rounded-full border border-line font-serif text-xl text-pine-dark"
      style="background: radial-gradient(120% 120% at 30% 25%, color-mix(in srgb, var(--color-mint) 55%, var(--color-paper)), var(--color-paper));"
    >
      S
    </div>
    <div>
      <div class="text-sm font-semibold text-ink">Sara</div>
      <div class="flex items-center gap-1.5 text-xs text-pine">
        <span class="h-1.5 w-1.5 rounded-full bg-mint"></span>
        en línea · responde al toque
      </div>
    </div>
  </div>

  <div class="flex flex-col gap-2">
    {
      bubbles.map((b) => (
        <div
          class={
            b.who === 'in'
              ? 'max-w-[82%] self-start rounded-2xl rounded-bl-sm bg-ink/[0.06] px-3 py-2 text-[14px] leading-snug text-ink'
              : 'max-w-[82%] self-end rounded-2xl rounded-br-sm border border-mint/35 bg-mint/[0.14] px-3 py-2 text-[14px] leading-snug text-ink'
          }
        >
          {b.text}
          <span class="mt-1 block text-[10px] tabular-nums text-salvia">{b.t}</span>
        </div>
      ))
    }
  </div>
</div>
