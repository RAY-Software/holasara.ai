---
import { whatsappLink, whatsappText } from '../lib/whatsapp';
import { SHOW_GRADER_CTA } from '../lib/flags';
import ClientsStrip from './ClientsStrip.astro';
import { defaultLocale, localePath, type Locale } from '../i18n/config';

interface Props {
  eyebrow: string;
  title: string; // puede contener <em> y &nbsp;
  lead: string;
  image?: string;
  imageAlt?: string;
  imageW?: number;
  imageH?: number;
  lang?: Locale;
}
const { eyebrow, title, lead, image, imageAlt = '', imageW, imageH, lang = defaultLocale } = Astro.props;
const t =
  lang === 'en'
    ? { back: 'Back to home', demo: 'Book a demo', scan: 'Scan my business', talk: 'Talk to Sara' }
    : { back: 'Volver al inicio', demo: 'Pedir demo', scan: 'Escanear mi negocio', talk: 'Habla con Sara' };
// CTA secundario del hero: "Escanear mi negocio" (al grader) en todas las
// páginas. Cae a "Habla con Sara" (WhatsApp) si se apaga el flag del grader.
const showScan = SHOW_GRADER_CTA;
// Slot "visual": permite poner un componente (p. ej. una conversación) en la
// columna derecha en vez de una imagen. Si está, reemplaza al <img>.
const hasVisual = Astro.slots.has('visual');
const hasMedia = Boolean(image) || hasVisual;
---

<section class="border-b border-line">
  <div class={`mx-auto max-w-6xl px-5 pb-20 pt-14 ${hasMedia ? 'grid gap-14 md:grid-cols-[1.05fr_0.95fr] md:items-center' : ''}`}>
    <div>
      <a href={localePath('/', lang)} class="mb-8 inline-flex items-center gap-1.5 text-sm font-medium text-salvia transition-colors hover:text-ink">
        <span aria-hidden="true">←</span> {t.back}
      </a>
      <p class="mb-4 flex items-center gap-2.5 text-sm font-semibold uppercase tracking-[0.14em] text-pine-dark">
        <span class="dot h-2 w-2"></span>{eyebrow}
      </p>
      <h1 class="font-serif text-3xl font-black leading-[1.05] tracking-tight text-balance md:text-6xl" set:html={title} />
      <p class="mt-6 max-w-xl text-lg text-salvia">{lead}</p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a
          href={localePath('/demo', lang)}
          class="inline-flex items-center gap-2 rounded-full bg-pine px-6 py-3 text-base font-semibold text-cream transition-colors hover:bg-pine-dark"
        >
          {t.demo}
        </a>
        {
          showScan ? (
            <a
              href="https://grader.rayapp.ai/?product=servicios&utm_source=hero&utm_medium=website&utm_campaign=holasara"
              class="inline-flex items-center gap-2 rounded-full border border-line px-6 py-3 text-base font-semibold text-ink transition-colors hover:border-ink/30"
            >
              {t.scan}
            </a>
          ) : (
            <a
              href={whatsappLink(whatsappText(lang))}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-2 rounded-full border border-line px-6 py-3 text-base font-semibold text-ink transition-colors hover:border-ink/30"
            >
              {t.talk}
            </a>
          )
        }
      </div>
    </div>

    {
      hasVisual ? (
        <div class="flex w-full justify-center md:justify-end">
          <slot name="visual" />
        </div>
      ) : (
        image && (
          <div class="flex justify-center md:justify-center">
            <div class="relative inline-block">
              <img
                src={image}
                width={imageW}
                height={imageH}
                alt={imageAlt}
                class="block h-auto max-h-[520px] w-auto max-w-full rounded-2xl border border-line shadow-[0_10px_30px_-20px_rgba(20,38,31,0.26)]"
                fetchpriority="high"
              />
              <slot name="image-overlay" />
            </div>
          </div>
        )
      )
    }
  </div>
</section>

<ClientsStrip lang={lang} />
