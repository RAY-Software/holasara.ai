---
import '../styles/global.css';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import AgentToggle from '../components/AgentToggle.astro';
import MetaAttribution from '../components/MetaAttribution.astro';
import { GA4_ID, META_PIXEL_ID, GOOGLE_ADS_ID, saraTrack } from '../lib/tracking';
import { SRC_TAG } from '../lib/whatsapp';
import { defaultLocale, locales, type Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  schema?: unknown; // JSON-LD extra por página (opcional)
  lang?: Locale;
  /** OG image propia de la página (path absoluto del sitio, 1200x630).
   * Sin ella, cae al genérico /og-image.jpg. */
  ogImage?: string;
}

const { lang = defaultLocale, schema, ogImage = '/og-image.jpg' } = Astro.props;
const t = useTranslations(lang);

const { title = t('meta.title'), description = t('meta.description') } = Astro.props;
const ogImageUrl = new URL(ogImage, Astro.site);

const canonical = new URL(Astro.url.pathname, Astro.site);
const siteUrl = (Astro.site?.toString() ?? 'https://holasara.ai/').replace(/\/$/, '');

// hreflang: alterna el segmento de idioma del path actual (/es/foo ↔ /en/foo).
const stripLocale = Astro.url.pathname.replace(/^\/(es|en)(?=\/|$)/, '') || '/';
const altUrls = locales.map((l) => ({
  lang: l,
  href: new URL(`/${l}${stripLocale === '/' ? '' : stripLocale}`, Astro.site).toString(),
}));
const ogLocale = lang === 'en' ? 'en_US' : 'es_LA';

// --- Tracking ---
// Config centralizada en src/lib/tracking.ts (labels separados para form y WhatsApp).
// Definí las env vars en .env y en Vercel → Settings → Environment Variables (Production).

// JS inline de los tags (armado acá para evitar template literals anidados en el markup)
const gtagJs =
  `window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}` +
  `gtag('js',new Date());gtag('config','${GA4_ID}');` +
  (GOOGLE_ADS_ID ? `gtag('config','${GOOGLE_ADS_ID}');` : '');
const pixelJs = META_PIXEL_ID
  ? `!function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');fbq('init','${META_PIXEL_ID}');fbq('track','PageView');`
  : '';
const pixelNoscript = META_PIXEL_ID
  ? `<img height="1" width="1" style="display:none" alt="" src="https://www.facebook.com/tr?id=${META_PIXEL_ID}&ev=PageView&noscript=1"/>`
  : '';
const saraTrackJs = 'window.__saraTrack=' + JSON.stringify(saraTrack) + ';';
const gtagSrc = `https://www.googletagmanager.com/gtag/js?id=${GA4_ID}`;

const baseSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteUrl}/#organization`,
      name: 'Sara',
      url: `${siteUrl}/`,
      logo: `${siteUrl}/brand/sara-mark-512.png`,
      description:
        lang === 'en'
          ? 'The AI receptionist for clinics: she handles WhatsApp and Instagram 24/7, books appointments and collects the deposit. With Mia (marketing) and Daniel (finance).'
          : 'La secretaria con IA para clínicas: atiende WhatsApp e Instagram las 24 horas, agenda y cobra el anticipo. Con Mia (marketing) y Daniel (finanzas).',
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      name: 'Sara',
      url: `${siteUrl}/`,
      inLanguage: lang,
      publisher: { '@id': `${siteUrl}/#organization` },
    },
    {
      '@type': 'SoftwareApplication',
      name: 'Sara',
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Web',
      description:
        lang === 'en'
          ? 'An AI front desk for aesthetic and health clinics. She answers, books, collects the deposit and cuts no-shows on WhatsApp and Instagram.'
          : 'Recepción con IA para clínicas de estética y salud. Atiende, agenda, cobra el anticipo y baja las ausencias en WhatsApp e Instagram.',
      publisher: { '@id': `${siteUrl}/#organization` },
    },
  ],
};

const schemas = schema ? [baseSchema, schema] : [baseSchema];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

    <!-- Verificación de dominio de Meta (porfolio RAY Software). Va en TODAS las páginas
         y no solo en la home porque el Edge Middleware redirige / a /es: el crawler de
         Meta sigue el redirect y termina leyendo el <head> de este Layout. Estático a
         propósito (no env var): el tag tiene que estar en el HTML servido siempre. -->
    <meta name="facebook-domain-verification" content="njpqfx6xxvyxxakl8z8pch5r1k5e9f" />

    <!-- Marketing tags (GA4 + Google Ads + Meta Pixel) · solo en producción -->
    {
      import.meta.env.PROD && (
        <Fragment>
          <script async is:inline src={gtagSrc} />
          <script is:inline set:html={gtagJs} />
          <script is:inline set:html={pixelJs} />
          <noscript set:html={pixelNoscript}></noscript>
          <script is:inline set:html={saraTrackJs} />
        </Fragment>
      )
    }

    <!-- Captura de `_fbc` / `_fbp`. Fuera del gate de PROD a propósito: solo escribe
         cookies de primera parte (no manda nada a Meta) y así el circuito de
         atribución se puede probar en dev igual que en producción. -->
    <MetaAttribution />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    {altUrls.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={altUrls.find((a) => a.lang === defaultLocale)?.href} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Sara" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Schema.org / JSON-LD -->
    {schemas.map((s) => <script type="application/ld+json" is:inline set:html={JSON.stringify(s)} />)}
  </head>
  <body class="min-h-screen antialiased">
    <slot />
    <WhatsAppFloat lang={lang} />
    <AgentToggle active="human" lang={lang} />

    <script>
      // Scroll reveal
      const els = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                io.unobserve(e.target);
              }
            }
          },
          { threshold: 0.12 }
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-in'));
      }
    </script>

    <!-- Atribución: captura de click-ids y evento Contact en clicks de WhatsApp -->
    <script is:inline define:vars={{ SRC_TAG }}>
      (function () {
        function setCookie(n, v) {
          document.cookie = n + '=' + v + ';path=/;max-age=' + 60 * 60 * 24 * 90 + ';SameSite=Lax';
        }
        function getCookie(n) {
          var m = document.cookie.match('(^|;)\\s*' + n + '\\s*=\\s*([^;]+)');
          return m ? m.pop() : '';
        }
        // 1) Capturar click-ids de la URL (gclid de Google, fbclid de Meta) en cookie 90d
        var p = new URLSearchParams(location.search);
        var toks = [];
        ['gclid', 'wbraid', 'gbraid', 'fbclid'].forEach(function (k) {
          var v = p.get(k);
          if (v) toks.push('[' + k + ':' + v + ']');
        });
        var token = toks.join('');
        if (token) setCookie('sara_click', encodeURIComponent(token));
        else token = decodeURIComponent(getCookie('sara_click') || '');

        // Marcador de marca + click-ids. El de marca va SIEMPRE (identifica a holasara en
        // el backend compartido con RAY); los click-ids solo si hay. Ver lib/whatsapp.ts.
        //
        // Al MENSAJE de WhatsApp van solo los click-ids de Google: el de Meta viaja como
        // `[fbc:fb.1.<ts>.<fbclid>]` que arma <MetaAttribution />, que es el único formato
        // que lee `extractFbc()` en el backend. El `[fbclid:<crudo>]` queda igual dentro de
        // la cookie `sara_click`, porque de ahí lo levanta el formulario de /demo para los
        // campos ocultos.
        var googleToken = token.replace(/\[fbclid:[^\]]*\]/g, '');
        var metaRefs = '';
        try {
          if (window.__saraMeta) metaRefs = window.__saraMeta.refs();
        } catch (e) {}
        var tag = SRC_TAG + googleToken + metaRefs;

        // Ruteo AR/MX (igual que ray-website): el link se server-renderiza a la línea MX
        // y acá lo pasamos a la AR para visitantes de Argentina (timezone o idioma).
        var WA_MX = '526144659466', WA_AR = '5491150363441', IS_AR = false;
        try {
          var _tz = (Intl.DateTimeFormat().resolvedOptions().timeZone) || '';
          IS_AR = /America\/Argentina/.test(_tz) || /^es-AR/i.test(navigator.language || '');
        } catch (e) {}

        // 2) Ruteo AR/MX + token en el mensaje de wa.me + disparar Contact al click
        function enhance() {
          document.querySelectorAll('a[href^="https://wa.me/"]').forEach(function (a) {
            if (IS_AR) a.href = a.href.replace('/' + WA_MX, '/' + WA_AR);
            // El sufijo de atribución siempre arranca con SRC_TAG, así que cortando ahí
            // recuperamos el texto base y volvemos a escribirlo completo. Idempotente:
            // da igual si el link ya venía server-renderizado con el marcador o si
            // enhance() corre dos veces.
            try {
              var u = new URL(a.href);
              var t = (u.searchParams.get('text') || '').split(SRC_TAG)[0].trim();
              u.searchParams.set('text', (t + ' ' + tag).trim());
              a.href = u.toString();
            } catch (e) {}
            if (a.__saraBound) return;
            a.__saraBound = 1;
            a.addEventListener('click', function () {
              // Meta: `Contact`, NO `Lead`. Un clic en WhatsApp no es un lead — es
              // barato y lo hace cualquiera. Si compartiera nombre de evento con el
              // envío del formulario, optimizar por `Lead` haría que el algoritmo
              // persiga clics y el pipeline quede vacío con un CPA que parece
              // excelente. Es la misma razón por la que en Google hay dos labels
              // separados (ver lib/tracking.ts).
              try {
                if (window.fbq)
                  fbq('track', 'Contact', {
                    content_name: 'whatsapp-click',
                    content_category: location.pathname,
                  });
              } catch (e) {}
              try {
                if (window.gtag)
                  gtag('event', 'generate_lead', {
                    event_category: 'engagement',
                    event_label: 'whatsapp',
                    transport_type: 'beacon',
                  });
              } catch (e) {}
              // Conversión SECUNDARIA (observación). El clic no es un lead: la conversión
              // que optimiza es la conversación real, que se sube por offline import
              // matcheando el token que va acá abajo dentro del texto del mensaje.
              try {
                var c = window.__saraTrack;
                if (window.gtag && c && c.adsId && c.waLabel)
                  gtag('event', 'conversion', { send_to: c.adsId + '/' + c.waLabel });
              } catch (e) {}
            });
          });
        }
        if (document.readyState !== 'loading') enhance();
        else document.addEventListener('DOMContentLoaded', enhance);
      })();
    </script>
  </body>
</html>
