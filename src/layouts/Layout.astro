---
import '../styles/global.css';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';

interface Props {
  title?: string;
  description?: string;
  schema?: unknown; // JSON-LD extra por página (opcional)
}

const {
  title = 'Sara — La recepción que nunca cierra',
  description =
    'Sara es la secretaria con IA de tu clínica: atiende WhatsApp e Instagram las 24 horas, agenda, cobra el anticipo y baja las ausencias. Más pacientes, más facturación, todo automático.',
  schema,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const siteUrl = (Astro.site?.toString() ?? 'https://holasara.ai/').replace(/\/$/, '');

// --- Tracking (Fase 1) ---
// Los tags se cargan SOLO en build de producción y SOLO si defines las env vars.
// Definí en .env (y en Vercel): PUBLIC_META_PIXEL_ID, PUBLIC_GOOGLE_ADS_ID,
// PUBLIC_GOOGLE_ADS_LEAD_LABEL. GA4 ya está seteado (holasara), overrideable por env.
const GA4_ID = import.meta.env.PUBLIC_GA4_ID ?? 'G-NRN8H0WR62';
const META_PIXEL_ID = import.meta.env.PUBLIC_META_PIXEL_ID ?? '';
const GOOGLE_ADS_ID = import.meta.env.PUBLIC_GOOGLE_ADS_ID ?? '';
const GOOGLE_ADS_LEAD_LABEL = import.meta.env.PUBLIC_GOOGLE_ADS_LEAD_LABEL ?? '';

// JS inline de los tags (armado acá para evitar template literals anidados en el markup)
const gtagJs =
  `window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}` +
  `gtag('js',new Date());gtag('config','${GA4_ID}');` +
  (GOOGLE_ADS_ID ? `gtag('config','${GOOGLE_ADS_ID}');` : '');
const pixelJs = META_PIXEL_ID
  ? `!function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');fbq('init','${META_PIXEL_ID}');fbq('track','PageView');`
  : '';
const pixelNoscript = META_PIXEL_ID
  ? `<img height="1" width="1" style="display:none" alt="" src="https://www.facebook.com/tr?id=${META_PIXEL_ID}&ev=PageView&noscript=1"/>`
  : '';
const saraTrackObj = JSON.stringify({ adsId: GOOGLE_ADS_ID, adsLabel: GOOGLE_ADS_LEAD_LABEL });
const saraTrackJs = 'window.__saraTrack=' + saraTrackObj + ';';
const gtagSrc = `https://www.googletagmanager.com/gtag/js?id=${GA4_ID}`;

const baseSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteUrl}/#organization`,
      name: 'Sara',
      url: `${siteUrl}/`,
      logo: `${siteUrl}/brand/sara-mark-512.png`,
      description:
        'La secretaria con IA para clínicas: atiende WhatsApp e Instagram las 24 horas, agenda y cobra el anticipo.',
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      name: 'Sara',
      url: `${siteUrl}/`,
      inLanguage: 'es',
      publisher: { '@id': `${siteUrl}/#organization` },
    },
    {
      '@type': 'SoftwareApplication',
      name: 'Sara',
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Web',
      description:
        'Recepción con IA para clínicas de estética y salud. Atiende, agenda, cobra el anticipo y baja las ausencias en WhatsApp e Instagram.',
      publisher: { '@id': `${siteUrl}/#organization` },
    },
  ],
};

const schemas = schema ? [baseSchema, schema] : [baseSchema];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Marketing tags (GA4 + Google Ads + Meta Pixel) — solo en producción -->
    {
      import.meta.env.PROD && (
        <Fragment>
          <script async is:inline src={gtagSrc} />
          <script is:inline set:html={gtagJs} />
          <script is:inline set:html={pixelJs} />
          <noscript set:html={pixelNoscript}></noscript>
          <script is:inline set:html={saraTrackJs} />
        </Fragment>
      )
    }
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href="/fonts/Chopin-Trial-Black.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Sara" />
    <meta property="og:locale" content="es_LA" />
    <meta property="og:image" content={new URL('/og-image.jpg', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Sara — La recepción que nunca cierra" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL('/og-image.jpg', Astro.site)} />

    <!-- Schema.org / JSON-LD -->
    {schemas.map((s) => <script type="application/ld+json" is:inline set:html={JSON.stringify(s)} />)}
  </head>
  <body class="min-h-screen antialiased">
    <slot />
    <WhatsAppFloat />

    <script>
      // Scroll reveal
      const els = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                io.unobserve(e.target);
              }
            }
          },
          { threshold: 0.12 }
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-in'));
      }
    </script>

    <!-- Atribución: captura de click-ids y evento Lead en clicks de WhatsApp -->
    <script is:inline>
      (function () {
        function setCookie(n, v) {
          document.cookie = n + '=' + v + ';path=/;max-age=' + 60 * 60 * 24 * 90 + ';SameSite=Lax';
        }
        function getCookie(n) {
          var m = document.cookie.match('(^|;)\\s*' + n + '\\s*=\\s*([^;]+)');
          return m ? m.pop() : '';
        }
        // 1) Capturar click-ids de la URL (gclid de Google, fbclid de Meta) en cookie 90d
        var p = new URLSearchParams(location.search);
        var toks = [];
        ['gclid', 'wbraid', 'gbraid', 'fbclid'].forEach(function (k) {
          var v = p.get(k);
          if (v) toks.push('[' + k + ':' + v + ']');
        });
        var token = toks.join('');
        if (token) setCookie('sara_click', encodeURIComponent(token));
        else token = decodeURIComponent(getCookie('sara_click') || '');

        // 2) Meter el token en el mensaje de wa.me + disparar Lead al click
        function enhance() {
          document.querySelectorAll('a[href^="https://wa.me/"]').forEach(function (a) {
            if (token && a.href.indexOf('%5Bgclid') === -1 && a.href.indexOf('%5Bfbclid') === -1) {
              try {
                var u = new URL(a.href);
                var t = u.searchParams.get('text') || '';
                if (t.indexOf('[gclid') === -1 && t.indexOf('[fbclid') === -1) {
                  u.searchParams.set('text', (t + ' ' + token).trim());
                  a.href = u.toString();
                }
              } catch (e) {}
            }
            if (a.__saraBound) return;
            a.__saraBound = 1;
            a.addEventListener('click', function () {
              try { if (window.fbq) fbq('track', 'Lead'); } catch (e) {}
              try {
                if (window.gtag)
                  gtag('event', 'generate_lead', {
                    event_category: 'engagement',
                    event_label: 'whatsapp',
                    transport_type: 'beacon',
                  });
              } catch (e) {}
              try {
                var c = window.__saraTrack;
                if (window.gtag && c && c.adsId && c.adsLabel)
                  gtag('event', 'conversion', { send_to: c.adsId + '/' + c.adsLabel });
              } catch (e) {}
            });
          });
        }
        if (document.readyState !== 'loading') enhance();
        else document.addEventListener('DOMContentLoaded', enhance);
      })();
    </script>
  </body>
</html>
