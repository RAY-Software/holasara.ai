---
import '../styles/global.css';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';

interface Props {
  title?: string;
  description?: string;
  schema?: unknown; // JSON-LD extra por página (opcional)
}

const {
  title = 'Sara — La recepción que nunca cierra',
  description =
    'Sara es la secretaria con IA de tu clínica: atiende WhatsApp e Instagram las 24 horas, agenda, cobra el anticipo y baja las ausencias. Más pacientes, más facturación, todo automático.',
  schema,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const siteUrl = (Astro.site?.toString() ?? 'https://holasara.ai/').replace(/\/$/, '');

const baseSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteUrl}/#organization`,
      name: 'Sara',
      url: `${siteUrl}/`,
      logo: `${siteUrl}/brand/sara-mark-512.png`,
      description:
        'La secretaria con IA para clínicas: atiende WhatsApp e Instagram las 24 horas, agenda y cobra el anticipo.',
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      name: 'Sara',
      url: `${siteUrl}/`,
      inLanguage: 'es',
      publisher: { '@id': `${siteUrl}/#organization` },
    },
    {
      '@type': 'SoftwareApplication',
      name: 'Sara',
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Web',
      description:
        'Recepción con IA para clínicas de estética y salud. Atiende, agenda, cobra el anticipo y baja las ausencias en WhatsApp e Instagram.',
      publisher: { '@id': `${siteUrl}/#organization` },
    },
  ],
};

const schemas = schema ? [baseSchema, schema] : [baseSchema];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Google Analytics (gtag.js) — solo en producción -->
    {
      import.meta.env.PROD && (
        <Fragment>
          <script async is:inline src="https://www.googletagmanager.com/gtag/js?id=G-NRN8H0WR62" />
          <script is:inline>
            {`window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('js', new Date());
            gtag('config', 'G-NRN8H0WR62');`}
          </script>
        </Fragment>
      )
    }
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href="/fonts/Chopin-Trial-Black.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Sara" />
    <meta property="og:locale" content="es_LA" />
    <meta property="og:image" content={new URL('/og-image.jpg', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Sara — La recepción que nunca cierra" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL('/og-image.jpg', Astro.site)} />

    <!-- Schema.org / JSON-LD -->
    {schemas.map((s) => <script type="application/ld+json" is:inline set:html={JSON.stringify(s)} />)}
  </head>
  <body class="min-h-screen antialiased">
    <slot />
    <WhatsAppFloat />

    <script>
      // Scroll reveal
      const els = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                io.unobserve(e.target);
              }
            }
          },
          { threshold: 0.12 }
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-in'));
      }
    </script>
  </body>
</html>
